; Generated plain interpreter for fetch-sequence comparisons.
Global Dim OpTableMFetchRef.Label(8192)
Global OpTableReadyMFetchRef.i                    ; 0 until the first CpuRun fills OpTable
Global FillFromMFetchRef.i, FillCountMFetchRef.i           ; Ops() - Globals, cheaper than locals

; OpTable(from) .. OpTable(from + count - 1) = target. A '.Label' can only
; be taken with ?Name inside the procedure that owns the label, so CpuRun
; itself passes its labels in; this only stores them.
Procedure OpsMFetchRef(from.i, count.i, target.Label)
  FillFromMFetchRef = from
  FillCountMFetchRef = count
  While FillCountMFetchRef > 0
    OpTableMFetchRef(FillFromMFetchRef) = target
    FillFromMFetchRef = FillFromMFetchRef + 1
    FillCountMFetchRef = FillCountMFetchRef - 1
  Wend
EndProcedure

; Execute up to n instructions. Returns how many ran.
ProcedureRAM.i CpuRunMFetchRef(n.i)
; ---- THE EMULATED PC (see PC in cpu) ----------------------------------
; Between instructions the emulated PC lives in PC, a register; Reg(7)
; is a stale copy. A handler that reaches Reg(7) through a variable
; register number, or calls a helper that does (EaWord, FetchWord, Push,
; Pop, TakeTrap, PswSet is fine), starts with PcOut() and ends with
; NextSynced(), which takes the PC back. Every other handler - the
; branches, SOB, and the register forms whose register cannot be R7 -
; works on PC directly and ends with NextNative().
Macro PcOutMFetchRef()
  Reg(7) = PC
EndMacro

; THE TAIL (see the top of this file), written once as macros and
; expanded in place at the end of every handler - a macro costs nothing
; at run time, so every handler still has its own copy of these lines.
; After a synced handler: take the PC back, take any trap, count, fetch.
Macro NextSyncedMFetchRef()
  PC = Reg(7)
  If Reg(#CPU_TRAPVECTOR)
    Goto SlowTailM
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEndM
  EndIf
  If PC >= Reg(#CPU_FW + (0))                       ; the fetch, through the fetch window (cpu)
    If PC - Reg(#CPU_FW + (0)) < Reg(#CPU_FW + (1))
      If (PC & 1) = 0
        MmuInstrStart(PC)
        Op = PeekU(PC + Reg(#CPU_FW + (2)))
        PC = PC + 2
        Goto OpTableMFetchRef(Op >> 3)
      EndIf
    EndIf
  EndIf
  Goto SlowFetchM
EndMacro

; After a native handler: it cannot trap and the PC it leaves is even (it
; was even when fetched, and a branch moves it by an even amount), so the
; only test left is whether it is still in RAM.
Macro NextNativeMFetchRef()
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEndM
  EndIf
  If PC >= Reg(#CPU_FW + (0))                       ; the fetch, through the fetch window (cpu)
    If PC - Reg(#CPU_FW + (0)) < Reg(#CPU_FW + (1))
      If (PC & 1) = 0
        MmuInstrStart(PC)
        Op = PeekU(PC + Reg(#CPU_FW + (2)))
        PC = PC + 2
        Goto OpTableMFetchRef(Op >> 3)
      EndIf
    EndIf
  EndIf
  Goto SlowFetchM
EndMacro

; After a native handler that read memory (an immediate operand): that
; read can leave a trap (the I/O page), so take it; otherwise as above.
Macro NextNativeTrapMFetchRef()
  If Reg(#CPU_TRAPVECTOR)
    Goto SlowTailM
  EndIf
  NextNativeMFetchRef()
EndMacro

; A branch taken: the low byte of the instruction, signed, in words.
; Op << 24 puts the offset's sign in bit 31, and the arithmetic >> 23
; brings it back down already doubled and sign-extended.
Macro BranchToMFetchRef()
  PC = (PC + ((Op << 24) >> 23)) & $FFFF
EndMacro

  If OpTableReadyMFetchRef = 0
    Goto BuildTableM
  EndIf
RunStartM:
  If n <= 0 Or Halted <> 0
    ProcedureReturn 0
  EndIf
  PC = Reg(7)                            ; the caller may have set Reg(7)
  RunFrom = InstrCount
  RunBank = n
  RunLeft = 0
  RunWindow = 0
  Goto RunEndM                            ; which lets the devices act, then opens a window
FetchM:
  If PC >= Reg(#CPU_FW + (0))                       ; the fetch, through the fetch window (cpu)
    If PC - Reg(#CPU_FW + (0)) < Reg(#CPU_FW + (1))
      If (PC & 1) = 0
        MmuInstrStart(PC)
        Op = PeekU(PC + Reg(#CPU_FW + (2)))
        PC = PC + 2
        Goto OpTableMFetchRef(Op >> 3)
      EndIf
    EndIf
  EndIf
SlowFetchM:                               ; the I/O page, an odd PC, past the end of RAM
  Reg(7) = PC
  MmuInstrStart(PC)
  TrapHeld = Reg(#CPU_TRAPVECTOR)
  Reg(#CPU_TRAPVECTOR) = 0
  Op = FetchWordM()
  PC = Reg(7)
  If Reg(#CPU_TRAPVECTOR)                          ; the fetch itself failed (odd PC, nothing there):
    Goto SlowTailM                        ; trap through 4 and execute nothing - it read as
  EndIf                                  ; 0, a HALT (MAINDEC-11-DFKAB test 100). The PC stays
                                         ; incremented, as on the J-11 (Architecture Handbook
                                         ; 1983, model differences 28 and 30)
  Reg(#CPU_TRAPVECTOR) = TrapHeld
  Goto OpTableMFetchRef(Op >> 3)

;-MOV-------------------------------------------------------------------
; ---- INDEXED HANDLERS ----
; ---- IMX HANDLERS ----
; ---- MEMORY HELPERS ----
InstructionMOV_01M:            ; 01SSDD   entries $0200-$03FF
  PcOutMFetchRef()
  ;name = "MOV"
  MMSrcWord()
  If (Op & $38) = 0
    Reg(Op & 7) = Reg(#CPU_SRC)
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMWriteWord(Reg(#CPU_EA), Reg(#CPU_SRC))
  EndIf
  FlagNZ = Reg(#CPU_SRC)
  Reg(#CPU_FLAGV) = 0
  ; ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("MOV " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

InstructionMOVB_11M:           ; 11SSDD   entries $1200-$13FF
  PcOutMFetchRef()
  ;name = "MOVB"
  MMSrcByte()
  If (Op & $38) = 0
    Reg(Op & 7) = (Reg(#CPU_SRC) | (0 - (Reg(#CPU_SRC) & $80))) & $FFFF   ; to a register it is sign-extended
  Else
    Reg(#CPU_EA) = EaByteM(Op & $3F)
    MMWriteByte(Reg(#CPU_EA), Reg(#CPU_SRC))
  EndIf
  FlagNZ = Reg(#CPU_SRC) << 8
  Reg(#CPU_FLAGV) = 0
  ; ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("MOVB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

;-CMP-------------------------------------------------------------------
InstructionCMP_02M:            ; 02SSDD   entries $0400-$05FF
  PcOutMFetchRef()
  ;name = "CMP"
  MMSrcWord()
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7)
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMReadWordSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
  EndIf
  Res = Reg(#CPU_SRC) - Reg(#CPU_DST)                        ; src - dst, the other way round from SUB
  Reg(#CPU_FLAGC) = Res
  Reg(#CPU_FLAGV) = (Reg(#CPU_SRC) ! Reg(#CPU_DST)) & (Reg(#CPU_SRC) ! Res)
  FlagNZ = Res & $FFFF
  ; ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("CMP " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

InstructionCMPB_12M:           ; 12SSDD   entries $1400-$15FF
  PcOutMFetchRef()
  ;name = "CMPB"
  MMSrcByte()
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7) & $FF
  Else
    Reg(#CPU_EA) = EaByteM(Op & $3F)
    MMReadByteSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
  EndIf
  Res = Reg(#CPU_SRC) - Reg(#CPU_DST)
  Reg(#CPU_FLAGC) = Res << 8
  Reg(#CPU_FLAGV) = ((Reg(#CPU_SRC) ! Reg(#CPU_DST)) & (Reg(#CPU_SRC) ! Res)) << 8
  FlagNZ = (Res & $FF) << 8
  ; ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("CMPB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

;-BIT-------------------------------------------------------------------
InstructionBIT_03M:            ; 03SSDD   entries $0600-$07FF
  PcOutMFetchRef()
  ;name = "BIT"
  MMSrcWord()
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7)
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMReadWordSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
  EndIf
  FlagNZ = Reg(#CPU_SRC) & Reg(#CPU_DST)
  Reg(#CPU_FLAGV) = 0
  ; ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BIT " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

InstructionBITB_13M:           ; 13SSDD   entries $1600-$17FF
  PcOutMFetchRef()
  ;name = "BITB"
  MMSrcByte()
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7) & $FF
  Else
    Reg(#CPU_EA) = EaByteM(Op & $3F)
    MMReadByteSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
  EndIf
  FlagNZ = (Reg(#CPU_SRC) & Reg(#CPU_DST)) << 8
  Reg(#CPU_FLAGV) = 0
  ; ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BITB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

;-BIC-------------------------------------------------------------------
InstructionBIC_04M:            ; 04SSDD   entries $0800-$09FF
  PcOutMFetchRef()
  ;name = "BIC"
  MMSrcWord()
  If (Op & $38) = 0
    Res = Reg(Op & 7) & ~Reg(#CPU_SRC) & $FFFF
    Reg(Op & 7) = Res
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMReadWord(Res, Reg(#CPU_EA))
    Res = Res & ~Reg(#CPU_SRC) & $FFFF
    MMWriteWord(Reg(#CPU_EA), Res)
  EndIf
  FlagNZ = Res
  Reg(#CPU_FLAGV) = 0
  ; ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BIC " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

InstructionBICB_14M:           ; 14SSDD   entries $1800-$19FF
  PcOutMFetchRef()
  ;name = "BICB"
  MMSrcByte()
  If (Op & $38) = 0
    Res = Reg(Op & 7) & ~Reg(#CPU_SRC) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Reg(#CPU_EA) = EaByteM(Op & $3F)
    MMReadByte(Res, Reg(#CPU_EA))
    Res = Res & ~Reg(#CPU_SRC) & $FF
    MMWriteByte(Reg(#CPU_EA), Res)
  EndIf
  FlagNZ = Res << 8
  Reg(#CPU_FLAGV) = 0
  ; ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BICB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

;-BIS-------------------------------------------------------------------
InstructionBIS_05M:            ; 05SSDD   entries $0A00-$0BFF
  PcOutMFetchRef()
  ;name = "BIS"
  MMSrcWord()
  If (Op & $38) = 0
    Res = Reg(Op & 7) | Reg(#CPU_SRC)
    Reg(Op & 7) = Res
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMReadWord(Res, Reg(#CPU_EA))
    Res = Res | Reg(#CPU_SRC)
    MMWriteWord(Reg(#CPU_EA), Res)
  EndIf
  FlagNZ = Res
  Reg(#CPU_FLAGV) = 0
  ; ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BIS " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

InstructionBISB_15M:           ; 15SSDD   entries $1A00-$1BFF
  PcOutMFetchRef()
  ;name = "BISB"
  MMSrcByte()
  If (Op & $38) = 0
    Res = (Reg(Op & 7) | Reg(#CPU_SRC)) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Reg(#CPU_EA) = EaByteM(Op & $3F)
    MMReadByte(Res, Reg(#CPU_EA))
    Res = Res | Reg(#CPU_SRC)
    MMWriteByte(Reg(#CPU_EA), Res)
  EndIf
  FlagNZ = Res << 8
  Reg(#CPU_FLAGV) = 0
  ; ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BISB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

;-ADD-------------------------------------------------------------------
InstructionADD_06M:            ; 06SSDD   entries $0C00-$0DFF
  PcOutMFetchRef()
  ;name = "ADD"
  MMSrcWord()
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7)
    Res = Reg(#CPU_SRC) + Reg(#CPU_DST)
    Reg(Op & 7) = Res & $FFFF
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMReadWordSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
    Res = Reg(#CPU_SRC) + Reg(#CPU_DST)
    MMWriteWord(Reg(#CPU_EA), Res)
  EndIf
  Reg(#CPU_FLAGC) = Res
  Reg(#CPU_FLAGV) = ~(Reg(#CPU_SRC) ! Reg(#CPU_DST)) & (Reg(#CPU_SRC) ! Res)
  FlagNZ = Res & $FFFF
  ; ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("ADD " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

;-SUB-------------------------------------------------------------------
InstructionSUB_16M:            ; 16SSDD   entries $1C00-$1DFF
  PcOutMFetchRef()
  ;name = "SUB"
  MMSrcWord()
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7)
    Res = Reg(#CPU_DST) - Reg(#CPU_SRC)
    Reg(Op & 7) = Res & $FFFF
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMReadWordSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
    Res = Reg(#CPU_DST) - Reg(#CPU_SRC)
    MMWriteWord(Reg(#CPU_EA), Res)
  EndIf
  Reg(#CPU_FLAGC) = Res                ; borrow
  Reg(#CPU_FLAGV) = (Reg(#CPU_SRC) ! Reg(#CPU_DST)) & (Reg(#CPU_DST) ! Res)
  FlagNZ = Res & $FFFF
  ; ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("SUB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

; ======================================================================
;  SINGLE-OPERAND. The destination is fetched at the top and stored at
;  the bottom, each with register mode inline.
; ======================================================================

;-CLR-------------------------------------------------------------------
InstructionCLR_0050M:          ; 0050DD   entries $0140-$0147
  PcOutMFetchRef()
  ;name = "CLR"
  If (Op & $38) = 0
    Reg(Op & 7) = 0
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMWriteWord(Reg(#CPU_EA), 0)
  EndIf
  FlagNZ = 0
  Reg(#CPU_FLAGV) = 0
  Reg(#CPU_FLAGC) = 0
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("CLR " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

InstructionCLRB_1050M:         ; 1050DD   entries $1140-$1147
  PcOutMFetchRef()
  ;name = "CLRB"
  If (Op & $38) = 0
    Reg(Op & 7) = Reg(Op & 7) & $FF00
  Else
    Reg(#CPU_EA) = EaByteM(Op & $3F)
    MMWriteByte(Reg(#CPU_EA), 0)
  EndIf
  FlagNZ = 0
  Reg(#CPU_FLAGV) = 0
  Reg(#CPU_FLAGC) = 0
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("CLRB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

;-COM-------------------------------------------------------------------
InstructionCOM_0051M:          ; 0051DD   entries $0148-$014F
  PcOutMFetchRef()
  ;name = "COM"
  If (Op & $38) = 0
    Res = Reg(Op & 7) ! $FFFF
    Reg(Op & 7) = Res
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMReadWord(Res, Reg(#CPU_EA))
    Res = Res ! $FFFF
    MMWriteWord(Reg(#CPU_EA), Res)
  EndIf
  FlagNZ = Res
  Reg(#CPU_FLAGV) = 0
  Reg(#CPU_FLAGC) = $10000
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("COM " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

InstructionCOMB_1051M:         ; 1051DD   entries $1148-$114F
  PcOutMFetchRef()
  ;name = "COMB"
  If (Op & $38) = 0
    Res = (Reg(Op & 7) ! $FF) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Reg(#CPU_EA) = EaByteM(Op & $3F)
    MMReadByte(Res, Reg(#CPU_EA))
    Res = Res ! $FF
    MMWriteByte(Reg(#CPU_EA), Res)
  EndIf
  FlagNZ = Res << 8
  Reg(#CPU_FLAGV) = 0
  Reg(#CPU_FLAGC) = $10000
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("COMB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

;-INC-------------------------------------------------------------------
InstructionINC_0052M:          ; 0052DD   entries $0150-$0157   C unaffected
  PcOutMFetchRef()
  ;name = "INC"
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7)
    Res = (Reg(#CPU_DST) + 1) & $FFFF
    Reg(Op & 7) = Res
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMReadWordSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
    Res = (Reg(#CPU_DST) + 1) & $FFFF
    MMWriteWord(Reg(#CPU_EA), Res)
  EndIf
  Reg(#CPU_FLAGV) = 0
  If Reg(#CPU_DST) = $7FFF
    Reg(#CPU_FLAGV) = $8000
  EndIf
  FlagNZ = Res
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("INC " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

InstructionINCB_1052M:         ; 1052DD   entries $1150-$1157
  PcOutMFetchRef()
  ;name = "INCB"
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7) & $FF
    Res = (Reg(#CPU_DST) + 1) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Reg(#CPU_EA) = EaByteM(Op & $3F)
    MMReadByteSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
    Res = (Reg(#CPU_DST) + 1) & $FF
    MMWriteByte(Reg(#CPU_EA), Res)
  EndIf
  Reg(#CPU_FLAGV) = 0
  If Reg(#CPU_DST) = $7F
    Reg(#CPU_FLAGV) = $8000
  EndIf
  FlagNZ = Res << 8
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("INCB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

;-DEC-------------------------------------------------------------------
InstructionDEC_0053M:          ; 0053DD   entries $0158-$015F   C unaffected
  PcOutMFetchRef()
  ;name = "DEC"
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7)
    Res = (Reg(#CPU_DST) - 1) & $FFFF
    Reg(Op & 7) = Res
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMReadWordSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
    Res = (Reg(#CPU_DST) - 1) & $FFFF
    MMWriteWord(Reg(#CPU_EA), Res)
  EndIf
  Reg(#CPU_FLAGV) = 0
  If Reg(#CPU_DST) = $8000
    Reg(#CPU_FLAGV) = $8000
  EndIf
  FlagNZ = Res
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("DEC " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

InstructionDECB_1053M:         ; 1053DD   entries $1158-$115F
  PcOutMFetchRef()
  ;name = "DECB"
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7) & $FF
    Res = (Reg(#CPU_DST) - 1) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Reg(#CPU_EA) = EaByteM(Op & $3F)
    MMReadByteSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
    Res = (Reg(#CPU_DST) - 1) & $FF
    MMWriteByte(Reg(#CPU_EA), Res)
  EndIf
  Reg(#CPU_FLAGV) = 0
  If Reg(#CPU_DST) = $80
    Reg(#CPU_FLAGV) = $8000
  EndIf
  FlagNZ = Res << 8
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("DECB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

;-NEG-------------------------------------------------------------------
InstructionNEG_0054M:          ; 0054DD   entries $0160-$0167
  PcOutMFetchRef()
  ;name = "NEG"
  If (Op & $38) = 0
    Res = (0 - Reg(Op & 7)) & $FFFF      ; 100000 negates to itself
    Reg(Op & 7) = Res
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMReadWord(Res, Reg(#CPU_EA))
    Res = (0 - Res) & $FFFF
    MMWriteWord(Reg(#CPU_EA), Res)
  EndIf
  Reg(#CPU_FLAGV) = 0
  If Res = $8000
    Reg(#CPU_FLAGV) = $8000
  EndIf
  Reg(#CPU_FLAGC) = $10000
  If Res = 0
    Reg(#CPU_FLAGC) = 0
  EndIf
  FlagNZ = Res
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("NEG " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

InstructionNEGB_1054M:         ; 1054DD   entries $1160-$1167
  PcOutMFetchRef()
  ;name = "NEGB"
  If (Op & $38) = 0
    Res = (0 - Reg(Op & 7)) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Reg(#CPU_EA) = EaByteM(Op & $3F)
    MMReadByte(Res, Reg(#CPU_EA))
    Res = (0 - Res) & $FF
    MMWriteByte(Reg(#CPU_EA), Res)
  EndIf
  Reg(#CPU_FLAGV) = 0
  If Res = $80
    Reg(#CPU_FLAGV) = $8000
  EndIf
  Reg(#CPU_FLAGC) = $10000
  If Res = 0
    Reg(#CPU_FLAGC) = 0
  EndIf
  FlagNZ = Res << 8
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("NEGB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

;-ADC-------------------------------------------------------------------
InstructionADC_0055M:          ; 0055DD   entries $0168-$016F
  PcOutMFetchRef()
  ;name = "ADC"
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7)
    Res = (Reg(#CPU_DST) + ((Reg(#CPU_FLAGC) >> 16) & 1)) & $FFFF
    Reg(Op & 7) = Res
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMReadWordSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
    Res = (Reg(#CPU_DST) + ((Reg(#CPU_FLAGC) >> 16) & 1)) & $FFFF
    MMWriteWord(Reg(#CPU_EA), Res)
  EndIf
  Reg(#CPU_FLAGV) = 0
  If Reg(#CPU_DST) = $7FFF And (Reg(#CPU_FLAGC) & $10000) <> 0
    Reg(#CPU_FLAGV) = $8000
  EndIf
  If Reg(#CPU_DST) <> $FFFF Or Reg(#CPU_FLAGC) = 0
    Reg(#CPU_FLAGC) = 0
  EndIf
  FlagNZ = Res
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ADC " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

InstructionADCB_1055M:         ; 1055DD   entries $1168-$116F
  PcOutMFetchRef()
  ;name = "ADCB"
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7) & $FF
    Res = (Reg(#CPU_DST) + ((Reg(#CPU_FLAGC) >> 16) & 1)) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Reg(#CPU_EA) = EaByteM(Op & $3F)
    MMReadByteSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
    Res = (Reg(#CPU_DST) + ((Reg(#CPU_FLAGC) >> 16) & 1)) & $FF
    MMWriteByte(Reg(#CPU_EA), Res)
  EndIf
  Reg(#CPU_FLAGV) = 0
  If Reg(#CPU_DST) = $7F And (Reg(#CPU_FLAGC) & $10000) <> 0
    Reg(#CPU_FLAGV) = $8000
  EndIf
  If Reg(#CPU_DST) <> $FF Or Reg(#CPU_FLAGC) = 0
    Reg(#CPU_FLAGC) = 0
  EndIf
  FlagNZ = Res << 8
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ADCB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

;-SBC-------------------------------------------------------------------
; C: set if the destination was 0 and C was 1, cleared otherwise (the
; processor handbook's rule; the C core in this repository leaves C set
; when C was clear - worth checking against a real machine or a test).
InstructionSBC_0056M:          ; 0056DD   entries $0170-$0177
  PcOutMFetchRef()
  ;name = "SBC"
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7)
    Res = (Reg(#CPU_DST) - ((Reg(#CPU_FLAGC) >> 16) & 1)) & $FFFF
    Reg(Op & 7) = Res
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMReadWordSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
    Res = (Reg(#CPU_DST) - ((Reg(#CPU_FLAGC) >> 16) & 1)) & $FFFF
    MMWriteWord(Reg(#CPU_EA), Res)
  EndIf
  Reg(#CPU_FLAGV) = 0
  If Reg(#CPU_DST) = $8000
    Reg(#CPU_FLAGV) = $8000
  EndIf
  If Reg(#CPU_DST) <> 0 Or Reg(#CPU_FLAGC) = 0
    Reg(#CPU_FLAGC) = 0
  EndIf
  FlagNZ = Res
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("SBC " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

InstructionSBCB_1056M:         ; 1056DD   entries $1170-$1177
  PcOutMFetchRef()
  ;name = "SBCB"
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7) & $FF
    Res = (Reg(#CPU_DST) - ((Reg(#CPU_FLAGC) >> 16) & 1)) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Reg(#CPU_EA) = EaByteM(Op & $3F)
    MMReadByteSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
    Res = (Reg(#CPU_DST) - ((Reg(#CPU_FLAGC) >> 16) & 1)) & $FF
    MMWriteByte(Reg(#CPU_EA), Res)
  EndIf
  Reg(#CPU_FLAGV) = 0
  If Reg(#CPU_DST) = $80
    Reg(#CPU_FLAGV) = $8000
  EndIf
  If Reg(#CPU_DST) <> 0 Or Reg(#CPU_FLAGC) = 0
    Reg(#CPU_FLAGC) = 0
  EndIf
  FlagNZ = Res << 8
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("SBCB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

;-TST-------------------------------------------------------------------
InstructionTST_0057M:          ; 0057DD   entries $0178-$017F
  PcOutMFetchRef()
  ;name = "TST"
  If (Op & $38) = 0
    FlagNZ = Reg(Op & 7)
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMReadWord(FlagNZ, Reg(#CPU_EA))
  EndIf
  Reg(#CPU_FLAGV) = 0
  Reg(#CPU_FLAGC) = 0
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("TST " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

InstructionTSTB_1057M:         ; 1057DD   entries $1178-$117F
  PcOutMFetchRef()
  ;name = "TSTB"
  If (Op & $38) = 0
    FlagNZ = (Reg(Op & 7) & $FF) << 8
  Else
    Reg(#CPU_EA) = EaByteM(Op & $3F)
    MMReadByte(FlagNZ, Reg(#CPU_EA))
    FlagNZ = FlagNZ << 8
  EndIf
  Reg(#CPU_FLAGV) = 0
  Reg(#CPU_FLAGC) = 0
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("TSTB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

; ======================================================================
;  SHIFTS AND ROTATES. V is N xor C after the operation.
; ======================================================================

;-ROR-------------------------------------------------------------------
InstructionROR_0060M:          ; 0060DD   entries $0180-$0187
  PcOutMFetchRef()
  ;name = "ROR"
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7)
    Res = (Reg(#CPU_DST) >> 1) | ((Reg(#CPU_FLAGC) >> 1) & $8000)
    Reg(Op & 7) = Res
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMReadWordSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
    Res = (Reg(#CPU_DST) >> 1) | ((Reg(#CPU_FLAGC) >> 1) & $8000)
    MMWriteWord(Reg(#CPU_EA), Res)
  EndIf
  Reg(#CPU_FLAGC) = Reg(#CPU_DST) << 16
  Reg(#CPU_FLAGV) = Res ! (Reg(#CPU_FLAGC) >> 1)
  FlagNZ = Res
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ROR " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

InstructionRORB_1060M:         ; 1060DD   entries $1180-$1187
  PcOutMFetchRef()
  ;name = "RORB"
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7) & $FF
    Res = (Reg(#CPU_DST) >> 1) | ((Reg(#CPU_FLAGC) >> 9) & $80)
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Reg(#CPU_EA) = EaByteM(Op & $3F)
    MMReadByteSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
    Res = (Reg(#CPU_DST) >> 1) | ((Reg(#CPU_FLAGC) >> 9) & $80)
    MMWriteByte(Reg(#CPU_EA), Res)
  EndIf
  Reg(#CPU_FLAGC) = Reg(#CPU_DST) << 16
  Reg(#CPU_FLAGV) = (Res << 8) ! (Reg(#CPU_FLAGC) >> 1)
  FlagNZ = Res << 8
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("RORB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

;-ROL-------------------------------------------------------------------
InstructionROL_0061M:          ; 0061DD   entries $0188-$018F
  PcOutMFetchRef()
  ;name = "ROL"
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7)
    Res = ((Reg(#CPU_DST) << 1) | ((Reg(#CPU_FLAGC) >> 16) & 1)) & $FFFF
    Reg(Op & 7) = Res
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMReadWordSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
    Res = ((Reg(#CPU_DST) << 1) | ((Reg(#CPU_FLAGC) >> 16) & 1)) & $FFFF
    MMWriteWord(Reg(#CPU_EA), Res)
  EndIf
  Reg(#CPU_FLAGC) = Reg(#CPU_DST) << 1
  Reg(#CPU_FLAGV) = Res ! (Reg(#CPU_FLAGC) >> 1)
  FlagNZ = Res
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ROL " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

InstructionROLB_1061M:         ; 1061DD   entries $1188-$118F
  PcOutMFetchRef()
  ;name = "ROLB"
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7) & $FF
    Res = ((Reg(#CPU_DST) << 1) | ((Reg(#CPU_FLAGC) >> 16) & 1)) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Reg(#CPU_EA) = EaByteM(Op & $3F)
    MMReadByteSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
    Res = ((Reg(#CPU_DST) << 1) | ((Reg(#CPU_FLAGC) >> 16) & 1)) & $FF
    MMWriteByte(Reg(#CPU_EA), Res)
  EndIf
  Reg(#CPU_FLAGC) = Reg(#CPU_DST) << 9
  Reg(#CPU_FLAGV) = (Res << 8) ! (Reg(#CPU_FLAGC) >> 1)
  FlagNZ = Res << 8
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ROLB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedMFetchRef()

;-ASR-------------------------------------------------------------------
InstructionASR_0062M:          ; 0062DD   entries $0190-$0197
  PcOutMFetchRef()
  ;name = "ASR"
  If (Op & $38) = 0
    Reg(#CPU_DST) = Reg(Op & 7)
    Res = (Reg(#CPU_DST) >> 1) | (Reg(#CPU_DST) & $8000)
    Reg(Op & 7) = Res
  Else
    Reg(#CPU_EA) = EaWordM(Op & $3F)
    MMReadWordSlot(@Reg(#CPU_DST), Reg(#CPU_EA))
