    ldr r3, =global_mapf
    adds r2, r2, r3
    ldr r3, [r2, #0]
    cmp r0, r3
    blt __ul_cpurunm_instructionmov_01_m61refm
    ldr r3, [r2, #4]
    cmp r0, r3
    bge __ul_cpurunm_instructionmov_01_m61refm
    lsls r3, r0, #31
    bne __ul_cpurunm_instructionmov_01_m61refm
    ldr r3, [r2, #16]
    ldrh r1, [r3, r0]
    and.w r2, r8, #7
    cmp r2, #7
    beq __ul_cpurunm_instructionmov_01_m61refm
    mov.w r3, r5
    lsls r0, r2, #2
    ldr r0, [r3, r0]
    ldr r2, [r5, #72]
    add.w r2, r2, r0, lsr #13
    lsls r2, r2, #5
    ldr r3, =global_mapf
    adds r2, r2, r3
    ldr r3, [r2, #8]
    cmp r0, r3
    blt __ul_cpurunm_instructionmov_01_m61refm
    ldr r3, [r2, #12]
    cmp r0, r3
    bge __ul_cpurunm_instructionmov_01_m61refm
    lsls r3, r0, #31
    bne __ul_cpurunm_instructionmov_01_m61refm
    ldr r3, [r2, #16]
    strh r1, [r3, r0]
    movs r4, r1
    adds.w r9, r9, #2
    movs r0, #0
    str r0, [r5, #104]
    subs.w r11, r11, #1
    beq __ul_cpurunm_runendm
    mov r0, r9
    ldr r1, [r5, #56]
    cmp r0, r1
    blt __ul_cpurunm_slowfetchm
    ldr r1, [r5, #60]
    cmp r0, r1
    bge __ul_cpurunm_slowfetchm
    str r0, [r5, #68]
    ldr r1, [r5, #64]
    ldrh r2, [r1, r0]
    mov r8, r2
    adds.w r9, r9, #2
    lsrs r2, r2, #3
    lsls r2, r2, #2
    ldr r1, =global_optablem
    ldr r1, [r1, r2]
    bx r1
  EndASM
CompilerEndIf
InstructionMOV_01_M61RefM:         ; the plain version: the fast path's slow path and its reference
  PcOutM()
  Reg(#CPU_EAREG) = (Op >> 6) & 7
  Reg(#CPU_ADR) = Reg(7)
  Reg(7) = (Reg(#CPU_ADR) + 2) & $FFFF
  MMReadWordESlot(@Reg(#CPU_TMP), Reg(#CPU_ADR), Reg(#CPU_CURI))
  Reg(#CPU_EA) = (Reg(#CPU_TMP) + Reg(Reg(#CPU_EAREG))) & $FFFF
  MMReadWordESlot(@Reg(#CPU_SRC), Reg(#CPU_EA), Reg(#CPU_CURD))
  Reg(#CPU_EAREG) = Op & 7
  Reg(#CPU_EA) = Reg(Reg(#CPU_EAREG))
  MMWriteWordE(Reg(#CPU_EA), Reg(#CPU_SRC), Reg(#CPU_CURD))
  FlagNZ = Reg(#CPU_SRC)
  Reg(#CPU_FLAGV) = 0
CompilerIf #ASM_TAILS = 1
  ASM Uses PC, RunLeft, Op, GBase
    ldr r0, [r5, #28]
    mov r9, r0
    ldr r1, [r5, #96]
    cmp r1, #0
    bne __tm202_t
    subs.w r11, r11, #1
    beq __tm202_e
    lsls r1, r0, #31
    bne __tm202_s
    ldr r1, [r5, #56]
    cmp r0, r1
    blt __tm202_s
    ldr r1, [r5, #60]
    cmp r0, r1
    bge __tm202_s
    str r0, [r5, #68]
    ldr r1, [r5, #64]
    ldrh r2, [r1, r0]
    mov r8, r2
    adds.w r9, r9, #2
    lsrs r2, r2, #3
    lsls r2, r2, #2
    ldr r1, =global_optablem
    ldr r1, [r1, r2]
    bx r1
__tm202_e:
    b __ul_cpurunm_runendm
__tm202_s:
    b __ul_cpurunm_slowfetchm
__tm202_t:
    b __ul_cpurunm_slowtailm
  EndASM
CompilerElse
  NextSyncedM()
CompilerEndIf

InstructionMOV_01_M06M:            ; MOV, source mode 0, destination mode 6
CompilerIf #ASM_MOV = 1
  ASM Uses PC, RunLeft, Op, FlagNZ, GBase
    mov r0, r9
    ldr r2, [r5, #76]
    add.w r2, r2, r0, lsr #13
    lsls r2, r2, #5
    ldr r3, =global_mapf
    adds r2, r2, r3
    ldr r3, [r2, #0]
    cmp r0, r3
    blt __ul_cpurunm_instructionmov_01_m06refm
    ldr r3, [r2, #4]
    cmp r0, r3
    bge __ul_cpurunm_instructionmov_01_m06refm
    lsls r3, r0, #31
    bne __ul_cpurunm_instructionmov_01_m06refm
    ldr r3, [r2, #16]
    ldrh r3, [r3, r0]
    and.w r1, r8, #7
    cmp r1, #7
    bne __mv06_d1
    adds r1, r0, #2
    b __mv06_d2
__mv06_d1:
    mov.w r2, r5
    lsls r1, r1, #2
    ldr r1, [r2, r1]
__mv06_d2:
    adds r0, r3, r1
    uxth r0, r0
    ldr r2, [r5, #72]
    add.w r2, r2, r0, lsr #13
    lsls r2, r2, #5
    ldr r3, =global_mapf
    adds r2, r2, r3
    ldr r3, [r2, #8]
    cmp r0, r3
    blt __ul_cpurunm_instructionmov_01_m06refm
    ldr r3, [r2, #12]
    cmp r0, r3
    bge __ul_cpurunm_instructionmov_01_m06refm
    lsls r3, r0, #31
    bne __ul_cpurunm_instructionmov_01_m06refm
    ldr r3, [r2, #16]
    ubfx r1, r8, #6, #3
    cmp r1, #7
    bne __mv06_a1
    mov r1, r9
    adds r1, r1, #2
    b __mv06_a9
__mv06_a1:
    mov.w r2, r5
    lsls r1, r1, #2
    ldr r1, [r2, r1]
__mv06_a9:
    strh r1, [r3, r0]
    movs r4, r1
    adds.w r9, r9, #2
    movs r0, #0
    str r0, [r5, #104]
    subs.w r11, r11, #1
    beq __ul_cpurunm_runendm
    mov r0, r9
    ldr r1, [r5, #56]
    cmp r0, r1
    blt __ul_cpurunm_slowfetchm
    ldr r1, [r5, #60]
    cmp r0, r1
    bge __ul_cpurunm_slowfetchm
    str r0, [r5, #68]
    ldr r1, [r5, #64]
    ldrh r2, [r1, r0]
    mov r8, r2
    adds.w r9, r9, #2
    lsrs r2, r2, #3
    lsls r2, r2, #2
    ldr r1, =global_optablem
    ldr r1, [r1, r2]
    bx r1
  EndASM
CompilerEndIf
InstructionMOV_01_M06RefM:         ; the plain version: the fast path's slow path and its reference
  PcOutM()
  Reg(#CPU_EAREG) = Op & 7
  Reg(#CPU_ADR) = Reg(7)
  Reg(7) = (Reg(#CPU_ADR) + 2) & $FFFF
  MMReadWordESlot(@Reg(#CPU_TMP), Reg(#CPU_ADR), Reg(#CPU_CURI))
  Reg(#CPU_EA) = (Reg(#CPU_TMP) + Reg(Reg(#CPU_EAREG))) & $FFFF
  Reg(#CPU_SRC) = Reg((Op >> 6) & 7)
  MMWriteWordE(Reg(#CPU_EA), Reg(#CPU_SRC), Reg(#CPU_CURD))
  FlagNZ = Reg(#CPU_SRC)
  Reg(#CPU_FLAGV) = 0
CompilerIf #ASM_TAILS = 1
  ASM Uses PC, RunLeft, Op, GBase
    ldr r0, [r5, #28]
    mov r9, r0
    ldr r1, [r5, #96]
    cmp r1, #0
    bne __tm203_t
    subs.w r11, r11, #1
    beq __tm203_e
    lsls r1, r0, #31
    bne __tm203_s
    ldr r1, [r5, #56]
    cmp r0, r1
    blt __tm203_s
    ldr r1, [r5, #60]
    cmp r0, r1
    bge __tm203_s
    str r0, [r5, #68]
    ldr r1, [r5, #64]
    ldrh r2, [r1, r0]
    mov r8, r2
    adds.w r9, r9, #2
    lsrs r2, r2, #3
    lsls r2, r2, #2
    ldr r1, =global_optablem
    ldr r1, [r1, r2]
    bx r1
__tm203_e:
    b __ul_cpurunm_runendm
__tm203_s:
