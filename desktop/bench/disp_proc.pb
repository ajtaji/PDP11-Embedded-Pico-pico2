Fill()
OpenConsole()
Define i.i, t0.i, n.i = 200000000
Define Fn.Handler
Global Dim Code.a(65535)
For i = 0 To 65535 : Seed = (Seed * 1103515245 + 12345) & $7FFFFFFF : Code(i) = (Seed >> 8) & 255 : Next
t0 = ElapsedMilliseconds()
For i = 1 To n
  Op = Code(i & 65535)
  Fn = Tab(Op) : Fn()
Next
t0 = ElapsedMilliseconds() - t0
PrintN("procedure table: " + Str(n) + " dispatches in " + Str(t0) + " ms = " + StrF(n / t0 / 1000.0, 1) + " M/s  acc=" + Str(Acc))

