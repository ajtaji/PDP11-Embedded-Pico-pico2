; ======================================================================
;  psram_pdp11.pico2 - what the PDP-11 does with a board's QSPI PSRAM
;  (#PSRAM = 1 in the main file): the RK05 packs and the memory above
;  56 KB live in it.
;
;  THE CHIP ITSELF - finding it, its timing, its two address windows - is
;  the compiler's library, RP2350/Lib/psram.pico2 (PsramBegin and the
;  rest). Nothing here talks to the QSPI interface. Read that file's
;  header for the chip's rules and the errors PsramBegin can give.
;
;  THE BOARDS (APS6404L, 8 MB, on each)
;      Adafruit Feather RP2350 HSTX              RP2350A  CS on GPIO8   8 MB flash
;      Pimoroni Pico Plus 2 / Pico Plus 2 W      RP2350B  CS on GPIO47  16 MB flash
;  #PSRAM_CS_PIN and #FLASH_CHIP pick the board. diag.pico2 sets them for
;  the Pico Plus 2 W when that board is chosen (its 48 GPIOs); for the
;  Feather, tools/psram_build.py sets them (--board feather or picoplus2)
;  and builds the image. This file is included on every build and is
;  empty unless #PSRAM = 1.
;
;  WHAT IT GIVES THE PDP-11 (when PsramOk = 1)
;    * both RK05 packs in PSRAM, copied from the flash at start-up, and
;      writable: every write stays in PSRAM and is lost at power-off, as
;      with the RAM overlay - the flash is written only by Ctrl-] w (SAVING THE PACKS' CHANGES);
;    * the whole swap area of the pack (V6: 872 blocks);
;    * physical memory up to 3812 KB (00000000-16707777): 000000-157777
;      stays in SRAM, the rest is PSRAM, reached through the memory
;      management unit's fast windows and slow path (cpu.pico2) and the
;      RK11's DMA through the Unibus map (rk11.pico2, RkMemRead/RkMemWrite).
;      A system that leaves 22-bit mapping off sees the first 248 KB of it,
;      up to the 18-bit I/O page (cpu.pico2, MemLim).
;
;  THE FALLBACK. Anything short of a fully working 8 MB chip leaves
;  PsramOk = 0, and then NOTHING here is used: the firmware runs exactly
;  as the Pico 2 build does - the pack read-only in flash, the RAM overlay,
;  the 112-block swap RAM disk, 56 KB of memory. It falls back when:
;      PsramBegin() finds no chip, or one that is not an APS6404L, or one
;        that does not keep a word written (its error, 1 to 8, is printed);
;      the chip found is smaller than 8 MB;
;      the address test finds one wrong word (a different word every
;        32 KB across the whole chip);
;      the pack header is not a dense pack this code can copy;
;      the copy does not read back with the checksum of the flash words it
;        was made from, or a block the pack does not store does not read
;        back as zeros.
;  Every one of those also gives the CS pin back (PsramEnd), so the pin is
;  not left driven. The banner says which.
;
;  WHICH WINDOW. The library gives two views of the same bytes: one
;  through the 16 KB XIP cache the flash also uses ($11000000) and one
;  that goes to the chip on every access ($15000000). The packs and the
;  memory are separate address ranges, and each range is only ever used
;  through ONE window, so a cached write can never be hidden from an
;  uncached read. Which window each uses is set in the main file:
;      #PS_DISK_UNCACHED   the packs: the start-up copy and every block
;      #PS_MEM_UNCACHED    the PDP-11 memory above 56 KB
;  The README's PSRAM section has the figures measured on the boards that
;  decided them.
;
;  THE LAYOUT IN PSRAM
;      $000000   PDP-11 physical memory from 160000 (octal) up: byte pa is
;                at pa - $E000, so its address in the cached window is
;                #PS_MEM + pa with #PS_MEM = $10FF2000 (cpu.pico2), up to
;                pa $3B9000, 3812 KB (#PS_MEM_TOP): what the two packs
;                leave of the 8 MB. (A PDP-11/84 can hold memory up to
;                17757777, 4088 KB: its technical manual, page 2-61.)
;      $3AB000   RK0, 4872 blocks (2,494,464 bytes): a whole RK05
;      $60C000   RK1, 4000 blocks (2,048,000 bytes), to the end of the
;                chip: the size of the V6 source pack's file system.
;                Blocks 4000-4871 of RK1 do not exist here: the controller
;                reports a drive error for them, as for any block a pack
;                does not hold. A pack for RK1 with more than 4000 blocks
;                is not copied (RK1 is then absent).
;  WHY THE MEMORY IS FIRST. The memory is read through the 16 KB XIP cache,
;  whose two ways are 8 KB each, and the same cache serves the firmware's
;  code in flash. With the memory first, a PDP-11 address that is a multiple
;  of 8 KB is a host address that is one too. Measured on a Feather RP2350
;  (V6 `time od /rkunix`, timed from the host, compiler fb819cbcd): memory
;  behind the packs at $447000 + pa 13.35 s; the same moved by 4 KB
;  ($448000 + pa, 4 KB of memory given up) 13.16 s; memory first, nothing
;  given up, 13.08 s - the figure of the 248 KB firmware before it.
;
;  THE PACK CHECKSUMS. The start-up line prints, for each pack region of
;  the flash, the checksum tools/pack_install.py printed when it put the
;  pack there and prints for the image file (--sums): over the region's
;  bytes as 32-bit words, low byte first, a = a + word : b = b + a.
; ======================================================================
CompilerIf #PSRAM = 1                ; included on every build (diag.pico2: a constant cannot guard an XIncludeFile); used only with PSRAM
CompilerIf #PS_DISK_UNCACHED = 1
#PS_WIN        = #PSRAM_BASE_UNCACHED
CompilerElse
#PS_WIN        = #PSRAM_BASE
CompilerEndIf
#PS_BYTES      = $800000         ; the chip this is built for: 8 MB
#PS_RK0        = $3AB000         ; RK0's place: right behind the PDP-11's memory (THE LAYOUT IN PSRAM)
#PS_RK1        = $60C000         ; RK1's place: right behind RK0's 4872 blocks, to the end of the chip
#PS_RK1_BLOCKS = 4000            ; RK1's size in the PSRAM
#PS_MEM_TOP    = $3B9000         ; 3812 KB: #PS_MEM + #PS_MEM_TOP is the end of the chip
#DISK_REGION1  = #FL_RK1          ; RK1's pack in the flash (flash_layout.pico2; rk_image.py --drive1)
#FL_STORE      = #FLASH_CHIP - #FL_STORE_SIZE   ; the store of saved changes (store.pico2)
; PsramOk, PsDrives, MemTop and #PS_MEM are declared in cpu.pico2, which the others read.
Global PsramWhy.i                ; why not: see PsramWhyText
Global PsramFound.i              ; bytes PsramBegin() found
Global PsramBad.i                ; the address test's first wrong offset
Global PsramCopyUs.i             ; the start-up copy and its check, us
Global PsCopyUs.i, PsCheckUs.i   ; its two parts: flash to PSRAM, and the read back
Global PsClearUs.i               ; clearing the PDP-11's memory in the PSRAM, us
Global PsRk1Blocks.i
Global PsRk1TooBig.i                     ; an RK1 pack with more blocks than its place holds (said in the banner)
Global PsReads.i, PsWrites.i     ; blocks read and written in PSRAM
Global PsSumA.i, PsSumB.i        ; the checksum being added up
Global PsRk0A.i, PsRk0B.i, PsRk1A.i, PsRk1B.i   ; the pack regions' checksums ...
Global PsRk0Sum.i, PsRk1Sum.i    ; ... and whether each has been added up
; The wear-levelled store (store.pico2), read here first:
Global StPresent.i                           ; 1: saves go to the store; 0: in place, as before it
Global StDirty.i, StLastWrite.i              ; core 1: a block written since the last save, and when (Micros)
Global StAuto.i                              ; 1: core 1 asked for this save by itself (quiet disks)
Global StFolded.i                            ; 1: the last save was a fold (PsFold)
Global RpSaveFail.i                          ; the RP's part of the last fold that failed (rp11.pico2)
; THE SWAP RAM DISK'S SRAM WHILE THE PSRAM IS IN USE - DkSwapRam is the
; fallback's (disk.pico2) and idle then, so the saves keep their work here.
; Byte offsets from @DkSwapRam(0); 57,344 bytes in all.
#SW_STAGE   = 0                  ; 4 KB: the sector being written (PsSaveSector, RpSave, StSave)
#SW_LIST    = 4096               ; 24 KB: RpSave's work lists, or StSave's pending blocks (6,144 u32)
#SW_LIST_N  = 6144
#SW_TAG     = 32768              ; the store: a u32 per slot, what it holds now ($FFFFFFFF none)
#SW_SEQ     = 39936              ; ... a u32 per sector, its write sequence
#SW_ERA     = 40960              ; ... a u32 per sector, when it was erased (the erase sequence)
#SW_STATE   = 41984              ; ... a byte per sector: 0 blank, 1 written, 2 to erase before use
#SW_RPDIRTY = 42240              ; a byte per RP overlay slot: changed since the last save (to 46,128)

Procedure PsramInit()
  Define i.i
  Define a.i
  Define v.i
  PsramOk = 0
  PsramWhy = 0
  PsramFound = PsramBegin(#PSRAM_CS_PIN)
  If PsramFound = 0
    PsramWhy = 1                         ; PsramError() says which of its eight reasons
    ProcedureReturn
  EndIf
  If PsramFound < #PS_BYTES
    PsramWhy = 2
    PsramEnd()
    ProcedureReturn
  EndIf
  ; THE ADDRESS TEST, uncached: one word every 32 KB across the whole
  ; chip, each different, then all read back. A stuck address line
  ; overwrites an early word; a bad data line shows as a wrong bit.
  For i = 0 To 255
    a = i << 15
    PokeL(#PSRAM_BASE_UNCACHED + a, (i * $01010101) ! $5AC3F00F ! a)
  Next
  For i = 0 To 255
    a = i << 15
    v = (i * $01010101) ! $5AC3F00F ! a
    If PeekL(#PSRAM_BASE_UNCACHED + a) <> v
      PsramWhy = 3
      PsramBad = a
      PsramEnd()
      ProcedureReturn
    EndIf
  Next
  ; and the halfword and byte stores the PDP-11's memory uses
  PokeU(#PSRAM_BASE_UNCACHED + $500000, $A55A)   ; (a place inside the memory's part)
  PokeA(#PSRAM_BASE_UNCACHED + $500002, $3C)
  PokeA(#PSRAM_BASE_UNCACHED + $500003, $C3)
  If PeekL(#PSRAM_BASE_UNCACHED + $500000) <> $C33CA55A
    PsramWhy = 3
    PsramBad = $500000
    PsramEnd()
    ProcedureReturn
  EndIf
  PsramOk = 1                            ; the packs still have to copy (PsramLoad)
EndProcedure

; ---- the packs, from flash into PSRAM, and checked --------------------------
; A region's header: "PDP11RK1", version 1, dense. The number of blocks
; stored, or -1 if it is not a pack this can copy.
Procedure.i PsPackBlocks(region.i)
  If PeekL($10000000 + region) <> $31504450 Or PeekL($10000000 + region + 4) <> $314B5231
    ProcedureReturn -1
  EndIf
  If PeekL($10000000 + region + 8) <> 1 Or PeekL($10000000 + region + 12) <> 0
    ProcedureReturn -1                   ; not version 1, or not the dense layout
  EndIf
  If PeekL($10000000 + region + 16) > #RK_BLOCKS
    ProcedureReturn -1
  EndIf
  ProcedureReturn PeekL($10000000 + region + 16)
EndProcedure

; Add n bytes of flash at adr (whole 32-bit words) to the checksum.
Procedure PsSum(adr.i, n.i)
  Define i.i
  Define a.i
  Define b.i
  a = PsSumA
  b = PsSumB
  i = 0
  While i < n
    a = a + PeekL(adr + i)
    b = b + a
    i = i + 4
  Wend
  PsSumA = a
  PsSumB = b
EndProcedure

; The checksum of a pack region as the flash holds it, into PsSumA and
; PsSumB: its header sector, then its blocks to the end of their last
; 4096-byte sector - the bytes tools/pack_install.py wrote.
Procedure PsRegionSum(region.i, blocks.i)
  PsSumA = 0
  PsSumB = 0
  PsSum($10000000 + region, 4096 + ((blocks * 512 + 4095) & ~4095))
EndProcedure

; Copy one pack: its stored blocks, then zeros to the end of its place in
; the PSRAM (room blocks: a whole RK05 for RK0, #PS_RK1_BLOCKS for RK1).
; 1 = copied and read back right. The flash is read ONCE: each word goes
; into the PSRAM and into the region's checksum (left in PsSumA, PsSumB:
; the header sector, the blocks, and the rest of the blocks' last sector).
; The PSRAM copy is then read back and must give the same checksum as the
; flash words it was made from, and the zeros must read as zeros. Two
; passes, timed apart: PsCopyUs (flash to PSRAM) and PsCheckUs (the read
; back).
Procedure.i PsCopy(region.i, dst.i, blocks.i, room.i)
  Define p.i
  Define q.i
  Define e.i
  Define w.i
  Define a.i
  Define b.i
  Define sa.i
  Define sb.i
  Define ea.i
  Define eb.i
  Define t0.i
  t0 = Micros()
  PsSumA = 0
  PsSumB = 0
  PsSum($10000000 + region, 4096)        ; the header sector
  a = PsSumA
  b = PsSumB
  sa = a
  sb = b
  p = $10000000 + region + 4096          ; dense: the data follows the header sector
  e = p + blocks * 512
  q = #PS_WIN + dst
  While p < e
    w = PeekL(p)
    PokeL(q, w)
    a = a + w
    b = b + a
    p = p + 4
    q = q + 4
  Wend
  ea = a
  eb = b
  PsSumA = a
  PsSumB = b
  PsSum(p, ((blocks * 512 + 4095) & ~4095) - blocks * 512)   ; the flash to the end of the last sector
  e = #PS_WIN + dst + room * 512
  While q < e                            ; the blocks the pack does not store read as zeros
    PokeL(q, 0)
    q = q + 4
  Wend
  PsCopyUs = PsCopyUs + (Micros() - t0)
  t0 = Micros()
  a = sa                                 ; the read back, from the same starting sum
  b = sb
  q = #PS_WIN + dst
  e = q + blocks * 512
  While q < e
    a = a + PeekL(q)
    b = b + a
    q = q + 4
  Wend
  w = 0
  e = #PS_WIN + dst + room * 512
  While q < e
    w = w | PeekL(q)
    q = q + 4
  Wend
  PsCheckUs = PsCheckUs + (Micros() - t0)
  If a <> ea Or b <> eb Or w <> 0
    ProcedureReturn 0
  EndIf
  ProcedureReturn 1
EndProcedure

; THE PSRAM KERNEL PATCH (the header's +96, rk_image.py --psram-patch): a
; word of the pack changed in the PSRAM copy only - V6's _nswap back to the
; whole swap area, which only the PSRAM can hold. The flash copy, and so
; the fallback, keeps the pack exactly as packed. The old value must
; match, or the copy is not used.
;   +96 u32 1 = a patch   +100 u32 block   +104 u32 byte offset (even)
;   +108 u32 the old word +112 u32 the new word
Procedure.i PsPatch(region.i, dst.i, room.i)
  Define a.i
  If PeekL($10000000 + region + 96) <> 1
    ProcedureReturn 1
  EndIf
  a = PeekL($10000000 + region + 100) * 512 + PeekL($10000000 + region + 104)
  If (a & 1) <> 0 Or a >= room * 512
    ProcedureReturn 0
  EndIf
  If PeekU(#PS_WIN + dst + a) <> (PeekL($10000000 + region + 108) & $FFFF)
    ProcedureReturn 0
  EndIf
  PokeU(#PS_WIN + dst + a, PeekL($10000000 + region + 112) & $FFFF)
  ProcedureReturn 1
EndProcedure

; The PDP-11's memory in the PSRAM, cleared: at start-up and when the tape
; reader clears memory. Through the window the memory always uses.
Procedure PsClearMemory()
  Define p.i
  Define e.i
  p = #PS_MEM + #RAM_BYTES
  e = #PS_MEM + #PS_MEM_TOP
  While p < e
    PokeL(p, 0)
    p = p + 4
  Wend
EndProcedure

Procedure PsramLoad()
  Define t0.i
  Define n.i
  Define n1.i
  Define i.i
  n = PsPackBlocks(#DISK_REGION)
  n1 = PsPackBlocks(#DISK_REGION1)
  If PsramOk
    t0 = Micros()
    If n < 0
      PsramWhy = 4
    ElseIf PsCopy(#DISK_REGION, #PS_RK0, n, #RK_BLOCKS) = 0
      PsramWhy = 5
    ElseIf PsPatch(#DISK_REGION, #PS_RK0, #RK_BLOCKS) = 0
      PsramWhy = 6
    EndIf
    If PsramWhy = 0
      PsRk0A = PsSumA                    ; PsCopy added the region up as it read it
      PsRk0B = PsSumB
      PsRk0Sum = 1
      PsDrives = 1
      If n1 > #PS_RK1_BLOCKS
        PsRk1TooBig = n1                 ; too big for its place: absent, and the banner says why
      EndIf
      If n1 >= 0 And n1 <= #PS_RK1_BLOCKS   ; RK1: optional; a bad one is absent
        If PsCopy(#DISK_REGION1, #PS_RK1, n1, #PS_RK1_BLOCKS)
          PsRk1A = PsSumA
          PsRk1B = PsSumB
          PsRk1Sum = 1
          If PsPatch(#DISK_REGION1, #PS_RK1, #PS_RK1_BLOCKS)
            PsDrives = 3
            PsRk1Blocks = n1
          EndIf
        EndIf
      EndIf
      i = Micros()
      PsClearMemory()                    ; the extra memory starts clear
      PsClearUs = Micros() - i
      MemTop = #PS_MEM_TOP
      MemLim = #UB_IOPAGE
      If PsDrives = 1
        RpInit()                         ; an RP pack in RK1's place (rp11.pico2)
      EndIf
      PsSaveSetup()
      StInit()                           ; the saved changes over the packs (store.pico2)
      ; (PsSaveSetup:) what Ctrl-] w may save (SAVING THE PACKS' CHANGES)                ; 22-bit mapping is off at power-up (cpu.pico2, MmuRecompute)
    Else
      PsramOk = 0
      PsDrives = 0
      PsramEnd()
    EndIf
    PsramCopyUs = Micros() - t0
  EndIf
  ; the checksums the start-up line prints, where a copy did not make them
  If PsRk0Sum = 0 And n >= 0
    PsRegionSum(#DISK_REGION, n)
    PsRk0A = PsSumA
    PsRk0B = PsSumB
    PsRk0Sum = 1
  EndIf
  If PsRk1Sum = 0 And n1 >= 0
    PsRegionSum(#DISK_REGION1, n1)
    PsRk1A = PsSumA
    PsRk1B = PsSumB
    PsRk1Sum = 1
  EndIf
EndProcedure

Procedure PsHex(v.i)                     ; two hex digits
  Define k.i
  k = (v >> 4) & 15
  If k < 10
    Ch(48 + k)
  Else
    Ch(55 + k)
  EndIf
  k = v & 15
  If k < 10
    Ch(48 + k)
  Else
    Ch(55 + k)
  EndIf
EndProcedure

Procedure PsHex8(v.i)                    ; eight hex digits
  PsHex(v >> 24) : PsHex(v >> 16) : PsHex(v >> 8) : PsHex(v)
EndProcedure

Procedure PsramWhyText()
  Select PsramWhy
    Case 1
      Say("the PSRAM library found none (its error ") : Num(PsramError())
      Select PsramError()
        Case 1 : Say(": the pin cannot be the QSPI chip select 1 on this chip")
        Case 2 : Say(": the system clock could not be measured")
        Case 3 : Say(": the system clock is too low for the chip")
        Case 4 : Say(": the QSPI interface did not answer")
        Case 5 : Say(": no chip answered the ID read on this pin")
        Case 6 : Say(": a chip answered that is not an APS6404L or is marked bad")
        Case 7 : Say(": a word written did not read back")
        Case 8 : Say(": less than 4 MB found")
      EndSelect
      Say(")")
    Case 2 : Say("the chip found has ") : Num(PsramFound / 1048576) : Say(" MB; this needs 8 MB")
    Case 3 : Say("the address test failed at offset ") : Num(PsramBad)
    Case 4 : Say("the RK0 pack is not a dense pack that can be copied")
    Case 5 : Say("the copy of RK0 did not read back as the flash holds it")
    Case 6 : Say("the pack's PSRAM kernel patch did not find its old value")
  EndSelect
EndProcedure

; The banner's PSRAM lines (core 1, before the pack's own line).
Procedure PsramBanner()
  Say("PSRAM: ")
  If PsramOk
    Say("8 MB on GPIO") : Num(#PSRAM_CS_PIN) : Say(", ID ") : PsHex(PsramIdByte(0))
    Ch(32) : PsHex(PsramIdByte(1)) : Ch(32) : PsHex(PsramIdByte(2))
    Say(", clock ") : Num(PsramClockKhz()) : Say(" kHz")
    Say("; packs copied and checked in ") : Num(PsramCopyUs / 1000) : Say(" ms (copy ")
    Num(PsCopyUs / 1000) : Say(", check ") : Num(PsCheckUs / 1000) : Say("), memory cleared in ")
    Num(PsClearUs / 1000) : Say(" ms")
    Say("; memory ") : Num(MemTop / 1024) : Say(" KB; RK0")
    If PsDrives & 2
      Say(" (whole, 4872 blocks) and RK1 (") : Num(PsRk1Blocks) : Say(" blocks stored, ") : Num(#PS_RK1_BLOCKS)
      Say(" exist: blocks ") : Num(#PS_RK1_BLOCKS) : Say("-4871 of RK1 answer with a drive error)")
    EndIf
    Say(" writable in PSRAM, saved to flash (the store, below)")
    If PsRk1TooBig
      Say("; RK1 NOT copied: its pack has ") : Num(PsRk1TooBig) : Say(" blocks and its place in the PSRAM holds ")
      Num(#PS_RK1_BLOCKS) : Say(" - RK1 is absent")
    EndIf
    If RpPresent
      RpBanner()                         ; rp11.pico2
    EndIf
    If StPresent
      StBanner()                         ; store.pico2
    EndIf
    If PeekL($10000000 + #DISK_REGION + 96) = 1
      Say("; the PSRAM copy's kernel patch applied (block ") : Num(PeekL($10000000 + #DISK_REGION + 100))
      Say(" +") : Num(PeekL($10000000 + #DISK_REGION + 104)) : Say(")")
    EndIf
    Eol()
    Say("PSRAM windows: packs ")
    CompilerIf #PS_DISK_UNCACHED = 1
      Say("uncached")
    CompilerElse
      Say("cached")
    CompilerEndIf
    Say(", memory ")
    CompilerIf #PS_MEM_UNCACHED = 1
      Say("uncached")
    CompilerElse
      Say("cached")
    CompilerEndIf
    Eol()
  Else
    Say("not in use - ") : PsramWhyText()
    If PsramIdByte(0) <> 0 Or PsramIdByte(1) <> 0
      Say(" (ID ") : PsHex(PsramIdByte(0)) : Ch(32) : PsHex(PsramIdByte(1)) : Ch(32) : PsHex(PsramIdByte(2)) : Ch(41)
    EndIf
    Say(". Running as the Pico 2 build: 56 KB, the pack read-only in flash.") : Eol()
  EndIf
  Say("pack checksums: RK0 ")
  If PsRk0Sum
    PsHex8(PsRk0A) : Ch(32) : PsHex8(PsRk0B)
  Else
    Say("no pack")
  EndIf
  Say(" RK1 ")
  If PsRk1Sum
    PsHex8(PsRk1A) : Ch(32) : PsHex8(PsRk1B)
  Else
    Say("no pack")
  EndIf
  Eol()
EndProcedure

; ---- the disk, when PsramOk (disk.pico2 calls these) -----------------------
; ======================================================================
;  SAVING THE PACKS' CHANGES TO FLASH - Ctrl-] then w (2026-10-22)
; ======================================================================
;  Everything Unix writes goes to the packs' PSRAM copies and is gone at
;  power-off. Ctrl-] w writes the changed part back into the packs' own
;  places in the flash, so the next power-up copies it in with the rest.
;  Nothing is written at any other time: a flash sector takes about 100,000
;  erases, and V7's update daemon syncs every 30 s.
;
;  WHAT IS SAVED. Each block write marks its 4 KB flash sector (a dense
;  pack: block n is at the region + 4096 + n * 512, so sector n / 8). On the
;  command each marked sector is compared with the flash and written only
;  if it differs: erase, program from SRAM, read back and compared. Never
;  saved: the header sector; RK0's swap area (the header's +64, +68 -
;  swap is scratch); blocks past what the region stores (they live only in
;  the PSRAM: counted and said); and the PSRAM-only kernel patch (PsPatch),
;  whose old word is put back in the copy that is written, so the flash
;  stays the pack the fallback can boot.
;
;  HOW, with two cores. Core 0 runs the PDP-11 and does the save between
;  its slices, so the PDP-11 is paused while it lasts. The flash library
;  (RP2350/Lib/flash.pico2) needs the other core off the flash and the
;  PSRAM: for each sector core 1 is parked in SRAM code with its
;  interrupts off (Core1Park, diag.pico2), the sector is erased and
;  programmed, and core 1 is let go for a few milliseconds - USB and the
;  watchdog stay served - before the next. The staging buffer is the
;  fallback's swap RAM disk (DkSwapRam), which is idle when the PSRAM is in
;  use: no new SRAM.
#PS_SECTORS = (#RK_BLOCKS + 7) / 8
Global Dim PsDirty0.a(#PS_SECTORS + 1)       ; RK0: 1 = the PSRAM sector changed since the last save
Global Dim PsDirty1.a(#PS_SECTORS + 1)       ; RK1
Global PsStored0.i, PsStored1.i              ; blocks each region stores in the flash
Global PsSwapLo.i, PsSwapEnd.i               ; RK0's swap area, never saved
Global PsPatchAt.i = -1, PsPatchOld.i        ; RK0's PSRAM-only patch: its byte offset and the flash word
Global PsUnsaved.i                           ; writes to blocks the flash has no room for
Global C1ParkReq.i, C1Parked.i               ; core 0 asks core 1 to park (Core1Park in diag.pico2)
Global PsSaveReq.i, PsSaveDone.i             ; core 1 asks (Ctrl-] w); core 0 says it has finished
Global RpAutoSave.i                          ; 1: the RP11's full overlay asked for this save (rp11.pico2)
Global PsSaveWrote.i, PsSaveSame.i, PsSaveFail.i, PsSaveUs.i, PsSaveWhy.i, PsSaveErr.i
Global PsSaveTotal.i                         ; sectors written to flash since power-up

Procedure PsSaveSetup()
  PsStored0 = PsPackBlocks(#DISK_REGION)
  PsStored1 = PsRk1Blocks
  PsSwapLo = PeekL($10000000 + #DISK_REGION + 64)
  PsSwapEnd = PsSwapLo + PeekL($10000000 + #DISK_REGION + 68)
  If PeekL($10000000 + #DISK_REGION + 96) = 1
    PsPatchAt = PeekL($10000000 + #DISK_REGION + 100) * 512 + PeekL($10000000 + #DISK_REGION + 104)
    PsPatchOld = PeekL($10000000 + #DISK_REGION + 108) & $FFFF
  EndIf
EndProcedure

; A block write's mark (PsDiskWrite).
Macro PsMarkDirty(mD, mBlk)
  StDirty = 1
  StLastWrite = Micros()
  If mD = 0
    If mBlk < PsSwapLo Or mBlk >= PsSwapEnd
      If mBlk < PsStored0
        PsDirty0(mBlk >> 3) = 1
      Else
        PsUnsaved = PsUnsaved + 1
      EndIf
    EndIf
  ElseIf mBlk < PsStored1
    PsDirty1(mBlk >> 3) = 1
  Else
    PsUnsaved = PsUnsaved + 1
  EndIf
EndMacro

Procedure.i PsDirtyCount()
  Define i.i, n.i
  For i = 0 To #PS_SECTORS - 1
    n = n + PsDirty0(i) + PsDirty1(i)
  Next
  ProcedureReturn n
EndProcedure

; Core 1 into Core1Park, and back out. 1 = it is parked (it answers within a
; pass of its loop: a fraction of a millisecond).
Procedure.i PsPark()
  Define t0.i
  C1ParkReq = 1
  t0 = Micros()
  While C1Parked = 0 And (Micros() - t0) < 200000
  Wend
  ProcedureReturn C1Parked
EndProcedure

Procedure PsUnpark()
  Define t0.i
  C1ParkReq = 0
  t0 = Micros()
  While C1Parked <> 0 And (Micros() - t0) < 200000
  Wend
  t0 = Micros()
  While (Micros() - t0) < 3000           ; let core 1 serve USB before the next sector
  Wend
EndProcedure

; One sector: 0 the flash already holds it, 1 written and read back right, -1 failed.
Procedure.i PsSaveSector(region.i, psbase.i, idx.i, isrk0.i)
  Define buf.i, src.i, i.i
  buf = @DkSwapRam(0)
  src = #PS_WIN + psbase + idx * 4096
  For i = 0 To 1023
    PokeL(buf + i * 4, PeekL(src + i * 4))
  Next
  If isrk0 And PsPatchAt >= idx * 4096 And PsPatchAt < idx * 4096 + 4096
    PokeU(buf + PsPatchAt - idx * 4096, PsPatchOld)
  EndIf
  ProcedureReturn PsWriteSector(region + 4096 + idx * 4096, buf)
EndProcedure

; The 4 KB at buf into the flash sector at off (also the RP11's save,
; rp11.pico2): 0 the flash already holds it, 1 written and read back
; right, -1 failed (PsSaveWhy, PsSaveErr say why).
Procedure.i PsWriteSector(off.i, buf.i)
  Define i.i, same.i, ok.i
  same = 1
  For i = 0 To 1023
    If PeekL($10000000 + off + i * 4) <> PeekL(buf + i * 4)
      same = 0
      Break
    EndIf
  Next
  If same
    ProcedureReturn 0
  EndIf
  If PsPark() = 0
    PsUnpark()
    PsSaveWhy = 1                        ; core 1 did not park
    ProcedureReturn -1
  EndIf
  ok = FlashRangeErase(off, 4096)
  If ok
    ok = FlashRangeProgram(off, buf, 4096)
  EndIf
  PsSaveErr = flash_error
  PsUnpark()
  If ok = 0
    PsSaveWhy = 2                        ; the flash library refused: flash_error says why
    ProcedureReturn -1
  EndIf
  For i = 0 To 1023
    If PeekL($10000000 + off + i * 4) <> PeekL(buf + i * 4)
      PsSaveWhy = 3                      ; it does not read back as written
      ProcedureReturn -1
    EndIf
  Next
  PsSaveTotal = PsSaveTotal + 1
  ProcedureReturn 1
EndProcedure

; Core 0, between slices: every marked sector of both packs.
; Core 0, between slices: a save. Into the store (store.pico2) when there
; is one and it has room; otherwise, and when the RP's overlay is full,
; FOLDED: everything that differs from the packs written into the packs'
; own places in the flash (PsFold), and the store started afresh.
Procedure PsSave()
  Define t0.i
  PsSaveWrote = 0 : PsSaveSame = 0 : PsSaveFail = 0 : PsSaveWhy = 0 : PsSaveErr = 0
  StFolded = 0
  t0 = Micros()
  If StPresent And RpAutoSave = 0
    If StSave() <> -2                    ; -2: the store cannot take it
      PsSaveUs = Micros() - t0
      ProcedureReturn
    EndIf
  EndIf
  PsFold()
  PsSaveUs = Micros() - t0
EndProcedure

; Every RK sector whose PSRAM copy differs from the flash (compared, so
; this also catches what earlier saves put in the store), the RP's
; overlay, then a new generation of the store, whose entries are now in
; the packs. Sectors wholly in RK0's swap area are never written.
Procedure PsFold()
  Define i.i, r.i, d.i, n.i
  StFolded = 1
  For d = 0 To 1
    If (PsDrives >> d) & 1
      n = PsStored0
      If d = 1
        n = PsStored1
      EndIf
      For i = 0 To #PS_SECTORS - 1
        If i * 8 + 8 > n
          Break
        EndIf
        If d = 0 And i * 8 >= PsSwapLo And i * 8 + 8 <= PsSwapEnd
          Continue
        EndIf
        If d = 0
          r = PsSaveSector(#DISK_REGION, #PS_RK0, i, 1)
        Else
          r = PsSaveSector(#DISK_REGION1, #PS_RK1, i, 0)
        EndIf
        If r = 1
          PsSaveWrote = PsSaveWrote + 1
        ElseIf r < 0
          PsSaveFail = PsSaveFail + 1
        EndIf
      Next
    EndIf
  Next
  RpSave()                               ; the RP11's overlay (rp11.pico2)
  If PsSaveFail = 0 And RpSaveFail = 0
    For i = 0 To #PS_SECTORS - 1
      PsDirty0(i) = 0
      PsDirty1(i) = 0
    Next
    If StPresent
      StNewGen()                         ; store.pico2
    EndIf
  EndIf
EndProcedure


Procedure.i PsDiskRead(d.i, blk.i)
  Define a.i
  Define i.i
  Define w.i
  If d = 8                               ; the RP11's pack (rp11.pico2)
    ProcedureReturn RpStoreRead(blk)
  EndIf
  If ((PsDrives >> d) & 1) = 0 Or blk < 0 Or blk >= #RK_BLOCKS Or (d = 1 And blk >= #PS_RK1_BLOCKS)
    DkWhy = 1
    ProcedureReturn -1
  EndIf
  a = #PS_WIN + #PS_RK0 + blk * 512
  If d = 1
    a = #PS_WIN + #PS_RK1 + blk * 512
  EndIf
  For i = 0 To 127
    w = PeekL(a + i * 4)
    DkBuf(i * 2) = w & $FFFF
    DkBuf(i * 2 + 1) = (w >> 16) & $FFFF
  Next
  PsReads = PsReads + 1
  ProcedureReturn 1
EndProcedure

Procedure.i PsDiskWrite(d.i, blk.i)
  Define a.i
  Define i.i
  If d = 8
    ProcedureReturn RpStoreWrite(blk)
  EndIf
  If ((PsDrives >> d) & 1) = 0 Or blk < 0 Or blk >= #RK_BLOCKS Or (d = 1 And blk >= #PS_RK1_BLOCKS)
    DkWhy = 1
    ProcedureReturn -1
  EndIf
  a = #PS_WIN + #PS_RK0 + blk * 512
  If d = 1
    a = #PS_WIN + #PS_RK1 + blk * 512
  EndIf
  For i = 0 To 127
    PokeL(a + i * 4, DkBuf(i * 2) | (DkBuf(i * 2 + 1) << 16))
  Next
  PsWrites = PsWrites + 1
  PsMarkDirty(d, blk)
  ProcedureReturn 1
EndProcedure
CompilerEndIf                        ; #PSRAM = 1
