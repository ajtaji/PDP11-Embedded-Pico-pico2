Global ProfBase.i, ProfEnabled.i, ProfSamples.i, ProfBad.i
Global ProfCpu.i, ProfIo.i, ProfTx.i, ProfOther.i
ProcedureInterrupt TIMER0_IRQ_3()
 ASM
  ldr r0, =0x400b0000
  movs r1, #8
  str r1, [r0, #60]
  ldr r1, [r0, #40]
  addw r1, r1, #997
  str r1, [r0, #28]
  ldr r0, =global_profenabled
  ldr r0, [r0]
  cmp r0, #0
  beq __pr_done
  ldr r0, [sp, #64]
  ldr r1, [sp, #68]
  tst.w r1, #0x01000000
  beq __pr_bad
  tst.w r0, #1
  bne __pr_bad
  ldr r1, =0x10000000
  subs r2, r0, r1
  ldr r3, =0x80000
  cmp r2, r3
  blo __pr_index
  ldr r1, =0x20000000
  subs r2, r0, r1
  cmp r2, r3
  bhs __pr_bad
  add.w r2, r2, #0x80000
__pr_index:
  lsrs r2, r2, #6
  lsls r2, r2, #2
  ldr r1, =global_profbase
  ldr r1, [r1]
  adds r1, r1, r2
  ldr r2, [r1]
  adds r2, r2, #1
  str r2, [r1]
  ldr r1, =global_profsamples
  ldr r2, [r1]
  adds r2, r2, #1
  str r2, [r1]
  ldr r1, =global_waiting
  ldr r1, [r1]
  cbz r1, __pr_cpu
  ldr r1, =global_rkbusy
  ldr r1, [r1]
  ldr r2, =global_rpbusy
  ldr r2, [r2]
  orrs r1, r1, r2
  cbnz r1, __pr_io
  ldr r1, =global_dl11txrdy
  ldr r1, [r1]
  cbz r1, __pr_tx
  ldr r1, =global_profother
  b __pr_inc
__pr_cpu:
  ldr r1, =global_profcpu
  b __pr_inc
__pr_io:
  ldr r1, =global_profio
  b __pr_inc
__pr_tx:
  ldr r1, =global_proftx
__pr_inc:
  ldr r2, [r1]
  adds r2, r2, #1
  str r2, [r1]
  b __pr_done
__pr_bad:
  ldr r1, =global_profbad
  ldr r2, [r1]
  adds r2, r2, #1
  str r2, [r1]
__pr_done:
 EndASM
EndProcedure
Procedure ProfInit()
 Define i.i
 ProfBase=#PS_MEM+$300000
 For i=0 To 16383 : PokeL(ProfBase+i*4,0) : Next
 * TIMER0_INTE = (* TIMER0_INTE) | 8
 * TIMER0_ALARM3 = Micros()+997
 nvic_set_priority(3,15) : nvic_enable_irq(3) : EnableInterrupts()
EndProcedure
Procedure ProfDump()
 Define i.i,n.i,a.i
 ProfEnabled=0
 Say("PROFILE ") : Num(ProfSamples) : Ch(32) : Num(ProfBad) : Ch(32) : Num(ProfCpu) : Ch(32) : Num(ProfIo) : Ch(32) : Num(ProfTx) : Ch(32) : Num(ProfOther) : Eol()
 For i=0 To 16383
  n=PeekL(ProfBase+i*4)
  If n
   a=$10000000+i*64
   If i>=8192 : a=$20000000+(i-8192)*64 : EndIf
   Say("P ") : Num(a) : Ch(32) : Num(n) : Eol() : Service()
  EndIf
 Next
 Say("PROFILE END") : Eol()
EndProcedure
