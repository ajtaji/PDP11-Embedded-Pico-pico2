    bne __tm118_t
    subs.w r11, r11, #1
    beq __tm118_e
    lsls r1, r0, #31
    bne __tm118_s
    ldr r1, [r5, #56]
    cmp r0, r1
    blt __tm118_s
    ldr r1, [r5, #60]
    cmp r0, r1
    bge __tm118_s
    str r0, [r5, #68]
    ldr r1, [r5, #64]
    ldrh r2, [r1, r0]
    mov r8, r2
    adds.w r9, r9, #2
    lsrs r2, r2, #3
    lsls r2, r2, #2
    ldr r1, =global_optablem
    ldr r1, [r1, r2]
    bx r1
__tm118_e:
    b __ul_cpurunm_runendm
__tm118_s:
    b __ul_cpurunm_slowfetchm
__tm118_t:
    b __ul_cpurunm_slowtailm
  EndASM
CompilerElse
  NextSyncedM()
CompilerEndIf

;-ASH-------------------------------------------------------------------
; Shift count is the low six bits of the source, signed: positive shifts
; left, negative shifts right. A loop - rare instruction, correct first.
InstructionASH_072M:           ; 072RSS   entries $0E80-$0EBF
  PcOutM()
  ;name = "ASH"
  If (Op & $38) = 0
    Reg(#CPU_SRC) = Reg(Op & 7) & $3F
  Else
CompilerIf #ASM_EA = 1
      ASM Uses Op, GBase
        and.w r0, r8, #0x3f
        bl __eaw
        str r0, [r5, #84]
      EndASM
CompilerElse
      Reg(#CPU_EA) = EaWordM(Op & $3F)
CompilerEndIf
    MMReadWordSlot(@Reg(#CPU_SRC), Reg(#CPU_EA))
    Reg(#CPU_SRC) = Reg(#CPU_SRC) & $3F
  EndIf
  Res = Reg((Op >> 6) & 7)
  Reg(#CPU_FLAGV) = 0
  If Reg(#CPU_SRC) & $20
    Reg(#CPU_SRC) = 64 - Reg(#CPU_SRC)                                         ; right by this many
    While Reg(#CPU_SRC) > 0
      Reg(#CPU_FLAGC) = Res << 16
      Res = (Res >> 1) | (Res & $8000)
      Reg(#CPU_SRC) = Reg(#CPU_SRC) - 1
    Wend
  Else
    While Reg(#CPU_SRC) > 0
      Reg(#CPU_FLAGC) = Res << 1
      Reg(#CPU_TMP) = (Res << 1) & $FFFF
      If (Reg(#CPU_TMP) ! Res) & $8000
        Reg(#CPU_FLAGV) = $8000                                          ; the sign changed
      EndIf
      Res = Reg(#CPU_TMP)
      Reg(#CPU_SRC) = Reg(#CPU_SRC) - 1
    Wend
  EndIf
  Reg((Op >> 6) & 7) = Res
  FlagNZ = Res
  ; ClockCycles = ClockCycles + #J11_T_EIS
  ;disassembly("ASH " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
CompilerIf #ASM_TAILS = 1
  ASM Uses PC, RunLeft, Op, GBase
    ldr r0, [r5, #28]
    mov r9, r0
    ldr r1, [r5, #96]
    cmp r1, #0
    bne __tm119_t
    subs.w r11, r11, #1
    beq __tm119_e
    lsls r1, r0, #31
    bne __tm119_s
    ldr r1, [r5, #56]
    cmp r0, r1
    blt __tm119_s
    ldr r1, [r5, #60]
    cmp r0, r1
    bge __tm119_s
    str r0, [r5, #68]
    ldr r1, [r5, #64]
    ldrh r2, [r1, r0]
    mov r8, r2
    adds.w r9, r9, #2
    lsrs r2, r2, #3
    lsls r2, r2, #2
    ldr r1, =global_optablem
    ldr r1, [r1, r2]
    bx r1
__tm119_e:
    b __ul_cpurunm_runendm
__tm119_s:
    b __ul_cpurunm_slowfetchm
__tm119_t:
    b __ul_cpurunm_slowtailm
  EndASM
CompilerElse
  NextSyncedM()
CompilerEndIf

