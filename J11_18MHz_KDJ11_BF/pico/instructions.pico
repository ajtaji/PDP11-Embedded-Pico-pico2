; ======================================================================
;  REGISTER SOURCE, MEMORY DESTINATION - OP Rs,(Rd)  OP Rs,(Rd)+  OP Rs,X(Rd)
;  and every other form whose source is a register and whose destination
;  is not. On the J-11 the source register is read AFTER the destination's
;  address has been worked out, so:
;    OP R,(R)+  OP R,-(R)  OP R,@(R)+  OP R,@-(R)   the source is R already
;                                                   stepped by the destination
;    OP PC,X(R)  OP PC,@X(R)  OP PC,A  OP PC,@A     the source is the address
;                                                   of the instruction + 4
;  (KDJ11-A CPU Module User's Guide EK-KDJ1A-UG-002, appendix B, table B-1,
;  items 1, 2 and 3, page B-2: the KDJ11-A is in the 11/23's row, not the
;  11/44's or the 11/70's. The DCF11-AA CPU diagnostic CJKDBD0 tests the
;  same row in its tests 264 to 267 and 271 to 274.) The general handlers
;  above read the source first, which is the same thing for every other
;  pair of modes, so the table sends these forms here and the general
;  handlers never see them. Everything else is the general handler's, line
;  for line; with neither mode to test, these are also the shorter path.
; ======================================================================
InstructionMOV_01_RM:            ; 010SDD  MOV Rs,memory
  PcOut()
  EaFast()
  Src = Reg((Op >> 6) & 7)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerIf #ASM_MEM = 1
  ASM
    ldr r0, =global_ea
    ldr r0, [r0]
    ldr r1, =global_src
    ldr r1, [r1]
    bl __t1_writeword
  EndASM
CompilerElse
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  MWriteWord(Ea, Src)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerEndIf
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  FlagNZ = Src
  FlagV = 0
  NextSynced()

InstructionCMP_02_RM:            ; 020SDD  CMP Rs,memory
  PcOut()
  EaFast()
  Src = Reg((Op >> 6) & 7)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerIf #ASM_MEM = 1
  ASM
    ldr r0, =global_ea
    ldr r0, [r0]
    bl __t1_readword
    ldr r1, =global_dst
    str r0, [r1]
  EndASM
CompilerElse
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  MReadWord(Dst, Ea)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerEndIf
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  Res = Src - Dst
  FlagC = Res
  FlagV = (Src ! Dst) & (Src ! Res)
  FlagNZ = Res & $FFFF
  NextSynced()

InstructionBIT_03_RM:            ; 030SDD  BIT Rs,memory
  PcOut()
  EaFast()
  Src = Reg((Op >> 6) & 7)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerIf #ASM_MEM = 1
  ASM
    ldr r0, =global_ea
    ldr r0, [r0]
    bl __t1_readword
    ldr r1, =global_dst
    str r0, [r1]
  EndASM
CompilerElse
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  MReadWord(Dst, Ea)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerEndIf
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  FlagNZ = Src & Dst
  FlagV = 0
  NextSynced()

InstructionBIC_04_RM:            ; 040SDD  BIC Rs,memory
  PcOut()
  EaFast()
  Src = Reg((Op >> 6) & 7)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerIf #ASM_MEM = 1
  ASM Uses Res
    ldr r0, =global_ea
    ldr r0, [r0]
    bl __t1_readword
    mov r10, r0
  EndASM
CompilerElse
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  MReadWord(Res, Ea)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerEndIf
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  Res = Res & ~Src & $FFFF
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerIf #ASM_MEM = 1
  ASM Uses Res
    ldr r0, =global_ea
    ldr r0, [r0]
    mov r1, r10
    bl __t1_writeword
  EndASM
CompilerElse
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  MWriteWord(Ea, Res)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerEndIf
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  FlagNZ = Res
  FlagV = 0
  NextSynced()

InstructionBIS_05_RM:            ; 050SDD  BIS Rs,memory
  PcOut()
  EaFast()
  Src = Reg((Op >> 6) & 7)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerIf #ASM_MEM = 1
  ASM Uses Res
    ldr r0, =global_ea
    ldr r0, [r0]
    bl __t1_readword
    mov r10, r0
  EndASM
CompilerElse
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  MReadWord(Res, Ea)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerEndIf
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  Res = Res | Src
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerIf #ASM_MEM = 1
  ASM Uses Res
    ldr r0, =global_ea
    ldr r0, [r0]
    mov r1, r10
    bl __t1_writeword
