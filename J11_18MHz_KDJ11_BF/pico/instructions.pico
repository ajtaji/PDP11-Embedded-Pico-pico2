    str r0, [r1]
  EndASM
CompilerElse
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
    MReadWord(Src, Ea)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerEndIf
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
