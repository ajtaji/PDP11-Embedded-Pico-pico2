    Goto InstructionROR_0060     ; the general handler
  EndIf
  ;name = "ROR Rd"
  Dst = Reg(Op & 7)
  Res = (Dst >> 1) | ((FlagC >> 1) & $8000)
  Reg(Op & 7) = Res
  FlagC = Dst << 16
  FlagV = Res ! (FlagC >> 1)
  FlagNZ = Res
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ROR " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  NextNative()

