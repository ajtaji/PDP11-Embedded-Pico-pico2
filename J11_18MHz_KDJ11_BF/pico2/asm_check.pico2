; ======================================================================
;  asm_check.pico2 - holds the mapped loop's assembly MOV handlers to their
;  plain versions, on the board (Raspberry Pi Pico 2 / Pico 2 W).
;
;  tools/mmu_gen.py gives each MOV_PAIRS handler an assembly fast path in
;  front of its plain body (asm_mov; #ASM_MOV = 1 in cpu.pico2). This
;  program puts the machine in a random state - registers, memory, the
;  kernel's PARs and PDRs, D space on or off, MMR0 frozen or not, MMR1 and
;  the instruction it belongs to, the condition codes - writes one MOV of
;  a random form at a random PC, and runs it twice from that same state:
;  once with the table pointing at the assembly entry and once at the plain
;  one (MovAsmM / MovRefM, filled with the table). Everything an instruction
;  can change is compared: R0-R7, N Z V C, MMR0-2, the instruction MMR1
;  belongs to, the pending trap, the CPU error register, the yellow stack
;  flag, the PDRs (their W bits), the fetch window, and every word of the
;  56 KB of memory (against a shadow copy, so a stray store anywhere is
;  seen). The states are built so that both ways through the assembly are
;  taken: the fast path (counted by the plain handler not having run - it
;  is the only one that writes Src) and every early exit to the plain body
;  (outside a window, odd, R7, the stack limit, a page that is not there).
;
;  It also holds JSR, RTS and DIV (tools/mmu_gen.py, pico2_ops: __pushm and
;  __popm, SDIV) to their plain handlers the same way (ASMCHECK ops).
;  __eab, the byte form, is held to EaByteM the same way (ASMCHECK eab).
;  It also holds __eaw, the handlers' operand address (tools/mmu_gen.py,
;  ASM_EAW), to EaWord's own body (EaWordMRef below) on random specs and
;  registers. Every round prints
;      ASMCHECK mov checks=N fast=F slow=S failures=X PASS
;      ASMCHECK ea checks=N fast=F slow=S failures=X PASS
;  (FAIL with the first difference). A deliberately broken handler must
;  make it FAIL; these did, each within the first round (2026-10-19): the
;  MMR1 byte of -(R) wrong, the (R)+ step of MOV (R)+,R 4 for 2, MOV
;  X(R),-(R) setting N/Z from the address, MOV X(R),(R) indexing Reg() by 2
;  bytes; in __eaw the X(R) PC step 4 for 2, the (R)+ MMR1 byte wrong, and
;  the slow path losing the spec.
;  Build and upload:
;      PureMetalForge.exe --compile asm_check.pico2 -t rp2350 -o asm_check.bin --port COMn
; ======================================================================
#DISK_BACKEND = 0
#DISK_FLASH_MODEL = 0
#DISK_READ_ONLY = 0
#DESK_PROBE = 0
#PSRAM = 0
#DEMO_DEV = 0                ; 1 = the demo display and tone generator (demo_dev.pico2): only tools/demo_build.py sets it
#TERM_PANEL = 0              ; 1 = the console on the LAFVIN panel (term_panel.pico2): only tools/term_build.py sets it
#PSRAM_CS_PIN = 8
#FLASH_CHIP = $400000
#SRAM_MEM_KB = 56                       ; the test compares all of memory with a shadow copy: 56 KB
EnableExplicit
XIncludeFile "RP2350/Lib/clocks.pico2"
XIncludeFile "RP2350/Lib/timer.pico2"
XIncludeFile "RP2350/Lib/uart.pico2"
XIncludeFile "RP2350/Lib/usb_serial.pico2"
XIncludeFile "RP2350/Lib/safety.pico2"
XIncludeFile "cpu.pico2"
XIncludeFile "fp11.pico2"
XIncludeFile "instructions_mmu.pico2"
XIncludeFile "instructions.pico2"
XIncludeFile "disk.pico2"
XIncludeFile "kw11.pico2"
XIncludeFile "rk11.pico2"
XIncludeFile "rp11.pico2"

#CLOCK_KHZ = 150000
#ROUND = 2000
#PAIRS = 7
#NOT_RUN = $5A5A1234                    ; Src before a run: still there = the plain body never ran

Global Seed.i = $1234567
Global Dim Shadow.u(#RAM_WORDS)
Global Dim PairSm.i(#PAIRS)
Global Dim PairDm.i(#PAIRS)
#SNAP = 40
Global Dim SnapA.i(#SNAP)
Global Dim SnapB.i(#SNAP)
Global Dim DiffA.i(8)                   ; up to 4 (word index, value) pairs
Global Dim DiffB.i(8)
Global NDiffA.i, NDiffB.i
Global Checks.i, Fast.i, Slow.i, Failures.i, FirstBad.i, FirstOp.i, FirstField.i
Global TPc.i, TOp.i, TPair.i, TRs.i, TRd.i
Global Dim SReg.i(8)
Global Dim SPar.i(64)
Global Dim SPdr.i(64)
Global Dim SAlt.i(6)
Global Dim SBank.i(4)
Global GK.i, GS.i, GD.i, GN.i, GI.i, GK2.i, GN2.i
Global Osm.i, Odm.i, Oi.i, Oj.i, Ow.i, Ofield.i, Mr.i, Mt0.i
Global SNZ.i, SV.i, SC.i, SMmr0.i, SMmr1.i, SMmr3.i, SPcRec.i
Global OpPsw.i = $00E0                ; the PSW a check starts from: kernel; MFPI/MTPI vary the previous mode

; FlagNZ lives in r4 (cpu.pico2): only these two small procedures name it, so no
; procedure here that saves r4 in its frame touches it (PM1126).
Procedure.i NzRead()
  ProcedureReturn FlagNZ
EndProcedure

Procedure NzWrite(v.i)
  FlagNZ = v
EndProcedure

Procedure Ch(c.i)
  UsbSerialWrite(c)
EndProcedure

Procedure Say(*s.i)
  Define p.i, c.i
  p = *s
  c = PeekA(p) & 255
  While c <> 0
    Ch(c)
    p = p + 1
    c = PeekA(p) & 255
  Wend
EndProcedure

Procedure Num(v.i)
  Define n.i, p.i
  n = v
  If n < 0
    Ch(45)
    n = 0 - n
  EndIf
  p = 1
  While n / p >= 10
    p = p * 10
  Wend
  While p > 0
    Ch(48 + (n / p) % 10)
    p = p / 10
  Wend
EndProcedure

Procedure Oct(v.i)
  Define k.i
  For k = 15 To 0 Step -3
    Ch(48 + ((v >> k) & 7))
  Next
EndProcedure

Procedure Eol()
  Ch(13)
  Ch(10)
  UsbSerialFlush()
  UsbSerialTask()
EndProcedure

Procedure Pump(us.i)
  Define t0.i
  t0 = Micros()
  While (Micros() - t0) < us
    UsbSerialTask()
    SafetyPet()
  Wend
EndProcedure

Procedure.i Rnd()                       ; xorshift32
  Seed = Seed ! (Seed << 13)
  Seed = Seed ! ((Seed >> 17) & $7FFF)
  Seed = Seed ! (Seed << 5)
  ProcedureReturn Seed & $7FFFFFFF
EndProcedure

Procedure.i RndN(n.i)
  ProcedureReturn Rnd() % n
EndProcedure

; An even address in one of the current D space's write windows (or, if
; there is none, any even address).
Procedure.i RndMapped()
  Define t.i, e.i
  For t = 1 To 16
    e = Reg(#CPU_CURD) + RndN(8)
    If MapWHi(e) > MapWLo(e)
      ProcedureReturn (MapWLo(e) + RndN(MapWHi(e) - MapWLo(e))) & $FFFE
    EndIf
  Next
  ProcedureReturn RndN($8000) * 2
EndProcedure

; An even address in one of the previous mode's windows (space sp: 0 I, 8 D).
Procedure.i RndMappedPrv(sp.i)
  Define t.i, e.i
  For t = 1 To 16
    e = PrvBase + sp + RndN(8)
    If MapWHi(e) > MapWLo(e)
      ProcedureReturn (MapWLo(e) + RndN(MapWHi(e) - MapWLo(e))) & $FFFE
    EndIf
  Next
  ProcedureReturn RndN($8000) * 2
EndProcedure

; A register value: mostly an address in a write window (the fast path),
; sometimes any even address, odd, near the stack limit, or anything.
Procedure.i RndReg()
  Define k.i
  k = RndN(12)
  If k < 6
    ProcedureReturn (RndMapped() + 2) & $FFFF   ; +2: a -(R) lands in the window too
  ElseIf k < 8
    ProcedureReturn RndN($8000) * 2
  ElseIf k = 8
    ProcedureReturn RndN($10000) | 1
  ElseIf k = 9
    ProcedureReturn $FC + RndN(8) * 2   ; 000374-000412: either side of the yellow limit
  EndIf
  ProcedureReturn RndN($10000)
EndProcedure

; The kernel's map: mostly pages in the 56 KB, some beyond it (no fast window),
; most read/write with W set, some read-only, some not resident, some growing down.
Procedure RandomMap()
  Define e.i, k.i, acf.i
  For e = 0 To 63
    If e = 32                           ; mode 2 does not exist: its entries stay empty
      e = 48
    EndIf
    If RndN(4) = 0
      Par(e) = $380 + RndN($C80)        ; past the memory: no window
    Else
      Par(e) = RndN($300) & $FFF8       ; in the 56 KB (whole page)
    EndIf
    k = RndN(20)
    If k < 15
      acf = 6
    ElseIf k < 18
      acf = 2
    Else
      acf = 0
    EndIf
    Pdr(e) = acf | (RndN($80) << 8)
    If RndN(10) < 7
      Pdr(e) = Pdr(e) | $40
    EndIf
    If RndN(5) = 0
      Pdr(e) = Pdr(e) | 8
    EndIf
    If RndN(3) <> 0
      Pdr(e) = (Pdr(e) & $00FF) | $7F00 ; most pages whole: more fast windows
    EndIf
  Next
  For e = 32 To 47
    Par(e) = 0
    Pdr(e) = 0
  Next
  Mmr3 = RndN(8)                        ; D space on or off for kernel (4), supervisor (2), user (1)
  MmuRecompute()
EndProcedure

; A PC in a page whose word at the PC and the two after it are in the I fast window.
Procedure.i PickPc()
  Define t.i, va.i, e.i
  For t = 1 To 200
    va = RndN($8000) * 2
    If va <= $FFF8
      e = Reg(#CPU_CURI) + (va >> 13)
      If va >= MapRLo(e) And va + 6 <= MapRHi(e)
        ProcedureReturn va
      EndIf
    EndIf
  Next
  ProcedureReturn -1
EndProcedure

Procedure SaveState()
  For GI = 0 To 7 : SReg(GI) = Reg(GI) : Next
  For GI = 0 To 63 : SPar(GI) = Par(GI) : SPdr(GI) = Pdr(GI) : Next
  For GI = 0 To 5 : SAlt(GI) = Reg(#CPU_ALT + (GI)) : Next
  For GI = 0 To 3 : SBank(GI) = StackBank(GI) : Next
  SNZ = NzRead() : SV = Reg(#CPU_FLAGV) : SC = Reg(#CPU_FLAGC)
  SMmr0 = Reg(#CPU_MMR0) : SMmr1 = Reg(#CPU_MMR1) : SMmr3 = Mmr3 : SPcRec = Reg(#CPU_MMUPCREC)
EndProcedure

; Back to the saved state exactly: a trap in the run before may have changed
; the mode, the register set, the stack pointers and the map's entry bases.
Procedure LoadState()
  PswSet(OpPsw)                         ; kernel, register set 0, priority 7 (and a previous mode)
  For GI = 0 To 7 : Reg(GI) = SReg(GI) : Next
  For GI = 0 To 63 : Par(GI) = SPar(GI) : Pdr(GI) = SPdr(GI) : Next
  For GI = 0 To 5 : Reg(#CPU_ALT + (GI)) = SAlt(GI) : Next
  For GI = 0 To 3 : StackBank(GI) = SBank(GI) : Next
  Mmr3 = SMmr3
  MmuRecompute()
  NzWrite(SNZ) : Reg(#CPU_FLAGV) = SV : Reg(#CPU_FLAGC) = SC
  Reg(#CPU_MMR0) = SMmr0 : Reg(#CPU_MMR1) = SMmr1 : Reg(#CPU_MMUPCREC) = SPcRec : Mmr2 = 0
  MmuOn = 1
  Reg(#CPU_TRAPVECTOR) = 0 : PswLate = 0 : AbortPsw = 0 : StackYellow = 0 : CpuErr = 0
  TraceArm = 0 : Halted = 0 : Waiting = 0 : IntReq = 0 : DevActive = 0 : Dl11TxRdy = 1
  Reg(#CPU_SRC) = #NOT_RUN
EndProcedure

 ; Random PAR/PDR bursts, followed by a mapped access: lazy versus rebuilding
; every entry after every write. Replay the same random stream and compare
; physical addresses, aborts, PDR W bits, fetch invalidation and map contents.
Global TmmChecks.i, TmmFailures.i, TmmSeed.i, TmmAfter.i, TmmPass.i
Global TmmI.i, TmmJ.i, TmmR.i, TmmAddr.i, TmmValue.i, TmmE.i, TmmVa.i, TmmWr.i, TmmPa.i
; Snapshot storage borrows Shadow before the MOV tests fill it.

ProcedureRAM MmuRegWriteRef(a.i, v.i)
  Protected r.i
  MmuTouches = MmuTouches + 1
  If a = #MMR0_ADDR                      ; 15-13, 8 and 0 are writable
    v = (Reg(#CPU_MMR0) & $00FE) | (v & $E101)
    If (v ! Reg(#CPU_MMR0)) & 1
      MmuOn = v & 1
      CpuEventIn(1)                      ; the other run loop, from the next instruction
    EndIf
    Reg(#CPU_MMR0) = v
  ElseIf a = #MMR3_ADDR
    Mmr3 = v & $3F
    MmuRecompute()
  ElseIf a = #MMR1_ADDR Or a = #MMR2_ADDR
    ProcedureReturn                      ; read-only
  Else
    r = MmuRegIndex(a)
    If r & $100
      r = r & $FF
      Par(r) = v & $FFFF
      Pdr(r) = Pdr(r) & ~$40
    Else
      Pdr(r) = v & $7F0E
    EndIf
    MmuRegChanged(r)
  EndIf
EndProcedure

ProcedureRAM.i MmuPhysRef(va.i, e.i, write.i)
  Protected bits.i, r.i
  bits = 0
  If MapAcf(e) = 0
    bits = $8000
  EndIf
  If va < MapLo(e) Or va >= MapHi(e)
    bits = bits | $4000
  EndIf
  If write <> 0 And MapAcf(e) = 1
    bits = bits | $2000
  EndIf
  If bits
    MmuAbort(bits, e)
    ProcedureReturn -1
  EndIf
  If write
    r = MapReg(e)
    If (Pdr(r) & $40) = 0                ; the first write: W, and a fast window
      Pdr(r) = Pdr(r) | $40
      MmuRegChanged(r)
    EndIf
  EndIf
  ProcedureReturn (va + MapBase(e)) & MapMask
EndProcedure

Procedure TmmOne()
  OpPsw = $00E0
  PswSet(OpPsw)
  For TmmI = 0 To 63
    Par(TmmI) = RndN($10000)
    Pdr(TmmI) = RndN($8000) & $7F4E
  Next
  Mmr3 = RndN(64)
  Reg(#CPU_MMR0) = RndN(2) * $E000
  Reg(#CPU_MMR1) = RndN($10000)
  SaveState()
  TmmSeed = Seed
  For TmmPass = 0 To 1
    LoadState()
    Seed = TmmSeed
    For TmmI = 0 To 31
      TmmR = RndN(48)
      TmmAddr = $F4C0
      If TmmR >= 32
        TmmAddr = $FF80
        TmmR = TmmR - 32
      ElseIf TmmR >= 16
        TmmAddr = $F480
        TmmR = TmmR - 16
      EndIf
      TmmAddr = TmmAddr + TmmR * 2 + RndN(2) * 32
      TmmValue = RndN($10000)
      If RndN(2) : TmmValue = MmuRegRead(TmmAddr) : EndIf
      If TmmPass = 0
        MmuRegWrite(TmmAddr, TmmValue)
      Else
        MmuRegWriteRef(TmmAddr, TmmValue)
      EndIf
      If TmmPass = 1
        For TmmJ = 0 To 63 : MmuMapEntry(TmmJ) : Next
      EndIf
    Next
    ; Probe every mode and space, reads and writes, with all page offsets.
    For TmmE = 0 To 63
      TmmVa = ((TmmE & 7) << 13) | RndN($2000)
      TmmWr = RndN(2)
      Reg(#CPU_TRAPVECTOR) = 0 : AbortPsw = 0
      If TmmPass = 0
        TmmPa = MmuPhys(TmmVa, TmmE, TmmWr)
      Else
        TmmPa = MmuPhysRef(TmmVa, TmmE, TmmWr)
        For TmmJ = 0 To 63 : MmuMapEntry(TmmJ) : Next
      EndIf
      TmmJ = TmmE * 15
      If TmmPass = 0
        PokeL(@Shadow(0) + (TmmJ) * 4, TmmPa)
        PokeL(@Shadow(0) + (TmmJ + 1) * 4, Reg(#CPU_MMR0))
        PokeL(@Shadow(0) + (TmmJ + 2) * 4, Reg(#CPU_MMR1))
        PokeL(@Shadow(0) + (TmmJ + 3) * 4, Mmr2)
        PokeL(@Shadow(0) + (TmmJ + 4) * 4, Reg(#CPU_TRAPVECTOR))
        PokeL(@Shadow(0) + (TmmJ + 5) * 4, AbortPsw)
        PokeL(@Shadow(0) + (TmmJ + 6) * 4, Pdr(MapReg(TmmE)))
        PokeL(@Shadow(0) + (TmmJ + 7) * 4, MapBase(TmmE))
        PokeL(@Shadow(0) + (TmmJ + 8) * 4, Reg(#CPU_FW + (0)))
        PokeL(@Shadow(0) + (TmmJ + 9) * 4, FwSave((TmmE >> 4) * 4))
        PokeL(@Shadow(0) + (TmmJ + 10) * 4, MapF((TmmE << 3) + 0))
        PokeL(@Shadow(0) + (TmmJ + 11) * 4, MapF((TmmE << 3) + 1))
        PokeL(@Shadow(0) + (TmmJ + 12) * 4, MapF((TmmE << 3) + 2))
        PokeL(@Shadow(0) + (TmmJ + 13) * 4, MapF((TmmE << 3) + 3))
        PokeL(@Shadow(0) + (TmmJ + 14) * 4, MapF((TmmE << 3) + 4))
      Else
        If PeekL(@Shadow(0) + (TmmJ) * 4) <> TmmPa Or PeekL(@Shadow(0) + (TmmJ + 1) * 4) <> Reg(#CPU_MMR0) Or PeekL(@Shadow(0) + (TmmJ + 2) * 4) <> Reg(#CPU_MMR1) Or PeekL(@Shadow(0) + (TmmJ + 3) * 4) <> Mmr2 Or PeekL(@Shadow(0) + (TmmJ + 4) * 4) <> Reg(#CPU_TRAPVECTOR) Or PeekL(@Shadow(0) + (TmmJ + 5) * 4) <> AbortPsw Or PeekL(@Shadow(0) + (TmmJ + 6) * 4) <> Pdr(MapReg(TmmE)) Or PeekL(@Shadow(0) + (TmmJ + 7) * 4) <> MapBase(TmmE) Or PeekL(@Shadow(0) + (TmmJ + 8) * 4) <> Reg(#CPU_FW + (0)) Or PeekL(@Shadow(0) + (TmmJ + 9) * 4) <> FwSave((TmmE >> 4) * 4)
          TmmFailures = TmmFailures + 1
        EndIf
        For TmmR = 0 To 4
          If PeekL(@Shadow(0) + (TmmJ + 10 + TmmR) * 4) <> MapF((TmmE << 3) + TmmR)
            TmmFailures = TmmFailures + 1
          EndIf
        Next
        TmmChecks = TmmChecks + 1
      EndIf
    Next
  Next
EndProcedure

; Run the one instruction at TPc through entry target; snapshot what it left.
Procedure RunOnce(target.Label)
  OpTableM(TOp >> 3) = target
  Reg(7) = TPc
  GK = CpuRunM(1)
EndProcedure

; What the run left, into *snap / *diff / *nd (no locals: see NzRead)
Procedure Snap(*snap.i, *diff.i, *nd.i)
  GS = *snap : GD = *diff : GN = *nd
  PokeL(GS, GK)
  For GI = 0 To 7 : PokeL(GS + 4 + GI * 4, Reg(GI)) : Next
  PokeL(GS + 36, NzRead())
  PokeL(GS + 40, Reg(#CPU_FLAGV) & $8000)
  PokeL(GS + 44, Reg(#CPU_FLAGC) & $10000)
  PokeL(GS + 48, Reg(#CPU_MMR0))
  PokeL(GS + 52, Reg(#CPU_MMR1))
  PokeL(GS + 56, Mmr2)
  PokeL(GS + 60, Reg(#CPU_MMUPCREC))
  PokeL(GS + 64, Reg(#CPU_TRAPVECTOR))
  PokeL(GS + 68, CpuErr)
  PokeL(GS + 72, StackYellow)
  PokeL(GS + 76, Reg(#CPU_FW + (0)))
  PokeL(GS + 80, Reg(#CPU_FW + (1)))
  PokeL(GS + 84, Reg(#CPU_FW + (3)))
  PokeL(GS + 88, PswGet())
  GK2 = 0
  For GI = 0 To 63 : GK2 = GK2 * 31 + Pdr(GI) : Next
  PokeL(GS + 92, GK2)
  PokeL(GS + 96, Halted)
  PokeL(GS + 100, Bool(Reg(#CPU_SRC) = #NOT_RUN))
  ; memory against the shadow: note what changed, then put it back
  GN2 = 0
  For GI = 0 To #RAM_WORDS - 1
    If Mem(GI) <> Shadow(GI)
      If GN2 < 4
        PokeL(GD + GN2 * 8, GI)
        PokeL(GD + GN2 * 8 + 4, Mem(GI))
      EndIf
      GN2 = GN2 + 1
      Mem(GI) = Shadow(GI)
    EndIf
  Next
  PokeL(GN, GN2)
EndProcedure

Procedure OneCheck()
  PswSet($00E0)                         ; kernel, register set 0 (a trap last time may have left another)
  TPair = RndN(#PAIRS)
  Osm = PairSm(TPair)
  Odm = PairDm(TPair)
  RandomMap()
  For Oi = 0 To 6 : Reg(Oi) = RndReg() : Next
  TPc = PickPc()
  If TPc < 0
    ProcedureReturn
  EndIf
  TRs = RndN(8)
  If Osm = 2 And TRs = 7
    TRs = RndN(7)                       ; (R7)+ is an immediate: the table sends it elsewhere
  EndIf
  TRd = RndN(8)
  TOp = $1000 | (Osm << 9) | (TRs << 6) | (Odm << 3) | TRd
  Ow = TPc + MapHost(Reg(#CPU_CURI) + (TPc >> 13))
  PokeU(Ow, TOp)
  PokeU(Ow + 2, RndN($10000))           ; an index word
  If RndN(4) <> 0
    PokeU(Ow + 2, (RndMapped() - Reg(RndN(7))) & $FFFF)   ; ... often one that lands in a window
  EndIf
  For Oi = 0 To #RAM_WORDS - 1           ; (only the words just written differ)
    Shadow(Oi) = Mem(Oi)
  Next
  ; the condition codes, MMR0 (sometimes frozen), MMR1 and its instruction
  NzWrite(Rnd()) : Reg(#CPU_FLAGV) = Rnd() : Reg(#CPU_FLAGC) = Rnd()
  Reg(#CPU_MMR0) = 1 | (RndN(8) << 1)
  If RndN(8) = 0
    Reg(#CPU_MMR0) = Reg(#CPU_MMR0) | ((RndN(7) + 1) << 13)
  EndIf
  Reg(#CPU_MMR1) = RndN($10000)
  If RndN(3) = 0
    Reg(#CPU_MMR1) = Reg(#CPU_MMR1) & $FF00
  EndIf
  Reg(#CPU_MMUPCREC) = RndN($10000)
  If RndN(2)
    Reg(#CPU_MMUPCREC) = TPc                      ; MMR1 already belongs to this instruction
  EndIf
  SaveState()
  LoadState()
  RunOnce(MovAsmM(TPair))
  Snap(@SnapA(0), @DiffA(0), @NDiffA)
  LoadState()
  RunOnce(MovRefM(TPair))
  Snap(@SnapB(0), @DiffB(0), @NDiffB)
  OpTableM(TOp >> 3) = MovAsmM(TPair)  ; the table as built
  Checks = Checks + 1
  If SnapA(25) = 1
    Fast = Fast + 1
  Else
    Slow = Slow + 1
  EndIf
  Ofield = -1
  For Oi = 0 To 24
    If SnapA(Oi) <> SnapB(Oi) And Ofield < 0
      Ofield = Oi
    EndIf
  Next
  If Ofield < 0 And NDiffA <> NDiffB
    Ofield = 30
  EndIf
  If Ofield < 0
    For Oi = 0 To 7
      If Oi < NDiffA * 2 And DiffA(Oi) <> DiffB(Oi) And Ofield < 0
        Ofield = 31
      EndIf
    Next
  EndIf
  If Ofield >= 0
    Failures = Failures + 1
    If FirstBad < 0
      FirstBad = Checks
      FirstOp = TOp
      FirstField = Ofield
      Say("FIRST FAIL op=") : Oct(TOp) : Say(" pc=") : Oct(TPc) : Say(" Ofield=") : Num(Ofield)
      If Ofield < 25
        Say(" asm=") : Num(SnapA(Ofield)) : Say(" plain=") : Num(SnapB(Ofield))
      EndIf
      Say(" fast=") : Num(SnapA(25)) : Eol()
    EndIf
  EndIf
EndProcedure

; ---- __eaw, the mapped handlers' operand address --------------------------
; The plain body, as a procedure of its own (cpu.pico2, EaWordMBody).
ProcedureRAM.i EaWordMRef(spec.i)
  EaWordMBody()
EndProcedure

; __eaw as the handlers reach it: bl, spec in r0, the address back in r0.
; (lr is kept on the stack across the bl.)
Procedure EaAsm()
  ASM
    push {r3, lr}
    ldr r0, =global_espec
    ldr r0, [r0]
    bl __eaw
    ldr r1, =global_er
    str r0, [r1]
    pop {r2, r3}
    mov lr, r3
  EndASM
EndProcedure

; __eab, the byte form, the same way (EaByteMode = 1): its reference is EaByteM itself.
Procedure EabAsm()
  ASM
    push {r3, lr}
    ldr r0, =global_espec
    ldr r0, [r0]
    bl __eab
    ldr r1, =global_er
    str r0, [r1]
    pop {r2, r3}
    mov lr, r3
  EndASM
EndProcedure
Global EaByteMode.i, EbI.i

#EA_NONE = $77AA55                      ; EaSpec before a run: still there = __eaw never went on to EaWordM
Global EaChecks.i, EaFast.i, EaSlow.i, EaFailures.i, EaFirst.i, EaFirstSpec.i, EaFirstField.i
Global ESpec.i, ER.i, Ei.i, EField.i
Global Dim EaA.i(24)
Global Dim EaB.i(24)

Procedure EaSnap(*s.i)
  GS = *s
  PokeL(GS, ER)
  For GI = 0 To 7 : PokeL(GS + 4 + GI * 4, Reg(GI)) : Next
  PokeL(GS + 36, 0)                     ; EaReg, Tmp and Adr: EaWordM's own working words, which
  PokeL(GS + 40, Reg(#CPU_EABASE))                ; nothing reads after the address is formed - __eaw no
  PokeL(GS + 44, 0)                     ; longer stores them (2026-10-25); EaBase the access that
  PokeL(GS + 48, 0)                     ; follows uses, so it is held to the plain one
  PokeL(GS + 52, Reg(#CPU_MMR0))
  PokeL(GS + 56, Reg(#CPU_MMR1))
  PokeL(GS + 60, Mmr2)
  PokeL(GS + 64, Reg(#CPU_MMUPCREC))
  PokeL(GS + 68, Reg(#CPU_TRAPVECTOR))
  PokeL(GS + 72, CpuErr)
  PokeL(GS + 76, StackYellow)
  PokeL(GS + 80, AbortPsw)
  PokeL(GS + 84, Bool(Reg(#CPU_EASPEC) = #EA_NONE))
  PokeL(GS + 88, Reg(#CPU_EASTEP))
EndProcedure

Procedure.i PickMode()
  Define k.i
  k = RndN(6)
  If k = 0
    ProcedureReturn 6
  ElseIf k = 1
    ProcedureReturn 4
  ElseIf k = 2
    ProcedureReturn 2
  ElseIf k = 3
    ProcedureReturn 3
  ElseIf k = 4
    ProcedureReturn 7
  EndIf
  ProcedureReturn 1
EndProcedure

Procedure EaOne()
  PswSet($00E0)
  RandomMap()
  For Ei = 0 To 6 : Reg(Ei) = RndReg() : Next
  Reg(7) = RndReg()
  If RndN(2)
    Ei = PickPc()                       ; a PC whose next word is in the I window: X(R)'s fast path
    If Ei >= 0
      Reg(7) = Ei
      PokeU(Ei + MapHost(Reg(#CPU_CURI) + (Ei >> 13)), (RndMapped() - Reg(RndN(7))) & $FFFF)
    EndIf
  EndIf
  ESpec = RndN(64)
  If RndN(3) <> 0                       ; mostly the six modes the assembly does
    ESpec = (ESpec & 7) | (PickMode() << 3)
  EndIf
  NzWrite(Rnd()) : Reg(#CPU_FLAGV) = Rnd() : Reg(#CPU_FLAGC) = Rnd()
  Reg(#CPU_MMR0) = 1 | (RndN(8) << 1)
  If RndN(8) = 0
    Reg(#CPU_MMR0) = Reg(#CPU_MMR0) | ((RndN(7) + 1) << 13)
  EndIf
  Reg(#CPU_MMR1) = RndN($10000)
  If RndN(3) = 0
    Reg(#CPU_MMR1) = Reg(#CPU_MMR1) & $FF00
  EndIf
  Reg(#CPU_FW + (3)) = RndN($10000)
  Reg(#CPU_MMUPCREC) = RndN($10000)
  If RndN(2)
    Reg(#CPU_MMUPCREC) = Reg(#CPU_FW + (3))
  EndIf
  SaveState()
  LoadState()
  ER = 0
  Reg(#CPU_EASPEC) = #EA_NONE
  If EaByteMode
    EabAsm()
  Else
    EaAsm()
  EndIf
  EaSnap(@EaA(0))
  Ei = Reg(#CPU_FW + (3))
  LoadState()
  Reg(#CPU_FW + (3)) = Ei
  Reg(#CPU_EASPEC) = #EA_NONE
  If EaByteMode
    ER = EaByteM(ESpec)
  Else
    ER = EaWordMRef(ESpec)
  EndIf
  EaSnap(@EaB(0))
  EaChecks = EaChecks + 1
  If EaA(21) = 1
    EaFast = EaFast + 1
  Else
    EaSlow = EaSlow + 1
  EndIf
  EField = -1
  For Ei = 0 To 22
    If Ei <> 21 And EaA(Ei) <> EaB(Ei) And EField < 0
      EField = Ei
    EndIf
  Next
  If EField >= 0
    EaFailures = EaFailures + 1
    If EaFirst < 0
      EaFirst = EaChecks
      EaFirstSpec = ESpec
      EaFirstField = EField
      Say("EA FIRST FAIL spec=") : Oct(ESpec) : Say(" field=") : Num(EField)
      Say(" asm=") : Num(EaA(EField)) : Say(" plain=") : Num(EaB(EField)) : Say(" fast=") : Num(EaA(21)) : Eol()
    EndIf
  EndIf
EndProcedure


; ---- __eau / __eaub, the unmapped handlers' operand address -----------------
; (instructions.pico2, the UNMAPPED ONLY block): held to EaWord and EaByte, the
; plain bodies they go on to, with memory management off - random registers
; (mostly even and in the 56 KB, some odd, at the edge of the I/O page, in it,
; or either side of the stack limit), random specs, the same state for both.
Procedure EauAsm()
  ASM
    push {r3, lr}
    ldr r0, =global_espec
    ldr r0, [r0]
    bl __eau
    ldr r1, =global_er
    str r0, [r1]
    pop {r2, r3}
    mov lr, r3
  EndASM
EndProcedure

Procedure EaubAsm()
  ASM
    push {r3, lr}
    ldr r0, =global_espec
    ldr r0, [r0]
    bl __eaub
    ldr r1, =global_er
    str r0, [r1]
    pop {r2, r3}
    mov lr, r3
  EndASM
EndProcedure

Global EuChecks.i, EuFast.i, EuFailures.i, EuFirst.i, EuFirstSpec.i, EuFirstField.i, EuByte.i
Global Dim EuReg.i(8)

Procedure.i RndRegU()
  Define k.i
  k = RndN(12)
  If k < 7
    ProcedureReturn RndN($6FFC) * 2 + 2   ; even, in the 56 KB, room for -(R)
  ElseIf k = 7
    ProcedureReturn $DFF8 + RndN(8) * 2   ; either side of 160000
  ElseIf k = 8
    ProcedureReturn RndN($10000) | 1
  ElseIf k = 9
    ProcedureReturn $FC + RndN(8) * 2     ; either side of the stack limit
  ElseIf k = 10
    ProcedureReturn $E000 + RndN($800) * 2   ; the I/O page's empty start: a bus error
  EndIf
  ProcedureReturn RndN($10000)
EndProcedure

Procedure EuPrep()
  For Ei = 0 To 7 : Reg(Ei) = EuReg(Ei) : Next
  Reg(#CPU_TRAPVECTOR) = 0 : CpuErr = 0 : StackYellow = 0 : AbortPsw = 0
  Reg(#CPU_EAREG) = -1 : Reg(#CPU_TMP) = -1 : Reg(#CPU_ADR) = -1 : Reg(#CPU_EASTEP) = -1
  ER = 0
  Reg(#CPU_EASPEC) = #EA_NONE
EndProcedure

Procedure EuSnap(*s.i)
  GS = *s
  PokeL(GS, ER)
  For GI = 0 To 7 : PokeL(GS + 4 + GI * 4, Reg(GI)) : Next
  PokeL(GS + 36, Reg(#CPU_EAREG))
  PokeL(GS + 40, Reg(#CPU_TMP))
  PokeL(GS + 44, Reg(#CPU_ADR))
  PokeL(GS + 48, Reg(#CPU_EASTEP))
  PokeL(GS + 52, Reg(#CPU_TRAPVECTOR))
  PokeL(GS + 56, CpuErr)
  PokeL(GS + 60, StackYellow)
  PokeL(GS + 64, AbortPsw)
  PokeL(GS + 68, Bool(Reg(#CPU_EASPEC) = #EA_NONE))
EndProcedure

Procedure EuOne()
  PswSet($00E0)
  Reg(#CPU_MMR0) = 0 : MmuOn = 0
  For Ei = 0 To 7 : EuReg(Ei) = RndRegU() : Next
  ESpec = RndN(64)
  If RndN(4) <> 0                       ; mostly modes 1 to 7
    ESpec = (ESpec & 7) | ((1 + RndN(7)) << 3)
  EndIf
  EuPrep()
  If EuByte
    EaubAsm()
  Else
    EauAsm()
  EndIf
  EuSnap(@EaA(0))
  EuPrep()
  If EuByte
    ER = EaByte(ESpec)
  Else
    ER = EaWord(ESpec)
  EndIf
  EuSnap(@EaB(0))
  EuChecks = EuChecks + 1
  If EaA(17) = 1
    EuFast = EuFast + 1
  EndIf
  EField = -1
  For Ei = 0 To 16
    If EaA(Ei) <> EaB(Ei) And EField < 0
      EField = Ei
    EndIf
  Next
  If EField >= 0
    EuFailures = EuFailures + 1
    If EuFirst < 0
      EuFirst = EuChecks
      EuFirstSpec = ESpec
      EuFirstField = EField
      Say("EAU FIRST FAIL byte=") : Num(EuByte) : Say(" spec=") : Oct(ESpec) : Say(" field=") : Num(EField)
      Say(" asm=") : Num(EaA(EField)) : Say(" plain=") : Num(EaB(EField)) : Say(" fast=") : Num(EaA(17)) : Eol()
    EndIf
  EndIf
EndProcedure


; ---- the FPU's assembly (fp11.pico2) ----------------------------------------
; FpFracMulAsm against FpFracMulRef, and FpDivQAsm against FpDivQRef, on the
; same fractions: random ones (the hidden bit set, the low word 0 a third of
; the time - the 24 x 24 case), and every pairing of the extremes (the
; smallest fraction, the largest, and the two equal). Only the results are
; the procedures' contract - #P_FF for the multiply, #P_Q for the quotient -
; and the assembly must leave #P_SF as it found it.
Global FpChecks.i, FpFailures.i, FpFirst.i
Global Fa.i, Fb.i, Fc.i, Fd.i, Fr0.i, Fr1.i, Fk.i
Global Dim EdgeH.i(3)
Global Dim EdgeL.i(3)

Procedure.i RndW()                      ; 32 random bits
  ProcedureReturn (Rnd() << 1) ! Rnd()
EndProcedure

Procedure FpOneCase(ah.i, al.i, bh.i, bl.i, qd.i)
  ; the multiply
  PH(#P_FF) = ah : PL(#P_FF) = al : PH(#P_SF) = bh : PL(#P_SF) = bl
  FpFracMulRef()
  Fr0 = PH(#P_FF) : Fr1 = PL(#P_FF)
  PH(#P_FF) = ah : PL(#P_FF) = al : PH(#P_SF) = bh : PL(#P_SF) = bl
  FpFracMulAsm()
  FpChecks = FpChecks + 1
  If PH(#P_FF) <> Fr0 Or PL(#P_FF) <> Fr1 Or PH(#P_SF) <> bh Or PL(#P_SF) <> bl
    FpFailures = FpFailures + 1
    If FpFirst < 0
      FpFirst = FpChecks
      Say("FP FIRST FAIL mul a=") : Num(ah) : Ch(32) : Num(al) : Say(" b=") : Num(bh) : Ch(32) : Num(bl)
      Say(" asm=") : Num(PH(#P_FF)) : Ch(32) : Num(PL(#P_FF)) : Say(" plain=") : Num(Fr0) : Ch(32) : Num(Fr1) : Eol()
    EndIf
  EndIf
  ; the quotient, of the guarded fractions; F keeps only the high words
  If qd = 0
    al = 0 : bl = 0
  EndIf
  Fa = (ah << 3) | ((al >> 29) & 7) : Fb = al << 3
  Fc = (bh << 3) | ((bl >> 29) & 7) : Fd = bl << 3
  FqQd = qd
  If qd
    FqCount = 23 + #FP_GUARD + 33
  Else
    FqCount = 23 + #FP_GUARD + 1
  EndIf
  PH(#P_FF) = Fa : PL(#P_FF) = Fb : PH(#P_SF) = Fc : PL(#P_SF) = Fd
  FpDivQRef()
  Fr0 = PH(#P_Q) : Fr1 = PL(#P_Q)
  PH(#P_FF) = Fa : PL(#P_FF) = Fb : PH(#P_SF) = Fc : PL(#P_SF) = Fd
  PH(#P_Q) = RndW() : PL(#P_Q) = RndW()
  FpDivQAsm()
  FpChecks = FpChecks + 1
  If PH(#P_Q) <> Fr0 Or PL(#P_Q) <> Fr1 Or PH(#P_SF) <> Fc Or PL(#P_SF) <> Fd
    FpFailures = FpFailures + 1
    If FpFirst < 0
      FpFirst = FpChecks
      Say("FP FIRST FAIL div qd=") : Num(qd) : Say(" ff=") : Num(Fa) : Ch(32) : Num(Fb) : Say(" sf=") : Num(Fc) : Ch(32) : Num(Fd)
      Say(" asm=") : Num(PH(#P_Q)) : Ch(32) : Num(PL(#P_Q)) : Say(" plain=") : Num(Fr0) : Ch(32) : Num(Fr1) : Eol()
    EndIf
  EndIf
EndProcedure

Procedure FpOne()
  Define ah.i, al.i, bh.i, bl.i
  ah = (RndW() & $7FFFFF) | $800000
  bh = (RndW() & $7FFFFF) | $800000
  al = RndW() : bl = RndW()
  If RndN(3) = 0
    al = 0 : bl = 0
  EndIf
  FpOneCase(ah, al, bh, bl, RndN(2))
EndProcedure

Procedure FpEdges()
  Define i.i, j.i
  EdgeH(0) = $800000 : EdgeL(0) = 0            ; 0.5, the smallest
  EdgeH(1) = $FFFFFF : EdgeL(1) = -1           ; the largest
  EdgeH(2) = $800000 : EdgeL(2) = 1
  For i = 0 To 2
    For j = 0 To 2
      FpOneCase(EdgeH(i), EdgeL(i), EdgeH(j), EdgeL(j), 0)
      FpOneCase(EdgeH(i), EdgeL(i), EdgeH(j), EdgeL(j), 1)
    Next
  Next
EndProcedure

; ---- the floating operand in one pass (fp11.pico2, FpOpAsm) -----------------
; FpSrc and FpDst (the assembly first) against FpEa followed by FpReadF or
; FpWriteF, from the same state: the kernel's random map, random registers
; (as the ea check's), random specs - mostly modes 1-7, some of every spec -
; F and D lengths, reads and writes, the index word of X(R) and @X(R) mostly
; pointing into a window, a deferred mode's pointer mostly in one too, a
; random FPS (FIUV sometimes, so an undefined variable can trap). Compared:
; the registers, the pair, FpAdr, FpSpace, the register change left for the
; end, FpQuit, the trap, FEC and FPS, MMR0/1, the CPU error, the yellow
; stack, and memory (what a write changed, against the shadow copy).
Global FoChecks.i, FoFast.i, FoFailures.i, FoFirst.i, FoField.i
Global FoSpec.i, FoLn.i, FoWr.i, Fq.i, Fv.i, Fm.i, Fn.i, Fh.i, Fl.i, Fps0.i
Global Dim FoA.i(28)
Global Dim FoB.i(28)

Procedure FoSnap(*s.i)
  GS = *s
  PokeL(GS, GK)
  For GI = 0 To 7 : PokeL(GS + 4 + GI * 4, Reg(GI)) : Next
  PokeL(GS + 36, PH(#P_SRC))
  PokeL(GS + 40, PL(#P_SRC))
  PokeL(GS + 44, FpAdr)
  PokeL(GS + 48, FpSpace)
  PokeL(GS + 52, FpChgOn)
  PokeL(GS + 56, FpChgOn * FpChgReg)
  PokeL(GS + 60, FpChgOn * FpChgVal)
  PokeL(GS + 64, FpQuit)
  PokeL(GS + 68, Reg(#CPU_TRAPVECTOR))
  PokeL(GS + 72, Fec)
  PokeL(GS + 76, Fps)
  PokeL(GS + 80, Reg(#CPU_MMR0))
  PokeL(GS + 84, Reg(#CPU_MMR1))
  PokeL(GS + 88, CpuErr)
  PokeL(GS + 92, StackYellow)
  GN2 = 0 : GK2 = 0
  If FoWr
    For GI = 0 To #RAM_WORDS - 1
      If Mem(GI) <> Shadow(GI)
        GN2 = GN2 + 1
        GK2 = GK2 * 31 + (GI << 16) + Mem(GI)
        Mem(GI) = Shadow(GI)
      EndIf
    Next
  EndIf
  PokeL(GS + 96, GN2)
  PokeL(GS + 100, GK2)
EndProcedure

Procedure FoPoke(va.i, base.i, v.i)     ; v at va if va is in base's read window
  va = va & $FFFF
  Fn = base + (va >> 13)
  If (va & 1) = 0 And va >= MapRLo(Fn) And va < MapRHi(Fn)
    PokeU(va + MapHost(Fn), v & $FFFF)
  EndIf
EndProcedure

Procedure FoPrep()
  Fps = Fps0 : Fec = 0 : FpQuit = 0 : FpChgOn = 0 : FpChgReg = 0 : FpChgVal = 0
  FrwFast = 0 : FpAdr = 0 : FpSpace = 0
  PH(#P_SRC) = Fh : PL(#P_SRC) = Fl
EndProcedure

Procedure FpOpOne()
  PswSet($00E0)
  RandomMap()
  For Fq = 0 To 6 : Reg(Fq) = RndReg() : Next
  Reg(7) = RndReg()
  FoSpec = RndN(64)
  If RndN(4) <> 0
    If RndN(7) = 0
      Fm = 5
    Else
      Fm = PickMode()
    EndIf
    FoSpec = (FoSpec & 7) | (Fm << 3)
  EndIf
  Fm = (FoSpec >> 3) & 7
  Fn = FoSpec & 7
  FoLn = 4 + 4 * RndN(2)
  If RndN(5) = 0
    FoLn = 2
  EndIf
  FoWr = RndN(2)
  If (Fm = 6 Or Fm = 7) And RndN(4) <> 0
    Fq = PickPc()
    If Fq >= 0
      Reg(7) = Fq
      If Fn = 7
        Fv = Fq + 2
      Else
        Fv = Reg(Fn)
      EndIf
      Fl = RndMapped()                  ; the address X(R) forms
      PokeU(Fq + MapHost(Reg(#CPU_CURI) + (Fq >> 13)), (Fl - Fv) & $FFFF)
      If Fm = 7 And RndN(4) <> 0
        FoPoke(Fl, Reg(#CPU_CURD), RndMapped())
      EndIf
    EndIf
  ElseIf Fm = 3 And RndN(4) <> 0
    If Fn = 7
      FoPoke(Reg(7), Reg(#CPU_CURI), RndMapped())
    Else
      FoPoke(Reg(Fn), Reg(#CPU_CURD), RndMapped())
    EndIf
  ElseIf Fm = 5 And RndN(4) <> 0
    FoPoke(Reg(Fn) - 2, Reg(#CPU_CURD), RndMapped())
  EndIf
  Fps0 = RndN($10000) & #FPS_RW
  Fh = RndW() : Fl = RndW()
  If RndN(8) = 0
    Fh = Fh & ~#FP_EXP                  ; a zero, or (the sign set) the undefined variable
  EndIf
  If FoWr
    For Fq = 0 To #RAM_WORDS - 1 : Shadow(Fq) = Mem(Fq) : Next
  EndIf
  If FoLn = 2 And FoSpec <= 7
    FoSpec = FoSpec | $10               ; a word has no register form here
  EndIf
  SaveState()
  LoadState()
  FoPrep()
  If FoLn = 2                           ; a word: FpOpAsm alone, against FpEa with FpRdW / FpWrW
    FrDs = FoSpec : FrLn = 2 : FrP = #P_SRC : FrWr = FoWr
    If FoSpec > 7
      FpOpAsm()
    EndIf
    GK = 0
  ElseIf FoWr
    FpDst(#P_SRC, FoSpec, FoLn)
    GK = 0
  Else
    GK = FpSrc(#P_SRC, FoSpec, FoLn)
  EndIf
  Fv = FrwFast
  FoSnap(@FoA(0))
  LoadState()
  FoPrep()
  If FoLn = 2
    GK = 0
    If Fv                               ; it did it: the plain way must give the same
      FpEa(FoSpec, 2)
      If FoWr
        FpWrW(FpAdr, FpSpace, (PH(#P_SRC) >> 16) & $FFFF)
      Else
        PH(#P_SRC) = FpRdW(FpAdr, FpSpace) << 16
        PL(#P_SRC) = 0
      EndIf
    EndIf                               ; it did not: nothing may have changed (FpAdr, FpSpace aside)
  Else
    FpEa(FoSpec, FoLn)
    If FoWr
      FpWriteF(#P_SRC, FoSpec, FoLn)
      GK = 0
    ElseIf FpQuit
      GK = 0
    Else
      GK = FpReadF(#P_SRC, FoSpec, FoLn)
    EndIf
  EndIf
  FoSnap(@FoB(0))
  If FoLn = 2 And Fv = 0
    FoA(11) = 0 : FoA(12) = 0 : FoB(11) = 0 : FoB(12) = 0
  EndIf
  FoChecks = FoChecks + 1
  FoFast = FoFast + Fv
  FoField = -1
  For Fq = 0 To 25
    If FoA(Fq) <> FoB(Fq) And FoField < 0
      FoField = Fq
    EndIf
  Next
  If FoField >= 0
    FoFailures = FoFailures + 1
    If FoFirst < 0
      FoFirst = FoChecks
      Say("FPOP FIRST FAIL spec=") : Oct(FoSpec) : Say(" ln=") : Num(FoLn) : Say(" wr=") : Num(FoWr)
      Say(" field=") : Num(FoField) : Say(" asm=") : Num(FoA(FoField)) : Say(" plain=") : Num(FoB(FoField))
      Say(" fast=") : Num(Fv) : Eol()
    EndIf
  EndIf
EndProcedure

; ---- addfp11 (fp11.pico2, FpAddOpAsm) -----------------------------------------
; FpAddOpAsm against FpAddOpRef on the same operands and FPS: random signs,
; exponents mostly close together (the subtract's cancellation, the add's
; carry), sometimes equal magnitudes, a zero, exponents 60 or more apart, or
; at the top and the bottom of the range (overflow, underflow); F operands
; (the low word 0) and D; FPS D, T and the overflow and underflow enables at
; random, FID sometimes. Compared: #P_FAC, the result (V), FPS, FEC, FEA and
; the trap.
Global FaMul.i, FmChecks.i, FmFailures.i
Global FaChecks.i, FaFailures.i, FaFirst.i, FaH.i, FaL.i, FbH.i, FbL.i, FaFps.i, FaK.i
Global Dim FaA.i(8)
Global Dim FaB.i(8)

Procedure.i FaExp()
  FaK = RndN(10)
  If FaK = 0
    ProcedureReturn 0
  ElseIf FaK = 1
    ProcedureReturn 250 + RndN(6)
  ElseIf FaK = 2
    ProcedureReturn 1 + RndN(4)
  EndIf
  ProcedureReturn 100 + RndN(56)
EndProcedure

Procedure FaSnap(*s.i, r.i)
  GS = *s
  PokeL(GS, PH(#P_FAC))
  PokeL(GS + 4, PL(#P_FAC))
  PokeL(GS + 8, r)
  PokeL(GS + 12, Fps)
  PokeL(GS + 16, Fec)
  PokeL(GS + 20, Fea)
  PokeL(GS + 24, Reg(#CPU_TRAPVECTOR))
EndProcedure

Procedure FaPrep()
  PH(#P_FAC) = FaH : PL(#P_FAC) = FaL
  PH(#P_SRC) = FbH : PL(#P_SRC) = FbL
  Fps = FaFps : Fec = 0 : Fea = 0 : Reg(#CPU_TRAPVECTOR) = 0
EndProcedure

Procedure FpAddOne()
  FaFps = RndN($10000) & #FPS_RW
  FaH = (RndW() & ~#FP_EXP) | (FaExp() << 23)
  FaK = RndN(8)
  If FaK = 0                            ; the same magnitude
    FbH = FaH ! (RndN(2) << 31)
  ElseIf FaK < 5                        ; close exponents
    FbH = (RndW() & ~#FP_EXP) | (((((FaH >> 23) & $FF) + RndN(5) - 2) & $FF) << 23)
  Else
    FbH = (RndW() & ~#FP_EXP) | (FaExp() << 23)
  EndIf
  If FaFps & #FPS_D
    FaL = RndW()
    If FaK = 0
      FbL = FaL
      If RndN(2)
        FbL = FaL ! (1 << RndN(32))
      EndIf
    Else
      FbL = RndW()
    EndIf
  Else
    FaL = 0 : FbL = 0
  EndIf
  FpBackupPc = RndN($10000)
  FaPrep()
  If FaMul
    FpMulOpAsm()
  Else
    FpAddOpAsm()
  EndIf
  FaSnap(@FaA(0), FaRet)
  FaPrep()
  If FaMul
    FaK = FpMulOpRef()
    FmChecks = FmChecks + 1
  Else
    FaK = FpAddOpRef()
    FaChecks = FaChecks + 1
  EndIf
  FaSnap(@FaB(0), FaK)
  For FaK = 0 To 6
    If FaA(FaK) <> FaB(FaK)
      If FaMul
        FmFailures = FmFailures + 1
      Else
        FaFailures = FaFailures + 1
      EndIf
      If FaFirst < 0
        FaFirst = FaChecks + FmChecks
        Say("FPADD/MUL FIRST FAIL mul=") : Num(FaMul) : Say(" fac=") : Num(FaH) : Ch(32) : Num(FaL) : Say(" src=") : Num(FbH) : Ch(32) : Num(FbL)
        Say(" fps=") : Oct(FaFps) : Say(" field=") : Num(FaK) : Say(" asm=") : Num(FaA(FaK)) : Say(" plain=") : Num(FaB(FaK)) : Eol()
      EndIf
      Break
    EndIf
  Next
EndProcedure

; ---- the FP instruction (fp11.pico2, FpExec with FpExecAsm) -------------------
; FpExec (FpExecAsm first) against FpExecRef from the same state: the random map
; and registers of the fpop check, an FP instruction - mostly one FpExecAsm
; does (MULf ADDf LDf SUBf STf DIVf), the rest any 17xxxx - with any
; accumulator and spec (the operand mostly in a window), six random
; accumulators (zeros, undefined variables, exponents near the ends now and
; then), a random FPS. Compared: R0-R7, the six accumulators, FPS, FEC, FEA,
; the trap, FpQuit, the CPU's N Z V C, the CPU error, the yellow stack,
; MMR0/1, and memory.
Global FxChecks.i, FxFailures.i, FxFirst.i, FxOp.i, Fxk.i
Global Dim FxSH.i(6)
Global Dim FxSL.i(6)
Global Dim FxA.i(40)
Global Dim FxB.i(40)

Procedure FxSnap(*s.i)
  GS = *s
  For GI = 0 To 7 : PokeL(GS + GI * 4, Reg(GI)) : Next
  For GI = 0 To 5
    PokeL(GS + 32 + GI * 8, FrH(GI))
    PokeL(GS + 36 + GI * 8, FrL(GI))
  Next
  PokeL(GS + 80, Fps)
  PokeL(GS + 84, Fec)
  PokeL(GS + 88, Fea)
  PokeL(GS + 92, Reg(#CPU_TRAPVECTOR))
  PokeL(GS + 96, FpQuit)
  PokeL(GS + 100, NzRead())
  PokeL(GS + 104, Reg(#CPU_FLAGV) & $8000)
  PokeL(GS + 108, Reg(#CPU_FLAGC) & $10000)
  PokeL(GS + 112, CpuErr)
  PokeL(GS + 116, StackYellow)
  PokeL(GS + 120, Reg(#CPU_MMR0))
  PokeL(GS + 124, Reg(#CPU_MMR1))
  GN2 = 0 : GK2 = 0
  For GI = 0 To #RAM_WORDS - 1
    If Mem(GI) <> Shadow(GI)
      GN2 = GN2 + 1
      GK2 = GK2 * 31 + (GI << 16) + Mem(GI)
      Mem(GI) = Shadow(GI)
    EndIf
  Next
  PokeL(GS + 128, GN2)
  PokeL(GS + 132, GK2)
EndProcedure

Procedure FxPrep()
  For GI = 0 To 5 : FrH(GI) = FxSH(GI) : FrL(GI) = FxSL(GI) : Next
  Fps = Fps0 : Fec = 0 : Fea = 0 : FpQuit = 0 : FpChgOn = 0
  Op = FxOp
EndProcedure

Procedure FpxOne()
  FpOpOne()                             ; a random map, registers, spec and operand words (its own check too)
  LoadState()
  Fxk = RndN(10)
  If Fxk < 7
    Fxk = RndN(6)
    If Fxk = 0
      Fxk = 2
    ElseIf Fxk = 1
      Fxk = 4
    ElseIf Fxk = 2
      Fxk = 5
    ElseIf Fxk = 3
      Fxk = 6
    ElseIf Fxk = 4
      Fxk = 8
    Else
      Fxk = 9
    EndIf
    FxOp = $F000 | (Fxk << 8) | (RndN(4) << 6) | FoSpec
    If RndN(4) = 0                      ; CLRf TSTf ABSf NEGf
      FxOp = (FxOp & $F0FF) | $0100
    ElseIf RndN(5) = 0                  ; LDFPS STFPS (STST too)
      FxOp = (FxOp & $F0FF) | ((RndN(3) + 1) << 6)
    ElseIf RndN(6) = 0                  ; CFCC SETF SETI SETD SETL, and the illegal ones round them
      FxOp = $F000 | RndN(12)
    EndIf
  Else
    FxOp = $F000 | RndN($1000)
  EndIf
  For Fxk = 0 To 5
    FxSH(Fxk) = (RndW() & ~#FP_EXP) | (FaExp() << 23)
    If RndN(2)
      FxSL(Fxk) = RndW()
    Else
      FxSL(Fxk) = 0
    EndIf
  Next
  Fps0 = RndN($10000) & #FPS_RW
  For Fq = 0 To #RAM_WORDS - 1 : Shadow(Fq) = Mem(Fq) : Next
  SaveState()
  LoadState()
  FxPrep()
  FpExec()
  FxSnap(@FxA(0))
  Fv = FxDone
  LoadState()
  FxPrep()
  FpExecRef()
  FxSnap(@FxB(0))
  FxChecks = FxChecks + 1
  For Fxk = 0 To 33
    If FxA(Fxk) <> FxB(Fxk)
      FxFailures = FxFailures + 1
      If FxFirst < 0
        FxFirst = FxChecks
        Say("FPX FIRST FAIL op=") : Oct(FxOp) : Say(" fps=") : Oct(Fps0) : Say(" field=") : Num(Fxk)
        Say(" asm=") : Num(FxA(Fxk)) : Say(" plain=") : Num(FxB(Fxk)) : Say(" done=") : Num(Fv) : Eol()
      EndIf
      Break
    EndIf
  Next
EndProcedure

; ---- JSR, RTS and DIV (tools/mmu_gen.py, pico2_ops) -------------------------
; Each assembly handler (OpAsmM) against its plain one (OpRefM), from the same
; random state as the MOV check: JSR of every mode (0, illegal, too), RTS of
; every register, DIV from every source mode, with the stack pointer anywhere
; RndReg puts a register (in a window, odd, at the stack limit, unmapped) and
; the dividend and divisor often at the edges (0, -1, 077777, 100000, a quotient
; just out of range). The same fields and the same memory as the MOV check.
Global OpChecks.i, OpFailures.i, OpFirst.i, OpKind.i, OpR.i
Global Dim OpCount.i(65)
Global Dim EdgeW.i(8)
Global Dim OpsFast.i(14)                ; the register fast paths (tools/mmu_gen.py, FAST): the opcode ...
Global Dim OpsFastK.i(14)               ; ... and its form: 1 Rs,Rd, 2 Rd or #n,Rd, 3 SOB
Global Dim OpsBr.i(15)                  ; BR, BNE ... BCS (tools/mmu_gen.py, BRANCHES): the opcode, offset 0
Global Dim OpsTwo.i(8)                  ; ADD SUB BIT BIC BIS MOVB CMPB BITB: the opcode with no operands

Procedure.i RndEdge()
  If RndN(2)
    ProcedureReturn EdgeW(RndN(8))
  EndIf
  ProcedureReturn RndN($10000)
EndProcedure

Global ForceForm.i = -1, FormI.i, FormBefore.i, FormChecked.i
Global ForceCall.i = -1

Procedure OpsOne()
  OpPsw = $00E0
  PswSet($00E0)
  RandomMap()
  For Oi = 0 To 6 : Reg(Oi) = RndReg() : Next
  TPc = PickPc()
  If TPc < 0
    ProcedureReturn
  EndIf
  OpKind = RndN(51)
  If ForceCall >= 0 : OpKind = ForceCall : EndIf
  If ForceForm = 8 : OpKind = 19
  ElseIf ForceForm = 9 : OpKind = 4
  ElseIf ForceForm = 10 : OpKind = 5
  ElseIf ForceForm = 11 : OpKind = 6
  ElseIf ForceForm = 12 : OpKind = 20
  ElseIf ForceForm = 13 : OpKind = 21
  ElseIf ForceForm = 0 : OpKind = 16
  ElseIf ForceForm = 1 : OpKind = 10
  ElseIf ForceForm = 2 : OpKind = 3
  ElseIf ForceForm >= 3 : OpKind = ForceForm + 8
  EndIf
  OpR = RndN(8)
  If OpKind = 8 Or OpKind = 9           ; MFPI/MTPI: kernel, the previous mode kernel, supervisor or user
    Oi = RndN(3)
    If Oi = 2
      Oi = 3
    EndIf
    OpPsw = $00E0 | (Oi << 12)
    PswSet(OpPsw)
  EndIf
  If OpKind = 0                         ; JSR R, dd
    TOp = $0800 | (OpR << 6) | RndN(64)
    If RndN(8) <> 0 And (TOp & $38) = 0
      TOp = TOp | $08                   ; mostly a legal mode
    EndIf
  ElseIf OpKind = 1                     ; RTS R
    TOp = $0080 | OpR
  ElseIf OpKind = 3                     ; CMP ss, dd
    TOp = $2000 | (RndN(64) << 6) | RndN(64)
  ElseIf OpKind = 4                     ; TST dd
    TOp = $0BC0 | RndN(64)
  ElseIf OpKind = 5                     ; INC dd
    TOp = $0A80 | RndN(64)
  ElseIf OpKind = 6                     ; DEC dd
    TOp = $0AC0 | RndN(64)
  ElseIf OpKind = 7                     ; SXT dd
    TOp = $0DC0 | RndN(64)
  ElseIf OpKind = 8                     ; MFPI ss, or MFPD (bit 15)
    TOp = $0D40 | RndN(64) | (RndN(2) << 15)
  ElseIf OpKind = 9                     ; MTPI dd, or MTPD
    TOp = $0D80 | RndN(64) | (RndN(2) << 15)
  ElseIf OpKind = 10                    ; MOV ss, dd: every mode pair
    TOp = $1000 | RndN(4096)
  ElseIf OpKind >= 11 And OpKind <= 18 ; ADD SUB BIT BIC BIS MOVB CMPB BITB ss, dd: every mode pair
    TOp = OpsTwo(OpKind - 11) | RndN(4096)
  ElseIf OpKind >= 37                   ; a register fast path
    Oi = OpsFastK(OpKind - 37)
    If Oi = 1
      TOp = OpsFast(OpKind - 37) | (RndN(8) << 6) | RndN(8)
    ElseIf Oi = 2
      TOp = OpsFast(OpKind - 37) | RndN(8)
    Else
      TOp = OpsFast(OpKind - 37) | RndN(512)
    EndIf
  ElseIf OpKind >= 22                   ; a branch, any offset
    TOp = OpsBr(OpKind - 22) | RndN(256)
  ElseIf OpKind = 19                    ; CLR dd
    TOp = $0A00 | RndN(64)
  ElseIf OpKind = 20                    ; CLRB dd
    TOp = $8A00 | RndN(64)
  ElseIf OpKind = 21                    ; TSTB dd
    TOp = $8BC0 | RndN(64)
  Else                                  ; DIV R, ss
    TOp = $7200 | (OpR << 6) | RndN(64)
    If RndN(3) = 0
      Reg(OpR & 6) = RndEdge()
      Reg(OpR | 1) = RndEdge()
      Reg(TOp & 7) = RndEdge()
      If RndN(2)                        ; a quotient at the edge of the range
        Reg(TOp & 7) = 2 + RndN(3)
        Reg(OpR & 6) = (RndN(3) + $FFFF) & $FFFF
      EndIf
    EndIf
  EndIf
  If ForceForm >= 0
    If ForceForm = 0 : TOp = $95F0
    ElseIf ForceForm = 1 : TOp = $15F0
    ElseIf ForceForm = 2 : TOp = $25F0
    ElseIf ForceForm = 3 : TOp = $65F0
    ElseIf ForceForm = 4 : TOp = $E5F0
    ElseIf ForceForm = 5 : TOp = $35F0
    ElseIf ForceForm = 6 : TOp = $45F0
    ElseIf ForceForm = 7 : TOp = $55F0
    ElseIf ForceForm = 8 : TOp = $0A30
    ElseIf ForceForm = 9 : TOp = $0BF0
    ElseIf ForceForm = 10 : TOp = $0AB0
    ElseIf ForceForm = 11 : TOp = $0AF0
    ElseIf ForceForm = 12 : TOp = $8A30
    Else : TOp = $8BF0
    EndIf
    TOp = TOp | RndN(8)
  EndIf
  If OpKind >= 3 And RndN(3) = 0
    Reg(TOp & 7) = RndEdge()
  EndIf
  If OpKind >= 4 And (TOp & $38) = 0 And RndN(2) = 0   ; a register operand right at an edge (INC 077777, DEC 100000)
    Reg(TOp & 7) = EdgeW(RndN(8))
  EndIf
  If OpKind >= 4 And (TOp & $38) = $08 And (TOp & 7) < 7 And RndN(2) = 0   ; (R): the word it names, at an edge
    Oi = RndMapped()
    Reg(TOp & 7) = Oi
    PokeU(MapHost(Reg(#CPU_CURD) + (Oi >> 13)) + Oi, EdgeW(RndN(8)))
  EndIf
  If (OpKind = 8 Or OpKind = 9) And (TOp & 7) < 6 And RndN(2) = 0
    Reg(TOp & 7) = RndMappedPrv((TOp >> 12) & 8)
    If (TOp & $38) = $20
      Reg(TOp & 7) = (Reg(TOp & 7) + 2) & $FFFF      ; -(R) lands in the window
    EndIf
  EndIf
  Ow = TPc + MapHost(Reg(#CPU_CURI) + (TPc >> 13))
  PokeU(Ow, TOp)
  PokeU(Ow + 2, RndN($10000))
  If RndN(4) <> 0
    PokeU(Ow + 2, (RndMapped() - Reg(RndN(7))) & $FFFF)
  EndIf
  PokeU(Ow + 4, (RndMapped() - Reg(RndN(7))) & $FFFF)   ; a second index word (CMP X(R),Y(R))
  If (OpKind = 8 Or OpKind = 9) And RndN(2) = 0           ; X(R) and absolute into the previous mode's window
    PokeU(Ow + 2, (RndMappedPrv((TOp >> 12) & 8) - Reg(TOp & 7)) & $FFFF)
    If (TOp & 7) = 7
      PokeU(Ow + 2, RndMappedPrv((TOp >> 12) & 8))
    EndIf
  EndIf
  If OpKind >= 3 And RndN(3) = 0                          ; a memory operand at an edge
    Oi = RndMapped()
    PokeU(MapHost(Reg(#CPU_CURD) + (Oi >> 13)) + Oi, RndEdge())
  EndIf
  For Oi = 0 To #RAM_WORDS - 1
    Shadow(Oi) = Mem(Oi)
  Next
  NzWrite(Rnd()) : Reg(#CPU_FLAGV) = Rnd() : Reg(#CPU_FLAGC) = Rnd()
  If RndN(2)
    NzWrite(RndN(2) * $8000)          ; N set or clear plainly (SXT)
  EndIf
  If OpKind >= 22 And RndN(3) = 0       ; a branch: Z set (with N in bit 16, or not), or N alone
    Oi = RndN(4)
    If Oi = 0 : NzWrite(0) : ElseIf Oi = 1 : NzWrite($10000) : ElseIf Oi = 2 : NzWrite($8000) : Else : NzWrite(1) : EndIf
  EndIf
  Reg(#CPU_MMR0) = 1 | (RndN(8) << 1)
  If RndN(8) = 0
    Reg(#CPU_MMR0) = Reg(#CPU_MMR0) | ((RndN(7) + 1) << 13)
  EndIf
  Reg(#CPU_MMR1) = RndN($10000)
  Reg(#CPU_MMUPCREC) = RndN($10000)
  If RndN(2)
    Reg(#CPU_MMUPCREC) = TPc
  EndIf
  SaveState()
  LoadState()
  If ForceForm >= 0 : RunOnce(OpAsmM(51 + ForceForm)) : Else : RunOnce(OpAsmM(OpKind)) : EndIf
  Snap(@SnapA(0), @DiffA(0), @NDiffA)
  LoadState()
  If ForceForm >= 0 : RunOnce(OpRefM(51 + ForceForm)) : Else : RunOnce(OpRefM(OpKind)) : EndIf
  Snap(@SnapB(0), @DiffB(0), @NDiffB)
  If ForceForm >= 0 : OpTableM(TOp >> 3) = OpAsmM(51 + ForceForm) : Else : OpTableM(TOp >> 3) = OpAsmM(OpKind) : EndIf
  If ForceForm >= 0 And ForceForm < 8 And SnapA(25) = 1 : OpCount(51 + ForceForm) = OpCount(51 + ForceForm) + 1 : EndIf
  OpPsw = $00E0
  OpChecks = OpChecks + 1
  OpCount(OpKind) = OpCount(OpKind) + 1
  Ofield = -1
  For Oi = 0 To 24
    If SnapA(Oi) <> SnapB(Oi) And Ofield < 0
      Ofield = Oi
    EndIf
  Next
  If Ofield < 0 And NDiffA <> NDiffB
    Ofield = 30
  EndIf
  If Ofield < 0
    For Oi = 0 To 7
      If Oi < NDiffA * 2 And DiffA(Oi) <> DiffB(Oi) And Ofield < 0
        Ofield = 31
      EndIf
    Next
  EndIf
  If Ofield >= 0
    OpFailures = OpFailures + 1
    If OpFailures <= 12
      Say("OPS FAIL op=") : Oct(TOp) : Say(" field=") : Num(Ofield) : Say(" nA=") : Num(NDiffA) : Say(" nB=") : Num(NDiffB)
      For Oi = 0 To 2
        If Oi < NDiffA : Say(" A@") : Oct(DiffA(Oi * 2) * 2) : Say("=") : Oct(DiffA(Oi * 2 + 1)) : EndIf
        If Oi < NDiffB : Say(" B@") : Oct(DiffB(Oi * 2) * 2) : Say("=") : Oct(DiffB(Oi * 2 + 1)) : EndIf
      Next
      Say(" sp=") : Oct(SReg(6)) : Say(" r=") : Oct(SReg(TOp & 7)) : Say(" pc=") : Oct(TPc) : Say(" nz=") : Num(SNZ)
      Say(" ea=") : Oct(Reg(#CPU_EA)) : Eol()
    EndIf
    If OpFirst < 0
      OpFirst = OpChecks
      Say("OPS FIRST FAIL op=") : Oct(TOp) : Say(" pc=") : Oct(TPc) : Say(" sp=") : Oct(SReg(6)) : Say(" field=") : Num(Ofield)
      If Ofield < 25
        Say(" asm=") : Num(SnapA(Ofield)) : Say(" plain=") : Num(SnapB(Ofield))
      EndIf
      Eol()
    EndIf
  EndIf
EndProcedure

Global MbAdr.i, MbVal.i, MbRes.i, MbOld.i, MbWant.i, MbChecks.i, MbFailures.i
Procedure MByteOne()
  MbAdr = RndN(#RAM16)
  MbVal = Rnd()
  MbOld = Mem(MbAdr >> 1)
  MbWant = MbOld & $FF
  If MbAdr & 1 : MbWant = MbOld >> 8 : EndIf
  MbRes = ReadByte(MbAdr)
  If MbRes <> MbWant : MbFailures = MbFailures + 1 : EndIf
  MReadByte(MbRes, MbAdr)
  If MbRes <> MbWant : MbFailures = MbFailures + 1 : EndIf
  MbWant = (MbOld & $FF00) | (MbVal & $FF)
  If MbAdr & 1 : MbWant = (MbOld & $FF) | ((MbVal & $FF) << 8) : EndIf
  WriteByte(MbAdr, MbVal)
  If Mem(MbAdr >> 1) <> MbWant : MbFailures = MbFailures + 1 : EndIf
  Mem(MbAdr >> 1) = MbOld
  MWriteByte(MbAdr, MbVal)
  If Mem(MbAdr >> 1) <> MbWant : MbFailures = MbFailures + 1 : EndIf
  Mem(MbAdr >> 1) = MbOld
  MbChecks = MbChecks + 4
EndProcedure

Procedure Main()
  SafetyBoot()
  ClockInitKhz(#CLOCK_KHZ)
  UsbSerialInit()
  SafetyOk()
  While UsbSerialReady() = 0
    UsbSerialTask()
    SafetyPet()
  Wend
  Pump(3000000)
  ; MOV_PAIRS, in tools/mmu_gen.py's order
  PairSm(0) = 0 : PairDm(0) = 4
  PairSm(1) = 4 : PairDm(1) = 0
  PairSm(2) = 6 : PairDm(2) = 0
  PairSm(3) = 6 : PairDm(3) = 4
  PairSm(4) = 2 : PairDm(4) = 0
  PairSm(5) = 6 : PairDm(5) = 1
  PairSm(6) = 0 : PairDm(6) = 6
  BuildOpcodeTable()
  BuildOpcodeTableM()
  CpuReset()
  For Mr = 0 To #RAM_WORDS - 1
    Mem(Mr) = RndN($10000)
  Next
  FirstBad = -1
  EaFirst = -1
  EuFirst = -1
  FpFirst = -1
  FoFirst = -1
  FaFirst = -1
  FxFirst = -1
  OpFirst = -1
  EdgeW(0) = 0 : EdgeW(1) = $FFFF : EdgeW(2) = $7FFF : EdgeW(3) = $8000
  EdgeW(4) = 1 : EdgeW(5) = 2 : EdgeW(6) = $FFFE : EdgeW(7) = $8001
  OpsTwo(0) = $6000 : OpsTwo(1) = $E000 : OpsTwo(2) = $3000 : OpsTwo(3) = $4000
  OpsTwo(4) = $5000 : OpsTwo(5) = $9000 : OpsTwo(6) = $A000 : OpsTwo(7) = $B000
  OpsBr(0) = $0100 : OpsBr(1) = $0200 : OpsBr(2) = $0300 : OpsBr(3) = $0400 : OpsBr(4) = $0500
  OpsBr(5) = $0600 : OpsBr(6) = $0700 : OpsBr(7) = $8000 : OpsBr(8) = $8100 : OpsBr(9) = $8200
  OpsBr(10) = $8300 : OpsBr(11) = $8400 : OpsBr(12) = $8500 : OpsBr(13) = $8600 : OpsBr(14) = $8700
  OpsFast(0) = $1000 : OpsFast(1) = $2000 : OpsFast(2) = $6000 : OpsFast(3) = $E000
  OpsFast(4) = $0A00 : OpsFast(5) = $0A80 : OpsFast(6) = $0AC0 : OpsFast(7) = $0BC0
  OpsFast(8) = $15C0 : OpsFast(9) = $25C0 : OpsFast(10) = $35C0 : OpsFast(11) = $65C0
  OpsFast(12) = $E5C0 : OpsFast(13) = $7E00
  For Oi = 0 To 3 : OpsFastK(Oi) = 1 : Next
  For Oi = 4 To 12 : OpsFastK(Oi) = 2 : Next
  OpsFastK(13) = 3
  FpInit()
  Say("ASMCHECK start: the mapped loop's MOV handlers and __eaw, assembly against plain") : Eol()
  For Mr = 1 To 1000
    ForceCall = Mr & 1
    OpsOne()
    UsbSerialTask()
    SafetyPet()
  Next
  ForceCall = -1
  Say("ASMCHECK calls checks=") : Num(OpChecks) : Say(" jsr=") : Num(OpCount(0)) : Say(" rts=") : Num(OpCount(1)) : Say(" failures=") : Num(OpFailures)
  If OpFailures = 0 : Say(" PASS") : Else : Say(" FAIL") : EndIf
  Eol()
  Repeat
    For Mr = 1 To #ROUND * 10
      MByteOne()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK bytes checks=") : Num(MbChecks) : Say(" failures=") : Num(MbFailures)
    If MbFailures = 0 : Say(" PASS") : Else : Say(" FAIL") : EndIf
    Eol()
    For Mr = 1 To #ROUND / 4
      TmmOne()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK mmu checks=") : Num(TmmChecks) : Say(" failures=") : Num(TmmFailures)
    If TmmFailures = 0 : Say(" PASS") : Else : Say(" FAIL") : EndIf
    Eol()
    Mt0 = Micros()
    For Mr = 1 To #ROUND
      OneCheck()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK mov checks=") : Num(Checks) : Say(" fast=") : Num(Fast) : Say(" slow=") : Num(Slow)
    Say(" failures=") : Num(Failures)
    If Failures = 0
      Say(" PASS")
    Else
      Say(" FAIL first=") : Num(FirstBad) : Say(" op=") : Oct(FirstOp) : Say(" field=") : Num(FirstField)
    EndIf
    Say(" ms=") : Num((Micros() - Mt0) / 1000) : Eol()
    Mt0 = Micros()
    For Mr = 1 To #ROUND * 5
      EaOne()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK ea checks=") : Num(EaChecks) : Say(" fast=") : Num(EaFast) : Say(" slow=") : Num(EaSlow)
    Say(" failures=") : Num(EaFailures)
    If EaFailures = 0
      Say(" PASS")
    Else
      Say(" FAIL first=") : Num(EaFirst) : Say(" spec=") : Oct(EaFirstSpec) : Say(" field=") : Num(EaFirstField)
    EndIf
    Say(" ms=") : Num((Micros() - Mt0) / 1000) : Eol()
    Mt0 = Micros()
    Mr = EaFailures
    EaByteMode = 1
    For EbI = 1 To #ROUND * 5
      EaOne()
      UsbSerialTask()
      SafetyPet()
    Next
    EaByteMode = 0
    Say("ASMCHECK eab checks=") : Num(#ROUND * 5) : Say(" failures=") : Num(EaFailures - Mr)
    If EaFailures = Mr
      Say(" PASS")
    Else
      Say(" FAIL")
    EndIf
    Say(" ms=") : Num((Micros() - Mt0) / 1000) : Eol()
    Mt0 = Micros()
    For EuByte = 0 To 1
      For EbI = 1 To #ROUND * 5
        EuOne()
        UsbSerialTask()
        SafetyPet()
      Next
    Next
    EuByte = 0
    Say("ASMCHECK eau (unmapped __eau and __eaub) checks=") : Num(EuChecks) : Say(" fast=") : Num(EuFast)
    Say(" failures=") : Num(EuFailures)
    If EuFailures = 0
      Say(" PASS")
    Else
      Say(" FAIL first=") : Num(EuFirst) : Say(" spec=") : Oct(EuFirstSpec) : Say(" field=") : Num(EuFirstField)
    EndIf
    Say(" ms=") : Num((Micros() - Mt0) / 1000) : Eol()
    FormBefore = OpFailures
    FormChecked = OpChecks
    For FormI = 0 To 7
      ForceForm = FormI
      For Mr = 1 To #ROUND / 4
        OpsOne()
        UsbSerialTask()
        SafetyPet()
      Next
    Next
    ForceForm = -1
    Say("ASMCHECK imx checks=") : Num(OpChecks - FormChecked) : Say(" failures=") : Num(OpFailures - FormBefore)
    Say(" fast=")
    For FormI = 0 To 7 : Num(OpCount(51 + FormI)) : Say(" ") : Next
    If OpFailures = FormBefore : Say(" PASS") : Else : Say(" FAIL") : EndIf
    Eol()
    FormBefore = OpFailures
    FormChecked = OpChecks
    SingleHit = 0
    For FormI = 8 To 13
      ForceForm = FormI
      For Mr = 1 To #ROUND / 4
        OpsOne()
        UsbSerialTask()
        SafetyPet()
      Next
    Next
    ForceForm = -1
    Say("ASMCHECK indexed checks=") : Num(OpChecks - FormChecked) : Say(" failures=") : Num(OpFailures - FormBefore)
    Say(" fast=") : Num(SingleHit)
    If OpFailures = FormBefore And SingleHit > 0 : Say(" PASS") : Else : Say(" FAIL") : EndIf
    Eol()
    Mt0 = Micros()
    For Mr = 1 To #ROUND
      OpsOne()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK ops checks=") : Num(OpChecks) : Say(" jsr=") : Num(OpCount(0)) : Say(" rts=") : Num(OpCount(1))
    Say(" div=") : Num(OpCount(2)) : Say(" cmp=") : Num(OpCount(3)) : Say(" tst=") : Num(OpCount(4))
    Say(" inc=") : Num(OpCount(5)) : Say(" dec=") : Num(OpCount(6)) : Say(" sxt=") : Num(OpCount(7))
    Say(" mfpi=") : Num(OpCount(8)) : Say(" mtpi=") : Num(OpCount(9)) : Say(" mov=") : Num(OpCount(10))
    Say(" add=") : Num(OpCount(11)) : Say(" sub=") : Num(OpCount(12)) : Say(" bit=") : Num(OpCount(13))
    Say(" bic=") : Num(OpCount(14)) : Say(" bis=") : Num(OpCount(15)) : Say(" movb=") : Num(OpCount(16))
    Say(" cmpb=") : Num(OpCount(17)) : Say(" bitb=") : Num(OpCount(18)) : Say(" clr=") : Num(OpCount(19))
    Say(" clrb=") : Num(OpCount(20)) : Say(" tstb=") : Num(OpCount(21))
    Oi = 0
    For Oj = 22 To 36 : Oi = Oi + OpCount(Oj) : Next
    Say(" branches=") : Num(Oi)
    Oi = 0
    For Oj = 37 To 50 : Oi = Oi + OpCount(Oj) : Next
    Say(" fastpaths=") : Num(Oi) : Say(" failures=") : Num(OpFailures)
    If OpFailures = 0
      Say(" PASS")
    Else
      Say(" FAIL first=") : Num(OpFirst)
    EndIf
    Say(" ms=") : Num((Micros() - Mt0) / 1000) : Eol()
    Mt0 = Micros()
    FpEdges()
    For Mr = 1 To #ROUND * 5
      FpOne()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK fp checks=") : Num(FpChecks) : Say(" failures=") : Num(FpFailures)
    If FpFailures = 0
      Say(" PASS")
    Else
      Say(" FAIL first=") : Num(FpFirst)
    EndIf
    Say(" ms=") : Num((Micros() - Mt0) / 1000) : Eol()
    Mt0 = Micros()
    For Mr = 1 To #ROUND * 2
      FpOpOne()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK fpop checks=") : Num(FoChecks) : Say(" fast=") : Num(FoFast) : Say(" failures=") : Num(FoFailures)
    If FoFailures = 0
      Say(" PASS")
    Else
      Say(" FAIL first=") : Num(FoFirst)
    EndIf
    Say(" ms=") : Num((Micros() - Mt0) / 1000) : Eol()
    Mt0 = Micros()
    For Mr = 1 To #ROUND * 10
      FpAddOne()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK fpadd checks=") : Num(FaChecks) : Say(" failures=") : Num(FaFailures)
    If FaFailures = 0
      Say(" PASS")
    Else
      Say(" FAIL first=") : Num(FaFirst)
    EndIf
    Say(" ms=") : Num((Micros() - Mt0) / 1000) : Eol()
    Mt0 = Micros()
    FaMul = 1
    For Mr = 1 To #ROUND * 10
      FpAddOne()
      UsbSerialTask()
      SafetyPet()
    Next
    FaMul = 0
    Say("ASMCHECK fpmul checks=") : Num(FmChecks) : Say(" failures=") : Num(FmFailures)
    If FmFailures = 0
      Say(" PASS")
    Else
      Say(" FAIL first=") : Num(FaFirst)
    EndIf
    Say(" ms=") : Num((Micros() - Mt0) / 1000) : Eol()
    Mt0 = Micros()
    For Mr = 1 To #ROUND * 2
      FpxOne()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK fpx checks=") : Num(FxChecks) : Say(" failures=") : Num(FxFailures)
    If FxFailures = 0
      Say(" PASS")
    Else
      Say(" FAIL first=") : Num(FxFirst)
    EndIf
    Say(" ms=") : Num((Micros() - Mt0) / 1000) : Eol()
  ForEver
EndProcedure

Main()
