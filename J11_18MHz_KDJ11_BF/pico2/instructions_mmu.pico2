    adds.w r9, r9, #2
    lsrs r2, r2, #3
    lsls r2, r2, #2
    ldr r1, =global_optablem
    ldr r1, [r1, r2]
    bx r1
  EndASM
EndMacro
CompilerElse
Macro NextSyncedM()
  PC = Reg(7)
  If Reg(#CPU_TRAPVECTOR)
    Goto SlowTailM
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEndM
  EndIf
  If PC >= Reg(#CPU_FW + (0))                       ; the fetch, through the fetch window (cpu)
    If PC < Reg(#CPU_FW + (1))
      If (PC & 1) = 0
        MmuInstrStart(PC)
        Op = PeekU(PC + Reg(#CPU_FW + (2)))
        PC = PC + 2
        Goto OpTableM(Op >> 3)
      EndIf
    EndIf
  EndIf
  Goto SlowFetchM
EndMacro
CompilerEndIf

; After a native handler: it cannot trap and the PC it leaves is even (it
; was even when fetched, and a branch moves it by an even amount), so the
; only test left is whether it is still in RAM.
