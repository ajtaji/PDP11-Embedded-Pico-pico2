      EndASM
CompilerElse
      Reg(#CPU_EA) = EaWordM(Op & $3F)
CompilerEndIf
    MMReadWordSlot(@Reg(#CPU_SRC), Reg(#CPU_EA))
  EndIf
  ASM Uses Op, FlagNZ, GBase
    ldr r0, [r5, #88]
    sxth r0, r0
    mov.w r2, r5
    ubfx r1, r8, #6, #3
    lsls r1, r1, #2
    adds r3, r1, r2
    ldr r2, [r3]
    lsls r2, r2, #16
    mov r12, r2
    orr.w r1, r1, #4
    mov.w r2, r5
    adds r1, r1, r2
    ldr r2, [r1]
    orr.w r2, r2, r12
    cmp r0, #0
    beq __divm_zero
    cmp.w r0, #0xffffffff
    bne __divm_go
    cmp.w r2, #0x80000000
    beq __divm_over
__divm_go:
    sdiv r12, r2, r0
    mls r2, r12, r0, r2
    mov r0, r12
    sxth r0, r0
    cmp r0, r12
    bne __divm_over
    movs r4, #1
    cmp r0, #0
    bgt __divm_nz
    mov.w r4, #0x8000
    blt __divm_nz
    movs r4, #0
__divm_nz:
    uxth r0, r0
    str r0, [r3]
    uxth r2, r2
    str r2, [r1]
    movs r2, #0
    movs r0, #0
    b __divm_done
__divm_zero:
    mov.w r2, #0x8000
    mov.w r0, #0x10000
    b __divm_done
__divm_over:
    mov.w r2, #0x8000
    movs r0, #0
__divm_done:
    str r2, [r5, #104]
    str r0, [r5, #100]
