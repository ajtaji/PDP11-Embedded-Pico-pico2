        str r0, [r5, #84]
      EndASM
CompilerElse
      Reg(#CPU_EA) = EaWordM(Op & $3F)
CompilerEndIf
    MMReadWordSlot(@Reg(#CPU_SRC), Reg(#CPU_EA))
  EndIf
  Reg(#CPU_SRC) = Reg(#CPU_SRC) - ((Reg(#CPU_SRC) & $8000) << 1)
  Reg(#CPU_DST) = (Reg((Op >> 6) & 7) << 16) | Reg(((Op >> 6) & 7) | 1)   ; the 32-bit dividend
