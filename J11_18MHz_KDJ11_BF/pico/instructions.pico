    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionBVS_1024:          ; 102400   entries $10A0-$10BF   V = 1
  ;name = "BVS"
  If FlagV
    Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BVS " + ;name)
