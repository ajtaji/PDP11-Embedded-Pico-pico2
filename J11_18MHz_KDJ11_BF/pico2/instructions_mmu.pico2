;-NEG-------------------------------------------------------------------
InstructionNEG_0054M:          ; 0054DD   entries $0160-$0167
  PcOutM()
  ;name = "NEG"
  If (Op & $38) = 0
    Res = (0 - Reg(Op & 7)) & $FFFF      ; 100000 negates to itself
    Reg(Op & 7) = Res
  Else
    Ea = EaWordM(Op & $3F)
    MMReadWord(Res, Ea)
    Res = (0 - Res) & $FFFF
    MMWriteWord(Ea, Res)
  EndIf
  FlagV = 0
  If Res = $8000
    FlagV = $8000
  EndIf
  FlagC = $10000
  If Res = 0
    FlagC = 0
  EndIf
  FlagNZ = Res
  ; ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("NEG " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSyncedM()

