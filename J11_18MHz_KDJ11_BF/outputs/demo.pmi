; ======================================================================
;  demo.pmi - the demo display and tone generator on the board:
;  the same two invented devices as the desktop program's (desktop/
;  machine_demo.pbi), for the compiler's PDP-11 demo (demo/), shown on the
;  configured RGB565 panel by either Pico family.
;
;  Built only by tools/demo_build.py (#DEMO_DEV = 1): it includes this file,
;  the shared panel/audio modules, and the demo as the built-in tape. The Unix
;  firmware (#DEMO_DEV = 0) has none of it - the CPU device hooks compile
;  to nothing.
;
;  THE REGISTERS (octal; agreed with the compiler's PDP-11 back end)
;    DISPLAY  320 x 200, 4 bits a pixel, 160 bytes a row (32000 bytes);
;             pixel x of a row is in byte x/2, the LOW nibble the even x
;      164000 DPCSR   bit 0 ENABLE, bit 6 IE (frame interrupt), bit 7 FRAME
;                     (set at each 60 Hz vertical blank; writing 1 clears it)
;      164002 DPBASE  the framebuffer's physical address in 64-byte units
;      164004 DPSCRY  the framebuffer row shown on the top line, 0-199
;      164040-164076  DPPAL0-15, 12-bit RGB (0x0RGB)
;      the frame interrupt: vector 320, BR4
;    SOUND    voice n at 164100 + 10n: +0 FREQ (Hz), +2 VOL (0-15),
;             +4 WAVE (0 square, 1 triangle, 2 saw, 3 noise);
;             164140 SNDVOL (0-15), 164142 SNDCSR bit 0 ENABLE
;
;  THE CORES. Core 0 (the PDP-11) reads and writes the registers through
;  IoRead / IoWrite / WriteByte, and DevService calls DdPoll, which sets
;  FRAME at each new vertical blank and takes the frame interrupt. Core 1
;  keeps the 60 Hz (DdTick, in DvStep) and sends the picture to the panel
;  a strip of 4 or 8 rows at a time by DMA (DvStep), straight from the PDP-11's
;  memory, while the next strip is drawn.
; ======================================================================

; ---- the device (core 0, but for DdSeq) ------------------------------------
#DEMO_W = 320
#DEMO_H = 200
#DEMO_ROW = 160                          ; bytes a row
#DEMO_FRAME_US = 16667

Global DdCsr.i, DdBase.i, DdScroll.i
Global Dim DdPal.i(16)
Global DdSeq.i                           ; vertical blanks counted by core 1 (DdTick)
Global DdSeen.i                          ; ... and acted on by core 0 (DdPoll)
Global DdNext.i                          ; core 1: Micros() of the next vertical blank
Global DdFrames.i                        ; frames seen by core 0
Global DdPalSeq.i                        ; palette writes: core 1 rebuilds its colour table when it changes

Procedure DdReset()
  Define i.i
  DdCsr = 0 : DdBase = $100 : DdScroll = 0 : OutputMaster = 15 : OutputEnabled = 0
  Restore DdEgaPal
  For i = 0 To 15
    Read.u DdPal(i)
  Next
  For i = 0 To 3
    OutputFreq(i) = 0 : OutputVol(i) = 0 : OutputWave(i) = 0
  Next
  DdPalSeq = DdPalSeq + 1
  IntReq = IntReq & ~#INT_DEMO
EndProcedure

ProcedureRAM.i DdRead(a.i)
  Define r.i
  r = (a - #DEMO_BASE) & $7E
  If r = 0
    ProcedureReturn DdCsr & $C1
  ElseIf r = 2
    ProcedureReturn DdBase
  ElseIf r = 4
    ProcedureReturn DdScroll
  ElseIf r >= $20 And r <= $3E
    ProcedureReturn DdPal((r - $20) >> 1)
  ElseIf r >= $40 And r <= $5E
    If (r & 7) = 0
      ProcedureReturn OutputFreq((r - $40) >> 3)
    ElseIf (r & 7) = 2
      ProcedureReturn OutputVol((r - $40) >> 3)
    ElseIf (r & 7) = 4
      ProcedureReturn OutputWave((r - $40) >> 3)
    EndIf
  ElseIf r = $60
    ProcedureReturn OutputMaster
  ElseIf r = $62
    ProcedureReturn OutputEnabled
  EndIf
  ProcedureReturn 0
EndProcedure

ProcedureRAM DdWrite(a.i, v.i)
  Define r.i
  Define wasIe.i
  r = (a - #DEMO_BASE) & $7E
  v = v & $FFFF
  If r = 0
    wasIe = DdCsr & $40
    If v & $80                           ; FRAME: write 1 to clear
      DdCsr = DdCsr & ~$80
      IntReq = IntReq & ~#INT_DEMO
    EndIf
    DdCsr = (DdCsr & $80) | (v & $41)
    If (DdCsr & $40) = 0
      IntReq = IntReq & ~#INT_DEMO
    ElseIf wasIe = 0 And (DdCsr & $80) <> 0
      IntReq = IntReq | #INT_DEMO
      IntCheck()
    EndIf
  ElseIf r = 2
    DdBase = v
  ElseIf r = 4
    DdScroll = v % #DEMO_H
  ElseIf r >= $20 And r <= $3E
    DdPal((r - $20) >> 1) = v & $FFF
    DdPalSeq = DdPalSeq + 1
  ElseIf r >= $40 And r <= $5E
    If (r & 7) = 0
      OutputFreq((r - $40) >> 3) = v
    ElseIf (r & 7) = 2
      OutputVol((r - $40) >> 3) = v & 15
    ElseIf (r & 7) = 4
      OutputWave((r - $40) >> 3) = v & 3
    EndIf
  ElseIf r = $60
    OutputMaster = v & 15
  ElseIf r = $62
    OutputEnabled = v & 1
  EndIf
EndProcedure

; A byte write is a write of that byte into the register, the other byte kept.
ProcedureRAM DdWriteByte(a.i, v.i)
  Define w.i
  w = DdRead(a & $FFFE)
  If a & 1
    DdWrite(a & $FFFE, (w & $FF) | ((v & $FF) << 8))
  Else
    DdWrite(a, (w & $FF00) | (v & $FF))
  EndIf
EndProcedure

; Core 0, from DevService: FRAME at a new vertical blank, the request while
; enabled, and the interrupt taken when it is the only one asked for (with
; others, DevService's own chain takes theirs first: BR4 and above).
ProcedureRAM DdPoll()
  If DdSeq <> DdSeen
    DdSeen = DdSeq
    DdFrames = DdFrames + 1
    DdCsr = DdCsr | $80
    If DdCsr & $40
      IntReq = IntReq | #INT_DEMO
    EndIf
  EndIf
  If IntReq = #INT_DEMO
    If (PswHigh & $E0) < $80
      Waiting = 0
      IntReq = 0
      TakeTrap(#VEC_DEMO)
      TakeStackTrap()
    EndIf
  EndIf
EndProcedure

; ---- the panel (core 1) ------------------------------------------------------
; Controller-independent 320x200 picture, centered on any supported panel.
CompilerIf #STAT_CHIP = 2040
#DV_STRIP_ROWS = 4                       ; smaller DMA buffers on the Pico W
CompilerElse
#DV_STRIP_ROWS = 8
CompilerEndIf
#DV_STRIPS = #DEMO_H / #DV_STRIP_ROWS
#DV_STRIP_PAIRS = #DEMO_W * #DV_STRIP_ROWS / 2

Global Dim DvStrip.i(2 * #DV_STRIP_PAIRS)               ; two strips; pixel pairs, the first pixel in the low half
Global Dim DvPair.i(256)                 ; a framebuffer byte -> its two pixels as RGB565
Global DvPalSeq.i = -1                   ; the palette DvPair was made from
Global DvStripNo.i = -1                  ; the strip in flight, -1 none (no frame being sent)
Global DvSeqShown.i                      ; the vertical blank the last frame started at
Global DvShown.i, DvError.i, DvOn.i

Procedure DvBegin()
  DvOn = PanelReady
EndProcedure

ProcedureRAM.i DvRgb565(c.i)
  Define r.i
  Define g.i
  Define b.i
  r = (c >> 8) & 15
  g = (c >> 4) & 15
  b = c & 15
  ProcedureReturn (((r << 1) | (r >> 3)) << 11) | (((g << 2) | (g >> 2)) << 5) | ((b << 1) | (b >> 3))
EndProcedure

Global Dim DvCol.i(16)                   ; the palette as RGB565 (DvPairs)

ProcedureRAM DvPairs()
  Define i.i
  For i = 0 To 15
    DvCol(i) = DvRgb565(DdPal(i))
  Next
  For i = 0 To 255
    DvPair(i) = DvCol(i & 15) | (DvCol(i >> 4) << 16)
  Next
EndProcedure

; Strip s (DV_STRIP_ROWS rows of the picture) into buffer buf, from the PDP-11's
; memory as DPBASE and DPSCRY say; black while ENABLE is off or where the
; framebuffer is not in the memory.
ProcedureRAM DvRender(s.i, buf.i)
  Define r.i
  Define x.i
  Define row.i
  Define src.i
  Define dst.i
  Define base.i
  base = (DdBase << 6) & $3FFFFF
  dst = buf
  For r = 0 To #DV_STRIP_ROWS - 1
    row = (s * #DV_STRIP_ROWS + r + DdScroll) % #DEMO_H
    src = base + row * #DEMO_ROW
    If (DdCsr & 1) = 0 Or src + #DEMO_ROW > #RAM_BYTES
      For x = 0 To #DEMO_ROW - 1
        PokeL(dst, 0) : dst = dst + 4
      Next
    Else
      src = @Mem(0) + src
      For x = 0 To #DEMO_ROW - 1
        PokeL(dst, DvPair(PeekA(src + x))) : dst = dst + 4
      Next
    EndIf
  Next
EndProcedure

 ; Core 1 owns both terminal and graphics DMA. The current transfer must
; finish before ownership changes, and before a strip buffer is reused.
ProcedureRAM DvStep()
  Define now.i, buf.i, active.i
  now = Micros()
  If now - DdNext >= 0
    DdNext = DdNext + #DEMO_FRAME_US
    If now - DdNext >= 0 : DdNext = now + #DEMO_FRAME_US : EndIf
    DdSeq = DdSeq + 1
  EndIf
  OutputAudioPoll()
  If DvOn = 0 : ProcedureReturn : EndIf
  active = DdCsr & 1
  If active = 0
    If OutputGraphics
      If PanelPoll() = 0 : ProcedureReturn : EndIf
      OutputGraphics = 0 : DvStripNo = -1
    EndIf
    ProcedureReturn
  EndIf
  If OutputGraphics = 0
    If PanelPoll() = 0 : ProcedureReturn : EndIf
    OutputGraphics = 1 : DvStripNo = -1
  EndIf
  If DvStripNo < 0
    If DdSeq = DvSeqShown : ProcedureReturn : EndIf
    DvSeqShown = DdSeq
    If DvPalSeq <> DdPalSeq : DvPalSeq = DdPalSeq : DvPairs() : EndIf
    DvRender(0, @DvStrip(0))
    If PanelStart((PanelWidth - #DEMO_W) / 2, (PanelHeight - #DEMO_H) / 2, #DEMO_W, #DV_STRIP_ROWS, @DvStrip(0)) = 0
      DvError = DvError + 1 : ProcedureReturn
    EndIf
    DvRender(1, @DvStrip(#DV_STRIP_PAIRS)) : DvStripNo = 0
    ProcedureReturn
  EndIf
  If PanelPoll() = 0 : ProcedureReturn : EndIf
  DvStripNo = DvStripNo + 1
  If DvStripNo >= #DV_STRIPS
    DvStripNo = -1 : DvShown = DvShown + 1 : ProcedureReturn
  EndIf
  buf = @DvStrip(0) + (DvStripNo & 1) * #DV_STRIP_PAIRS * 4
  If PanelStart((PanelWidth - #DEMO_W) / 2, (PanelHeight - #DEMO_H) / 2 + DvStripNo * #DV_STRIP_ROWS, #DEMO_W, #DV_STRIP_ROWS, buf) = 0
    DvError = DvError + 1 : DvStripNo = -1 : ProcedureReturn
  EndIf
  If DvStripNo + 1 < #DV_STRIPS
    DvRender(DvStripNo + 1, @DvStrip(0) + ((DvStripNo + 1) & 1) * #DV_STRIP_PAIRS * 4)
  EndIf
EndProcedure

DataSection
  DdEgaPal:
  Data.u $000, $00A, $0A0, $0AA, $A00, $A0A, $A50, $AAA, $555, $55F, $5F5, $5FF, $F55, $F5F, $FF5, $FFF
EndDataSection
