    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionBCS_1034:          ; 103400   entries $10E0-$10FF   C = 1 (also BLO)
  ;name = "BCS"
  If FlagC
    Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BCS " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
