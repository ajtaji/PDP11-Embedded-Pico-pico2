;-SUB-------------------------------------------------------------------
InstructionSUB_16M:            ; 16SSDD   entries $1C00-$1DFF
  PcOutM()
  ;name = "SUB"
  MMSrcWord()
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = Dst - Src
    Reg(Op & 7) = Res & $FFFF
  Else
    Ea = EaWordM(Op & $3F)
