    adds r0, r0, r1
    uxth r0, r0
    mov r9, r0
__br_br_nt:
  EndASM
CompilerIf #ASM_TAILS = 1
  ASM Uses PC, RunLeft, Op, GBase
    subs.w r11, r11, #1
    beq __tm77_e
    mov r0, r9
    ldr r1, [r5, #56]
    cmp r0, r1
    blt __tm77_s
    ldr r1, [r5, #60]
    cmp r0, r1
    bge __tm77_s
    str r0, [r5, #68]
    ldr r1, [r5, #64]
    ldrh r2, [r1, r0]
    mov r8, r2
    adds.w r9, r9, #2
    lsrs r2, r2, #3
    lsls r2, r2, #2
    ldr r1, =global_optablem
    ldr r1, [r1, r2]
    bx r1
__tm77_e:
    b __ul_cpurunm_runendm
__tm77_s:
    b __ul_cpurunm_slowfetchm
  EndASM
CompilerElse
  NextNativeM()
CompilerEndIf
CompilerEndIf
