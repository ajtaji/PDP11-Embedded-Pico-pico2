    EndIf
  Else
    EaFast()
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerIf #ASM_MEM = 1
  ASM
    ldr r0, =global_ea
    ldr r0, [r0]
    bl __t1_readword
