+	if(fp->f_flag&FPIPE) {
+		if(m==FREAD) readp(fp); else writep(fp);
+	} else {
+		if(m==FREAD) readi(fp->f_inode); else writei(fp->f_inode);
+		dpadd(fp->f_offset, u.u_arg[1]-u.u_count);
+	}
