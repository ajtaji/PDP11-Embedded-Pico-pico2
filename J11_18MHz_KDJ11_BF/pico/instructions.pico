; ======================================================================
;  JUMPS AND SUBROUTINES
; ======================================================================

;-JMP-------------------------------------------------------------------
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- FAST THUMB1 ----
CompilerEndIf
; ---- END FAST THUMB1 ----
; ---- END UNMAPPED ONLY ----
InstructionJMP_0001:          ; 0001DD   entries $0008-$000F
  PcOut()
  ;name = "JMP"
  If (Op & $38) = 0
    TrapVector = #VEC_BUS                ; JMP to a register is illegal
  Else
    Reg(7) = EaWord(Op & $3F)
  EndIf
  ; ClockCycles = ClockCycles + #J11_T_JUMP
  ;disassembly("JMP " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSynced()

;-JSR-------------------------------------------------------------------
InstructionJSR_004:           ; 004RDD   entries $0100-$013F
; ---- UNMAPPED ONLY: native calls (tools/asm_call_gen.py) ----
CompilerIf #ASM_FAST = 1
  ASM Uses Op, PC
    ldr r2, =global_reg
    ldr r0, [r2, #24]
    subs r0, #2
    uxth r0, r0
    cmp r0, #255
    bls __call_jsr_slow
    lsrs r3, r0, #1
    bcs __call_jsr_slow
    ldr r3, =#RAM_BYTES
    cmp r0, r3
    bhs __call_jsr_slow
    mov r12, r0
    mov r0, r8
    movs r1, #63
    ands r0, r1
    cmp r0, #31
    beq __call_jsr_fetch
    movs r1, #56
    ands r0, r1
    cmp r0, #8
    beq __call_jsr_indirect
    cmp r0, #48
    bne __call_jsr_slow
__call_jsr_fetch:
    mov r0, r9
    lsrs r1, r0, #1
    bcs __call_jsr_slow
    ldr r1, =#RAM_BYTES
    cmp r0, r1
    bhs __call_jsr_slow
    ldr r1, =global_mem
    ldrh r3, [r1, r0]
    adds r0, #2
    uxth r0, r0
    mov r1, r8
    lsls r1, r1, #26
    lsrs r1, r1, #29
    cmp r1, #3
    beq __call_jsr_commit
    b __call_jsr_base
__call_jsr_indirect:
    movs r3, #0
    mov r0, r9
__call_jsr_base:
    mov r1, r8
    lsls r1, r1, #29
    lsrs r1, r1, #27
    cmp r1, #28
    beq __call_jsr_pc
    ldr r1, [r2, r1]
    b __call_jsr_target
__call_jsr_pc:
    movs r1, r0
__call_jsr_target:
    adds r3, r3, r1
    uxth r3, r3
__call_jsr_commit:
    str r0, [r2, #28]
    ldr r1, =global_ea
    str r3, [r1]
    mov r1, r8
    lsls r1, r1, #23
    lsrs r1, r1, #29
    lsls r1, r1, #2
    ldr r3, [r2, r1]
    mov r0, r12
    str r0, [r2, #24]
    mov r12, r1
    ldr r1, =global_mem
    strh r3, [r1, r0]
    ldr r3, [r2, #28]
    mov r1, r12
    str r3, [r2, r1]
    ldr r1, =global_ea
    ldr r0, [r1]
    str r0, [r2, #28]
  EndASM
  NextSynced()
  ASM
__call_jsr_slow:
  EndASM
CompilerEndIf
InstructionJSR_004Ref:
; ---- END UNMAPPED ONLY ----
  PcOut()
  ;name = "JSR"
  If (Op & $38) = 0
    TrapVector = #VEC_BUS                ; JSR to a register is illegal
  Else
    EaFast()
    Push(Reg((Op >> 6) & 7))
    Reg((Op >> 6) & 7) = Reg(7)
    Reg(7) = Ea
  EndIf
  ; ClockCycles = ClockCycles + #J11_T_JUMP
  ;disassembly("JSR " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSynced()

;-RTS-------------------------------------------------------------------
InstructionRTS_00020:         ; 00020R   entry $0010
; ---- UNMAPPED ONLY: native calls (tools/asm_call_gen.py) ----
CompilerIf #ASM_FAST = 1
  ASM Uses Op
    ldr r2, =global_reg
    ldr r0, [r2, #24]
    lsrs r3, r0, #1
    bcs __call_rts_slow
    ldr r3, =#RAM_BYTES
    cmp r0, r3
    bhs __call_rts_slow
    mov r1, r8
    lsls r1, r1, #29
    lsrs r1, r1, #27
    ldr r3, [r2, r1]
    str r3, [r2, #28]
    ldr r3, =global_mem
    ldrh r3, [r3, r0]
    adds r0, #2
    uxth r0, r0
    str r0, [r2, #24]
    str r3, [r2, r1]
  EndASM
  NextSynced()
  ASM
__call_rts_slow:
  EndASM
CompilerEndIf
InstructionRTS_00020Ref:
; ---- END UNMAPPED ONLY ----
  PcOut()
  ;name = "RTS"
  Reg(7) = Reg(Op & 7)
  Reg(Op & 7) = Pop()
  ; ClockCycles = ClockCycles + #J11_T_JUMP
  ;disassembly("RTS " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSynced()

;-MARK------------------------------------------------------------------
InstructionMARK_0064:         ; 0064NN   entries $01A0-$01A7
  PcOut()
  ;name = "MARK"
  Reg(6) = (Reg(7) + ((Op & $3F) << 1)) & $FFFF
  Reg(7) = Reg(5)
  Reg(5) = Pop()
  ; ClockCycles = ClockCycles + #J11_T_JUMP
  ;disassembly("MARK " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSynced()

;-SOB-------------------------------------------------------------------
InstructionSOB_077:           ; 077RNN   entries $0FC0-$0FFF
  ;name = "SOB"                          ; R0-R6 only: SOB R7 is below
  Res = (Reg((Op >> 6) & 7) - 1) & $FFFF
  Reg((Op >> 6) & 7) = Res
  If Res
    PC = (PC - ((Op & $3F) << 1)) & $FFFF
  EndIf
  ; ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("SOB " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  NextNative()

InstructionSOB_077_PC:        ; 0777NN   SOB R7 - legal, if strange: it counts the PC down
  PcOut()
  Reg(7) = (Reg(7) - 1) & $FFFF
  If Reg(7)
    Reg(7) = (Reg(7) - ((Op & $3F) << 1)) & $FFFF
  EndIf
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSynced()

; ======================================================================
;  EIS - MUL, DIV, ASH, ASHC, XOR. Register in bits 8-6, operand in 5-0.
; ======================================================================

;-MUL-------------------------------------------------------------------
InstructionMUL_070:           ; 070RSS   entries $0E00-$0E3F
  PcOut()
  ;name = "MUL"
  If (Op & $38) = 0
    Src = Reg(Op & 7)
  Else
    EaFast()
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerIf #ASM_MEM = 1
  ASM
    ldr r0, =global_ea
    ldr r0, [r0]
    bl __t1_readword
    ldr r1, =global_src
    str r0, [r1]
  EndASM
CompilerElse
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
    MReadWord(Src, Ea)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerEndIf
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  EndIf
  Src = Src - ((Src & $8000) << 1)                        ; signed 16
  Dst = Reg((Op >> 6) & 7)
  Dst = Dst - ((Dst & $8000) << 1)
  Res = Src * Dst                                          ; fits in 32 bits
  If Op & $40                                              ; odd register: low word only
    Reg((Op >> 6) & 7) = Res & $FFFF
  Else
    Reg((Op >> 6) & 7) = (Res >> 16) & $FFFF
    Reg(((Op >> 6) & 7) | 1) = Res & $FFFF
  EndIf
  SetNZ(Bool(Res < 0), Bool(Res = 0))
  FlagV = 0
  FlagC = 0
  If Res < -32768 Or Res > 32767
    FlagC = $10000
  EndIf
  ; ClockCycles = ClockCycles + #J11_T_EIS
  ;disassembly("MUL " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSynced()

;-DIV-------------------------------------------------------------------
InstructionDIV_071:           ; 071RSS   entries $0E40-$0E7F
  PcOut()
  ;name = "DIV"
  If (Op & $38) = 0
    Src = Reg(Op & 7)
  Else
    EaFast()
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerIf #ASM_MEM = 1
  ASM
    ldr r0, =global_ea
    ldr r0, [r0]
    bl __t1_readword
    ldr r1, =global_src
    str r0, [r1]
  EndASM
CompilerElse
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
    MReadWord(Src, Ea)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerEndIf
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  EndIf
  Src = Src - ((Src & $8000) << 1)
  Dst = (Reg((Op >> 6) & 7) << 16) | Reg(((Op >> 6) & 7) | 1)   ; the 32-bit dividend
  If Src = 0
    FlagV = $8000
    FlagC = $10000
  ElseIf Src = -1 And Dst = $80000000
    FlagV = $8000
    FlagC = 0
  Else
    Res = Dst / Src
    If Res < -32768 Or Res > 32767
      FlagV = $8000                                            ; registers unchanged
      FlagC = 0
    Else
      Reg((Op >> 6) & 7) = Res & $FFFF
      Reg(((Op >> 6) & 7) | 1) = (Dst - Res * Src) & $FFFF
      SetNZ(Bool(Res < 0), Bool(Res = 0))
      FlagV = 0
      FlagC = 0
    EndIf
  EndIf
  ; ClockCycles = ClockCycles + #J11_T_EIS
  ;disassembly("DIV " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSynced()

;-ASH-------------------------------------------------------------------
; Shift count is the low six bits of the source, signed: positive shifts
; left, negative shifts right. A loop - rare instruction, correct first.
InstructionASH_072:           ; 072RSS   entries $0E80-$0EBF
  PcOut()
  ;name = "ASH"
  If (Op & $38) = 0
    Src = Reg(Op & 7) & $3F
  Else
    EaFast()
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerIf #ASM_MEM = 1
  ASM
    ldr r0, =global_ea
    ldr r0, [r0]
    bl __t1_readword
    ldr r1, =global_src
    str r0, [r1]
  EndASM
CompilerElse
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
    MReadWord(Src, Ea)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerEndIf
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
    Src = Src & $3F
  EndIf
  Res = Reg((Op >> 6) & 7)
  FlagV = 0
  If Src & $20
    Src = 64 - Src                                         ; right by this many
    While Src > 0
      FlagC = Res << 16
      Res = (Res >> 1) | (Res & $8000)
      Src = Src - 1
    Wend
  Else
    While Src > 0
      FlagC = Res << 1
      Tmp = (Res << 1) & $FFFF
      If (Tmp ! Res) & $8000
        FlagV = $8000                                          ; the sign changed
      EndIf
      Res = Tmp
      Src = Src - 1
    Wend
  EndIf
  Reg((Op >> 6) & 7) = Res
  FlagNZ = Res
  ; ClockCycles = ClockCycles + #J11_T_EIS
  ;disassembly("ASH " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSynced()

;-ASHC------------------------------------------------------------------
InstructionASHC_073:          ; 073RSS   entries $0EC0-$0EFF
  PcOut()
  ;name = "ASHC"
  If (Op & $38) = 0
    Src = Reg(Op & 7) & $3F
  Else
    EaFast()
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerIf #ASM_MEM = 1
  ASM
    ldr r0, =global_ea
    ldr r0, [r0]
    bl __t1_readword
    ldr r1, =global_src
    str r0, [r1]
  EndASM
CompilerElse
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
    MReadWord(Src, Ea)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerEndIf
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
    Src = Src & $3F
  EndIf
  Res = (Reg((Op >> 6) & 7) << 16) | Reg(((Op >> 6) & 7) | 1)
  FlagV = 0
  If Src & $20
    Src = 64 - Src
    While Src > 0
      FlagC = Res << 16
      Res = Res >> 1                                       ; arithmetic on a 32-bit .i
      Src = Src - 1
    Wend
  Else
    While Src > 0
      FlagC = Res >> 15
      Tmp = Res << 1
      If (Tmp ! Res) & $80000000
        FlagV = $8000
      EndIf
      Res = Tmp
      Src = Src - 1
    Wend
  EndIf
  Reg((Op >> 6) & 7) = (Res >> 16) & $FFFF
  Reg(((Op >> 6) & 7) | 1) = Res & $FFFF
  SetNZ(Bool(Res < 0), Bool(Res = 0))
  ; ClockCycles = ClockCycles + #J11_T_EIS
  ;disassembly("ASHC " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSynced()

;-XOR-------------------------------------------------------------------
InstructionXOR_074:           ; 074RDD   entries $0F00-$0F3F
  PcOut()
  ;name = "XOR"
  If (Op & $38) = 0
    Res = Reg(Op & 7) ! Reg((Op >> 6) & 7)
    Reg(Op & 7) = Res
  Else
    EaFast()
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerIf #ASM_MEM = 1
  ASM Uses Res
    ldr r0, =global_ea
    ldr r0, [r0]
    bl __t1_readword
    mov r10, r0
  EndASM
CompilerElse
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
    MReadWord(Res, Ea)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerEndIf
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
    Res = Res ! Reg((Op >> 6) & 7)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerIf #ASM_MEM = 1
  ASM Uses Res
    ldr r0, =global_ea
    ldr r0, [r0]
    mov r1, r10
    bl __t1_writeword
  EndASM
CompilerElse
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
    MWriteWord(Ea, Res)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerEndIf
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  EndIf
  FlagNZ = Res
  FlagV = 0
  ; ClockCycles = ClockCycles + #J11_T_EIS
  ;disassembly("XOR " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSynced()

; ======================================================================
;  TRAPS AND MACHINE CONTROL
; ======================================================================
InstructionEMT_104:           ; 104000-104377   entries $1100-$111F
  PcOut()
  ;name = "EMT"
  TrapVector = #VEC_EMT
  ; ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("EMT " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSynced()

InstructionTRAP_1044:         ; 104400-104777   entries $1120-$113F
  PcOut()
  ;name = "TRAP"
  TrapVector = #VEC_TRAP
  ; ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("TRAP " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSynced()

InstructionHALT_000000:       ; entry $0000, sub-decoded
  PcOut()
  ;name = "HALT"
  If (PswHigh & $C000) <> 0 Or MaintTrap <> 0   ; HALT outside kernel mode (or with the maintenance
    CpuErr = CpuErr | #CPUE_HALT                ; register's trap option) does not halt: it traps
    TrapVector = #VEC_BUS                       ; through 4, CPU error register bit 7 (cpu.pico,
    Goto SlowTail                               ; THE CPU ERROR AND MAINTENANCE REGISTERS)
  EndIf
  Halted = 1
  Reg(7) = (Reg(7) - 2) & $FFFF          ; PC stays on the HALT, as on the console
  PC = Reg(7)
  ; ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("HALT")
  Goto SlowTail                         ; Halted is only looked at there

InstructionWAIT_000001:       ; entry $0000, sub-decoded
  ;name = "WAIT"
  Waiting = 1                            ; RunEnd holds the processor until an interrupt
  CpuEventIn(1)
  ; ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("WAIT")
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  NextNative()

InstructionRTI_000002:        ; entry $0000, sub-decoded
  PcOut()
  ;name = "RTI"
  Reg(7) = Pop()
  Src = Pop()
  If PswHigh & $C000                     ; outside kernel: bits 15-11 can only be set,
    Src = (Src & $F81F) | (PswHigh & $F8E0)   ; and the priority stays
  EndIf
  PswSet(Src)
  If PswHigh & $10                       ; RTI loading T: trace straight after it
    TraceArm = 1
  EndIf
  ; ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("RTI")
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSynced()

InstructionBPT_000003:        ; entry $0000, sub-decoded
  PcOut()
  ;name = "BPT"
  TrapVector = #VEC_BPT
  ; ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("BPT")
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSynced()

InstructionIOT_000004:        ; entry $0000, sub-decoded
  PcOut()
  ;name = "IOT"
  TrapVector = #VEC_IOT
  ; ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("IOT")
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSynced()

InstructionRESET_000005:      ; entry $0000, sub-decoded
  ;name = "RESET"
  DevReset()                             ; the bus INIT
  ; ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("RESET")
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  NextNative()

InstructionRTT_000006:        ; entry $0000, sub-decoded (the T bit: StartWindow in cpu)
  PcOut()
  ;name = "RTT"
  Reg(7) = Pop()
  Src = Pop()
  If PswHigh & $C000                     ; outside kernel: bits 15-11 can only be set,
    Src = (Src & $F81F) | (PswHigh & $F8E0)   ; and the priority stays
  EndIf
  PswSet(Src)
  ; ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("RTT")
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSynced()

InstructionMFPT_000007:       ; entry $0000, sub-decoded
  ;name = "MFPT"
  Reg(0) = 5                             ; processor type 5 = J-11
  ; ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("MFPT")
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  NextNative()

InstructionSPL_00023:         ; 00023N   entry $0013
  ;name = "SPL"
  If (PswHigh & $C000) = 0                ; kernel only; a no-op in other modes
    PswHigh = (PswHigh & $FF1F) | ((Op & 7) << 5)
    IntCheck()                           ; a lower priority may let a request in
  EndIf
  ; ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("SPL")
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  NextNative()

; 000240-000277: bit 4 = set (1) or clear (0), bits 3-0 = N Z V C.
; 000240 is NOP, 000257 CCC, 000277 SCC.
InstructionCC_00024:          ; 00024x-00027x   entries $0014-$0017
  ;name = "CLx/SEx"
  ; Each named flag is set or cleared where it lives (see SPEED in cpu),
  ; with no PswGet/PswSet round trip: these are frequent (CLC, SEC, NOP,
  ; CCC...). The priority is untouched, so the only part of PswSet that
  ; could matter - IntCheck - is still called whenever a request waits.
  If Op & 1
    If Op & $10
      FlagC = $10000
    Else
      FlagC = 0
    EndIf
  EndIf
  If Op & 2
    If Op & $10
      FlagV = $8000
    Else
      FlagV = 0
    EndIf
  EndIf
  If Op & $C                             ; N or Z named: rebuild the lazy pair
    Tmp = 0
    If FlagNZ & $18000
      Tmp = 8
    EndIf
    If (FlagNZ & $FFFF) = 0
      Tmp = Tmp | 4
    EndIf
    If Op & $10
      Tmp = Tmp | (Op & $C)
    Else
      Tmp = Tmp & ~(Op & $C)
    EndIf
    SetNZ((Tmp >> 3) & 1, (Tmp >> 2) & 1)
  EndIf
  If IntReq
    IntCheck()
  EndIf
  ; ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("CC")
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  NextNative()

CompilerIf #FP11 = 1
InstructionFP:                ; 17xxxx: the FPJ11 (fp11.pico, FpExec)
  PcOut()
  FpExec()
  NextSynced()
CompilerEndIf

InstructionReserved:          ; every opcode this model does not execute
  PcOut()
  ;name = "reserved"
  TrapVector = #VEC_RESV
  ; ClockCycles = ClockCycles + #J11_T_TRAP
  ;disassembly(".WORD")
  ; ---- next instruction (THE TAIL, top of file) ----
  NextSynced()

; ======================================================================
;  000000-000007 - the one entry that still holds several instructions.
;  HALT, WAIT, RTI, BPT, IOT, RESET, RTT and MFPT differ only in the low
;  three bits, below the table's index. They are rare, so a short If chain
;  tells them apart - no second table.
; ======================================================================
InstructionGroup0_0000:       ; 000000-000007   entry $0000
  Tmp = Op & 7
  If Tmp = 0
    Goto InstructionHALT_000000
  ElseIf Tmp = 1
    Goto InstructionWAIT_000001
  ElseIf Tmp = 2
    Goto InstructionRTI_000002
  ElseIf Tmp = 3
    Goto InstructionBPT_000003
  ElseIf Tmp = 4
    Goto InstructionIOT_000004
  ElseIf Tmp = 5
    Goto InstructionRESET_000005
  ElseIf Tmp = 6
    Goto InstructionRTT_000006
  Else
    Goto InstructionMFPT_000007
  EndIf


; ======================================================================
;  REGISTER FAST PATHS. The commonest forms - both operands in registers,
;  or a single operand in a register - get handlers with no mode test, no
;  operand-helper call and no Reg(7) traffic. The Pico's table is indexed
;  by Op >> 3, so an entry knows both addressing modes and the source
;  register but NOT the destination register: each fast path first sends
;  a destination of R7 back to the general handler, which keeps the PC
;  right. The table sends a source of R7 there too. (The Pico 2 has one
;  entry per opcode and needs no such test.) Anything not listed here
;  (ADC, SBC, the byte rotates...) is correct through its general handler.
; ======================================================================

InstructionMOV_01_RR:               ; 01SD, both operands in registers
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- FAST THUMB1 ----
CompilerIf #ASM_FAST = 1
  ASM Uses PC, RunLeft, Op, FlagNZ
    mov r0, r8
    movs r1, #7
    ands r0, r1
    cmp r0, #7
    beq __ul_cpurun_instructionmov_01
    lsls r0, r0, #2
    ldr r1, =global_reg
    adds r1, r1, r0
    mov r0, r8
    lsls r0, r0, #23
    lsrs r0, r0, #29
    lsls r0, r0, #2
    ldr r2, =global_reg
    ldr r0, [r2, r0]
    ldr r2, [r1]
    str r0, [r1]
    movs r4, r0
    movs r0, #0
    ldr r1, =global_flagv
    str r0, [r1]
    mov r1, r11
    subs r1, #1
    mov r11, r1
    beq __ul_cpurun_runend
    mov r0, r9
    ldr r1, =#RAM_BYTES
    cmp r0, r1
    bhs __ul_cpurun_slowfetch
    ldr r1, =global_mem
    ldrh r2, [r1, r0]
    mov r8, r2
    adds r0, #2
    mov r9, r0
    lsrs r2, r2, #3
    lsls r2, r2, #2
    ldr r1, =global_optable
    ldr r1, [r1, r2]
    bx r1
  EndASM
CompilerEndIf
CompilerIf #ASM_FAST = 0 Or #DISK_BACKEND = 0
InstructionMOV_01_RRRef:
; ---- END FAST THUMB1 ----
; ---- END UNMAPPED ONLY ----
  If (Op & 7) = 7                        ; the destination is the PC:
    Goto InstructionMOV_01       ; the general handler
  EndIf
  ;name = "MOV Rs,Rd"
  Src = Reg((Op >> 6) & 7)
  Reg(Op & 7) = Src
  FlagNZ = Src
  FlagV = 0
  ; ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("MOV " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  NextNative()

; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- FAST THUMB1 ----
CompilerEndIf
; ---- END FAST THUMB1 ----
; ---- END UNMAPPED ONLY ----
InstructionCMP_02_RR:               ; 02SD, both operands in registers
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- FAST THUMB1 ----
CompilerIf #ASM_FAST = 1
  ASM Uses PC, RunLeft, Op, FlagNZ, Res
    mov r0, r8
    movs r1, #7
    ands r0, r1
    cmp r0, #7
    beq __ul_cpurun_instructioncmp_02
    lsls r0, r0, #2
    ldr r1, =global_reg
    adds r1, r1, r0
    mov r0, r8
    lsls r0, r0, #23
    lsrs r0, r0, #29
    lsls r0, r0, #2
    ldr r2, =global_reg
    ldr r0, [r2, r0]
    ldr r2, [r1]
    subs r3, r0, r2
    mov r10, r3
    ldr r1, =global_flagc
    str r3, [r1]
    eors r2, r0
    eors r0, r3
    ands r0, r2
    ldr r1, =global_flagv
    str r0, [r1]
    uxth r4, r3
    mov r1, r11
    subs r1, #1
    mov r11, r1
    beq __ul_cpurun_runend
    mov r0, r9
    ldr r1, =#RAM_BYTES
    cmp r0, r1
    bhs __ul_cpurun_slowfetch
    ldr r1, =global_mem
    ldrh r2, [r1, r0]
    mov r8, r2
    adds r0, #2
    mov r9, r0
    lsrs r2, r2, #3
    lsls r2, r2, #2
    ldr r1, =global_optable
    ldr r1, [r1, r2]
    bx r1
  EndASM
CompilerEndIf
CompilerIf #ASM_FAST = 0 Or #DISK_BACKEND = 0
InstructionCMP_02_RRRef:
; ---- END FAST THUMB1 ----
; ---- END UNMAPPED ONLY ----
  If (Op & 7) = 7                        ; the destination is the PC:
    Goto InstructionCMP_02       ; the general handler
  EndIf
  ;name = "CMP Rs,Rd"
  Src = Reg((Op >> 6) & 7)
  Res = Src - Reg(Op & 7)
  FlagC = Res                            ; the borrow is bit 16
  FlagNZ = Res & $FFFF
  FlagV = (Src ! (Src - Res)) & (Src ! Res)   ; bit 15; Src - Res is Rd
  ; ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("CMP " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  NextNative()

; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- FAST THUMB1 ----
CompilerEndIf
; ---- END FAST THUMB1 ----
; ---- END UNMAPPED ONLY ----
InstructionBIT_03_RR:               ; 03SD, both operands in registers
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- FAST THUMB1 ----
CompilerIf #ASM_FAST = 1
  ASM Uses PC, RunLeft, Op, FlagNZ
    mov r0, r8
    movs r1, #7
    ands r0, r1
    cmp r0, #7
    beq __ul_cpurun_instructionbit_03
    lsls r0, r0, #2
    ldr r1, =global_reg
    adds r1, r1, r0
    mov r0, r8
    lsls r0, r0, #23
    lsrs r0, r0, #29
    lsls r0, r0, #2
    ldr r2, =global_reg
    ldr r0, [r2, r0]
    ldr r2, [r1]
    ands r0, r2
    movs r4, r0
    movs r0, #0
    ldr r1, =global_flagv
    str r0, [r1]
    mov r1, r11
    subs r1, #1
    mov r11, r1
    beq __ul_cpurun_runend
    mov r0, r9
    ldr r1, =#RAM_BYTES
    cmp r0, r1
    bhs __ul_cpurun_slowfetch
    ldr r1, =global_mem
    ldrh r2, [r1, r0]
    mov r8, r2
    adds r0, #2
    mov r9, r0
    lsrs r2, r2, #3
    lsls r2, r2, #2
    ldr r1, =global_optable
    ldr r1, [r1, r2]
    bx r1
  EndASM
CompilerEndIf
CompilerIf #ASM_FAST = 0 Or #DISK_BACKEND = 0
InstructionBIT_03_RRRef:
; ---- END FAST THUMB1 ----
; ---- END UNMAPPED ONLY ----
  If (Op & 7) = 7                        ; the destination is the PC:
    Goto InstructionBIT_03       ; the general handler
  EndIf
  ;name = "BIT Rs,Rd"
  FlagNZ = Reg((Op >> 6) & 7) & Reg(Op & 7)
  FlagV = 0
  ; ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BIT " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  NextNative()

; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- FAST THUMB1 ----
CompilerEndIf
; ---- END FAST THUMB1 ----
; ---- END UNMAPPED ONLY ----
InstructionBIC_04_RR:               ; 04SD, both operands in registers
