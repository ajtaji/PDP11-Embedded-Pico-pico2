;  run --empty again (or git checkout this file) before building Unix images.
;  Tape:   (none - tapes arrive over the serial port)
;  Loads:  0 words in 0 runs; starts at 000001; switches 000000
; ======================================================================
#TAPE_START = $0001          ; 000001
#TAPE_SWITCHES = $0000       ; 000000
#FEED_LEN = 0                 ; the desk probe's feed (tape_ladder.py --dump)

DataSection
TapeName:
  Data.u 115, 101, 114, 105, 97, 108, 0
TapeRuns:
