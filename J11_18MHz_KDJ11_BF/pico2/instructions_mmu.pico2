; 000240-000277: bit 4 = set (1) or clear (0), bits 3-0 = N Z V C.
; 000240 is NOP, 000257 CCC, 000277 SCC.
InstructionCC_00024M:          ; 00024x-00027x   entries $0014-$0017
  ;name = "CLx/SEx"
  ; Each named flag is set or cleared where it lives (see SPEED in cpu),
  ; with no PswGet/PswSet round trip: these are frequent (CLC, SEC, NOP,
  ; CCC...). The priority is untouched, so the only part of PswSet that
  ; could matter - IntCheck - is still called whenever a request waits.
  If Op & 1
    If Op & $10
      Reg(#CPU_FLAGC) = $10000
    Else
      Reg(#CPU_FLAGC) = 0
    EndIf
  EndIf
  If Op & 2
    If Op & $10
      Reg(#CPU_FLAGV) = $8000
    Else
      Reg(#CPU_FLAGV) = 0
    EndIf
  EndIf
  If Op & $C                             ; N or Z named: rebuild the lazy pair
    Reg(#CPU_TMP) = 0
    If FlagNZ & $18000
      Reg(#CPU_TMP) = 8
    EndIf
    If (FlagNZ & $FFFF) = 0
      Reg(#CPU_TMP) = Reg(#CPU_TMP) | 4
    EndIf
    If Op & $10
      Reg(#CPU_TMP) = Reg(#CPU_TMP) | (Op & $C)
    Else
      Reg(#CPU_TMP) = Reg(#CPU_TMP) & ~(Op & $C)
    EndIf
    SetNZ((Reg(#CPU_TMP) >> 3) & 1, (Reg(#CPU_TMP) >> 2) & 1)
  EndIf
  If IntReq
    IntCheck()
  EndIf
  ; ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("CC")
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
CompilerIf #ASM_TAILS = 1
  ASM Uses PC, RunLeft, Op, GBase
    subs.w r11, r11, #1
    beq __tm132_e
    mov r0, r9
    ldr r1, [r5, #56]
    cmp r0, r1
    blt __tm132_s
    ldr r1, [r5, #60]
    cmp r0, r1
    bge __tm132_s
    str r0, [r5, #68]
    ldr r1, [r5, #64]
    ldrh r2, [r1, r0]
    mov r8, r2
    adds.w r9, r9, #2
    lsrs r2, r2, #3
    lsls r2, r2, #2
    ldr r1, =global_optablem
    ldr r1, [r1, r2]
    bx r1
__tm132_e:
    b __ul_cpurunm_runendm
__tm132_s:
    b __ul_cpurunm_slowfetchm
  EndASM
CompilerElse
  NextNativeM()
CompilerEndIf

