      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionBHI_1010:          ; 101000   entries $1040-$105F   C = 0 and Z = 0
  ;name = "BHI"
  If FlagC = 0 And (FlagNZ & $FFFF) <> 0
    BranchTaken()
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BHI " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionBLOS_1014:         ; 101400   entries $1060-$107F   C = 1 or Z = 1
  ;name = "BLOS"
  If FlagC = 1 Or (FlagNZ & $FFFF) = 0
    BranchTaken()
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BLOS " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionBVC_1020:          ; 102000   entries $1080-$109F   V = 0
  ;name = "BVC"
  If FlagV = 0
    Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BVC " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
