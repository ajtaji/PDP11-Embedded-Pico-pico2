    mov r9, r0
    ldr r1, [r5, #96]
    cmp r1, #0
    bne __tm185_t
    subs.w r11, r11, #1
    beq __tm185_e
    lsls r1, r0, #31
    bne __tm185_s
    ldr r1, [r5, #56]
    cmp r0, r1
    blt __tm185_s
    ldr r1, [r5, #60]
    cmp r0, r1
    bge __tm185_s
    str r0, [r5, #68]
    ldr r1, [r5, #64]
    ldrh r2, [r1, r0]
    mov r8, r2
    adds.w r9, r9, #2
    lsrs r2, r2, #3
    lsls r2, r2, #2
    ldr r1, =global_optablem
    ldr r1, [r1, r2]
    bx r1
