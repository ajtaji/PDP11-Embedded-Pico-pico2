; ======================================================================
;  asm_check.pico - holds the Pico's assembly fast paths to their plain
;  versions, on the board (Raspberry Pi Pico / Pico W, the unmapped loop).
;
;  tools/asm_mov_gen.py gives the seven MOV handlers by addressing mode an
;  assembly fast path in front of their Basic bodies, and the handlers'
;  operand addresses a subroutine, __eaw1, in place of EaWord (cpu.pico,
;  #ASM_MOV and #ASM_EA). This program holds both to the plain code:
;    * MOV: a random machine state - registers, memory, the condition codes,
;      the stack pointer either side of the yellow limit - and one MOV of a
;      random form at a random PC, run twice from that state through CpuRun:
;      once with the table at the assembly entry and once at the plain one
;      (MovAsm / MovRef). R0-R7, N Z V C, the pending trap, the CPU error
;      register, the yellow stack flag, the PSW and every word of the 56 KB
;      (against a shadow copy) are compared.
;    * __eaw1 against EaWord's own body (EaWordRef) on random specs and
;      registers: the address, R0-R7, EaReg, Tmp, Adr, the trap, the CPU error
;      register and the yellow flag.
;  Both ways through the assembly are counted: "fast" (the plain code never
;  ran) and "slow" (an early exit to it). Addresses stay below the I/O page,
;  whose device registers have side effects a second run would see.
;  Every round prints
;      ASMCHECK mov checks=N fast=F slow=S failures=X PASS
;      ASMCHECK ea checks=N fast=F slow=S failures=X PASS
;  (FAIL with the first difference). A deliberately broken fast path must
;  make it FAIL; these did, each within the first round (2026-10-19): the
;  (R)+ step of MOV (R)+,R 4 for 2, MOV X(R),R setting N/Z from the PC, and
;  __eaw1's X(R) PC step 4 for 2. One did not, rightly: MOV R,-(R) leaving
;  for the Basic below 001000 instead of 000400 only sends more cases to the
;  Basic, whose answer is the same.
;      PureMetalForge.exe --compile asm_check.pico -t rp2040 -o asm_check.bin --port COMn
; ======================================================================
#DISK_BACKEND = 0
#DISK_FLASH_MODEL = 0
#DISK_READ_ONLY = 0
#DESK_PROBE = 0
EnableExplicit
XIncludeFile "RP2040/Lib/clocks.pico"
XIncludeFile "RP2040/Lib/timer.pico"
XIncludeFile "RP2040/Lib/uart.pico"
XIncludeFile "RP2040/Lib/usb_serial.pico"
XIncludeFile "RP2040/Lib/safety.pico"
XIncludeFile "cpu.pico"
XIncludeFile "instructions_mmu.pico"
XIncludeFile "instructions.pico"
XIncludeFile "disk.pico"
XIncludeFile "kw11.pico"
XIncludeFile "rk11.pico"

#CLOCK_KHZ = 200000
#ROUND = 2000
#PAIRS = 7
#NOT_RUN = $5A5A1234                    ; Src before a run: still there = the plain body never ran

Global Seed.i = $1234567
; The entire 56 KB is shadowed in two contiguous ranges. This also compares
; valid trap stacks at every RAM address. Improved SRAM packing makes the
; complete mirror fit beside the two dispatch tables and native code.
#LO_WORDS = $6E00                       ; 000000-155777; top 1 KB follows
#HI_WORD = $6E00                        ; 156000-157777
#HI_WORDS = #RAM_WORDS - #HI_WORD
Global Dim ShadowLo.u(#LO_WORDS)
Global Dim ShadowHi.u(#HI_WORDS)
Global MidSum.i, DbgA.i, DbgB.i, DbgShown.i
Global Dim PairSm.i(#PAIRS)
Global Dim PairDm.i(#PAIRS)
#SNAP = 40
Global Dim SnapA.i(#SNAP)
Global Dim SnapB.i(#SNAP)
Global Dim DiffA.i(16)                   ; up to 8 (word index, value) pairs
Global Dim DiffB.i(16)
Global NDiffA.i, NDiffB.i
Global Checks.i, Fast.i, Slow.i, Failures.i, FirstBad.i, FirstOp.i, FirstField.i
Global TPc.i, TOp.i, TPair.i, TRs.i, TRd.i
Global Dim SReg.i(8)
Global Dim SAlt.i(6)
Global Dim SBank.i(4)
Global GK.i, GS.i, GD.i, GN.i, GI.i, GK2.i, GN2.i
Global Osm.i, Odm.i, Oi.i, Ow.i, Ofield.i, Mr.i, Mt0.i
Global SNZ.i, SV.i, SC.i

; FlagNZ lives in r4 (cpu.pico2): only these two small procedures name it, so no
; procedure here that saves r4 in its frame touches it (PM1126).
Procedure.i NzRead()
  ProcedureReturn FlagNZ
EndProcedure

Procedure NzWrite(v.i)
  FlagNZ = v
EndProcedure

Procedure Ch(c.i)
  UsbSerialWrite(c)
EndProcedure

Procedure Say(*s.i)
  Define p.i, c.i
  p = *s
  c = PeekA(p) & 255
  While c <> 0
    Ch(c)
    p = p + 1
    c = PeekA(p) & 255
  Wend
EndProcedure

Procedure Num(v.i)
  Define n.i, p.i
  n = v
  If n < 0
    Ch(45)
    n = 0 - n
  EndIf
  p = 1
  While n / p >= 10
    p = p * 10
  Wend
  While p > 0
    Ch(48 + (n / p) % 10)
    p = p / 10
  Wend
EndProcedure

Procedure Oct(v.i)
  Define k.i
  For k = 15 To 0 Step -3
    Ch(48 + ((v >> k) & 7))
  Next
EndProcedure

Procedure Eol()
  Ch(13)
  Ch(10)
  UsbSerialFlush()
  UsbSerialTask()
EndProcedure

Procedure Pump(us.i)
  Define t0.i
  t0 = Micros()
  While (Micros() - t0) < us
    UsbSerialTask()
    SafetyPet()
  Wend
EndProcedure

Procedure.i Rnd()                       ; xorshift32
  Seed = Seed ! (Seed << 13)
  Seed = Seed ! ((Seed >> 17) & $7FFF)
  Seed = Seed ! (Seed << 5)
  ProcedureReturn Seed & $7FFFFFFF
EndProcedure

Procedure.i RndN(n.i)
  ProcedureReturn Rnd() % n
EndProcedure

; An even address in RAM (below the I/O page).
Procedure.i RndRam()
  If RndN(8) = 0
    ProcedureReturn #HI_WORD * 2 + RndN(#HI_WORDS) * 2
  EndIf
  ProcedureReturn RndN(#LO_WORDS) * 2
EndProcedure

Procedure.i MidSumNow()
  Define i.i, h.i
  h = 0
  For i = #LO_WORDS To #HI_WORD - 1
    h = h * 31 + Mem(i)
  Next
  ProcedureReturn h
EndProcedure

; A register value: mostly an even RAM address (the fast path; +2 so that a
; -(R) lands in RAM too), sometimes odd, either side of the yellow stack
; limit, the top of RAM, or anything below the I/O page.
Procedure.i RndReg()
  Define k.i
  k = RndN(12)
  If k < 7
    ProcedureReturn RndRam() + 2
  ElseIf k = 7
    ProcedureReturn RndRam() + 1
  ElseIf k = 8
    ProcedureReturn $FC + RndN(8) * 2   ; 000374-000412
  ElseIf k = 9
    ProcedureReturn #RAM_BYTES - 4 + RndN(3) * 2   ; 157774-160000: a step onto the I/O page
  EndIf
  ProcedureReturn RndRam() + RndN(2)
EndProcedure

Procedure SaveState()
  For GI = 0 To 7 : SReg(GI) = Reg(GI) : Next
  For GI = 0 To 5 : SAlt(GI) = RegAlt(GI) : Next
  For GI = 0 To 3 : SBank(GI) = StackBank(GI) : Next
  SNZ = NzRead() : SV = FlagV : SC = FlagC
EndProcedure

; Back to the saved state exactly: a trap in the run before may have changed
; the mode, the register set and the stack pointers.
Procedure LoadState()
  PswSet($00E0)                         ; kernel, register set 0, priority 7
  For GI = 0 To 7 : Reg(GI) = SReg(GI) : Next
  For GI = 0 To 5 : RegAlt(GI) = SAlt(GI) : Next
  For GI = 0 To 3 : StackBank(GI) = SBank(GI) : Next
  NzWrite(SNZ) : FlagV = SV : FlagC = SC
  MmuOn = 0
  TrapVector = 0 : PswLate = 0 : AbortPsw = 0 : StackYellow = 0 : CpuErr = 0
  TraceArm = 0 : Halted = 0 : Waiting = 0 : IntReq = 0 : DevActive = 0 : Dl11TxRdy = 1
  Src = #NOT_RUN
EndProcedure

; Run the one instruction at TPc through entry target.
Procedure RunOnce(target.Label)
  OpTable(TOp >> 3) = target
  Reg(7) = TPc
  GK = CpuRun(1)
EndProcedure

; What the run left, into *snap / *diff / *nd (no locals: see NzRead)
Procedure Snap(*snap.i, *diff.i, *nd.i)
  GS = *snap : GD = *diff : GN = *nd
  PokeL(GS, GK)
  For GI = 0 To 7 : PokeL(GS + 4 + GI * 4, Reg(GI)) : Next
  PokeL(GS + 36, NzRead())
  PokeL(GS + 40, FlagV & $8000)
  PokeL(GS + 44, FlagC & $10000)
  PokeL(GS + 48, TrapVector)
  PokeL(GS + 52, CpuErr)
  PokeL(GS + 56, StackYellow)
  PokeL(GS + 60, PswGet())
  PokeL(GS + 64, Halted)
  PokeL(GS + 68, Bool(Src = #NOT_RUN))
  GN2 = 0
  For GI = 0 To #LO_WORDS - 1
    If Mem(GI) <> ShadowLo(GI)
      If GN2 < 8
        PokeL(GD + GN2 * 8, GI)
        PokeL(GD + GN2 * 8 + 4, Mem(GI))
      EndIf
      GN2 = GN2 + 1
      Mem(GI) = ShadowLo(GI)
    EndIf
  Next
  For GI = 0 To #HI_WORDS - 1
    If Mem(#HI_WORD + GI) <> ShadowHi(GI)
      If GN2 < 8
        PokeL(GD + GN2 * 8, #HI_WORD + GI)
        PokeL(GD + GN2 * 8 + 4, Mem(#HI_WORD + GI))
      EndIf
      GN2 = GN2 + 1
      Mem(#HI_WORD + GI) = ShadowHi(GI)
    EndIf
  Next
  PokeL(GN, GN2)
EndProcedure

#SNAP_FAST = 17                         ; the index of the "plain code never ran" word

Procedure OneCheck()
  PswSet($00E0)
  TPair = RndN(#PAIRS)
  Osm = PairSm(TPair)
  Odm = PairDm(TPair)
  For Oi = 0 To 6 : Reg(Oi) = RndReg() : Next
  TPc = RndN(#LO_WORDS - 4) * 2
  TRs = RndN(8)
  If Osm = 2 And TRs = 7
    TRs = RndN(7)                       ; (R7)+ is an immediate: the table sends it elsewhere
  EndIf
  TRd = RndN(8)
  TOp = $1000 | (Osm << 9) | (TRs << 6) | (Odm << 3) | TRd
  Mem(TPc >> 1) = TOp
  Mem((TPc + 2) >> 1) = RndN($10000)    ; an index word
  If RndN(4) <> 0 Or Odm = 6            ; ... mostly one that lands in the shadowed RAM (always for a store):
    Oi = TRs                            ; the indexed register is the source's, or (0,6) the
    If Odm = 6                          ; destination's; X(PC) counts from the PC after the word
      Oi = TRd
    EndIf
    If Oi = 7
      Mem((TPc + 2) >> 1) = (RndRam() - (TPc + 4)) & $FFFF
    Else
      Mem((TPc + 2) >> 1) = (RndRam() - Reg(Oi)) & $FFFF
    EndIf
  EndIf
  For Oi = 0 To #LO_WORDS - 1
    ShadowLo(Oi) = Mem(Oi)
  Next
  For Oi = 0 To #HI_WORDS - 1
    ShadowHi(Oi) = Mem(#HI_WORD + Oi)
  Next
  NzWrite(Rnd()) : FlagV = Rnd() : FlagC = Rnd()
  For Oi = 1 To 3                       ; a trap into another mode pushes on that mode's stack:
    StackBank(Oi) = RndRam() + 8        ; keep it in the shadowed RAM too
  Next
  SaveState()
  LoadState()
  RunOnce(MovAsm(TPair))
  DbgA = MidSumNow()
  Snap(@SnapA(0), @DiffA(0), @NDiffA)
  LoadState()
  RunOnce(MovRef(TPair))
  DbgB = MidSumNow()
  Snap(@SnapB(0), @DiffB(0), @NDiffB)
  If (DbgA <> MidSum Or DbgB <> MidSum) And DbgShown < 3
    DbgShown = DbgShown + 1
    Say("MID op=") : Oct(TOp) : Say(" pc=") : Oct(TPc) : Say(" A=") : Num(Bool(DbgA <> MidSum)) : Say(" B=") : Num(Bool(DbgB <> MidSum))
    Say(" trap=") : Num(SnapB(12)) : Say(" regs")
    For Oi = 0 To 6 : Say(" ") : Oct(SReg(Oi)) : Next
    Say(" idx=") : Oct(ShadowLo((TPc + 2) >> 1)) : Say(" nd=") : Num(NDiffA) : Say(" d0=") : Oct(DiffA(0) * 2) : Say(" banks")
    For Oi = 0 To 3 : Say(" ") : Oct(SBank(Oi)) : Next
    Eol()
  EndIf
  OpTable(TOp >> 3) = MovAsm(TPair)     ; the table as built
  Checks = Checks + 1
  If SnapA(#SNAP_FAST) = 1
    Fast = Fast + 1
  Else
    Slow = Slow + 1
  EndIf
  Ofield = -1
  For Oi = 0 To #SNAP_FAST - 1
    If SnapA(Oi) <> SnapB(Oi) And Ofield < 0
      Ofield = Oi
    EndIf
  Next
  If Ofield < 0 And NDiffA <> NDiffB
    Ofield = 30
  EndIf
  If Ofield < 0
    For Oi = 0 To 15
      If Oi < NDiffA * 2 And DiffA(Oi) <> DiffB(Oi) And Ofield < 0
        Ofield = 31
      EndIf
    Next
  EndIf
  If Ofield < 0 And (DbgA <> MidSum Or DbgB <> MidSum)
    Ofield = 32                         ; a store outside the shadowed RAM, by either run
  EndIf
  MidSum = DbgB
  If Ofield >= 0
    Failures = Failures + 1
    If FirstBad < 0
      FirstBad = Checks
      FirstOp = TOp
      FirstField = Ofield
      Say("FIRST FAIL op=") : Oct(TOp) : Say(" pc=") : Oct(TPc) : Say(" field=") : Num(Ofield)
      If Ofield < #SNAP_FAST
        Say(" asm=") : Num(SnapA(Ofield)) : Say(" plain=") : Num(SnapB(Ofield))
      EndIf
      Say(" fast=") : Num(SnapA(#SNAP_FAST)) : Eol()
    EndIf
  EndIf
EndProcedure

Global FKind.i, FChecks.i, FFailures.i, FFirst.i = -1, FFirstOp.i, FFirstField.i, FFast.i, FSlow.i
Global Dim FCode.i(26)
Global FAsmTarget.Label, FRefTarget.Label
Procedure FastOne()
  PswSet($00E0)
  FKind = RndN(26)
  For Oi = 0 To 6 : Reg(Oi) = RndReg() : Next
  TPc = RndN(#LO_WORDS - 4) * 2
  If FKind < 15
    TOp = FCode(FKind) | RndN(256)
  ElseIf FKind < 22
    TOp = FCode(FKind) | (RndN(8) << 6) | RndN(8)
  Else
    TOp = FCode(FKind) | RndN(8)
  EndIf
  Mem(TPc >> 1) = TOp
  For Oi = 0 To #LO_WORDS - 1
    ShadowLo(Oi) = Mem(Oi)
  Next
  For Oi = 0 To #HI_WORDS - 1
    ShadowHi(Oi) = Mem(#HI_WORD + Oi)
  Next
  NzWrite(Rnd()) : FlagV = Rnd() : FlagC = Rnd()
  For Oi = 1 To 3                       ; a trap into another mode pushes on that mode's stack:
    StackBank(Oi) = RndRam() + 8        ; keep it in the shadowed RAM too
  Next
  FAsmTarget = FastAsm(FKind)
  FRefTarget = FastRef(FKind)
  ; RR entries are installed only for source R0-R6. Exercise a PC source
  ; through its real generic dispatch entry, preserving that table contract.
  If FKind >= 15 And FKind < 22 And ((TOp >> 6) & 7) = 7
    FAsmTarget = OpTable(TOp >> 3)
    FRefTarget = FAsmTarget
  EndIf
  SaveState()
  LoadState()
  RunOnce(FAsmTarget)
  DbgA = MidSumNow()
  Snap(@SnapA(0), @DiffA(0), @NDiffA)
  LoadState()
  RunOnce(FRefTarget)
  DbgB = MidSumNow()
  Snap(@SnapB(0), @DiffB(0), @NDiffB)
  If (DbgA <> MidSum Or DbgB <> MidSum) And DbgShown < 3
    DbgShown = DbgShown + 1
    Say("MID op=") : Oct(TOp) : Say(" pc=") : Oct(TPc) : Say(" A=") : Num(Bool(DbgA <> MidSum)) : Say(" B=") : Num(Bool(DbgB <> MidSum))
    Say(" trap=") : Num(SnapB(12)) : Say(" regs")
    For Oi = 0 To 6 : Say(" ") : Oct(SReg(Oi)) : Next
    Say(" idx=") : Oct(ShadowLo((TPc + 2) >> 1)) : Say(" nd=") : Num(NDiffA) : Say(" d0=") : Oct(DiffA(0) * 2) : Say(" banks")
    For Oi = 0 To 3 : Say(" ") : Oct(SBank(Oi)) : Next
    Eol()
  EndIf
  OpTable(TOp >> 3) = FAsmTarget     ; the table as built
  FChecks = FChecks + 1
  If SnapA(#SNAP_FAST) = 1
    FFast = FFast + 1
  Else
    FSlow = FSlow + 1
  EndIf
  Ofield = -1
  For Oi = 0 To #SNAP_FAST - 1
    If SnapA(Oi) <> SnapB(Oi) And Ofield < 0
      Ofield = Oi
    EndIf
  Next
  If Ofield < 0 And NDiffA <> NDiffB
    Ofield = 30
  EndIf
  If Ofield < 0
    For Oi = 0 To 15
      If Oi < NDiffA * 2 And DiffA(Oi) <> DiffB(Oi) And Ofield < 0
        Ofield = 31
      EndIf
    Next
  EndIf
  If Ofield < 0 And (DbgA <> MidSum Or DbgB <> MidSum)
    Ofield = 32                         ; a store outside the shadowed RAM, by either run
  EndIf
  MidSum = DbgB
  If Ofield >= 0
    FFailures = FFailures + 1
    If FFirst < 0
      FFirst = FChecks
      FFirstOp = TOp
      FFirstField = Ofield
      Say("FAST FIRST FAIL op=") : Oct(TOp) : Say(" pc=") : Oct(TPc) : Say(" field=") : Num(Ofield)
      If Ofield < #SNAP_FAST
        Say(" asm=") : Num(SnapA(Ofield)) : Say(" plain=") : Num(SnapB(Ofield))
      EndIf
      Say(" fast=") : Num(SnapA(#SNAP_FAST)) : Eol()
    EndIf
  EndIf
EndProcedure

Global IKind.i, IChecks.i, IFailures.i, IFirst.i = -1, IFirstOp.i, IFirstField.i, IFast.i, ISlow.i
Global Dim ICode.i(8)
Procedure IFormOne()
  PswSet($00E0)
  IKind = RndN(8)
  For Oi = 0 To 6 : Reg(Oi) = RndReg() : Next
  TPc = RndN(#LO_WORDS - 4) * 2
  TOp = ICode(IKind) | RndN(8)
  Mem(TPc >> 1) = TOp
  Mem((TPc + 2) >> 1) = RndN($10000)
  Oi = RndRam()
  If RndN(3) = 0 : Oi = Oi | 1 : EndIf
  If (TOp & 7) = 7
    Mem((TPc + 4) >> 1) = (Oi - (TPc + 6)) & $FFFF
  Else
    Mem((TPc + 4) >> 1) = (Oi - Reg(TOp & 7)) & $FFFF
  EndIf
  For Oi = 0 To #LO_WORDS - 1
    ShadowLo(Oi) = Mem(Oi)
  Next
  For Oi = 0 To #HI_WORDS - 1
    ShadowHi(Oi) = Mem(#HI_WORD + Oi)
  Next
  NzWrite(Rnd()) : FlagV = Rnd() : FlagC = Rnd()
  For Oi = 1 To 3                       ; a trap into another mode pushes on that mode's stack:
    StackBank(Oi) = RndRam() + 8        ; keep it in the shadowed RAM too
  Next
  SaveState()
  LoadState()
  RunOnce(FastAsm(26 + IKind))
  DbgA = MidSumNow()
  Snap(@SnapA(0), @DiffA(0), @NDiffA)
  LoadState()
  RunOnce(FastRef(26 + IKind))
  DbgB = MidSumNow()
  Snap(@SnapB(0), @DiffB(0), @NDiffB)
  If (DbgA <> MidSum Or DbgB <> MidSum) And DbgShown < 3
    DbgShown = DbgShown + 1
    Say("MID op=") : Oct(TOp) : Say(" pc=") : Oct(TPc) : Say(" A=") : Num(Bool(DbgA <> MidSum)) : Say(" B=") : Num(Bool(DbgB <> MidSum))
    Say(" trap=") : Num(SnapB(12)) : Say(" regs")
    For Oi = 0 To 6 : Say(" ") : Oct(SReg(Oi)) : Next
    Say(" idx=") : Oct(ShadowLo((TPc + 2) >> 1)) : Say(" nd=") : Num(NDiffA) : Say(" d0=") : Oct(DiffA(0) * 2) : Say(" banks")
    For Oi = 0 To 3 : Say(" ") : Oct(SBank(Oi)) : Next
    Eol()
  EndIf
  OpTable(TOp >> 3) = FastAsm(26 + IKind)     ; the table as built
  IChecks = IChecks + 1
  If SnapA(#SNAP_FAST) = 1
    IFast = IFast + 1
  Else
    ISlow = ISlow + 1
  EndIf
  Ofield = -1
  For Oi = 0 To #SNAP_FAST - 1
    If SnapA(Oi) <> SnapB(Oi) And Ofield < 0
      Ofield = Oi
    EndIf
  Next
  If Ofield < 0 And NDiffA <> NDiffB
    Ofield = 30
  EndIf
  If Ofield < 0
    For Oi = 0 To 15
      If Oi < NDiffA * 2 And DiffA(Oi) <> DiffB(Oi) And Ofield < 0
        Ofield = 31
      EndIf
    Next
  EndIf
  If Ofield < 0 And (DbgA <> MidSum Or DbgB <> MidSum)
    Ofield = 32                         ; a store outside the shadowed RAM, by either run
  EndIf
  MidSum = DbgB
  If Ofield >= 0
    IFailures = IFailures + 1
    If IFirst < 0
      IFirst = IChecks
      IFirstOp = TOp
      IFirstField = Ofield
      Say("IMX FIRST FAIL op=") : Oct(TOp) : Say(" pc=") : Oct(TPc) : Say(" field=") : Num(Ofield)
      If Ofield < #SNAP_FAST
        Say(" asm=") : Num(SnapA(Ofield)) : Say(" plain=") : Num(SnapB(Ofield))
      EndIf
      Say(" fast=") : Num(SnapA(#SNAP_FAST)) : Eol()
    EndIf
  EndIf
EndProcedure

Global SKind.i, SChecks.i, SFailures.i, SFirst.i = -1, SFirstOp.i, SFirstField.i, SFast.i, SSlow.i
Global Dim SCode.i(6)
Procedure SFormOne()
  PswSet($00E0)
  SKind = RndN(6)
  For Oi = 0 To 6 : Reg(Oi) = RndReg() : Next
  TPc = RndN(#LO_WORDS - 4) * 2
  TOp = SCode(SKind) | RndN(8)
  Mem(TPc >> 1) = TOp
  Oi = RndRam()
  If RndN(3) = 0 : Oi = Oi | 1 : EndIf
  If (TOp & 7) = 7
    Mem((TPc + 2) >> 1) = (Oi - (TPc + 4)) & $FFFF
  Else
    Mem((TPc + 2) >> 1) = (Oi - Reg(TOp & 7)) & $FFFF
  EndIf
  For Oi = 0 To #LO_WORDS - 1
    ShadowLo(Oi) = Mem(Oi)
  Next
  For Oi = 0 To #HI_WORDS - 1
    ShadowHi(Oi) = Mem(#HI_WORD + Oi)
  Next
  NzWrite(Rnd()) : FlagV = Rnd() : FlagC = Rnd()
  For Oi = 1 To 3                       ; a trap into another mode pushes on that mode's stack:
    StackBank(Oi) = RndRam() + 8        ; keep it in the shadowed RAM too
  Next
  SaveState()
  LoadState()
  RunOnce(FastAsm(34 + SKind))
  DbgA = MidSumNow()
  Snap(@SnapA(0), @DiffA(0), @NDiffA)
  LoadState()
  RunOnce(FastRef(34 + SKind))
  DbgB = MidSumNow()
  Snap(@SnapB(0), @DiffB(0), @NDiffB)
  If (DbgA <> MidSum Or DbgB <> MidSum) And DbgShown < 3
    DbgShown = DbgShown + 1
    Say("MID op=") : Oct(TOp) : Say(" pc=") : Oct(TPc) : Say(" A=") : Num(Bool(DbgA <> MidSum)) : Say(" B=") : Num(Bool(DbgB <> MidSum))
    Say(" trap=") : Num(SnapB(12)) : Say(" regs")
    For Oi = 0 To 6 : Say(" ") : Oct(SReg(Oi)) : Next
    Say(" idx=") : Oct(ShadowLo((TPc + 2) >> 1)) : Say(" nd=") : Num(NDiffA) : Say(" d0=") : Oct(DiffA(0) * 2) : Say(" banks")
    For Oi = 0 To 3 : Say(" ") : Oct(SBank(Oi)) : Next
    Eol()
  EndIf
  OpTable(TOp >> 3) = FastAsm(34 + SKind)     ; the table as built
  SChecks = SChecks + 1
  If SnapA(#SNAP_FAST) = 1
    SFast = SFast + 1
  Else
    SSlow = SSlow + 1
  EndIf
  Ofield = -1
  For Oi = 0 To #SNAP_FAST - 1
    If SnapA(Oi) <> SnapB(Oi) And Ofield < 0
      Ofield = Oi
    EndIf
  Next
  If Ofield < 0 And NDiffA <> NDiffB
    Ofield = 30
  EndIf
  If Ofield < 0
    For Oi = 0 To 15
      If Oi < NDiffA * 2 And DiffA(Oi) <> DiffB(Oi) And Ofield < 0
        Ofield = 31
      EndIf
    Next
  EndIf
  If Ofield < 0 And (DbgA <> MidSum Or DbgB <> MidSum)
    Ofield = 32                         ; a store outside the shadowed RAM, by either run
  EndIf
  MidSum = DbgB
  If Ofield >= 0
    SFailures = SFailures + 1
    If SFirst < 0
      SFirst = SChecks
      SFirstOp = TOp
      SFirstField = Ofield
      Say("INDEXED FIRST FAIL op=") : Oct(TOp) : Say(" pc=") : Oct(TPc) : Say(" field=") : Num(Ofield)
      If Ofield < #SNAP_FAST
        Say(" asm=") : Num(SnapA(Ofield)) : Say(" plain=") : Num(SnapB(Ofield))
      EndIf
      Say(" fast=") : Num(SnapA(#SNAP_FAST)) : Eol()
    EndIf
  EndIf
EndProcedure

; ---- __eaw1, the handlers' operand address --------------------------------
; The plain body, as a procedure of its own (cpu.pico, EaWordBody).
ProcedureRAM.i EaWordRef(spec.i)
  EaWordBody()
EndProcedure

ProcedureRAM.i EaByteRef(spec.i)
  EaReg = spec & 7
  EaStep = 1
  If EaReg >= 6
    EaStep = 2
  EndIf
  Tmp = (spec >> 3) & 7
  If Tmp = 2
    Tmp = Reg(EaReg)
    Reg(EaReg) = (Tmp + EaStep) & $FFFF
    ProcedureReturn Tmp
  ElseIf Tmp = 4
    Reg(EaReg) = (Reg(EaReg) - EaStep) & $FFFF
    If EaReg = 6
      StackCheckFast()
    EndIf
    ProcedureReturn Reg(EaReg)
  EndIf
  ProcedureReturn EaWordRef(spec)
EndProcedure
Global EByte.i, EByteI.i

; __eaw1 as the handlers reach it: bl, spec in r0, the address back in r0.
; (lr is kept in r5 across the bl: __eaw1 keeps r4-r11.)
Procedure EaAsm()
  ASM
    push {r5}
    mov r5, lr
    ldr r0, =global_espec
    ldr r0, [r0]
    ldr r1, =global_ebyte
    ldr r1, [r1]
    cmp r1, #0
    beq __ea_word_test
    bl __eab1
    b __ea_test_done
__ea_word_test:
    bl __eaw1
__ea_test_done:
    ldr r1, =global_er
    str r0, [r1]
    mov lr, r5
    pop {r5}
  EndASM
EndProcedure

#EA_NONE = $77AA55                      ; EaSpec before a run: still there = __eaw1 never went on to EaWord
Global EaChecks.i, EaFast.i, EaSlow.i, EaFailures.i, EaFirst.i, EaFirstSpec.i, EaFirstField.i
Global ESpec.i, ER.i, Ei.i, EField.i
Global Dim EaA.i(24)
Global Dim EaB.i(24)

Procedure EaSnap(*s.i)
  GS = *s
  PokeL(GS, ER)
  For GI = 0 To 7 : PokeL(GS + 4 + GI * 4, Reg(GI)) : Next
  PokeL(GS + 36, EaReg)
  PokeL(GS + 40, Tmp)
  PokeL(GS + 44, Adr)
  PokeL(GS + 48, TrapVector)
  PokeL(GS + 52, CpuErr)
  PokeL(GS + 56, StackYellow)
  PokeL(GS + 60, AbortPsw)
  PokeL(GS + 64, Bool(EaSpec = #EA_NONE))
  PokeL(GS + 68, EaStep)
EndProcedure

Procedure.i PickMode()
  Define k.i
  k = RndN(4)
  If k = 0
    ProcedureReturn 6
  ElseIf k = 1
    ProcedureReturn 4
  ElseIf k = 2
    ProcedureReturn 2
  EndIf
  ProcedureReturn 1
EndProcedure

Procedure EaOne()
  PswSet($00E0)
  For Ei = 0 To 6 : Reg(Ei) = RndReg() : Next
  Reg(7) = RndReg()
  If RndN(2)
    Reg(7) = RndN(#LO_WORDS - 2) * 2
    Mem((Reg(7)) >> 1) = (RndRam() - Reg(RndN(7))) & $FFFF
  EndIf
  ESpec = RndN(64)
  If RndN(3) <> 0                       ; mostly the four modes the assembly does
    ESpec = (ESpec & 7) | (PickMode() << 3)
  EndIf
  NzWrite(Rnd()) : FlagV = Rnd() : FlagC = Rnd()
  SaveState()
  LoadState()
  ER = 0
  EaSpec = #EA_NONE
  EaAsm()
  EaSnap(@EaA(0))
  LoadState()
  EaSpec = #EA_NONE
  If EByte : ER = EaByteRef(ESpec) : Else : ER = EaWordRef(ESpec) : EndIf
  EaSnap(@EaB(0))
  EaChecks = EaChecks + 1
  If EaA(16) = 1
    EaFast = EaFast + 1
  Else
    EaSlow = EaSlow + 1
  EndIf
  EField = -1
  For Ei = 0 To 15
    If EaA(Ei) <> EaB(Ei) And EField < 0
      EField = Ei
    EndIf
  Next
  If EByte And EaA(17) <> EaB(17) : EField = 17 : EndIf
  If EField >= 0
    EaFailures = EaFailures + 1
    If EaFirst < 0
      EaFirst = EaChecks
      EaFirstSpec = ESpec
      EaFirstField = EField
      Say("EA FIRST FAIL spec=") : Oct(ESpec) : Say(" field=") : Num(EField)
      Say(" asm=") : Num(EaA(EField)) : Say(" plain=") : Num(EaB(EField)) : Say(" fast=") : Num(EaA(16)) : Eol()
    EndIf
  EndIf
EndProcedure

 ; Hold byte memory helpers to the two word lanes, including the untouched
; adjacent byte. Every RAM byte is eligible; values carry arbitrary high bits.
Global MbAdr.i, MbVal.i, MbKind.i, MbRes.i, MbOld.i, MbWant.i, MbChecks.i, MbFailures.i
Procedure MByteAsm()
  ASM
    push {r5}
    mov r5, lr
    ldr r0, =global_mbadr
    ldr r0, [r0]
    ldr r1, =global_mbval
    ldr r1, [r1]
    ldr r2, =global_mbkind
    ldr r2, [r2]
    cmp r2, #0
    beq __mb_read
    bl __t1_writebyte
    b __mb_done
__mb_read:
    bl __t1_readbyte
    ldr r1, =global_mbres
    str r0, [r1]
__mb_done:
    mov lr, r5
    pop {r5}
  EndASM
EndProcedure

Procedure MByteOne()
  MbAdr = RndN(#RAM_BYTES)
  MbVal = Rnd()
  MbOld = Mem(MbAdr >> 1)
  Mem(MbAdr >> 1) = MbOld
  MbKind = 0
  MByteAsm()
  MbWant = MbOld & $FF
  If MbAdr & 1 : MbWant = MbOld >> 8 : EndIf
  If MbRes <> MbWant : MbFailures = MbFailures + 1 : EndIf
  MbKind = 1
  MByteAsm()
  MbWant = (MbOld & $FF00) | (MbVal & $FF)
  If MbAdr & 1 : MbWant = (MbOld & $FF) | ((MbVal & $FF) << 8) : EndIf
  If Mem(MbAdr >> 1) <> MbWant : MbFailures = MbFailures + 1 : EndIf
  Mem(MbAdr >> 1) = MbOld
  MbChecks = MbChecks + 2
EndProcedure

Procedure Main()
  SafetyBoot()
  ClockInitKhz(#CLOCK_KHZ)
  UsbSerialInit()
  SafetyOk()
  While UsbSerialReady() = 0
    UsbSerialTask()
    SafetyPet()
  Wend
  Pump(3000000)
  ; MOV_PAIRS, in tools/mmu_gen.py's order
  PairSm(0) = 0 : PairDm(0) = 4
  PairSm(1) = 4 : PairDm(1) = 0
  PairSm(2) = 6 : PairDm(2) = 0
  PairSm(3) = 6 : PairDm(3) = 4
  PairSm(4) = 2 : PairDm(4) = 0
  PairSm(5) = 6 : PairDm(5) = 1
  PairSm(6) = 0 : PairDm(6) = 6
  FCode(0) = $100
  FCode(1) = $200
  FCode(2) = $300
  FCode(3) = $400
  FCode(4) = $500
  FCode(5) = $600
  FCode(6) = $700
  FCode(7) = $8000
  FCode(8) = $8100
  FCode(9) = $8200
  FCode(10) = $8300
  FCode(11) = $8400
  FCode(12) = $8500
  FCode(13) = $8600
  FCode(14) = $8700
  FCode(15) = $1000
  FCode(16) = $2000
  FCode(17) = $6000
  FCode(18) = $E000
  FCode(19) = $3000
  FCode(20) = $4000
  FCode(21) = $5000
  FCode(22) = $A00
  FCode(23) = $BC0
  FCode(24) = $A80
  FCode(25) = $AC0
  ICode(0) = $95F0
  ICode(1) = $15F0
  ICode(2) = $25F0
  ICode(3) = $65F0
  ICode(4) = $E5F0
  ICode(5) = $35F0
  ICode(6) = $45F0
  ICode(7) = $55F0
  SCode(0) = $A30
  SCode(1) = $BF0
  SCode(2) = $AB0
  SCode(3) = $AF0
  SCode(4) = $8A30
  SCode(5) = $8BF0
  BuildOpcodeTable()
  CpuReset()
  For Mr = 0 To #RAM_WORDS - 1
    Mem(Mr) = RndN($10000)
  Next
  FirstBad = -1
  EaFirst = -1
  MidSum = MidSumNow()
  Say("ASMCHECK start: the Pico's unmapped MOV handlers and __eaw1, assembly against plain") : Eol()
  Repeat
    For Mr = 1 To #ROUND * 10
      MByteOne()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK bytes checks=") : Num(MbChecks) : Say(" failures=") : Num(MbFailures)
    If MbFailures = 0 : Say(" PASS") : Else : Say(" FAIL") : EndIf
    Eol()
    SingleHit = 0
    For Mr = 1 To #ROUND
      SFormOne()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK indexed checks=") : Num(SChecks) : Say(" fast=") : Num(SingleHit) : Say(" failures=") : Num(SFailures)
    If SFailures = 0 And SingleHit > 0 : Say(" PASS") : Else : Say(" FAIL") : EndIf
    Eol()
    For Mr = 1 To #ROUND
      IFormOne()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK imx checks=") : Num(IChecks) : Say(" fast=") : Num(IFast) : Say(" failures=") : Num(IFailures)
    If IFailures = 0 : Say(" PASS") : Else : Say(" FAIL") : EndIf
    Eol()
    For Mr = 1 To #ROUND
      FastOne()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK fast checks=") : Num(FChecks) : Say(" failures=") : Num(FFailures)
    If FFailures = 0 : Say(" PASS") : Else : Say(" FAIL") : EndIf
    Eol()
    Mt0 = Micros()
    For Mr = 1 To #ROUND
      OneCheck()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK mov checks=") : Num(Checks) : Say(" fast=") : Num(Fast) : Say(" slow=") : Num(Slow)
    Say(" failures=") : Num(Failures)
    If Failures = 0
      Say(" PASS")
    Else
      Say(" FAIL first=") : Num(FirstBad) : Say(" op=") : Oct(FirstOp) : Say(" field=") : Num(FirstField)
    EndIf
    Say(" ms=") : Num((Micros() - Mt0) / 1000) : Eol()
    Mt0 = Micros()
    For Mr = 1 To #ROUND * 5
      EaOne()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK ea checks=") : Num(EaChecks) : Say(" fast=") : Num(EaFast) : Say(" slow=") : Num(EaSlow)
    Say(" failures=") : Num(EaFailures)
    If EaFailures = 0
      Say(" PASS")
    Else
      Say(" FAIL first=") : Num(EaFirst) : Say(" spec=") : Oct(EaFirstSpec) : Say(" field=") : Num(EaFirstField)
    EndIf
    Say(" ms=") : Num((Micros() - Mt0) / 1000) : Eol()
    EByte = 1
    Mr = EaFailures
    For EByteI = 1 To #ROUND * 5
      EaOne()
      UsbSerialTask()
      SafetyPet()
    Next
    EByte = 0
    Say("ASMCHECK eab checks=") : Num(#ROUND * 5) : Say(" failures=") : Num(EaFailures - Mr)
    If EaFailures = Mr : Say(" PASS") : Else : Say(" FAIL") : EndIf
    Eol()
  ForEver
EndProcedure

Main()
