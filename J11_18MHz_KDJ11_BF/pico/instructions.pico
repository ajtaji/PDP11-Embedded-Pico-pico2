; ======================================================================
;  instructions.pico - the J-11 run loop: every instruction, and the jump
;  table that dispatches them. Raspberry Pi Pico (RP2040).
;
;  Requires cpu.pico - include it BEFORE this file. Call BuildOpcodeTable()
;  once (CpuRun does it itself if you do not), then CpuRun(n).
;
;  THE TABLE has 8192 entries indexed by the top thirteen bits of the
;  instruction (Op >> 3); only HALT..MFPT (000000-000007) share one, told
;  apart by a short If chain (InstructionGroup0_0000).
;
;  ONE PROCEDURE, EVERY INSTRUCTION A LABEL IN IT. CpuRun() below is the
;  whole emulator: each instruction's handler is a label inside it, named
;  Instruction<MNEMONIC>_<octal> in the 8080 core's layout, and
;  OpTable() is a '.Label' table filled with ?Name. An instruction is
;  fetched and then entered with one computed jump,
;      Goto OpTable(Op >> 3)
;  and every handler ENDS with the same few lines, which fetch the next
;  instruction and make that jump themselves - so no handler returns, and
;  there is no call, no frame and no return anywhere between two emulated
;  instructions (threaded dispatch). The comment on each label gives the
;  octal opcode and the table entries it owns.
;
;  THE TAIL - the lines every handler ends with, and the rules it keeps:
;    1. If the instruction left a trap to take (TrapVector), go to SlowTail,
;       which takes it. A handler that cannot possibly trap - it touches no
;       memory, no stack and no operand helper (the branches, SOB, SPL, the
;       condition-code ops) - leaves this test out; its tail
;       comment says so. A handler that is changed to touch memory MUST get
;       the test back, or its traps are lost.
;    2. Count the instruction (RunLeft); at zero, CpuRun returns.
;    3. Fetch the next word straight from RAM when the PC is even and in
;       RAM, and jump through the table. Anything else (the I/O page, an
;       odd PC) goes to SlowFetch.
;  HALT ends with Goto SlowTail instead: SlowTail is the only place that
;  looks at Halted, and nothing but HALT sets it. Anything added that sets
;  Halted must end the same way.
;  The loop this replaced ran the same steps in the same order - execute,
;  take a trap, count, stop at n or at HALT, fetch - so every instruction
;  behaves exactly as it did.
;
;  WHY, MEASURED (2026-09-22, the report's own instructions/s, self-test
;  PASS on both boards; Pico W at 200 MHz, Pico 2 W at 150 MHz):
;                                        Pico W       Pico 2 W
;    table of procedures + CallFunctionFast   801,600      810,807
;    threaded, one shared tail               904,981      879,757
;    threaded, the tail in every handler     927,991      911,830
;    ... and the tail tightened (below)    1,020,407    1,030,837   <- this file
;  The tightening: the PC test is written as two nested Ifs, not one
;  "a And b" (which builds two truth values and then ands them), and the
;  handlers that cannot trap drop the TrapVector test. Repeating the tail
;  in every handler costs flash (about 12 KB on the Pico, 15 KB on the
;  Pico 2) and is still the fastest of the four.
;
;  THE SHAPE OF A HANDLER, and why (see SPEED in cpu.pico):
;    * no Protected locals - Src, Dst, Res and Ea are Globals, cheaper here;
;    * register mode (mode 0) is tested for and done INLINE, so the common
;      case never pays for a call;
;    * N and Z are one store to FlagNZ (word result as is, byte result
;      shifted left 8); V and C are plain stores;
;    * the emulated time is added last: ClockCycles = ClockCycles + #J11_T_*
;      (the compiler refuses the "ClockCycles + n" shorthand - write it out).
;
;  ;name and ;disassembly lines are kept, commented out, as in the 8080
;  core this layout comes from - a disassembler can be switched in later
;  without touching the arithmetic.
; ======================================================================


; The branch offset: the low byte, signed, in words.
Procedure BranchTaken()
  Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
EndProcedure

; ======================================================================
;  THE RUN LOOP - one procedure, every handler a label inside it
; ======================================================================
Global Dim OpTable.Label(8192)
Global OpTableReady.i                    ; 0 until the first CpuRun fills OpTable
Global RunLeft.i                         ; instructions still to run in this CpuRun
Global FillFrom.i, FillCount.i           ; Ops() - Globals, cheaper than locals

; OpTable(from) .. OpTable(from + count - 1) = target. A '.Label' can only
; be taken with ?Name inside the procedure that owns the label, so CpuRun
; itself passes its labels in; this only stores them.
Procedure Ops(from.i, count.i, target.Label)
  FillFrom = from
  FillCount = count
  While FillCount > 0
    OpTable(FillFrom) = target
    FillFrom = FillFrom + 1
    FillCount = FillCount - 1
  Wend
EndProcedure

; Execute up to n instructions. Returns how many ran.
Procedure.i CpuRun(n.i)
  If OpTableReady = 0
    Goto BuildTable
  EndIf
RunStart:
  If n <= 0 Or Halted <> 0
    ProcedureReturn 0
  EndIf
  RunLeft = n
Fetch:
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)              ; fast fetch, straight from RAM
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
SlowFetch:                               ; the I/O page, an odd PC, past the end of RAM
  Op = FetchWord()
  Goto OpTable(Op >> 3)

;-MOV-------------------------------------------------------------------
InstructionMOV_01:            ; 01SSDD   entries $0200-$03FF
  ;name = "MOV"
  Src = SrcWord()
  If (Op & $38) = 0
    Reg(Op & 7) = Src
  Else
    WriteWord(EaWord(Op & $3F), Src)
  EndIf
  FlagNZ = Src
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("MOV " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionMOVB_11:           ; 11SSDD   entries $1200-$13FF
  ;name = "MOVB"
  Src = SrcByte()
  If (Op & $38) = 0
    Reg(Op & 7) = (Src | (0 - (Src & $80))) & $FFFF   ; to a register it is sign-extended
  Else
    WriteByte(EaByte(Op & $3F), Src)
  EndIf
  FlagNZ = Src << 8
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("MOVB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-CMP-------------------------------------------------------------------
InstructionCMP_02:            ; 02SSDD   entries $0400-$05FF
  ;name = "CMP"
  Src = SrcWord()
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
  Else
    Dst = ReadWord(EaWord(Op & $3F))
  EndIf
  Res = Src - Dst                        ; src - dst, the other way round from SUB
  FlagC = (Res >> 16) & 1
  FlagV = (((Src ! Dst) & (Src ! Res)) >> 15) & 1
  FlagNZ = Res & $FFFF
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("CMP " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionCMPB_12:           ; 12SSDD   entries $1400-$15FF
  ;name = "CMPB"
  Src = SrcByte()
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
  Else
    Dst = ReadByte(EaByte(Op & $3F))
  EndIf
  Res = Src - Dst
  FlagC = (Res >> 8) & 1
  FlagV = (((Src ! Dst) & (Src ! Res)) >> 7) & 1
  FlagNZ = (Res & $FF) << 8
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("CMPB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-BIT-------------------------------------------------------------------
InstructionBIT_03:            ; 03SSDD   entries $0600-$07FF
  ;name = "BIT"
  Src = SrcWord()
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
  Else
    Dst = ReadWord(EaWord(Op & $3F))
  EndIf
  FlagNZ = Src & Dst
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BIT " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionBITB_13:           ; 13SSDD   entries $1600-$17FF
  ;name = "BITB"
  Src = SrcByte()
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
  Else
    Dst = ReadByte(EaByte(Op & $3F))
  EndIf
  FlagNZ = (Src & Dst) << 8
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BITB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-BIC-------------------------------------------------------------------
InstructionBIC_04:            ; 04SSDD   entries $0800-$09FF
  ;name = "BIC"
  Src = SrcWord()
  If (Op & $38) = 0
    Res = Reg(Op & 7) & ~Src & $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Res = ReadWord(Ea) & ~Src & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagNZ = Res
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BIC " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionBICB_14:           ; 14SSDD   entries $1800-$19FF
  ;name = "BICB"
  Src = SrcByte()
  If (Op & $38) = 0
    Res = Reg(Op & 7) & ~Src & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Res = ReadByte(Ea) & ~Src & $FF
    WriteByte(Ea, Res)
  EndIf
  FlagNZ = Res << 8
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BICB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-BIS-------------------------------------------------------------------
InstructionBIS_05:            ; 05SSDD   entries $0A00-$0BFF
  ;name = "BIS"
  Src = SrcWord()
  If (Op & $38) = 0
    Res = Reg(Op & 7) | Src
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Res = ReadWord(Ea) | Src
    WriteWord(Ea, Res)
  EndIf
  FlagNZ = Res
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BIS " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionBISB_15:           ; 15SSDD   entries $1A00-$1BFF
  ;name = "BISB"
  Src = SrcByte()
  If (Op & $38) = 0
    Res = (Reg(Op & 7) | Src) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Res = ReadByte(Ea) | Src
    WriteByte(Ea, Res)
  EndIf
  FlagNZ = Res << 8
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BISB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-ADD-------------------------------------------------------------------
InstructionADD_06:            ; 06SSDD   entries $0C00-$0DFF
  ;name = "ADD"
  Src = SrcWord()
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = Src + Dst
    Reg(Op & 7) = Res & $FFFF
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = Src + Dst
    WriteWord(Ea, Res)
  EndIf
  FlagC = (Res >> 16) & 1
  FlagV = ((~(Src ! Dst) & (Src ! Res)) >> 15) & 1
  FlagNZ = Res & $FFFF
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("ADD " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-SUB-------------------------------------------------------------------
InstructionSUB_16:            ; 16SSDD   entries $1C00-$1DFF
  ;name = "SUB"
  Src = SrcWord()
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = Dst - Src
    Reg(Op & 7) = Res & $FFFF
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = Dst - Src
    WriteWord(Ea, Res)
  EndIf
  FlagC = (Res >> 16) & 1                ; borrow
  FlagV = (((Src ! Dst) & (Dst ! Res)) >> 15) & 1
  FlagNZ = Res & $FFFF
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("SUB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

; ======================================================================
;  SINGLE-OPERAND. The destination is fetched at the top and stored at
;  the bottom, each with register mode inline.
; ======================================================================

;-CLR-------------------------------------------------------------------
InstructionCLR_0050:          ; 0050DD   entries $0140-$0147
  ;name = "CLR"
  If (Op & $38) = 0
    Reg(Op & 7) = 0
  Else
    WriteWord(EaWord(Op & $3F), 0)
  EndIf
  FlagNZ = 0
  FlagV = 0
  FlagC = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("CLR " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionCLRB_1050:         ; 1050DD   entries $1140-$1147
  ;name = "CLRB"
  If (Op & $38) = 0
    Reg(Op & 7) = Reg(Op & 7) & $FF00
  Else
    WriteByte(EaByte(Op & $3F), 0)
  EndIf
  FlagNZ = 0
  FlagV = 0
  FlagC = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("CLRB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-COM-------------------------------------------------------------------
InstructionCOM_0051:          ; 0051DD   entries $0148-$014F
  ;name = "COM"
  If (Op & $38) = 0
    Res = Reg(Op & 7) ! $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Res = ReadWord(Ea) ! $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagNZ = Res
  FlagV = 0
  FlagC = 1
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("COM " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionCOMB_1051:         ; 1051DD   entries $1148-$114F
  ;name = "COMB"
  If (Op & $38) = 0
    Res = (Reg(Op & 7) ! $FF) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Res = ReadByte(Ea) ! $FF
    WriteByte(Ea, Res)
  EndIf
  FlagNZ = Res << 8
  FlagV = 0
  FlagC = 1
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("COMB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-INC-------------------------------------------------------------------
InstructionINC_0052:          ; 0052DD   entries $0150-$0157   C unaffected
  ;name = "INC"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = (Dst + 1) & $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = (Dst + 1) & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagV = 0
  If Dst = $7FFF
    FlagV = 1
  EndIf
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("INC " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionINCB_1052:         ; 1052DD   entries $1150-$1157
  ;name = "INCB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
    Res = (Dst + 1) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Dst = ReadByte(Ea)
    Res = (Dst + 1) & $FF
    WriteByte(Ea, Res)
  EndIf
  FlagV = 0
  If Dst = $7F
    FlagV = 1
  EndIf
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("INCB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-DEC-------------------------------------------------------------------
InstructionDEC_0053:          ; 0053DD   entries $0158-$015F   C unaffected
  ;name = "DEC"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = (Dst - 1) & $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = (Dst - 1) & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagV = 0
  If Dst = $8000
    FlagV = 1
  EndIf
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("DEC " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionDECB_1053:         ; 1053DD   entries $1158-$115F
  ;name = "DECB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
    Res = (Dst - 1) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Dst = ReadByte(Ea)
    Res = (Dst - 1) & $FF
    WriteByte(Ea, Res)
  EndIf
  FlagV = 0
  If Dst = $80
    FlagV = 1
  EndIf
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("DECB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-NEG-------------------------------------------------------------------
InstructionNEG_0054:          ; 0054DD   entries $0160-$0167
  ;name = "NEG"
  If (Op & $38) = 0
    Res = (0 - Reg(Op & 7)) & $FFFF      ; 100000 negates to itself
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Res = (0 - ReadWord(Ea)) & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagV = 0
  If Res = $8000
    FlagV = 1
  EndIf
  FlagC = 1
  If Res = 0
    FlagC = 0
  EndIf
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("NEG " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionNEGB_1054:         ; 1054DD   entries $1160-$1167
  ;name = "NEGB"
  If (Op & $38) = 0
    Res = (0 - Reg(Op & 7)) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Res = (0 - ReadByte(Ea)) & $FF
    WriteByte(Ea, Res)
  EndIf
  FlagV = 0
  If Res = $80
    FlagV = 1
  EndIf
  FlagC = 1
  If Res = 0
    FlagC = 0
  EndIf
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("NEGB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-ADC-------------------------------------------------------------------
InstructionADC_0055:          ; 0055DD   entries $0168-$016F
  ;name = "ADC"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = (Dst + FlagC) & $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = (Dst + FlagC) & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagV = 0
  If Dst = $7FFF And FlagC = 1
    FlagV = 1
  EndIf
  If Dst <> $FFFF Or FlagC = 0
    FlagC = 0
  EndIf
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ADC " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionADCB_1055:         ; 1055DD   entries $1168-$116F
  ;name = "ADCB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
    Res = (Dst + FlagC) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Dst = ReadByte(Ea)
    Res = (Dst + FlagC) & $FF
    WriteByte(Ea, Res)
  EndIf
  FlagV = 0
  If Dst = $7F And FlagC = 1
    FlagV = 1
  EndIf
  If Dst <> $FF Or FlagC = 0
    FlagC = 0
  EndIf
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ADCB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-SBC-------------------------------------------------------------------
; C: set if the destination was 0 and C was 1, cleared otherwise (the
; processor handbook's rule; the C core in this repository leaves C set
; when C was clear - worth checking against a real machine or a test).
InstructionSBC_0056:          ; 0056DD   entries $0170-$0177
  ;name = "SBC"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = (Dst - FlagC) & $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = (Dst - FlagC) & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagV = 0
  If Dst = $8000
    FlagV = 1
  EndIf
  If Dst <> 0 Or FlagC = 0
    FlagC = 0
  EndIf
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("SBC " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionSBCB_1056:         ; 1056DD   entries $1170-$1177
  ;name = "SBCB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
    Res = (Dst - FlagC) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Dst = ReadByte(Ea)
    Res = (Dst - FlagC) & $FF
    WriteByte(Ea, Res)
  EndIf
  FlagV = 0
  If Dst = $80
    FlagV = 1
  EndIf
  If Dst <> 0 Or FlagC = 0
    FlagC = 0
  EndIf
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("SBCB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-TST-------------------------------------------------------------------
InstructionTST_0057:          ; 0057DD   entries $0178-$017F
  ;name = "TST"
  If (Op & $38) = 0
    FlagNZ = Reg(Op & 7)
  Else
    FlagNZ = ReadWord(EaWord(Op & $3F))
  EndIf
  FlagV = 0
  FlagC = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("TST " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionTSTB_1057:         ; 1057DD   entries $1178-$117F
  ;name = "TSTB"
  If (Op & $38) = 0
    FlagNZ = (Reg(Op & 7) & $FF) << 8
  Else
    FlagNZ = ReadByte(EaByte(Op & $3F)) << 8
  EndIf
  FlagV = 0
  FlagC = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("TSTB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

; ======================================================================
;  SHIFTS AND ROTATES. V is N xor C after the operation.
; ======================================================================

;-ROR-------------------------------------------------------------------
InstructionROR_0060:          ; 0060DD   entries $0180-$0187
  ;name = "ROR"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = (Dst >> 1) | (FlagC << 15)
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = (Dst >> 1) | (FlagC << 15)
    WriteWord(Ea, Res)
  EndIf
  FlagC = Dst & 1
  FlagV = (Res >> 15) ! FlagC
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ROR " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionRORB_1060:         ; 1060DD   entries $1180-$1187
  ;name = "RORB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
    Res = (Dst >> 1) | (FlagC << 7)
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Dst = ReadByte(Ea)
    Res = (Dst >> 1) | (FlagC << 7)
    WriteByte(Ea, Res)
  EndIf
  FlagC = Dst & 1
  FlagV = (Res >> 7) ! FlagC
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("RORB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-ROL-------------------------------------------------------------------
InstructionROL_0061:          ; 0061DD   entries $0188-$018F
  ;name = "ROL"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = ((Dst << 1) | FlagC) & $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = ((Dst << 1) | FlagC) & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagC = (Dst >> 15) & 1
  FlagV = (Res >> 15) ! FlagC
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ROL " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionROLB_1061:         ; 1061DD   entries $1188-$118F
  ;name = "ROLB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
    Res = ((Dst << 1) | FlagC) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Dst = ReadByte(Ea)
    Res = ((Dst << 1) | FlagC) & $FF
    WriteByte(Ea, Res)
  EndIf
  FlagC = (Dst >> 7) & 1
  FlagV = (Res >> 7) ! FlagC
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ROLB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-ASR-------------------------------------------------------------------
InstructionASR_0062:          ; 0062DD   entries $0190-$0197
  ;name = "ASR"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = (Dst >> 1) | (Dst & $8000)
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = (Dst >> 1) | (Dst & $8000)
    WriteWord(Ea, Res)
  EndIf
  FlagC = Dst & 1
  FlagV = (Res >> 15) ! FlagC
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ASR " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionASRB_1062:         ; 1062DD   entries $1190-$1197
  ;name = "ASRB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
    Res = (Dst >> 1) | (Dst & $80)
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Dst = ReadByte(Ea)
    Res = (Dst >> 1) | (Dst & $80)
    WriteByte(Ea, Res)
  EndIf
  FlagC = Dst & 1
  FlagV = (Res >> 7) ! FlagC
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ASRB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-ASL-------------------------------------------------------------------
InstructionASL_0063:          ; 0063DD   entries $0198-$019F
  ;name = "ASL"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = (Dst << 1) & $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = (Dst << 1) & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagC = (Dst >> 15) & 1
  FlagV = (Res >> 15) ! FlagC
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ASL " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionASLB_1063:         ; 1063DD   entries $1198-$119F
  ;name = "ASLB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
    Res = (Dst << 1) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Dst = ReadByte(Ea)
    Res = (Dst << 1) & $FF
    WriteByte(Ea, Res)
  EndIf
  FlagC = (Dst >> 7) & 1
  FlagV = (Res >> 7) ! FlagC
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ASLB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-SWAB------------------------------------------------------------------
InstructionSWAB_0003:         ; 0003DD   entries $0018-$001F
  ;name = "SWAB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = ((Dst >> 8) | (Dst << 8)) & $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = ((Dst >> 8) | (Dst << 8)) & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagNZ = (Res & $FF) << 8              ; N and Z come from the low byte
  FlagV = 0
  FlagC = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("SWAB " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-SXT-------------------------------------------------------------------
InstructionSXT_0067:          ; 0067DD   entries $01B8-$01BF   N unaffected
  ;name = "SXT"
  Res = 0
  If FlagN()
    Res = $FFFF
  EndIf
  If (Op & $38) = 0
    Reg(Op & 7) = Res
  Else
    WriteWord(EaWord(Op & $3F), Res)
  EndIf
  SetNZ(FlagN(), 1 - FlagN())
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("SXT " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-MFPS / MTPS ----------------------------------------------------------
InstructionMFPS_1067:         ; 1067DD   entries $11B8-$11BF
  ;name = "MFPS"
  Res = PswGet() & $FF
  If (Op & $38) = 0
    Reg(Op & 7) = (Res | (0 - (Res & $80))) & $FFFF   ; sign-extended into a register
  Else
    WriteByte(EaByte(Op & $3F), Res)
  EndIf
  FlagNZ = Res << 8
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("MFPS " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionMTPS_1064:         ; 1064SS   entries $11A0-$11A7   the T bit is not written
  ;name = "MTPS"
  If (Op & $38) = 0
    Src = Reg(Op & 7) & $FF
  Else
    Src = ReadByte(EaByte(Op & $3F))
  EndIf
  PswSet((PswGet() & $FF10) | (Src & $EF))
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("MTPS " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-MFPI / MTPI / MFPD / MTPD -------------------------------------------
; One address space until the memory management unit is modelled, so the
; "previous" space is this one.
InstructionMFPI_0065:         ; 0065SS   entries $01A8-$01AF
  ;name = "MFPI"
  If (Op & $38) = 0
    Src = Reg(Op & 7)
  Else
    Src = ReadWord(EaWord(Op & $3F))
  EndIf
  Push(Src)
  FlagNZ = Src
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("MFPI " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionMTPI_0066:         ; 0066DD   entries $01B0-$01B7
  ;name = "MTPI"
  Src = Pop()
  If (Op & $38) = 0
    Reg(Op & 7) = Src
  Else
    WriteWord(EaWord(Op & $3F), Src)
  EndIf
  FlagNZ = Src
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("MTPI " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionMFPD_1065:         ; 1065SS   entries $11A8-$11AF
  ;name = "MFPD"
  Goto InstructionMFPI_0065
  ;disassembly("MFPD " + ;name)

InstructionMTPD_1066:         ; 1066DD   entries $11B0-$11B7
  ;name = "MTPD"
  Goto InstructionMTPI_0066
  ;disassembly("MTPD " + ;name)

; ======================================================================
;  BRANCHES. The offset is the low byte, signed, in words:
;      PC = PC + 2 * offset
;  written without a branch as ((Op & $FF) << 1) - ((Op & $80) << 2).
;  Each branch owns 32 table entries (its offset spills into bits 7-3).
; ======================================================================

;-BR--------------------------------------------------------------------
InstructionBR_0004:           ; 000400   entries $0020-$003F
  ;name = "BR"
  Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BR " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionBNE_0010:          ; 001000   entries $0040-$005F   Z = 0
  ;name = "BNE"
  If FlagNZ & $FFFF
    Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BNE " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionBEQ_0014:          ; 001400   entries $0060-$007F   Z = 1
  ;name = "BEQ"
  If (FlagNZ & $FFFF) = 0
    Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BEQ " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
