PanelIli9341Init:
  Data.a $EF,3,$03,$80,$02,$CF,3,$00,$C1,$30,$ED,4,$64,$03,$12,$81
  Data.a $E8,3,$85,$00,$78,$CB,5,$39,$2C,$00,$34,$02,$F7,1,$20,$EA,2,$00,$00
  Data.a $C0,1,$23,$C1,1,$10,$C5,2,$3E,$28,$C7,1,$86
  Data.a $3A,1,$55,$B1,2,$00,$18,$B6,3,$08,$82,$27,$F2,1,$00,$26,1,$01
  Data.a $E0,15,$0F,$31,$2B,$0C,$0E,$08,$4E,$F1,$37,$07,$10,$03,$0E,$09,$00
  Data.a $E1,15,$00,$0E,$14,$03,$11,$07,$31,$C1,$48,$08,$0F,$0C,$31,$36,$0F
  Data.a 0
EndDataSection

DataSection
PanelHx8357Init:
  Data.a $01,$94,$B9,$03,$FF,$83,$57,$FF,$E4,$B3,$04,$80,$00,$06
  Data.a $06,$B6,$01,$25,$B0,$01,$68,$CC,$01,$05,$B1,$06,$00,$15
  Data.a $1C,$1C,$83,$AA,$C0,$06,$50,$50,$01,$3C,$1E,$08,$B4,$07
  Data.a $02,$40,$00,$2A,$2A,$0D,$78,$E0,$22,$02,$0A,$11,$1D,$23
  Data.a $35,$41,$4B,$4B,$42,$3A,$27,$1B,$08,$09,$03,$02,$0A,$11
  Data.a $1D,$23,$35,$41,$4B,$4B,$42,$3A,$27,$1B,$08,$09,$03,$00
  Data.a $01,$3A,$01,$55,$36,$01,$C0,$35,$01,$00,$44,$02,$00,$02
  Data.a $11,$9E,$29,$8A,$00
EndDataSection
