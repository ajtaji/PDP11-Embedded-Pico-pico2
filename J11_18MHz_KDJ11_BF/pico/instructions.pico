    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

; ======================================================================
;  JUMPS AND SUBROUTINES
; ======================================================================

;-JMP-------------------------------------------------------------------
InstructionJMP_0001:          ; 0001DD   entries $0008-$000F
  ;name = "JMP"
  If (Op & $38) = 0
    TrapVector = #VEC_BUS                ; JMP to a register is illegal
  Else
    Reg(7) = EaWord(Op & $3F)
  EndIf
  ClockCycles = ClockCycles + #J11_T_JUMP
  ;disassembly("JMP " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-JSR-------------------------------------------------------------------
InstructionJSR_004:           ; 004RDD   entries $0100-$013F
  ;name = "JSR"
  If (Op & $38) = 0
    TrapVector = #VEC_BUS                ; JSR to a register is illegal
  Else
    Ea = EaWord(Op & $3F)
    Push(Reg((Op >> 6) & 7))
    Reg((Op >> 6) & 7) = Reg(7)
    Reg(7) = Ea
  EndIf
  ClockCycles = ClockCycles + #J11_T_JUMP
  ;disassembly("JSR " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-RTS-------------------------------------------------------------------
InstructionRTS_00020:         ; 00020R   entry $0010
  ;name = "RTS"
  Reg(7) = Reg(Op & 7)
  Reg(Op & 7) = Pop()
  ClockCycles = ClockCycles + #J11_T_JUMP
  ;disassembly("RTS " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-MARK------------------------------------------------------------------
InstructionMARK_0064:         ; 0064NN   entries $01A0-$01A7
  ;name = "MARK"
  Reg(6) = (Reg(7) + ((Op & $3F) << 1)) & $FFFF
  Reg(7) = Reg(5)
  Reg(5) = Pop()
  ClockCycles = ClockCycles + #J11_T_JUMP
  ;disassembly("MARK " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-SOB-------------------------------------------------------------------
InstructionSOB_077:           ; 077RNN   entries $0FC0-$0FFF
  ;name = "SOB"
  Reg((Op >> 6) & 7) = (Reg((Op >> 6) & 7) - 1) & $FFFF
  If Reg((Op >> 6) & 7)
    Reg(7) = (Reg(7) - ((Op & $3F) << 1)) & $FFFF
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("SOB " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

; ======================================================================
;  EIS - MUL, DIV, ASH, ASHC, XOR. Register in bits 8-6, operand in 5-0.
; ======================================================================

;-MUL-------------------------------------------------------------------
InstructionMUL_070:           ; 070RSS   entries $0E00-$0E3F
  ;name = "MUL"
  If (Op & $38) = 0
    Src = Reg(Op & 7)
  Else
    Src = ReadWord(EaWord(Op & $3F))
  EndIf
  Src = Src - ((Src & $8000) << 1)                        ; signed 16
  Dst = Reg((Op >> 6) & 7)
  Dst = Dst - ((Dst & $8000) << 1)
  Res = Src * Dst                                          ; fits in 32 bits
  If Op & $40                                              ; odd register: low word only
    Reg((Op >> 6) & 7) = Res & $FFFF
  Else
    Reg((Op >> 6) & 7) = (Res >> 16) & $FFFF
    Reg(((Op >> 6) & 7) | 1) = Res & $FFFF
  EndIf
  SetNZ(Bool(Res < 0), Bool(Res = 0))
  FlagV = 0
  FlagC = 0
  If Res < -32768 Or Res > 32767
    FlagC = 1
  EndIf
  ClockCycles = ClockCycles + #J11_T_EIS
  ;disassembly("MUL " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-DIV-------------------------------------------------------------------
InstructionDIV_071:           ; 071RSS   entries $0E40-$0E7F
  ;name = "DIV"
  If (Op & $38) = 0
    Src = Reg(Op & 7)
  Else
    Src = ReadWord(EaWord(Op & $3F))
  EndIf
  Src = Src - ((Src & $8000) << 1)
  Dst = (Reg((Op >> 6) & 7) << 16) | Reg(((Op >> 6) & 7) | 1)   ; the 32-bit dividend
  If Src = 0
    FlagV = 1
    FlagC = 1
  ElseIf Src = -1 And Dst = $80000000
    FlagV = 1
    FlagC = 0
  Else
    Res = Dst / Src
    If Res < -32768 Or Res > 32767
      FlagV = 1                                            ; registers unchanged
      FlagC = 0
    Else
      Reg((Op >> 6) & 7) = Res & $FFFF
      Reg(((Op >> 6) & 7) | 1) = (Dst - Res * Src) & $FFFF
      SetNZ(Bool(Res < 0), Bool(Res = 0))
      FlagV = 0
      FlagC = 0
    EndIf
  EndIf
  ClockCycles = ClockCycles + #J11_T_EIS
  ;disassembly("DIV " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-ASH-------------------------------------------------------------------
; Shift count is the low six bits of the source, signed: positive shifts
; left, negative shifts right. A loop - rare instruction, correct first.
InstructionASH_072:           ; 072RSS   entries $0E80-$0EBF
  ;name = "ASH"
  If (Op & $38) = 0
    Src = Reg(Op & 7) & $3F
  Else
    Src = ReadWord(EaWord(Op & $3F)) & $3F
  EndIf
  Res = Reg((Op >> 6) & 7)
  FlagV = 0
  If Src & $20
    Src = 64 - Src                                         ; right by this many
    While Src > 0
      FlagC = Res & 1
      Res = (Res >> 1) | (Res & $8000)
      Src = Src - 1
    Wend
  Else
    While Src > 0
      FlagC = (Res >> 15) & 1
      Tmp = (Res << 1) & $FFFF
      If (Tmp ! Res) & $8000
        FlagV = 1                                          ; the sign changed
      EndIf
      Res = Tmp
      Src = Src - 1
    Wend
  EndIf
  Reg((Op >> 6) & 7) = Res
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_EIS
  ;disassembly("ASH " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-ASHC------------------------------------------------------------------
InstructionASHC_073:          ; 073RSS   entries $0EC0-$0EFF
  ;name = "ASHC"
  If (Op & $38) = 0
    Src = Reg(Op & 7) & $3F
  Else
    Src = ReadWord(EaWord(Op & $3F)) & $3F
  EndIf
  Res = (Reg((Op >> 6) & 7) << 16) | Reg(((Op >> 6) & 7) | 1)
  FlagV = 0
  If Src & $20
    Src = 64 - Src
    While Src > 0
      FlagC = Res & 1
      Res = Res >> 1                                       ; arithmetic on a 32-bit .i
      Src = Src - 1
    Wend
  Else
    While Src > 0
      FlagC = (Res >> 31) & 1
      Tmp = Res << 1
      If (Tmp ! Res) & $80000000
        FlagV = 1
      EndIf
      Res = Tmp
      Src = Src - 1
    Wend
  EndIf
  Reg((Op >> 6) & 7) = (Res >> 16) & $FFFF
  Reg(((Op >> 6) & 7) | 1) = Res & $FFFF
  SetNZ(Bool(Res < 0), Bool(Res = 0))
  ClockCycles = ClockCycles + #J11_T_EIS
  ;disassembly("ASHC " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

;-XOR-------------------------------------------------------------------
InstructionXOR_074:           ; 074RDD   entries $0F00-$0F3F
  ;name = "XOR"
  If (Op & $38) = 0
    Res = Reg(Op & 7) ! Reg((Op >> 6) & 7)
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Res = ReadWord(Ea) ! Reg((Op >> 6) & 7)
    WriteWord(Ea, Res)
  EndIf
  FlagNZ = Res
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_EIS
  ;disassembly("XOR " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

; ======================================================================
;  TRAPS AND MACHINE CONTROL
; ======================================================================
InstructionEMT_104:           ; 104000-104377   entries $1100-$111F
  ;name = "EMT"
  TrapVector = #VEC_EMT
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("EMT " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionTRAP_1044:         ; 104400-104777   entries $1120-$113F
  ;name = "TRAP"
  TrapVector = #VEC_TRAP
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("TRAP " + ;name)
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionHALT_000000:       ; entry $0000, sub-decoded
  ;name = "HALT"
  Halted = 1
  Reg(7) = (Reg(7) - 2) & $FFFF          ; PC stays on the HALT, as on the console
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("HALT")
  Goto SlowTail                         ; Halted is only looked at there

InstructionWAIT_000001:       ; entry $0000, sub-decoded
  ;name = "WAIT"
  Waiting = 1
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("WAIT")
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionRTI_000002:        ; entry $0000, sub-decoded
  ;name = "RTI"
  Reg(7) = Pop()
  PswSet(Pop())
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("RTI")
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionBPT_000003:        ; entry $0000, sub-decoded
  ;name = "BPT"
  TrapVector = #VEC_BPT
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("BPT")
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionIOT_000004:        ; entry $0000, sub-decoded
  ;name = "IOT"
  TrapVector = #VEC_IOT
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("IOT")
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionRESET_000005:      ; entry $0000, sub-decoded - no devices yet
  ;name = "RESET"
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("RESET")
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionRTT_000006:        ; entry $0000, sub-decoded (T-bit timing not modelled)
  ;name = "RTT"
  Reg(7) = Pop()
  PswSet(Pop())
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("RTT")
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionMFPT_000007:       ; entry $0000, sub-decoded
  ;name = "MFPT"
  Reg(0) = 5                             ; processor type 5 = J-11
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("MFPT")
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionSPL_00023:         ; 00023N   entry $0013
  ;name = "SPL"
  PswHigh = (PswHigh & $FF1F) | ((Op & 7) << 5)
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("SPL")
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

; 000240-000277: bit 4 = set (1) or clear (0), bits 3-0 = N Z V C.
; 000240 is NOP, 000257 CCC, 000277 SCC.
InstructionCC_00024:          ; 00024x-00027x   entries $0014-$0017
  ;name = "CLx/SEx"
  Tmp = PswGet()
  If Op & $10
    Tmp = Tmp | (Op & $F)
  Else
    Tmp = Tmp & ~(Op & $F)
  EndIf
  PswSet(Tmp)
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("CC")
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionReserved:          ; every opcode this model does not execute
  ;name = "reserved"
  TrapVector = #VEC_RESV
  ClockCycles = ClockCycles + #J11_T_TRAP
  ;disassembly(".WORD")
  ; ---- next instruction (THE TAIL, top of file) ----
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

; ======================================================================
;  000000-000007 - the one entry that still holds several instructions.
;  HALT, WAIT, RTI, BPT, IOT, RESET, RTT and MFPT differ only in the low
;  three bits, below the table's index. They are rare, so a short If chain
;  tells them apart - no second table.
; ======================================================================
InstructionGroup0_0000:       ; 000000-000007   entry $0000
  Tmp = Op & 7
  If Tmp = 0
    Goto InstructionHALT_000000
  ElseIf Tmp = 1
    Goto InstructionWAIT_000001
  ElseIf Tmp = 2
    Goto InstructionRTI_000002
  ElseIf Tmp = 3
    Goto InstructionBPT_000003
  ElseIf Tmp = 4
    Goto InstructionIOT_000004
  ElseIf Tmp = 5
    Goto InstructionRESET_000005
  ElseIf Tmp = 6
    Goto InstructionRTT_000006
  Else
    Goto InstructionMFPT_000007
  EndIf


; ======================================================================
;  THE SLOW WAY OUT OF AN INSTRUCTION - a trap to take, or a HALT. The
;  handlers' own tails send any instruction that left TrapVector set here,
;  and HALT comes here always, because this is the only place that looks
;  at Halted (nothing else sets it).
; ======================================================================
SlowTail:
  If TrapVector
    Tmp = TrapVector
    TrapVector = 0
    TakeTrap(Tmp)
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft > 0 And Halted = 0
    Goto Fetch
  EndIf
RunEnd:
  ProcedureReturn n - RunLeft

; ======================================================================
;  THE TABLE - filled the first time CpuRun runs. A '.Label' is taken
;  with ?Name only inside the procedure that owns the label, so this is
;  part of CpuRun; BuildOpcodeTable() at the foot just calls CpuRun(0).
; ======================================================================
BuildTable:
  Ops(0, 8192, ?InstructionReserved)

  ; ---- 0000xx - 0003xx ----
  OpTable($0000) = ?InstructionGroup0_0000        ; 000000-000007
  Ops($0008, 8, ?InstructionJMP_0001)             ; 000100-000177
  OpTable($0010) = ?InstructionRTS_00020          ; 000200-000207
  OpTable($0013) = ?InstructionSPL_00023          ; 000230-000237
  Ops($0014, 4, ?InstructionCC_00024)             ; 000240-000277
  Ops($0018, 8, ?InstructionSWAB_0003)            ; 000300-000377

  ; ---- branches, JSR, single operand ----
  Ops($0020, 32, ?InstructionBR_0004)
  Ops($0040, 32, ?InstructionBNE_0010)
  Ops($0060, 32, ?InstructionBEQ_0014)
  Ops($0080, 32, ?InstructionBGE_0020)
  Ops($00A0, 32, ?InstructionBLT_0024)
  Ops($00C0, 32, ?InstructionBGT_0030)
  Ops($00E0, 32, ?InstructionBLE_0034)
  Ops($0100, 64, ?InstructionJSR_004)
  Ops($0140, 8, ?InstructionCLR_0050)
  Ops($0148, 8, ?InstructionCOM_0051)
  Ops($0150, 8, ?InstructionINC_0052)
  Ops($0158, 8, ?InstructionDEC_0053)
  Ops($0160, 8, ?InstructionNEG_0054)
  Ops($0168, 8, ?InstructionADC_0055)
  Ops($0170, 8, ?InstructionSBC_0056)
  Ops($0178, 8, ?InstructionTST_0057)
  Ops($0180, 8, ?InstructionROR_0060)
  Ops($0188, 8, ?InstructionROL_0061)
  Ops($0190, 8, ?InstructionASR_0062)
  Ops($0198, 8, ?InstructionASL_0063)
  Ops($01A0, 8, ?InstructionMARK_0064)
  Ops($01A8, 8, ?InstructionMFPI_0065)
  Ops($01B0, 8, ?InstructionMTPI_0066)
  Ops($01B8, 8, ?InstructionSXT_0067)

  ; ---- double operand, word ----
  Ops($0200, 512, ?InstructionMOV_01)
  Ops($0400, 512, ?InstructionCMP_02)
  Ops($0600, 512, ?InstructionBIT_03)
  Ops($0800, 512, ?InstructionBIC_04)
  Ops($0A00, 512, ?InstructionBIS_05)
  Ops($0C00, 512, ?InstructionADD_06)

  ; ---- EIS ----
  Ops($0E00, 64, ?InstructionMUL_070)
  Ops($0E40, 64, ?InstructionDIV_071)
  Ops($0E80, 64, ?InstructionASH_072)
  Ops($0EC0, 64, ?InstructionASHC_073)
  Ops($0F00, 64, ?InstructionXOR_074)
  Ops($0FC0, 64, ?InstructionSOB_077)

  ; ---- 10xxxx ----
  Ops($1000, 32, ?InstructionBPL_1000)
  Ops($1020, 32, ?InstructionBMI_1004)
  Ops($1040, 32, ?InstructionBHI_1010)
  Ops($1060, 32, ?InstructionBLOS_1014)
  Ops($1080, 32, ?InstructionBVC_1020)
  Ops($10A0, 32, ?InstructionBVS_1024)
  Ops($10C0, 32, ?InstructionBCC_1030)
  Ops($10E0, 32, ?InstructionBCS_1034)
  Ops($1100, 32, ?InstructionEMT_104)
  Ops($1120, 32, ?InstructionTRAP_1044)
  Ops($1140, 8, ?InstructionCLRB_1050)
  Ops($1148, 8, ?InstructionCOMB_1051)
  Ops($1150, 8, ?InstructionINCB_1052)
  Ops($1158, 8, ?InstructionDECB_1053)
  Ops($1160, 8, ?InstructionNEGB_1054)
  Ops($1168, 8, ?InstructionADCB_1055)
  Ops($1170, 8, ?InstructionSBCB_1056)
  Ops($1178, 8, ?InstructionTSTB_1057)
  Ops($1180, 8, ?InstructionRORB_1060)
  Ops($1188, 8, ?InstructionROLB_1061)
  Ops($1190, 8, ?InstructionASRB_1062)
  Ops($1198, 8, ?InstructionASLB_1063)
  Ops($11A0, 8, ?InstructionMTPS_1064)
  Ops($11A8, 8, ?InstructionMFPD_1065)
  Ops($11B0, 8, ?InstructionMTPD_1066)
  Ops($11B8, 8, ?InstructionMFPS_1067)

  ; ---- double operand, byte, and SUB ----
  Ops($1200, 512, ?InstructionMOVB_11)
  Ops($1400, 512, ?InstructionCMPB_12)
  Ops($1600, 512, ?InstructionBITB_13)
  Ops($1800, 512, ?InstructionBICB_14)
  Ops($1A00, 512, ?InstructionBISB_15)
  Ops($1C00, 512, ?InstructionSUB_16)

  ; 17xxxx (floating point, $1E00-$1FFF) stays reserved until the FPJ11 is modelled.
  OpTableReady = 1
  Goto RunStart
EndProcedure

; Fills the table. CpuRun does this itself the first time it runs; calling
; this first only moves the cost out of the first timed run.
Procedure BuildOpcodeTable()
  CpuRun(0)
EndProcedure
