  PcOutM()
  ;name = "DIV"
  If (Op & $38) = 0
    Reg(#CPU_SRC) = Reg(Op & 7)
  Else
CompilerIf #ASM_EA = 1
      ASM Uses Op, GBase
        and.w r0, r8, #0x3f
