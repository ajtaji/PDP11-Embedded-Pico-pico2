; ======================================================================
;  asm_check.pico2 - holds the mapped loop's assembly MOV handlers to their
;  plain versions, on the board (Raspberry Pi Pico 2 / Pico 2 W).
;
;  tools/mmu_gen.py gives each MOV_PAIRS handler an assembly fast path in
;  front of its plain body (asm_mov; #ASM_MOV = 1 in cpu.pico2). This
;  program puts the machine in a random state - registers, memory, the
;  kernel's PARs and PDRs, D space on or off, MMR0 frozen or not, MMR1 and
;  the instruction it belongs to, the condition codes - writes one MOV of
;  a random form at a random PC, and runs it twice from that same state:
;  once with the table pointing at the assembly entry and once at the plain
;  one (MovAsmM / MovRefM, filled with the table). Everything an instruction
;  can change is compared: R0-R7, N Z V C, MMR0-2, the instruction MMR1
;  belongs to, the pending trap, the CPU error register, the yellow stack
;  flag, the PDRs (their W bits), the fetch window, and every word of the
;  56 KB of memory (against a shadow copy, so a stray store anywhere is
;  seen). The states are built so that both ways through the assembly are
;  taken: the fast path (counted by the plain handler not having run - it
;  is the only one that writes Src) and every early exit to the plain body
;  (outside a window, odd, R7, the stack limit, a page that is not there).
;
;  It also holds JSR, RTS and DIV (tools/mmu_gen.py, pico2_ops: __pushm and
;  __popm, SDIV) to their plain handlers the same way (ASMCHECK ops).
;  It also holds __eaw, the handlers' operand address (tools/mmu_gen.py,
;  ASM_EAW), to EaWord's own body (EaWordMRef below) on random specs and
;  registers. Every round prints
;      ASMCHECK mov checks=N fast=F slow=S failures=X PASS
;      ASMCHECK ea checks=N fast=F slow=S failures=X PASS
;  (FAIL with the first difference). A deliberately broken handler must
;  make it FAIL; these did, each within the first round (2026-10-19): the
;  MMR1 byte of -(R) wrong, the (R)+ step of MOV (R)+,R 4 for 2, MOV
;  X(R),-(R) setting N/Z from the address, MOV X(R),(R) indexing Reg() by 2
;  bytes; in __eaw the X(R) PC step 4 for 2, the (R)+ MMR1 byte wrong, and
;  the slow path losing the spec.
;  Build and upload:
;      PureMetalForge.exe --compile asm_check.pico2 -t rp2350 -o asm_check.bin --port COMn
; ======================================================================
#DISK_BACKEND = 0
#DISK_FLASH_MODEL = 0
#DISK_READ_ONLY = 0
#DESK_PROBE = 0
#PSRAM = 0
#PSRAM_CS_PIN = 8
#FLASH_CHIP = $400000
#SRAM_MEM_KB = 56                       ; the test compares all of memory with a shadow copy: 56 KB
EnableExplicit
XIncludeFile "RP2350/Lib/clocks.pico2"
XIncludeFile "RP2350/Lib/timer.pico2"
XIncludeFile "RP2350/Lib/uart.pico2"
XIncludeFile "RP2350/Lib/usb_serial.pico2"
XIncludeFile "RP2350/Lib/safety.pico2"
XIncludeFile "cpu.pico2"
XIncludeFile "fp11.pico2"
XIncludeFile "instructions_mmu.pico2"
XIncludeFile "instructions.pico2"
XIncludeFile "disk.pico2"
XIncludeFile "kw11.pico2"
XIncludeFile "rk11.pico2"

#CLOCK_KHZ = 150000
#ROUND = 2000
#PAIRS = 7
#NOT_RUN = $5A5A1234                    ; Src before a run: still there = the plain body never ran

Global Seed.i = $1234567
Global Dim Shadow.u(#RAM_WORDS)
Global Dim PairSm.i(#PAIRS)
Global Dim PairDm.i(#PAIRS)
#SNAP = 40
Global Dim SnapA.i(#SNAP)
Global Dim SnapB.i(#SNAP)
Global Dim DiffA.i(8)                   ; up to 4 (word index, value) pairs
Global Dim DiffB.i(8)
Global NDiffA.i, NDiffB.i
Global Checks.i, Fast.i, Slow.i, Failures.i, FirstBad.i, FirstOp.i, FirstField.i
Global TPc.i, TOp.i, TPair.i, TRs.i, TRd.i
Global Dim SReg.i(8)
Global Dim SPar.i(16)
Global Dim SPdr.i(16)
Global Dim SAlt.i(6)
Global Dim SBank.i(4)
Global GK.i, GS.i, GD.i, GN.i, GI.i, GK2.i, GN2.i
Global Osm.i, Odm.i, Oi.i, Ow.i, Ofield.i, Mr.i, Mt0.i
Global SNZ.i, SV.i, SC.i, SMmr0.i, SMmr1.i, SMmr3.i, SPcRec.i

; FlagNZ lives in r4 (cpu.pico2): only these two small procedures name it, so no
; procedure here that saves r4 in its frame touches it (PM1126).
Procedure.i NzRead()
  ProcedureReturn FlagNZ
EndProcedure

Procedure NzWrite(v.i)
  FlagNZ = v
EndProcedure

Procedure Ch(c.i)
  UsbSerialWrite(c)
EndProcedure

Procedure Say(*s.i)
  Define p.i, c.i
  p = *s
  c = PeekA(p) & 255
  While c <> 0
    Ch(c)
    p = p + 1
    c = PeekA(p) & 255
  Wend
EndProcedure

Procedure Num(v.i)
  Define n.i, p.i
  n = v
  If n < 0
    Ch(45)
    n = 0 - n
  EndIf
  p = 1
  While n / p >= 10
    p = p * 10
  Wend
  While p > 0
    Ch(48 + (n / p) % 10)
    p = p / 10
  Wend
EndProcedure

Procedure Oct(v.i)
  Define k.i
  For k = 15 To 0 Step -3
    Ch(48 + ((v >> k) & 7))
  Next
EndProcedure

Procedure Eol()
  Ch(13)
  Ch(10)
  UsbSerialFlush()
  UsbSerialTask()
EndProcedure

Procedure Pump(us.i)
  Define t0.i
  t0 = Micros()
  While (Micros() - t0) < us
    UsbSerialTask()
    SafetyPet()
  Wend
EndProcedure

Procedure.i Rnd()                       ; xorshift32
  Seed = Seed ! (Seed << 13)
  Seed = Seed ! ((Seed >> 17) & $7FFF)
  Seed = Seed ! (Seed << 5)
  ProcedureReturn Seed & $7FFFFFFF
EndProcedure

Procedure.i RndN(n.i)
  ProcedureReturn Rnd() % n
EndProcedure

; An even address in one of the current D space's write windows (or, if
; there is none, any even address).
Procedure.i RndMapped()
  Define t.i, e.i
  For t = 1 To 16
    e = CurD + RndN(8)
    If MapWHi(e) > MapWLo(e)
      ProcedureReturn (MapWLo(e) + RndN(MapWHi(e) - MapWLo(e))) & $FFFE
    EndIf
  Next
  ProcedureReturn RndN($8000) * 2
EndProcedure

; A register value: mostly an address in a write window (the fast path),
; sometimes any even address, odd, near the stack limit, or anything.
Procedure.i RndReg()
  Define k.i
  k = RndN(12)
  If k < 6
    ProcedureReturn (RndMapped() + 2) & $FFFF   ; +2: a -(R) lands in the window too
  ElseIf k < 8
    ProcedureReturn RndN($8000) * 2
  ElseIf k = 8
    ProcedureReturn RndN($10000) | 1
  ElseIf k = 9
    ProcedureReturn $FC + RndN(8) * 2   ; 000374-000412: either side of the yellow limit
  EndIf
  ProcedureReturn RndN($10000)
EndProcedure

; The kernel's map: mostly pages in the 56 KB, some beyond it (no fast window),
; most read/write with W set, some read-only, some not resident, some growing down.
Procedure RandomMap()
  Define e.i, k.i, acf.i
  For e = 0 To 15
    If RndN(4) = 0
      Par(e) = $380 + RndN($C80)        ; past the memory: no window
    Else
      Par(e) = RndN($300) & $FFF8       ; in the 56 KB (whole page)
    EndIf
    k = RndN(20)
    If k < 15
      acf = 6
    ElseIf k < 18
      acf = 2
    Else
      acf = 0
    EndIf
    Pdr(e) = acf | (RndN($80) << 8)
    If RndN(10) < 7
      Pdr(e) = Pdr(e) | $40
    EndIf
    If RndN(5) = 0
      Pdr(e) = Pdr(e) | 8
    EndIf
    If RndN(3) <> 0
      Pdr(e) = (Pdr(e) & $00FF) | $7F00 ; most pages whole: more fast windows
    EndIf
  Next
  For e = 16 To 63
    Par(e) = 0
    Pdr(e) = 0
  Next
  Mmr3 = 0
  If RndN(2)
    Mmr3 = 4                            ; kernel D space on
  EndIf
  MmuRecompute()
EndProcedure

; A PC in a page whose word at the PC and the two after it are in the I fast window.
Procedure.i PickPc()
  Define t.i, va.i, e.i
  For t = 1 To 200
    va = RndN($8000) * 2
    If va <= $FFF8
      e = CurI + (va >> 13)
      If va >= MapRLo(e) And va + 6 <= MapRHi(e)
        ProcedureReturn va
      EndIf
    EndIf
  Next
  ProcedureReturn -1
EndProcedure

Procedure SaveState()
  For GI = 0 To 7 : SReg(GI) = Reg(GI) : Next
  For GI = 0 To 15 : SPar(GI) = Par(GI) : SPdr(GI) = Pdr(GI) : Next
  For GI = 0 To 5 : SAlt(GI) = RegAlt(GI) : Next
  For GI = 0 To 3 : SBank(GI) = StackBank(GI) : Next
  SNZ = NzRead() : SV = FlagV : SC = FlagC
  SMmr0 = Mmr0 : SMmr1 = Mmr1 : SMmr3 = Mmr3 : SPcRec = MmuPcRec
EndProcedure

; Back to the saved state exactly: a trap in the run before may have changed
; the mode, the register set, the stack pointers and the map's entry bases.
Procedure LoadState()
  PswSet($00E0)                         ; kernel, register set 0, priority 7
  For GI = 0 To 7 : Reg(GI) = SReg(GI) : Next
  For GI = 0 To 15 : Par(GI) = SPar(GI) : Pdr(GI) = SPdr(GI) : Next
  For GI = 0 To 5 : RegAlt(GI) = SAlt(GI) : Next
  For GI = 0 To 3 : StackBank(GI) = SBank(GI) : Next
  Mmr3 = SMmr3
  MmuRecompute()
  NzWrite(SNZ) : FlagV = SV : FlagC = SC
  Mmr0 = SMmr0 : Mmr1 = SMmr1 : MmuPcRec = SPcRec : Mmr2 = 0
  MmuOn = 1
  TrapVector = 0 : PswLate = 0 : AbortPsw = 0 : StackYellow = 0 : CpuErr = 0
  TraceArm = 0 : Halted = 0 : Waiting = 0 : IntReq = 0 : DevActive = 0 : Dl11TxRdy = 1
  Src = #NOT_RUN
EndProcedure

; Run the one instruction at TPc through entry target; snapshot what it left.
Procedure RunOnce(target.Label)
  OpTableM(TOp >> 3) = target
  Reg(7) = TPc
  GK = CpuRunM(1)
EndProcedure

; What the run left, into *snap / *diff / *nd (no locals: see NzRead)
Procedure Snap(*snap.i, *diff.i, *nd.i)
  GS = *snap : GD = *diff : GN = *nd
  PokeL(GS, GK)
  For GI = 0 To 7 : PokeL(GS + 4 + GI * 4, Reg(GI)) : Next
  PokeL(GS + 36, NzRead())
  PokeL(GS + 40, FlagV & $8000)
  PokeL(GS + 44, FlagC & $10000)
  PokeL(GS + 48, Mmr0)
  PokeL(GS + 52, Mmr1)
  PokeL(GS + 56, Mmr2)
  PokeL(GS + 60, MmuPcRec)
  PokeL(GS + 64, TrapVector)
  PokeL(GS + 68, CpuErr)
  PokeL(GS + 72, StackYellow)
  PokeL(GS + 76, Fw(0))
  PokeL(GS + 80, Fw(1))
  PokeL(GS + 84, Fw(3))
  PokeL(GS + 88, PswGet())
  GK2 = 0
  For GI = 0 To 15 : GK2 = GK2 * 31 + Pdr(GI) : Next
  PokeL(GS + 92, GK2)
  PokeL(GS + 96, Halted)
  PokeL(GS + 100, Bool(Src = #NOT_RUN))
  ; memory against the shadow: note what changed, then put it back
  GN2 = 0
  For GI = 0 To #RAM_WORDS - 1
    If Mem(GI) <> Shadow(GI)
      If GN2 < 4
        PokeL(GD + GN2 * 8, GI)
        PokeL(GD + GN2 * 8 + 4, Mem(GI))
      EndIf
      GN2 = GN2 + 1
      Mem(GI) = Shadow(GI)
    EndIf
  Next
  PokeL(GN, GN2)
EndProcedure

Procedure OneCheck()
  PswSet($00E0)                         ; kernel, register set 0 (a trap last time may have left another)
  TPair = RndN(#PAIRS)
  Osm = PairSm(TPair)
  Odm = PairDm(TPair)
  RandomMap()
  For Oi = 0 To 6 : Reg(Oi) = RndReg() : Next
  TPc = PickPc()
  If TPc < 0
    ProcedureReturn
  EndIf
  TRs = RndN(8)
  If Osm = 2 And TRs = 7
    TRs = RndN(7)                       ; (R7)+ is an immediate: the table sends it elsewhere
  EndIf
  TRd = RndN(8)
  TOp = $1000 | (Osm << 9) | (TRs << 6) | (Odm << 3) | TRd
  Ow = TPc + MapHost(CurI + (TPc >> 13))
  PokeU(Ow, TOp)
  PokeU(Ow + 2, RndN($10000))           ; an index word
  If RndN(4) <> 0
    PokeU(Ow + 2, (RndMapped() - Reg(RndN(7))) & $FFFF)   ; ... often one that lands in a window
  EndIf
  For Oi = 0 To #RAM_WORDS - 1           ; (only the words just written differ)
    Shadow(Oi) = Mem(Oi)
  Next
  ; the condition codes, MMR0 (sometimes frozen), MMR1 and its instruction
  NzWrite(Rnd()) : FlagV = Rnd() : FlagC = Rnd()
  Mmr0 = 1 | (RndN(8) << 1)
  If RndN(8) = 0
    Mmr0 = Mmr0 | ((RndN(7) + 1) << 13)
  EndIf
  Mmr1 = RndN($10000)
  If RndN(3) = 0
    Mmr1 = Mmr1 & $FF00
  EndIf
  MmuPcRec = RndN($10000)
  If RndN(2)
    MmuPcRec = TPc                      ; MMR1 already belongs to this instruction
  EndIf
  SaveState()
  LoadState()
  RunOnce(MovAsmM(TPair))
  Snap(@SnapA(0), @DiffA(0), @NDiffA)
  LoadState()
  RunOnce(MovRefM(TPair))
  Snap(@SnapB(0), @DiffB(0), @NDiffB)
  OpTableM(TOp >> 3) = MovAsmM(TPair)  ; the table as built
  Checks = Checks + 1
  If SnapA(25) = 1
    Fast = Fast + 1
  Else
    Slow = Slow + 1
  EndIf
  Ofield = -1
  For Oi = 0 To 24
    If SnapA(Oi) <> SnapB(Oi) And Ofield < 0
      Ofield = Oi
    EndIf
  Next
  If Ofield < 0 And NDiffA <> NDiffB
    Ofield = 30
  EndIf
  If Ofield < 0
    For Oi = 0 To 7
      If Oi < NDiffA * 2 And DiffA(Oi) <> DiffB(Oi) And Ofield < 0
        Ofield = 31
      EndIf
    Next
  EndIf
  If Ofield >= 0
    Failures = Failures + 1
    If FirstBad < 0
      FirstBad = Checks
      FirstOp = TOp
      FirstField = Ofield
      Say("FIRST FAIL op=") : Oct(TOp) : Say(" pc=") : Oct(TPc) : Say(" Ofield=") : Num(Ofield)
      If Ofield < 25
        Say(" asm=") : Num(SnapA(Ofield)) : Say(" plain=") : Num(SnapB(Ofield))
      EndIf
      Say(" fast=") : Num(SnapA(25)) : Eol()
    EndIf
  EndIf
EndProcedure

; ---- __eaw, the mapped handlers' operand address --------------------------
; The plain body, as a procedure of its own (cpu.pico2, EaWordMBody).
ProcedureRAM.i EaWordMRef(spec.i)
  EaWordMBody()
EndProcedure

; __eaw as the handlers reach it: bl, spec in r0, the address back in r0.
; (lr is kept in r5 across the bl: __eaw keeps r4-r11.)
Procedure EaAsm()
  ASM
    push {r5}
    mov r5, lr
    ldr r0, =global_espec
    ldr r0, [r0]
    bl __eaw
    ldr r1, =global_er
    str r0, [r1]
    mov lr, r5
    pop {r5}
  EndASM
EndProcedure

#EA_NONE = $77AA55                      ; EaSpec before a run: still there = __eaw never went on to EaWordM
Global EaChecks.i, EaFast.i, EaSlow.i, EaFailures.i, EaFirst.i, EaFirstSpec.i, EaFirstField.i
Global ESpec.i, ER.i, Ei.i, EField.i
Global Dim EaA.i(24)
Global Dim EaB.i(24)

Procedure EaSnap(*s.i)
  GS = *s
  PokeL(GS, ER)
  For GI = 0 To 7 : PokeL(GS + 4 + GI * 4, Reg(GI)) : Next
  PokeL(GS + 36, EaReg)
  PokeL(GS + 40, EaBase)
  PokeL(GS + 44, Tmp)
  PokeL(GS + 48, Adr)
  PokeL(GS + 52, Mmr0)
  PokeL(GS + 56, Mmr1)
  PokeL(GS + 60, Mmr2)
  PokeL(GS + 64, MmuPcRec)
  PokeL(GS + 68, TrapVector)
  PokeL(GS + 72, CpuErr)
  PokeL(GS + 76, StackYellow)
  PokeL(GS + 80, AbortPsw)
  PokeL(GS + 84, Bool(EaSpec = #EA_NONE))
EndProcedure

Procedure.i PickMode()
  Define k.i
  k = RndN(6)
  If k = 0
    ProcedureReturn 6
  ElseIf k = 1
    ProcedureReturn 4
  ElseIf k = 2
    ProcedureReturn 2
  ElseIf k = 3
    ProcedureReturn 3
  ElseIf k = 4
    ProcedureReturn 7
  EndIf
  ProcedureReturn 1
EndProcedure

Procedure EaOne()
  PswSet($00E0)
  RandomMap()
  For Ei = 0 To 6 : Reg(Ei) = RndReg() : Next
  Reg(7) = RndReg()
  If RndN(2)
    Ei = PickPc()                       ; a PC whose next word is in the I window: X(R)'s fast path
    If Ei >= 0
      Reg(7) = Ei
      PokeU(Ei + MapHost(CurI + (Ei >> 13)), (RndMapped() - Reg(RndN(7))) & $FFFF)
    EndIf
  EndIf
  ESpec = RndN(64)
  If RndN(3) <> 0                       ; mostly the six modes the assembly does
    ESpec = (ESpec & 7) | (PickMode() << 3)
  EndIf
  NzWrite(Rnd()) : FlagV = Rnd() : FlagC = Rnd()
  Mmr0 = 1 | (RndN(8) << 1)
  If RndN(8) = 0
    Mmr0 = Mmr0 | ((RndN(7) + 1) << 13)
  EndIf
  Mmr1 = RndN($10000)
  If RndN(3) = 0
    Mmr1 = Mmr1 & $FF00
  EndIf
  Fw(3) = RndN($10000)
  MmuPcRec = RndN($10000)
  If RndN(2)
    MmuPcRec = Fw(3)
  EndIf
  SaveState()
  LoadState()
  ER = 0
  EaSpec = #EA_NONE
  EaAsm()
  EaSnap(@EaA(0))
  Ei = Fw(3)
  LoadState()
  Fw(3) = Ei
  EaSpec = #EA_NONE
  ER = EaWordMRef(ESpec)
  EaSnap(@EaB(0))
  EaChecks = EaChecks + 1
  If EaA(21) = 1
    EaFast = EaFast + 1
  Else
    EaSlow = EaSlow + 1
  EndIf
  EField = -1
  For Ei = 0 To 20
    If EaA(Ei) <> EaB(Ei) And EField < 0
      EField = Ei
    EndIf
  Next
  If EField >= 0
    EaFailures = EaFailures + 1
    If EaFirst < 0
      EaFirst = EaChecks
      EaFirstSpec = ESpec
      EaFirstField = EField
      Say("EA FIRST FAIL spec=") : Oct(ESpec) : Say(" field=") : Num(EField)
      Say(" asm=") : Num(EaA(EField)) : Say(" plain=") : Num(EaB(EField)) : Say(" fast=") : Num(EaA(21)) : Eol()
    EndIf
  EndIf
EndProcedure


; ---- the FPU's assembly (fp11.pico2) ----------------------------------------
; FpFracMulAsm against FpFracMulRef, and FpDivQAsm against FpDivQRef, on the
; same fractions: random ones (the hidden bit set, the low word 0 a third of
; the time - the 24 x 24 case), and every pairing of the extremes (the
; smallest fraction, the largest, and the two equal). Only the results are
; the procedures' contract - #P_FF for the multiply, #P_Q for the quotient -
; and the assembly must leave #P_SF as it found it.
Global FpChecks.i, FpFailures.i, FpFirst.i
Global Fa.i, Fb.i, Fc.i, Fd.i, Fr0.i, Fr1.i, Fk.i
Global Dim EdgeH.i(3)
Global Dim EdgeL.i(3)

Procedure.i RndW()                      ; 32 random bits
  ProcedureReturn (Rnd() << 1) ! Rnd()
EndProcedure

Procedure FpOneCase(ah.i, al.i, bh.i, bl.i, qd.i)
  ; the multiply
  PH(#P_FF) = ah : PL(#P_FF) = al : PH(#P_SF) = bh : PL(#P_SF) = bl
  FpFracMulRef()
  Fr0 = PH(#P_FF) : Fr1 = PL(#P_FF)
  PH(#P_FF) = ah : PL(#P_FF) = al : PH(#P_SF) = bh : PL(#P_SF) = bl
  FpFracMulAsm()
  FpChecks = FpChecks + 1
  If PH(#P_FF) <> Fr0 Or PL(#P_FF) <> Fr1 Or PH(#P_SF) <> bh Or PL(#P_SF) <> bl
    FpFailures = FpFailures + 1
    If FpFirst < 0
      FpFirst = FpChecks
      Say("FP FIRST FAIL mul a=") : Num(ah) : Ch(32) : Num(al) : Say(" b=") : Num(bh) : Ch(32) : Num(bl)
      Say(" asm=") : Num(PH(#P_FF)) : Ch(32) : Num(PL(#P_FF)) : Say(" plain=") : Num(Fr0) : Ch(32) : Num(Fr1) : Eol()
    EndIf
  EndIf
  ; the quotient, of the guarded fractions; F keeps only the high words
  If qd = 0
    al = 0 : bl = 0
  EndIf
  Fa = (ah << 3) | ((al >> 29) & 7) : Fb = al << 3
  Fc = (bh << 3) | ((bl >> 29) & 7) : Fd = bl << 3
  FqQd = qd
  If qd
    FqCount = 23 + #FP_GUARD + 33
  Else
    FqCount = 23 + #FP_GUARD + 1
  EndIf
  PH(#P_FF) = Fa : PL(#P_FF) = Fb : PH(#P_SF) = Fc : PL(#P_SF) = Fd
  FpDivQRef()
  Fr0 = PH(#P_Q) : Fr1 = PL(#P_Q)
  PH(#P_FF) = Fa : PL(#P_FF) = Fb : PH(#P_SF) = Fc : PL(#P_SF) = Fd
  PH(#P_Q) = RndW() : PL(#P_Q) = RndW()
  FpDivQAsm()
  FpChecks = FpChecks + 1
  If PH(#P_Q) <> Fr0 Or PL(#P_Q) <> Fr1 Or PH(#P_SF) <> Fc Or PL(#P_SF) <> Fd
    FpFailures = FpFailures + 1
    If FpFirst < 0
      FpFirst = FpChecks
      Say("FP FIRST FAIL div qd=") : Num(qd) : Say(" ff=") : Num(Fa) : Ch(32) : Num(Fb) : Say(" sf=") : Num(Fc) : Ch(32) : Num(Fd)
      Say(" asm=") : Num(PH(#P_Q)) : Ch(32) : Num(PL(#P_Q)) : Say(" plain=") : Num(Fr0) : Ch(32) : Num(Fr1) : Eol()
    EndIf
  EndIf
EndProcedure

Procedure FpOne()
  Define ah.i, al.i, bh.i, bl.i
  ah = (RndW() & $7FFFFF) | $800000
  bh = (RndW() & $7FFFFF) | $800000
  al = RndW() : bl = RndW()
  If RndN(3) = 0
    al = 0 : bl = 0
  EndIf
  FpOneCase(ah, al, bh, bl, RndN(2))
EndProcedure

Procedure FpEdges()
  Define i.i, j.i
  EdgeH(0) = $800000 : EdgeL(0) = 0            ; 0.5, the smallest
  EdgeH(1) = $FFFFFF : EdgeL(1) = -1           ; the largest
  EdgeH(2) = $800000 : EdgeL(2) = 1
  For i = 0 To 2
    For j = 0 To 2
      FpOneCase(EdgeH(i), EdgeL(i), EdgeH(j), EdgeL(j), 0)
      FpOneCase(EdgeH(i), EdgeL(i), EdgeH(j), EdgeL(j), 1)
    Next
  Next
EndProcedure

; ---- JSR, RTS and DIV (tools/mmu_gen.py, pico2_ops) -------------------------
; Each assembly handler (OpAsmM) against its plain one (OpRefM), from the same
; random state as the MOV check: JSR of every mode (0, illegal, too), RTS of
; every register, DIV from every source mode, with the stack pointer anywhere
; RndReg puts a register (in a window, odd, at the stack limit, unmapped) and
; the dividend and divisor often at the edges (0, -1, 077777, 100000, a quotient
; just out of range). The same fields and the same memory as the MOV check.
Global OpChecks.i, OpFailures.i, OpFirst.i, OpKind.i, OpR.i
Global Dim OpCount.i(3)
Global Dim EdgeW.i(8)

Procedure.i RndEdge()
  If RndN(2)
    ProcedureReturn EdgeW(RndN(8))
  EndIf
  ProcedureReturn RndN($10000)
EndProcedure

Procedure OpsOne()
  PswSet($00E0)
  RandomMap()
  For Oi = 0 To 6 : Reg(Oi) = RndReg() : Next
  TPc = PickPc()
  If TPc < 0
    ProcedureReturn
  EndIf
  OpKind = RndN(3)
  OpR = RndN(8)
  If OpKind = 0                         ; JSR R, dd
    TOp = $0800 | (OpR << 6) | RndN(64)
    If RndN(8) <> 0 And (TOp & $38) = 0
      TOp = TOp | $08                   ; mostly a legal mode
    EndIf
  ElseIf OpKind = 1                     ; RTS R
    TOp = $0080 | OpR
  Else                                  ; DIV R, ss
    TOp = $7200 | (OpR << 6) | RndN(64)
    If RndN(3) = 0
      Reg(OpR & 6) = RndEdge()
      Reg(OpR | 1) = RndEdge()
      Reg(TOp & 7) = RndEdge()
      If RndN(2)                        ; a quotient at the edge of the range
        Reg(TOp & 7) = 2 + RndN(3)
        Reg(OpR & 6) = (RndN(3) + $FFFF) & $FFFF
      EndIf
    EndIf
  EndIf
  Ow = TPc + MapHost(CurI + (TPc >> 13))
  PokeU(Ow, TOp)
  PokeU(Ow + 2, RndN($10000))
  If RndN(4) <> 0
    PokeU(Ow + 2, (RndMapped() - Reg(RndN(7))) & $FFFF)
  EndIf
  For Oi = 0 To #RAM_WORDS - 1
    Shadow(Oi) = Mem(Oi)
  Next
  NzWrite(Rnd()) : FlagV = Rnd() : FlagC = Rnd()
  Mmr0 = 1 | (RndN(8) << 1)
  If RndN(8) = 0
    Mmr0 = Mmr0 | ((RndN(7) + 1) << 13)
  EndIf
  Mmr1 = RndN($10000)
  MmuPcRec = RndN($10000)
  If RndN(2)
    MmuPcRec = TPc
  EndIf
  SaveState()
  LoadState()
  RunOnce(OpAsmM(OpKind))
  Snap(@SnapA(0), @DiffA(0), @NDiffA)
  LoadState()
  RunOnce(OpRefM(OpKind))
  Snap(@SnapB(0), @DiffB(0), @NDiffB)
  OpTableM(TOp >> 3) = OpAsmM(OpKind)  ; the table as built
  OpChecks = OpChecks + 1
  OpCount(OpKind) = OpCount(OpKind) + 1
  Ofield = -1
  For Oi = 0 To 24
    If SnapA(Oi) <> SnapB(Oi) And Ofield < 0
      Ofield = Oi
    EndIf
  Next
  If Ofield < 0 And NDiffA <> NDiffB
    Ofield = 30
  EndIf
  If Ofield < 0
    For Oi = 0 To 7
      If Oi < NDiffA * 2 And DiffA(Oi) <> DiffB(Oi) And Ofield < 0
        Ofield = 31
      EndIf
    Next
  EndIf
  If Ofield >= 0
    OpFailures = OpFailures + 1
    If OpFirst < 0
      OpFirst = OpChecks
      Say("OPS FIRST FAIL op=") : Oct(TOp) : Say(" pc=") : Oct(TPc) : Say(" sp=") : Oct(SReg(6)) : Say(" field=") : Num(Ofield)
      If Ofield < 25
        Say(" asm=") : Num(SnapA(Ofield)) : Say(" plain=") : Num(SnapB(Ofield))
      EndIf
      Eol()
    EndIf
  EndIf
EndProcedure

Procedure Main()
  SafetyBoot()
  ClockInitKhz(#CLOCK_KHZ)
  UsbSerialInit()
  SafetyOk()
  While UsbSerialReady() = 0
    UsbSerialTask()
    SafetyPet()
  Wend
  Pump(3000000)
  ; MOV_PAIRS, in tools/mmu_gen.py's order
  PairSm(0) = 0 : PairDm(0) = 4
  PairSm(1) = 4 : PairDm(1) = 0
  PairSm(2) = 6 : PairDm(2) = 0
  PairSm(3) = 6 : PairDm(3) = 4
  PairSm(4) = 2 : PairDm(4) = 0
  PairSm(5) = 6 : PairDm(5) = 1
  PairSm(6) = 0 : PairDm(6) = 6
  BuildOpcodeTable()
  BuildOpcodeTableM()
  CpuReset()
  For Mr = 0 To #RAM_WORDS - 1
    Mem(Mr) = RndN($10000)
  Next
  FirstBad = -1
  EaFirst = -1
  FpFirst = -1
  OpFirst = -1
  EdgeW(0) = 0 : EdgeW(1) = $FFFF : EdgeW(2) = $7FFF : EdgeW(3) = $8000
  EdgeW(4) = 1 : EdgeW(5) = 2 : EdgeW(6) = $FFFE : EdgeW(7) = $8001
  FpInit()
  Say("ASMCHECK start: the mapped loop's MOV handlers and __eaw, assembly against plain") : Eol()
  Repeat
    Mt0 = Micros()
    For Mr = 1 To #ROUND
      OneCheck()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK mov checks=") : Num(Checks) : Say(" fast=") : Num(Fast) : Say(" slow=") : Num(Slow)
    Say(" failures=") : Num(Failures)
    If Failures = 0
      Say(" PASS")
    Else
      Say(" FAIL first=") : Num(FirstBad) : Say(" op=") : Oct(FirstOp) : Say(" field=") : Num(FirstField)
    EndIf
    Say(" ms=") : Num((Micros() - Mt0) / 1000) : Eol()
    Mt0 = Micros()
    For Mr = 1 To #ROUND * 5
      EaOne()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK ea checks=") : Num(EaChecks) : Say(" fast=") : Num(EaFast) : Say(" slow=") : Num(EaSlow)
    Say(" failures=") : Num(EaFailures)
    If EaFailures = 0
      Say(" PASS")
    Else
      Say(" FAIL first=") : Num(EaFirst) : Say(" spec=") : Oct(EaFirstSpec) : Say(" field=") : Num(EaFirstField)
    EndIf
    Say(" ms=") : Num((Micros() - Mt0) / 1000) : Eol()
    Mt0 = Micros()
    FpEdges()
    For Mr = 1 To #ROUND * 5
      FpOne()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK fp checks=") : Num(FpChecks) : Say(" failures=") : Num(FpFailures)
    If FpFailures = 0
      Say(" PASS")
    Else
      Say(" FAIL first=") : Num(FpFirst)
    EndIf
    Say(" ms=") : Num((Micros() - Mt0) / 1000) : Eol()
    Mt0 = Micros()
    For Mr = 1 To #ROUND
      OpsOne()
      UsbSerialTask()
      SafetyPet()
    Next
    Say("ASMCHECK ops checks=") : Num(OpChecks) : Say(" jsr=") : Num(OpCount(0)) : Say(" rts=") : Num(OpCount(1))
    Say(" div=") : Num(OpCount(2)) : Say(" failures=") : Num(OpFailures)
    If OpFailures = 0
      Say(" PASS")
    Else
      Say(" FAIL first=") : Num(OpFirst)
    EndIf
    Say(" ms=") : Num((Micros() - Mt0) / 1000) : Eol()
  ForEver
EndProcedure

Main()
