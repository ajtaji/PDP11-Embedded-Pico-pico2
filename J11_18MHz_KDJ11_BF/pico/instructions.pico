    EndIf
  EndIf
  Goto SlowFetch

InstructionBMI_1004:          ; 100400   entries $1020-$103F   N = 1
  ;name = "BMI"
  If FlagNZ & $18000
    Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BMI " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
