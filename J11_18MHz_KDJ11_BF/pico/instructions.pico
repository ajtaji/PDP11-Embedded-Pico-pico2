    mov r0, r9
    bl __t1_readword
    ldr r1, =global_src
    str r0, [r1]
  EndASM
CompilerElse
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  MReadWord(Src, PC)                     ; the word after the instruction
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerEndIf
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  PC = (PC + 2) & $FFFF
  FlagNZ = Src & Reg(Op & 7)
  FlagV = 0
  ; ---- next instruction - the read can trap (THE TAIL, top of file) ----
  NextNativeTrap()

InstructionBIC_04_IR:            ; 0427DD  BIC #n,Rd, the source an immediate
  ;name = "BIC #n,Rd"
  If (Op & 7) = 7                        ; the destination is the PC:
    Goto InstructionBIC_04                  ; the general handler
  EndIf
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerIf #ASM_MEM = 1
  ASM Uses PC
    mov r0, r9
    bl __t1_readword
    ldr r1, =global_src
    str r0, [r1]
  EndASM
CompilerElse
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  MReadWord(Src, PC)                     ; the word after the instruction
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- MEMORY THUMB1 ----
CompilerEndIf
; ---- END MEMORY THUMB1 ----
; ---- END UNMAPPED ONLY ----
  PC = (PC + 2) & $FFFF
