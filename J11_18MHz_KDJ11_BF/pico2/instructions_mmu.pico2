;-MUL-------------------------------------------------------------------
InstructionMUL_070M:           ; 070RSS   entries $0E00-$0E3F
  PcOutM()
  ;name = "MUL"
  If (Op & $38) = 0
    Reg(#CPU_SRC) = Reg(Op & 7)
  Else
CompilerIf #ASM_EA = 1
      ASM Uses Op, GBase
        and.w r0, r8, #0x3f
        bl __eaw
        str r0, [r5, #84]
      EndASM
CompilerElse
      Reg(#CPU_EA) = EaWordM(Op & $3F)
CompilerEndIf
    MMReadWordSlot(@Reg(#CPU_SRC), Reg(#CPU_EA))
  EndIf
  Reg(#CPU_SRC) = Reg(#CPU_SRC) - ((Reg(#CPU_SRC) & $8000) << 1)                        ; signed 16
  Reg(#CPU_DST) = Reg((Op >> 6) & 7)
  Reg(#CPU_DST) = Reg(#CPU_DST) - ((Reg(#CPU_DST) & $8000) << 1)
  Res = Reg(#CPU_SRC) * Reg(#CPU_DST)                                          ; fits in 32 bits
  If Op & $40                                              ; odd register: low word only
    Reg((Op >> 6) & 7) = Res & $FFFF
  Else
    Reg((Op >> 6) & 7) = (Res >> 16) & $FFFF
    Reg(((Op >> 6) & 7) | 1) = Res & $FFFF
  EndIf
  SetNZ(Bool(Res < 0), Bool(Res = 0))
  Reg(#CPU_FLAGV) = 0
  Reg(#CPU_FLAGC) = 0
  If Res < -32768 Or Res > 32767
    Reg(#CPU_FLAGC) = $10000
  EndIf
