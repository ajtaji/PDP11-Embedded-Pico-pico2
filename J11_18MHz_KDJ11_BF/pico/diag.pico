; ======================================================================
;  diag.pico - runs PDP-11 diagnostic tapes on the J-11 emulator, with the
;  console DL11 on the Pico's USB serial port.
;
;  TWO WAYS TO GET A TAPE IN
;    * over the serial port, with ONE firmware flashed for good (THE SERIAL
;      TAPE READER below; tools/tape_ladder.py is the host side). Build it
;      with an empty built-in tape:
;          python ../../tools/tape2pico.py --empty
;    * built in, one firmware per tape:
;          python ../../tools/tape2pico.py <tape> [--start OCTAL] [--switches OCTAL]
;      writes tape_image.pico here (and tape_image.pico2 beside diag.pico2):
;      the tape's words, its start address and the switch register's value.
;    Then compile this file.
;
;  WHAT IT DOES
;    With a built-in tape it loads the words into memory (what the Absolute
;    Loader would have done), resets the processor, sets the switch register,
;    and starts at the tape's start address with the PSW at 0 and SP at the
;    start address; with an empty one it waits for a tape on the port. It
;    waits for the serial port to be opened (up to 30 s), so the first
;    characters are not lost, then runs, and:
;      * everything the program types on the console appears on the
;        serial port (bit 7 stripped; NUL and DEL fill characters left
;        out). A BELL is not sent: it is counted, because the T1-T15
;        tapes ring one at the end of every pass, and that count is the
;        pass count;
;      * a character typed at the serial port goes to the console
;        receiver (a $F5 byte starts a loader command instead);
;      * every 2 s a status line: instructions run, bells, the PC;
;      * a HALT prints "HALT at <address of the HALT>" and the registers,
;        stops the processor, and repeats that every 3 s. The board keeps
;        answering USB, loader commands and the uploader's BOOTSEL request
;        throughout.
;
;  THE DISK AND THE CLOCK. The RK11 with its RK05 packs (rk11.pico,
;  disk.pico) and the KW11-L line clock (kw11.pico) are on the bus. BOOT
;  does what the RK05 bootstrap ROM does - block 0 of the pack into
;  000000-000777, then start at 000000 - from any of three places:
;    * typed at the serial port while no program runs:  BOOT RK0
;      (or BOOT RK0 173030 to set the switch register as well);
;    * the tape reader's B frame (drive, switches);
;    * the desk harness's feed, which is the same bytes.
;  A program booted from the disk owns the terminal: its output goes out
;  exactly as typed (no "| " marks, the bell passed through) and there is
;  no status line; the S frame still answers.
;  #DISK_BACKEND picks where the packs live (disk.pico): 2, the flash
;  pack, for the boards; 1, two RAM packs, for the desk's controller
;  tests. #DISK_FLASH_MODEL = 1 is the desk's model of the flash chip.
;  The flash is written a slice of a few hundred microseconds at a time,
;  with the chip's erase and program suspended in between, so the firmware
;  keeps running from flash and serving USB - see disk.pico.
; ======================================================================
#DISK_BACKEND = 2            ; 0 none, 1 RAM (desk), 2 flash (boards)
#DISK_READ_ONLY = 1          ; 1 = the flash is never written (disk.pico; the default: the emulator never writes flash)
#DISK_FLASH_MODEL = 0        ; 1 = the desk model of the flash chip (disk.pico)
#DESK_PROBE = 0            ; 1 = the desk measurement build (see DESK PROBE)
#STAT_CHIP = 2040            ; for the stats block's title
EnableExplicit
XIncludeFile "RP2040/Lib/clocks.pico"
XIncludeFile "RP2040/Lib/timer.pico"
XIncludeFile "RP2040/Lib/uart.pico"
XIncludeFile "RP2040/Lib/usb_serial.pico"
XIncludeFile "RP2040/Lib/safety.pico"
XIncludeFile "cpu.pico"
XIncludeFile "instructions_mmu.pico"
XIncludeFile "instructions.pico"
XIncludeFile "disk.pico"
XIncludeFile "kw11.pico"
XIncludeFile "rk11.pico"
XIncludeFile "tape_image.pico"
XIncludeFile "tapeload.pico"

#CLOCK_KHZ = 200000
; USB IS SERVICED AT LEAST EVERY MILLISECOND, IN EVERY STATE. The USB
; serial library is polled, and its control endpoint must be answered
; promptly while the host opens or closes the port. The first version of
; this file ran 20,000 instructions (about 15 ms) between services: after
; a reader closed the port, both boards stopped answering control
; transfers - the port would not reopen and the uploader's BOOTSEL request
; could not be sent - and both had to be replugged by hand.
; So every loop below calls Service(), and CpuRun gets #SLICE instructions
; at a time: a few hundred microseconds even of the slowest instructions.
; The gaps are MEASURED, not argued: build with #DESK_PROBE = 1 and run
; it in arm_run - see DESK PROBE at the foot.
#SLICE = 200
#PROBE_BOOTSEL_US = 0      ; with the probe: send the reboot phrase after this long (0 = never)

Global Bells.i
Global FromDisk.i           ; the running program was booted from the disk (BOOT)
Global ProgStart.i          ; Micros() when the program was started (the desk's status line)
Global ProgUpSec.i, ProgUpAcc.i   ; UpSec and UpAcc then: the time since BOOT, for as long as it runs
Global Total.i
; THE TWO CORES (Main, Core0Loop, Core1Main below)
Global C0CmdSeq.i, C0Op.i, C0A1.i, C0A2.i   ; a command for core 0: core 1 writes
Global C0DoneSeq.i                         ; core 0 has done it: core 0 writes
Global PswSnap.i                           ; the PSW after core 0's last slice (core 1 must not call PswGet)
Global C1Alone.i                           ; core 1 did not start: the I/O loop runs on core 0, no processor
Global UsbGapMax.i, UsbLastSvc.i           ; core 1: the longest gap between USB services since the banner
Global DkOvFullShown.i                    ; core 1 has said the overlay is full
Global C1Where.i, GapWhere.i               ; what core 1 was doing, and what it was doing in the longest gap
#C0_BOOT = 1
#C0_START = 2
#C0_RESET = 3
#C0_REPORT = 4
#C0_SYNC = 5
#CORE0_SLICE = 1000                        ; instructions per CpuRun on core 0 (the window cap still applies)
#C1_PASS_US = 500                          ; core 1's loop: one pass per 500 us unless there is work (less churn in the shared XIP cache)
Global ClkKhz.i                            ; clk_sys, measured once at start-up (the 1 ms count would be a USB gap)
Global Column.i
Global State.i             ; 0 waiting for the port, 1 running, 2 halted, 3 in a WAIT
Global Dim MaxGap.i(4)     ; the probe: longest gap between services, per State
Global LastService.i
Global ProbeStart.i, ProbeSent.i
Global ProbeMaxRun.i, ProbeMaxDisk.i ; the probe: the longest CpuRun slice and DiskTask step, us

Procedure Service()
  Define svc.i
  svc = Micros()                         ; the longest gap between services, for the stats block
  If UsbLastSvc <> 0 And svc - UsbLastSvc > UsbGapMax
    UsbGapMax = svc - UsbLastSvc
    GapWhere = C1Where
  EndIf
  UsbLastSvc = svc
  CompilerIf #DESK_PROBE = 1
    Define now.i
    Define gap.i
    Define i.i
    now = Micros()
    gap = now - LastService
    If LastService <> 0 And gap > MaxGap(State)
      MaxGap(State) = gap
    EndIf
    LastService = now
    If #PROBE_BOOTSEL_US > 0 And ProbeSent = 0 And (now - ProbeStart) > #PROBE_BOOTSEL_US
      ProbeSent = 1                      ; the phrase, as the uploader sends it,
      UsbSerialWrite(80) : UsbSerialWrite(48 + State) : UsbSerialWrite(10)   ; "P<state>"
      UsbSerialFlush()
      Restore ProbePhrase                ; through the library's own receive path
      For i = 0 To 21
        Read.u gap
        usbser_RxPush(gap)
      Next
    EndIf
  CompilerEndIf
  UsbSerialTask()
EndProcedure

Procedure Ch(c.i)
  UsbSerialWrite(c)
EndProcedure

Procedure Say(*s.i)
  Define p.i
  Define c.i
  p = *s
  c = PeekA(p) & 255
  While c <> 0
    Ch(c)
    p = p + 1
    c = PeekA(p) & 255
  Wend
EndProcedure

Procedure Num(v.i)
  Define n.i
  Define p.i
  n = v
  If n < 0
    Ch(45)
    n = 0 - n
  EndIf
  p = 1
  While n / p >= 10
    p = p * 10
  Wend
  While p > 0
    Ch(48 + (n / p) % 10)
    p = p / 10
  Wend
EndProcedure

Procedure Oct(v.i)                       ; six octal digits, as DEC prints them
  Define k.i
  For k = 15 To 0 Step -3
    Ch(48 + ((v >> k) & 7))
  Next
EndProcedure

Procedure Eol()
  Ch(13)
  Ch(10)
  Column = 0
  UsbSerialFlush()                       ; the library ends a full-packet transfer itself
  Service()
EndProcedure

Procedure Wait(us.i)
  Define t0.i
  t0 = Micros()
  While (Micros() - t0) < us
    Service()
  Wend
EndProcedure

Procedure SayName()
  Define c.i
  Restore TapeName
  Read.u c
  While c <> 0
    Ch(c)
    Read.u c
  Wend
EndProcedure

; What the Absolute Loader does: runs of words into memory.
Procedure LoadTape()
  Define a.i
  Define n.i
  Define w.i
  Restore TapeRuns
  Read.u a
  While (a & 1) = 0
    Read.u n
    While n > 0
      Read.u w
      Mem(a >> 1) = w
      a = a + 2
      n = n - 1
    Wend
    Read.u a
  Wend
EndProcedure


; ======================================================================
;  AUTO-BOOT. A pack can ask to be booted at power-up (rk_image.py
;  --autoboot KERNEL[,SWITCHES]: header +72 u32, bit 16 on and the switch
;  register in bits 15-0; +80 the kernel's name, NUL-terminated). After the
;  banner the firmware says so and waits #AUTO_WAIT_US; Esc (or a loader
;  frame) in that time leaves it at the diagnostic console. Otherwise it
;  boots RK0 with those switches and, when the boot block prints its '@',
;  types the kernel's name and a CR into the console receiver - the same
;  path a typed character takes.
; ======================================================================
#AUTO_WAIT_US = 2000000
#AUTO_NAME_MAX = 15
Global AutoSw.i = -1                     ; -1: the pack does not ask
Global AutoWindow.i, AutoCancel.i, AutoPending.i
Global Dim AutoName.a(#AUTO_NAME_MAX + 1)
Global AutoLen.i
Global LastCr.i                          ; the last console byte was a CR (a CR LF counts once)

; The boot block has printed its '@': type the kernel's name.
Procedure AutoBootType()
  Define i.i
  AutoPending = 0
  For i = 0 To AutoLen - 1
    If (ConInHead - ConInTail) < #CON_SIZE
      ConIn(ConInHead & (#CON_SIZE - 1)) = AutoName(i)
      SmpBarrier()
      ConInHead = ConInHead + 1
    EndIf
  Next
  If (ConInHead - ConInTail) < #CON_SIZE
    ConIn(ConInHead & (#CON_SIZE - 1)) = 13
    SmpBarrier()
    ConInHead = ConInHead + 1
  EndIf
EndProcedure

; The console's output, from the DL11's queue to the serial port. (Input
; goes the other way in Main: the serial port into ConIn.) UsbSerialFlush
; is called only after something was written, as the report firmware does.
; Core 0's console output, to the port - and NEVER WAITING for it. The USB
; library's UsbSerialWrite and UsbSerialFlush wait for the host to take the
; packet before (up to a whole 1 ms USB frame, twice when output keeps
; coming), and for that long core 1 served nothing else: it was the longest
; gap the stats block reported, and it grew as the processor got faster.
; So this writes only what the library takes without waiting
; (UsbSerialWriteRoom), pushes it (UsbSerialPush), and leaves the rest in
; ConOut for the next pass. If nobody has taken anything for #CON_STALL_US
; the port is not being read: the waiting characters are dropped, as the
; library's own bounded wait dropped them before.
#CON_STALL_US = 250000
Global ConStallAt.i                      ; when the port last took a character
Procedure DrainConsole()
  Define c.i
  Define room.i
  room = UsbSerialWriteRoom()
  If ConOutTail = ConOutHead Or room >= 3
    ConStallAt = Micros()
  ElseIf Micros() - ConStallAt > #CON_STALL_US
    ConOutTail = ConOutHead              ; nobody is reading: drop what waits
  EndIf
  While ConOutTail <> ConOutHead And room >= 3
    SmpBarrier()                         ; core 0's head, then the character
    c = ConOut(ConOutTail & (#CON_SIZE - 1)) & $7F
    ConOutTail = ConOutTail + 1
    If FromDisk                          ; a booted system owns the terminal: as typed
      If AutoPending <> 0 And c = 64          ; the boot block's '@': auto-boot types the kernel
        AutoBootType()
      EndIf
      If c <> 0 And c <> 127
        Ch(c)
        room = room - 1
        If c = 7
          Bells = Bells + 1
        EndIf
      EndIf
    ElseIf c = 7
      Bells = Bells + 1
    ElseIf c <> 0 And c <> 127
      If Column = 0 And c <> 13 And c <> 10
        Say("| ")                        ; marks the emulated console's lines
        Column = 2
        room = room - 2
      EndIf
      Ch(c)
      room = room - 1
      Column = Column + 1
      If c = 10
        Column = 0
      EndIf
    EndIf
  Wend
  UsbSerialPush()                        ; hand over what is staged, if the controller is free
EndProcedure

Procedure Status()
  If Column <> 0
    Eol()
  EndIf
  Say("[") : SayName() : Say("] ") : Num(Total) : Say(" instructions, ")
  Num(Bells) : Say(" bells, PC ") : Oct(Reg(7))
  If Waiting
    Say(" (WAIT)")
  EndIf
  If RkReads | RkWrites | KwTicks
    Say(" | RK ") : Num(RkReads) : Say(" read ") : Num(RkWrites) : Say(" written | clock ") : Num(KwTicks)
    Service()                            ; a long line: USB is served between its parts
    DiskStats()
    Service()
  EndIf
  CompilerIf #DESK_PROBE = 1
    Say(" | ") : Num(Micros() - ProgStart) : Say(" us since start")
    Service()
    Say(" | longest gap between USB services, us: port-wait ") : Num(MaxGap(0))
    Say(" running ") : Num(MaxGap(1)) : Say(" halted ") : Num(MaxGap(2)) : Say(" WAIT ") : Num(MaxGap(3))
    Say(" | longest CpuRun slice ") : Num(ProbeMaxRun) : Say(" us, device poll ") : Num(DevPollMax) : Say(" us, DiskTask step ") : Num(ProbeMaxDisk) : Say(" us")
  CompilerEndIf
  Eol()
EndProcedure

Procedure HaltReport()
  Define i.i
  If Column <> 0
    Eol()
  EndIf
  Say("HALT at ") : Oct(Reg(7)) : Say(" (") : SayName() : Say(", ") : Num(Total)
  Say(" instructions, ") : Num(Bells) : Say(" bells)") : Eol()
  For i = 0 To 5
    Say(" R") : Num(i) : Say("=") : Oct(Reg(i))
  Next
  Say(" SP=") : Oct(Reg(6)) : Say(" PSW=") : Oct(PswSnap) : Eol()
  CompilerIf #DESK_PROBE = 1
    Status()
  CompilerEndIf
EndProcedure

; ======================================================================
;  THE SERIAL TAPE READER - tapes sent over the USB serial port, so one
;  firmware stays flashed for the whole ladder (tools/tape_ladder.py is
;  the host side). A FRAME starts with the byte $F5, which no diagnostic
;  sends to the console (they type 7-bit ASCII); every other byte from the
;  port is a character typed at the console.
;
;      $F5  cmd  len-lo len-hi  payload (len bytes)  sum
;
;  sum makes cmd + len-lo + len-hi + the payload + sum = 0 (mod 256). A
;  frame longer than #FRAME_MAX, or with a bad sum, is refused ("#ERR").
;  Commands, each answered with ONE line starting '#' so a host can tell
;  replies from the program's own output:
;    R          reset: stop the processor, clear memory, ready for a tape
;               -> "#READY"
;    T bytes    the next bytes of an absolute-format tape, parsed as they
;               come (tapeload.pico) -> "#T <tape bytes so far>", and at
;               the tape's end "#LOADED <blocks> blocks, <bytes> bytes,
;               start <octal>", or "#ERR tape ..." if the tape is damaged
;    W a,w ...  words (address, value pairs) written into memory after
;               loading - the --patch edits of tape2pico -> "#W <count>"
;    G s,sw     go: start at s ($FFFF = the tape's own start), with the
;               switch register reading sw -> "#GO <start>"; the program
;               then runs exactly as in a built-in-tape firmware
;    H          stop the processor -> "#STOPPED <pc>"
;    Q          the report firmware's behaviour: self-test and benchmark
;               every 3 s -> "#REPORT"; R leaves it
;    S          -> "#STATUS <mode> <instructions> <bells> <pc>"
;    B d,sw     boot drive d of the RK11 with the switch register reading
;               sw (BOOT below) -> "#BOOT RK<d>"
;    D          the disk's counters -> "#DISK ..."; Y asks the flash
;               pack to write back everything cached -> "#SYNC"
;  Typed at the port while no program runs (and never inside a frame):
;    BOOT RKn [octal switches]   the same as the B frame; anything else
;               typed there is answered with a line saying what it takes.
;  Receiving is safe for USB: at most #FEED_MAX bytes are taken per pass
;  of the main loop, each costing a few microseconds, then Service() runs.
; ======================================================================
#FRAME_START = $F5
#FRAME_MAX   = 256
#FEED_MAX    = 64
#MODE_IDLE   = 0             ; no program: waiting for a tape
#MODE_RUN    = 1
#MODE_HALT   = 2
#MODE_REPORT = 3

Global Mode.i
Global FrameState.i          ; 0 none, 1 cmd, 2 len lo, 3 len hi, 4 payload, 5 sum
Global FrameCmd.i, FrameLen.i, FrameGot.i, FrameSum.i
Global Dim FrameBuf.u(#FRAME_MAX)
Global HaltShown.i           ; Micros() of the last HALT report
Global SelfTestPassed.i, SelfTestSteps.i, SelfTestR0.i, BenchInstructions.i, BenchMicros.i
Global FromSerial.i          ; the program came over the serial port (no built-in name)

Procedure SayHost(*s.i)                  ; a reply line: starts '#', on a line of its own
  If Column <> 0
    Eol()
  EndIf
  Ch(35)
  Say(*s)
EndProcedure

; ---- the report firmware's behaviour (pdp11.pico), for Q ------------------
; count per second over us microseconds, to the unit. The long division
; below works in r * 10 with r < us, so us is kept under 200,000,000 (it
; overflowed 32 bits past 214 s): both are halved together, which keeps the
; ratio and loses only the count's lowest bits.
Procedure.i PerSecond(count.i, us.i)
  Define q.i
  Define r.i
  Define k.i
  While us > 200000000
    us = us >> 1
    count = count >> 1
  Wend
  If us <= 0
    ProcedureReturn 0
  EndIf
  q = count / us
  r = count % us
  For k = 1 To 6
    r = r * 10
    q = q * 10 + r / us
    r = r % us
  Next
  ProcedureReturn q
EndProcedure

Procedure ReportCpu()                    ; core 0: the self-test and the benchmark
  Define t0.i
  Mem($100 >> 1) = $15C1                 ; the self-test: 1..10 into R0, then HALT
  Mem($102 >> 1) = $000A
  Mem($104 >> 1) = $0A00
  Mem($106 >> 1) = $6040
  Mem($108 >> 1) = $7E42
  Mem($10A >> 1) = $0000
  CpuReset()
  Reg(6) = $100
  Reg(7) = $100
  SelfTestSteps = CpuRun(1000)
  SelfTestR0 = Reg(0)
  SelfTestPassed = 0
  If Halted = 1 And Reg(0) = 55
    SelfTestPassed = 1
  EndIf
  Mem($200 >> 1) = $15C1                 ; the benchmark: 30,000 x (ADD, SOB)
  Mem($202 >> 1) = 30000
  Mem($204 >> 1) = $0A00
  Mem($206 >> 1) = $6040
  Mem($208 >> 1) = $7E42
  Mem($20A >> 1) = $0000
  CpuReset()
  Reg(6) = $100
  Reg(7) = $200
  t0 = Micros()
  BenchInstructions = 0
  While Halted = 0                       ; core 0 serves no USB: core 1 does, meanwhile
    BenchInstructions = BenchInstructions + CpuRun(#SLICE)
  Wend
  BenchMicros = Micros() - t0
EndProcedure

Procedure ReportPrint()                  ; core 1: what ReportCpu found
  Say("PDP-11 J-11 on Pico, clk_sys kHz ") : Num(ClkKhz) : Eol()
  Say("self-test: R0=") : Num(SelfTestR0) : Say(" steps=") : Num(SelfTestSteps)
  If SelfTestPassed
    Say(" PASS")
  Else
    Say(" FAIL")
  EndIf
  Eol()
  Say("bench: ") : Num(BenchInstructions) : Say(" instructions in ") : Num(BenchMicros) : Say(" us = ")
  If BenchMicros > 0
    Num(PerSecond(BenchInstructions, BenchMicros))
  EndIf
  Say(" instructions/s") : Eol()
EndProcedure


; ======================================================================
;  THE STATS BLOCK - Ctrl-] then s, typed at the serial port. The two
;  bytes never reach the emulated console (Ctrl-] twice sends one Ctrl-]
;  through). Every number is measured when asked, or kept by a counter
;  that already runs; none is written down. It is printed by the firmware
;  between CpuRun slices, with USB served between its lines, so it costs
;  the emulated CPU nothing but the pause of printing.
; ======================================================================
#ESC_KEY = $1D                   ; Ctrl-]
Global EscPending.i
Global StatT0.i, StatN0.i, StatIps.i ; the last one-second sample (StatTick)
Global UpAcc.i, UpSec.i              ; time since power-up, summed from Micros() deltas
Global UpLast.i

; Once a pass of the main loop: the uptime, and every second the rate.
Procedure StatTick()
  Define now.i
  now = Micros()
  UpAcc = UpAcc + (now - UpLast)
  UpLast = now
  While UpAcc >= 1000000
    UpAcc = UpAcc - 1000000
    UpSec = UpSec + 1
  Wend
  If now - StatT0 >= 1000000
    StatIps = PerSecond(InstrCount - StatN0, now - StatT0)
    StatT0 = now
    StatN0 = InstrCount
  EndIf
EndProcedure

Procedure StatLine(*s.i)
  Eol()
  Say(*s)
EndProcedure

Procedure StatsBlock()
  Define khz.i
  Define i.i
  Define nz.i
  Define up.i
  Define t.i
  Define k.i
  C1Where = 9
  Service()
  khz = ClkKhz                           ; measured with the frequency counter at start-up
  Service()
  nz = 0
  For i = 0 To #RAM_WORDS - 1            ; RAM words holding anything, a slice at a time
    If Mem(i)
      nz = nz + 1
    EndIf
    If (i & 255) = 255                   ; USB every 256 words (2048 was a 1.1-1.3 ms gap)
      Service()
    EndIf
  Next
  up = UpSec
  If Column <> 0
    Eol()
  EndIf
  CompilerIf #STAT_CHIP = 2350
    Say("=== PDP-11 emulator stats: RP2350 (Pico 2 W), Cortex-M33, clk_sys ")
  CompilerElse
    Say("=== PDP-11 emulator stats: RP2040 (Pico W), Cortex-M0+, clk_sys ")
  CompilerEndIf
  Num(khz / 1000) : Ch(46) : Num((khz % 1000) / 100) : Say(" MHz (measured at start-up)")
  StatLine("CPU     J-11 (KDJ11-BF), MMU ")
  If MmuOn
    Say("on, ")
    If Mmr3 & $10
      Say("22-bit")
    Else
      Say("18-bit")
    EndIf
  Else
    Say("off (16-bit)")
  EndIf
  Say(", PSW ") : Oct(PswSnap) : Say(", PC ") : Oct(Reg(7))
  If Waiting
    Say(" (WAIT)")
  EndIf
  Service()
  StatLine("speed   ") : Num(StatIps) : Say(" instructions/s over the last second; ")
  t = UpSec - ProgUpSec                  ; since BOOT, from the uptime (Micros() wraps at 71 min)
  k = UpAcc - ProgUpAcc
  If k < 0
    k = k + 1000000
    t = t - 1
  EndIf
  If t >= 1000
    Num(Total / t)                       ; past 1000 s whole seconds are exact enough
  Else
    Num(PerSecond(Total, t * 1000000 + k))
  EndIf
  Say(" average since BOOT (") : Num(Total) : Say(" instructions)")
  StatLine("memory  ") : Num(#RAM_BYTES / 1024) : Say(" KB (000000-") : Oct(#RAM_BYTES - 1) : Say("), ")
  Num(nz * 2 / 1024) : Say(" KB in non-zero words")
  Service()
  StatLine("disk    RK11: ") : Num(RkReads) : Say(" blocks read, ") : Num(RkWrites) : Say(" written")
  CompilerIf #DISK_BACKEND = 2
    StatLine("        cache: ") : Num(DkHits) : Say(" reads from RAM, ") : Num(DkMisses) : Say(" from flash (XIP)")
    If DkSwapN > 0
      StatLine("        swap RAM disk: blocks ") : Num(DkSwapLo) : Say("-") : Num(DkSwapLo + DkSwapN - 1)
      Say(", ") : Num(DkSwapTop) : Say(" of ") : Num(DkSwapN) : Say(" used so far")
      StatLine("        file-write overlay: ") : Num(DkOvUsed) : Say(" of ") : Num(#DK_OV_SLOTS) : Say(" blocks")
    Else
      StatLine("        RAM overlay: ") : Num(DkOvUsed) : Say(" of ") : Num(#DK_OV_SLOTS) : Say(" blocks")
      If DkSwapEnd > DkSwapLo
        Say(" (swap ") : Num(DkSwapLo) : Say("-") : Num(DkSwapEnd - 1) : Say(")")
      EndIf
    EndIf
    If DkOvFull
      Say(", FULL: ") : Num(DkOvFull) : Say(" writes refused")
    EndIf
    If RkBadBlock >= 0                   ; the storage refused a transfer: Unix saw a drive error
      StatLine("        REFUSED: block ") : Num(RkBadBlock) : Say(" (")
      If DkWhy = 6
        Say("RAM overlay full")
      Else
        Say("reason ") : Num(DkWhy)
      EndIf
      Say(") - the last refusal; Unix got a drive error for it")
    EndIf
    StatLine("        flash: ") : Num(DkErases) : Say(" erases, ") : Num(DkPages) : Say(" pages programmed")
    CompilerIf #DISK_READ_ONLY = 1
      Say(" - READ-ONLY build, never written")
    CompilerEndIf
  CompilerEndIf
  Service()
  StatLine("clock   KW11-L: ") : Num(KwTicks) : Say(" ticks at 60 Hz, ") : Num(KwLost + KwMissed) : Say(" dropped")
  If KwIe
    Say(", interrupts on")
  Else
    Say(", interrupts off")
  EndIf
  StatLine("uptime  ") : Num(up / 3600) : Ch(58) : Num((up / 600) % 6) : Num((up / 60) % 10) : Ch(58)
  Num((up / 10) % 6) : Num(up % 10) : Say(" since power-up, ") : Num(UpSec - ProgUpSec) : Say(" s since BOOT")
  If C1Alone
    StatLine("cores   core 1 did not start: the I/O runs on core 0 and the PDP-11 cannot run")
  Else
    StatLine("cores   core 0: the PDP-11 CPU and its device registers; core 1: USB, console, disk storage, 60 Hz, this block")
  EndIf
  StatLine("usb     longest gap between USB services since the banner: ") : Num(UsbGapMax) : Say(" us, during ")
  If GapWhere = 1
    Say("input")
  ElseIf GapWhere = 3
    Say("console output")
  ElseIf GapWhere = 4
    Say("a disk transfer")
  ElseIf GapWhere = 6
    Say("the rate sample")
  ElseIf GapWhere = 8
    Say("the idle wait")
  ElseIf GapWhere = 9
    Say("a stats block")
  ElseIf GapWhere = 11
    Say("a command to core 0")
  ElseIf GapWhere = 12
    Say("a status report")
  Else
    Say("start-up (") : Num(GapWhere) : Say(")")
  EndIf
  StatLine("===")
  Eol()
EndProcedure


; ---- core 1 asks core 0 ------------------------------------------------------
; Everything that resets or starts the processor runs ON CORE 0 (the reset
; reaches the run loop's reserved registers, which only core 0 may touch):
; core 1 writes the command and its number, and waits - serving USB - until
; core 0 has done it between two slices. Bounded: 5 s, then it gives up.
Procedure.i C0Ask(what.i, arg1.i, arg2.i)
  Define t0.i
  If C1Alone
    ProcedureReturn 0
  EndIf
  C0Op = what
  C0A1 = arg1
  C0A2 = arg2
  SmpBarrier()
  C0CmdSeq = C0CmdSeq + 1
  C1Where = 11
  t0 = Micros()
  While C0DoneSeq <> C0CmdSeq
    Service()
    DkServe()
    KwTick()
    If Micros() - t0 > 5000000
      ProcedureReturn 0
    EndIf
  Wend
  SmpBarrier()
  ProcedureReturn 1
EndProcedure

; ---- the frames ------------------------------------------------------------
Procedure ClearMemory()                  ; 512 words at a time, with USB served between
  Define i.i
  For i = 0 To #RAM_WORDS - 1
    Mem(i) = 0
    If (i & 511) = 511
      Service()
    EndIf
  Next
EndProcedure

Procedure StartCpu(start.i, switches.i)  ; core 0
  CpuReset()
  SwitchReg = switches & $FFFF
  PswSet(0)
  Reg(6) = start
  Reg(7) = start
  Total = 0
  ConInTail = ConInHead
EndProcedure

Procedure StartProgram(start.i, switches.i)  ; core 1
  C0Ask(#C0_START, start, switches)
  Bells = 0
  ConOutTail = ConOutHead
  Mode = #MODE_RUN
  FromDisk = 0
  ProgStart = Micros()
  ProgUpSec = UpSec
  ProgUpAcc = UpAcc
EndProcedure

; ---- THE DISK: the counters, and BOOT ------------------------------------
Procedure DiskStats()
  CompilerIf #DISK_BACKEND = 2
    Say(" | flash ") : Num(DkErases) : Say(" erases ") : Num(DkPages) : Say(" pages ")
    Num(DkDirtyCount()) : Say(" dirty ") : Num(DkSkipped) : Say(" unchanged")
    If DkPresent = 0
      Say(" NO PACK IN FLASH")
    EndIf
    Say(" | RAM overlay ") : Num(DkOvUsed) : Say(" of ") : Num(#DK_OV_SLOTS) : Say(" blocks, ")
    Num(DkOvWrites) : Say(" writes, ") : Num(DkSwapSpill) : Say(" swap writes to flash")
    CompilerIf #DISK_READ_ONLY = 1
      Say(" (READ-ONLY build: flash never written)")
    CompilerEndIf
    If DkVerifyFails | DkFatal
      Say(" | FLASH WRITE FAILED ") : Num(DkVerifyFails) : Say(" times")
      If DkFatal
        Say(", writes stopped")
      EndIf
    EndIf
    CompilerIf #DISK_FLASH_MODEL = 1
      Say(" | model ") : Num(MdUsed) : Say(" sectors, ") : Num(MdViolations) : Say(" violations")
      If MdFull
        Say(", MODEL FULL")
      EndIf
    CompilerEndIf
  CompilerEndIf
  If RkBadBlock >= 0
    Say(" | block ") : Num(RkBadBlock) : Say(" refused (") : Num(DkWhy)
    Say(": 1 no pack, 2 past the stored blocks, 3 flash full, 4 flash failed, 5 RAM disk full, 6 RAM overlay full)")
  EndIf
EndProcedure

; One line at start-up saying what pack the flash holds, so a board says
; at once whether its pack UF2 landed.
Procedure DiskBanner()
  CompilerIf #DISK_BACKEND = 2
    Define i.i
    Define c.i
    If DkPresent = 0
      Say("RK0: no pack in the flash at 0x10040000 - pack one with tools/rk_image.py") : Eol()
      Say("RK0: the ")                   ; what is there, so a board shows at once whether a UF2 landed
      If DkInitWhy = 1
        Say("magic")
      ElseIf DkInitWhy = 2
        Say("version")
      Else
        Say("size")
      EndIf
      Say(" check failed; 0x10040000 reads")
      For i = 0 To 15
        c = LlXip16(#DISK_REGION + (i & ~1))
        If i & 1
          c = c >> 8
        EndIf
        c = c & $FF
        Ch(32)
        If (c >> 4) < 10
          Ch(48 + (c >> 4))
        Else
          Ch(55 + (c >> 4))
        EndIf
        If (c & 15) < 10
          Ch(48 + (c & 15))
        Else
          Ch(55 + (c & 15))
        EndIf
      Next
      Eol()
      ProcedureReturn
    EndIf
    Say("RK0: ")
    For i = 0 To 31
      c = LlXip16(#DISK_REGION + 32 + (i & ~1))
      If i & 1
        c = c >> 8
      EndIf
      c = c & $FF
      If c = 0
        Break
      EndIf
      Ch(c)
    Next
    If (DkHeader32(72) >> 16) & 1        ; the pack asks to be booted at power-up
      AutoSw = DkHeader32(72) & $FFFF
      AutoLen = 0
      For i = 0 To #AUTO_NAME_MAX - 1
        c = LlXip16(#DISK_REGION + 80 + (i & ~1))
        If i & 1
          c = c >> 8
        EndIf
        c = c & $FF
        If c = 0
          Break
        EndIf
        AutoName(AutoLen) = c
        AutoLen = AutoLen + 1
      Next
    EndIf
    Say(", ") : Num(DkStored) : Say(" blocks")
    If DkMapped
      Say(" (mapped)")
    EndIf
    If DkSwapN > 0
      Say(", swap ") : Num(DkSwapLo) : Say("-") : Num(DkSwapLo + DkSwapN - 1) : Say(" on a RAM disk")
      If DkSwapEnd - DkSwapLo > DkSwapN
        Say(" (the pack says ") : Num(DkSwapEnd - DkSwapLo) : Say(" - a kernel not patched to match?)")
      EndIf
    ElseIf DkSwapEnd > DkSwapLo
      Say(", swap ") : Num(DkSwapLo) : Say("-") : Num(DkSwapEnd - 1) : Say(" in RAM")
    EndIf
    CompilerIf #DISK_READ_ONLY = 1
      Say(", READ-ONLY: the flash is never written")
    CompilerEndIf
    Eol()
  CompilerEndIf
EndProcedure

; What the RK05 bootstrap ROM does: block 0 of the drive into 000000-
; 000777 through the controller, then a jump to 000000 with the drive in
; R0 (as DEC's ROMs leave it); a controller error halts at 157042. It is
; a real PDP-11 program at 157000 (the top of the 56 KB), so the RK11
; sees exactly the register writes a ROM would make:
;   157000 012737 d<<13 177412   MOV #d<<13,@#RKDA
;   157006 005037 177410         CLR @#RKBA
;   157012 012737 177400 177406  MOV #-256.,@#RKWC
;   157020 012737 000005 177404  MOV #5,@#RKCS        read, GO
;   157026 105737 177404         TSTB @#RKCS          ready?
;   157032 100375                BPL 157026
;   157034 005737 177404         TST @#RKCS           error?
;   157040 100001                BPL 157044
;   157042 000000                HALT
;   157044 012700 d              MOV #d,R0
;   157050 005007                CLR PC               start at 000000
#BOOT_AT = $DE00                  ; 157000
Procedure BootRkCpu(d.i, switches.i)   ; core 0
  Define a.i
  CpuReset()                              ; the bus INIT: kernel, priority 7
  SwitchReg = switches & $FFFF
  a = #BOOT_AT >> 1
  Mem(a) = $15DF : Mem(a + 1) = (d & 7) << 13 : Mem(a + 2) = $FF0A
  Mem(a + 3) = $0A1F : Mem(a + 4) = $FF08
  Mem(a + 5) = $15DF : Mem(a + 6) = $FF00 : Mem(a + 7) = $FF06
  Mem(a + 8) = $15DF : Mem(a + 9) = 5 : Mem(a + 10) = $FF04
  Mem(a + 11) = $8BDF : Mem(a + 12) = $FF04
  Mem(a + 13) = $80FD
  Mem(a + 14) = $0BDF : Mem(a + 15) = $FF04
  Mem(a + 16) = $8001
  Mem(a + 17) = 0
  Mem(a + 18) = $15C0 : Mem(a + 19) = d & 7
  Mem(a + 20) = $0A07
  Reg(6) = #BOOT_AT
  Reg(7) = #BOOT_AT
  Total = 0
  ConInTail = ConInHead
EndProcedure

Procedure BootRk(d.i, switches.i)        ; core 1
  C0Ask(#C0_BOOT, d, switches)
  Bells = 0
  ConOutTail = ConOutHead
  Mode = #MODE_RUN
  FromDisk = 1
  ProgStart = Micros()
  ProgUpSec = UpSec
  ProgUpAcc = UpAcc
EndProcedure

; ---- a command typed while no program runs --------------------------------
#LINE_MAX = 40
Global Dim TypedLine.a(#LINE_MAX)
Global TypedLen.i

Procedure TypedCommand()
  Define i.i
  Define c.i
  Define d.i
  Define sw.i
  ; BOOT RKn [octal]
  If TypedLen >= 8
    If TypedLine(0) = 66 And TypedLine(1) = 79 And TypedLine(2) = 79 And TypedLine(3) = 84 And TypedLine(4) = 32 And TypedLine(5) = 82 And TypedLine(6) = 75
      d = TypedLine(7) - 48
      If d >= 0 And d < #RK_DRIVES And (TypedLen = 8 Or TypedLine(8) = 32)
        sw = 0
        For i = 9 To TypedLen - 1
          c = TypedLine(i)
          If c >= 48 And c <= 55
            sw = (sw << 3) | (c - 48)
          EndIf
        Next
        If DiskPresent(d)
          Say("booting RK") : Num(d) : Say(", switches ") : Oct(sw) : Eol()
          BootRk(d, sw)
        Else
          Say("RK") : Num(d) : Say(" has no pack: nothing is in the disk image area of the flash. Pack one with tools/rk_image.py.") : Eol()
        EndIf
        ProcedureReturn
      EndIf
    EndIf
  EndIf
  If TypedLen > 0
    Say("? type BOOT RK0 (or BOOT RK0 173030 to set the switch register as well)") : Eol()
  EndIf
EndProcedure

Procedure TypedChar(c.i)
  If c = 13 Or c = 10
    If Column <> 0 Or TypedLen > 0
      Eol()
    EndIf
    TypedCommand()
    TypedLen = 0
  ElseIf c = 8 Or c = 127
    If TypedLen > 0
      TypedLen = TypedLen - 1
      Ch(8) : Ch(32) : Ch(8)
    EndIf
  ElseIf c >= 32 And c < 127 And TypedLen < #LINE_MAX
    If c >= 97 And c <= 122
      c = c - 32                          ; BOOT rk0 works too
    EndIf
    TypedLine(TypedLen) = c
    TypedLen = TypedLen + 1
    Ch(c)
    Column = Column + 1
  EndIf
  UsbSerialFlush()
EndProcedure

Procedure DoFrame()
  Define i.i
  Define a.i
  Define w.i
  If FrameCmd = 82                       ; R
    Mode = #MODE_IDLE                    ; core 0 stops at the end of its slice
    C0Ask(#C0_RESET, 0, 0)               ; ... and resets the processor there
    ClearMemory()
    TapeReset()
    Mode = #MODE_IDLE
    FromSerial = 1
    SayHost("READY") : Eol()
  ElseIf FrameCmd = 84                   ; T
    For i = 0 To FrameLen - 1
      If TapeByte(FrameBuf(i))
        SayHost("LOADED ") : Num(TapeBlocks) : Say(" blocks, ") : Num(TapeBytes)
        Say(" bytes, start ") : Oct(TapeStart) : Eol()
      EndIf
    Next
    If TapeError
      SayHost("ERR tape ") : Num(TapeError) : Say(" at tape byte ") : Num(TapeErrAt)
      Say(" (1 no 001 000 block start, 2 byte count below 6, 3 outside RAM, 4 bad checksum)") : Eol()
    Else
      SayHost("T ") : Num(TapeIn) : Eol()
    EndIf
  ElseIf FrameCmd = 87                   ; W
    i = 0
    While i + 3 < FrameLen
      a = FrameBuf(i) | (FrameBuf(i + 1) << 8)
      w = FrameBuf(i + 2) | (FrameBuf(i + 3) << 8)
      If (a & 1) = 0 And a < #RAM_BYTES
        Mem(a >> 1) = w
      EndIf
      i = i + 4
    Wend
    SayHost("W ") : Num(FrameLen / 4) : Eol()
  ElseIf FrameCmd = 71                   ; G
    a = FrameBuf(0) | (FrameBuf(1) << 8)
    If a = $FFFF
      a = TapeStart
    EndIf
    If (a & 1) <> 0 Or a >= #RAM_BYTES Or FrameLen < 4
      SayHost("ERR go: no start address (odd, outside RAM, or no tape loaded)") : Eol()
    Else
      StartProgram(a, FrameBuf(2) | (FrameBuf(3) << 8))
      SayHost("GO ") : Oct(a) : Eol()
    EndIf
  ElseIf FrameCmd = 72                   ; H
    If Mode = #MODE_RUN
      Mode = #MODE_HALT
    EndIf
    C0Ask(#C0_SYNC, 0, 0)                ; core 0 has finished its slice: Reg(7) is settled
    SayHost("STOPPED ") : Oct(Reg(7)) : Eol()
  ElseIf FrameCmd = 81                   ; Q
    Mode = #MODE_REPORT
    HaltShown = Micros() - 3000000
    SayHost("REPORT") : Eol()
  ElseIf FrameCmd = 83                   ; S
    SayHost("STATUS ") : Num(Mode) : Ch(32) : Num(Total) : Ch(32) : Num(Bells) : Ch(32) : Oct(Reg(7)) : Eol()
  ElseIf FrameCmd = 66                   ; B
    a = FrameBuf(0)
    w = 0
    If FrameLen >= 3
      w = FrameBuf(1) | (FrameBuf(2) << 8)
    EndIf
    If FrameLen < 1 Or a >= #RK_DRIVES
      SayHost("ERR boot: no such drive") : Eol()
    ElseIf DiskPresent(a) = 0
      SayHost("ERR boot: RK") : Num(a) : Say(" has no pack") : Eol()
    Else
      SayHost("BOOT RK") : Num(a) : Eol()
      BootRk(a, w)
    EndIf
  ElseIf FrameCmd = 68                   ; D
    SayHost("DISK RK ") : Num(RkReads) : Say(" read ") : Num(RkWrites) : Say(" written | clock ") : Num(KwTicks)
    Say(" ticks ") : Num(KwLost + KwMissed) : Say(" lost")
    DiskStats()
    Eol()
  ElseIf FrameCmd = 89                   ; Y
    DiskSync()
    SayHost("SYNC") : Eol()
  Else
    SayHost("ERR unknown command ") : Num(FrameCmd) : Eol()
  EndIf
EndProcedure

; One byte from the port: part of a frame, or a character for the console.
Procedure InByte(c.i)
  c = c & $FF
  If AutoWindow <> 0 And FrameState = 0       ; the auto-boot's 2 s: Esc or a frame stops it
    If c = 27
      AutoCancel = 1
      ProcedureReturn
    ElseIf c <> #FRAME_START
      ProcedureReturn                    ; anything else typed then is dropped
    EndIf
    AutoCancel = 1
  EndIf
  If FrameState = 0 And EscPending = 0     ; (a frame's start clears it too)
    If c = 10 And LastCr <> 0               ; CR LF from a terminal or a paste: one line end
      LastCr = 0
      ProcedureReturn
    EndIf
    LastCr = 0
    If c = 13
      LastCr = 1
    EndIf
  EndIf
  If FrameState = 0 And EscPending <> 0   ; Ctrl-] then a key: the firmware's, not Unix's
    EscPending = 0
    If c = 115 Or c = 83                 ; s: the stats block
      StatsBlock()
      ProcedureReturn
    EndIf
    If c <> #ESC_KEY                     ; anything else: nothing (Ctrl-] Ctrl-] sends one)
      ProcedureReturn
    EndIf
  ElseIf FrameState = 0 And c = #ESC_KEY
    EscPending = 1
    ProcedureReturn
  EndIf
  If FrameState = 0
    If c = #FRAME_START
      FrameState = 1
    ElseIf Mode = #MODE_RUN
      If (ConInHead - ConInTail) < #CON_SIZE
        ConIn(ConInHead & (#CON_SIZE - 1)) = c
        SmpBarrier()                     ; the character, then the head core 0 reads
        ConInHead = ConInHead + 1
      EndIf
    Else
      TypedChar(c)                        ; no program runs: a command (BOOT)
    EndIf
  ElseIf FrameState = 1
    FrameCmd = c
    FrameSum = c
    FrameState = 2
  ElseIf FrameState = 2
    FrameLen = c
    FrameSum = FrameSum + c
    FrameState = 3
  ElseIf FrameState = 3
    FrameLen = FrameLen | (c << 8)
    FrameSum = FrameSum + c
    FrameGot = 0
    If FrameLen > #FRAME_MAX
      FrameState = 0
      SayHost("ERR frame longer than 256 bytes") : Eol()
    ElseIf FrameLen = 0
      FrameState = 5
    Else
      FrameState = 4
    EndIf
  ElseIf FrameState = 4
    FrameBuf(FrameGot) = c
    FrameGot = FrameGot + 1
    FrameSum = FrameSum + c
    If FrameGot = FrameLen
      FrameState = 5
    EndIf
  Else
    FrameState = 0
    If ((FrameSum + c) & $FF) = 0
      DoFrame()
    Else
      SayHost("ERR frame checksum") : Eol()
    EndIf
  EndIf
EndProcedure

CompilerIf #DESK_PROBE = 1
; THE DESK FEED: arm_run's USB host sends nothing to the board, so the probe
; build takes the bytes tools/tape_ladder.py WOULD send (its --dump writes
; them into an empty tape_image, as ProbeFeed) and hands them to InByte, the same path the
; port's bytes take, #FEED_MAX at a time. A 256 in the feed means "wait
; until the program halts, or rings a bell (and 2.5 s more, for the status
; line that shows it), or 3 s pass" - the pause the host spends reading a
; verdict. A 257 followed by n means "wait n tenths of a second" - how
; tools/rk_desk.py's feed lets a booted system reach its next prompt.
Global FeedPos.i, FeedWaitFrom.i, FeedBells.i, FeedLoaded.i, FeedUntil.i
Global Dim FeedBuf.u(#FEED_LEN + 1)   ; + 1: an empty feed still declares the array
Procedure ProbeFeedLoad()                ; the feed into RAM once, before timing starts
  Define k.i
  Define c.i
  Restore ProbeFeed
  For k = 0 To #FEED_LEN - 1
    Read.u c
    FeedBuf(k) = c
  Next
  FeedLoaded = 1
EndProcedure

Procedure ProbeFeedStep()
  Define k.i
  Define c.i
  If FeedLoaded = 0
    ProcedureReturn
  EndIf
  If FeedPos < 0 Or FeedPos >= #FEED_LEN
    ProcedureReturn
  EndIf
  If FeedUntil
    If Micros() - FeedUntil < 0
      ProcedureReturn
    EndIf
    FeedUntil = 0
  EndIf
  If FeedWaitFrom
    If Mode = #MODE_RUN And Bells = FeedBells And (Micros() - FeedWaitFrom) < 3000000
      ProcedureReturn
    EndIf
    If Bells <> FeedBells And FeedBells >= 0   ; a bell: wait for the status line that shows it
      FeedBells = -1
      FeedWaitFrom = Micros() - 500000
    EndIf
    If FeedBells = -1 And (Micros() - FeedWaitFrom) < 3000000
      ProcedureReturn
    EndIf
    FeedWaitFrom = 0
  EndIf
  For k = 1 To #FEED_MAX
    If FeedPos >= #FEED_LEN
      ProcedureReturn
    EndIf
    c = FeedBuf(FeedPos)
    FeedPos = FeedPos + 1
    If c = 256
      FeedWaitFrom = Micros()
      FeedBells = Bells
      ProcedureReturn
    EndIf
    If c = 257 And FeedPos < #FEED_LEN
      FeedUntil = Micros() + FeedBuf(FeedPos) * 100000
      FeedPos = FeedPos + 1
      If FeedUntil = 0
        FeedUntil = 1
      EndIf
      ProcedureReturn
    EndIf
    InByte(c)
  Next
EndProcedure
CompilerEndIf

; Up to #FEED_MAX bytes from the port per pass of the main loop.
Procedure ReadPort()
  Define k.i
  k = 0
  While k < #FEED_MAX And UsbSerialAvailable() > 0
    If Mode = #MODE_RUN And FrameState = 0 And (ConInHead - ConInTail) >= #CON_SIZE
      Break                              ; a long paste: the rest waits in the port until there is room
    EndIf
    InByte(UsbSerialRead())
    k = k + 1
  Wend
  CompilerIf #DESK_PROBE = 1
    ProbeFeedStep()
  CompilerEndIf
EndProcedure


Procedure AutoBootWait()
  Define t0.i
  If AutoSw < 0 Or Mode <> #MODE_IDLE
    ProcedureReturn
  EndIf
  Say("auto-boot: RK0, switches ") : Oct(AutoSw) : Say(", then ")
  Ch(34)
  For t0 = 0 To AutoLen - 1
    Ch(AutoName(t0))
  Next
  Ch(34) : Say(" at the @ prompt. Press Esc within 2 s for the diagnostic console.") : Eol()
  UsbSerialFlush()
  AutoWindow = 1
  AutoCancel = 0
  t0 = Micros()
  While (Micros() - t0) < #AUTO_WAIT_US And AutoCancel = 0
    ReadPort()
    Service()
    KwTick()
    DkServe()
  Wend
  AutoWindow = 0
  If AutoCancel
    Say("auto-boot cancelled: the diagnostic console. Type BOOT RK0 173030 to boot by hand.") : Eol()
    ProcedureReturn
  EndIf
  Say("booting RK0, switches ") : Oct(AutoSw) : Eol()
  BootRk(0, AutoSw)
  AutoPending = 1
EndProcedure


CompilerIf #DESK_PROBE = 1
; THE DESK'S STATE CHECK (#DESK_PROBE = 1): every #CHK_EVERY instructions
; core 0 stops exactly there and sums the registers, the PSW and memory;
; core 1 prints "[check] <instructions> <sum>". Two builds that run the
; same program must print the same lines - the word-for-word proof that a
; change to the firmware around the processor left the processor alone.
#CHK_EVERY = 1000000
Global ChkNext.i = #CHK_EVERY, ChkSeq.i, ChkShown.i, ChkAt.i, ChkSum.i

Procedure.i ChkState()
  Define i.i
  Define s.i
  s = PswGet()
  For i = 0 To 7
    s = (s * 31 + Reg(i)) & $7FFFFFFF
  Next
  For i = 0 To #RAM_WORDS - 1
    s = (s * 31 + Mem(i)) & $7FFFFFFF
  Next
  ProcedureReturn s
EndProcedure
CompilerEndIf

; ---- core 0: the processor ------------------------------------------------
; Between slices it answers core 1's commands; otherwise it runs the program
; while core 1 says RUN and the processor is not halted.
Procedure C0Do(what.i, arg1.i, arg2.i)
  If what = #C0_BOOT
    BootRkCpu(arg1, arg2)
  ElseIf what = #C0_START
    StartCpu(arg1, arg2)
  ElseIf what = #C0_RESET
    CpuReset()
    Halted = 1
  ElseIf what = #C0_REPORT
    ReportCpu()
  EndIf
  PswSnap = PswGet()
EndProcedure

Procedure Core0Loop()
  CompilerIf #DESK_PROBE = 1
    Define t0.i
  CompilerEndIf
  Repeat
    If C0CmdSeq <> C0DoneSeq
      SmpBarrier()                       ; the command's number, then its words
      C0Do(C0Op, C0A1, C0A2)
      SmpBarrier()                       ; everything it did, then the answer
      C0DoneSeq = C0CmdSeq
    ElseIf Mode = #MODE_RUN And Halted = 0
      CompilerIf #DESK_PROBE = 1
        t0 = Micros()
        If ChkNext - Total < #CORE0_SLICE
          Total = Total + CpuRun(ChkNext - Total)
        Else
          Total = Total + CpuRun(#CORE0_SLICE)
        EndIf
        If Total >= ChkNext
          ChkAt = Total
          ChkSum = ChkState()
          SmpBarrier()
          ChkSeq = ChkSeq + 1
          ChkNext = ChkNext + #CHK_EVERY
        EndIf
      CompilerElse
        Total = Total + CpuRun(#CORE0_SLICE)
      CompilerEndIf
      PswSnap = PswGet()
      CompilerIf #DESK_PROBE = 1
        If Micros() - t0 > ProbeMaxRun
          ProbeMaxRun = Micros() - t0
        EndIf
      CompilerEndIf
    EndIf
  ForEver
EndProcedure

; ---- core 1: everything else -------------------------------------------------
Procedure Core1Main()
  Define t0.i
  Define tlast.i
  Define tdisk.i
  Define tpass.i
  State = 0
  ProbeStart = Micros()
  KwNext = Micros() + #KW_PERIOD_US       ; the line clock's time is core 1's
  t0 = Micros()                          ; the port opened, or 30 s
  While UsbSerialReady() = 0 And (Micros() - t0) < 30000000
    Service()
    DkServe()
    KwTick()
  Wend
  ClkKhz = ClockSysKhz()                 ; before the banner: its 1 ms is not a gap anyone sees
  t0 = Micros()
  While (Micros() - t0) < 500000         ; the half second the port needs, served
    Service()
    KwTick()
    DkServe()
  Wend
  If Mode = #MODE_RUN
    Say("PDP-11 J-11 on Pico: ") : SayName() : Say(" from ") : Oct(#TAPE_START)
    Say(", switches ") : Oct(#TAPE_SWITCHES) : Eol()
  Else
    Say("PDP-11 J-11 on Pico: serial tape reader ready") : Eol()
    If C1Alone
      Say("core 1 did not start: the PDP-11 cannot run in this boot; the port stays up for a re-flash") : Eol()
    EndIf
    DiskBanner()
    AutoBootWait()
  EndIf
  UsbGapMax = 0                          ; from here on, the gaps the stats block reports
  UsbLastSvc = 0
  tlast = Micros()
  Repeat
    tpass = Micros()
    C1Where = 3
    If Mode = #MODE_RUN
      State = 1 + 2 * Waiting            ; 1 running, 3 in a WAIT
      DrainConsole()
      CompilerIf #DISK_BACKEND = 2
        If DkOvFull <> 0 And DkOvFullShown = 0   ; once: the overlay for file writes is full
          DkOvFullShown = 1
          If Column <> 0
            Eol()
          EndIf
          Say("[RK0: the RAM overlay for file writes is full (") : Num(#DK_OV_SLOTS)
          Say(" blocks): a write to a new block now fails, Unix sees a disk error. Nothing reaches the flash;")
          Say(" power off to start clean]") : Eol()
        EndIf
      CompilerEndIf
      CompilerIf #DESK_PROBE = 1
        If ChkSeq <> ChkShown
          ChkShown = ChkSeq
          SmpBarrier()
          If Column <> 0
            Eol()
          EndIf
          Say("[check] ") : Num(ChkAt) : Ch(32) : Num(ChkSum) : Eol()
        EndIf
      CompilerEndIf
      If Halted
        C0Ask(#C0_SYNC, 0, 0)            ; core 0 is between slices: the registers are settled
        DrainConsole()
        State = 2
        Mode = #MODE_HALT
        HaltReport()
        HaltShown = Micros()
      ElseIf (Micros() - tlast) >= 2000000 And (FromDisk = 0 Or #DESK_PROBE = 1)
        tlast = Micros()
        C1Where = 12
        If FromDisk = 0
          Status()
        ElseIf (Micros() - tdisk) >= 10000000
          tdisk = Micros()                 ; the desk: a booted system's counters every 10 s
          Status()
        EndIf
      EndIf
    ElseIf Mode = #MODE_HALT
      State = 2
      If (Micros() - HaltShown) >= 3000000
        HaltShown = Micros()
        If Halted
          HaltReport()
        Else
          Status()
        EndIf
      EndIf
    ElseIf Mode = #MODE_REPORT
      State = 2
      If (Micros() - HaltShown) >= 3000000
        HaltShown = Micros()
        If C0Ask(#C0_REPORT, 0, 0)
          ReportPrint()
        EndIf
      EndIf
    Else
      State = 0
    EndIf
    C1Where = 1
    ReadPort()
    Service()
    C1Where = 4
    DkServe()                            ; the disk's storage for core 0's RK11
    KwTick()                             ; the line clock's 60 Hz
    C1Where = 6
    CompilerIf #DESK_PROBE = 1
      t0 = Micros()
    CompilerEndIf
    DiskTask()
    StatTick()
    CompilerIf #DESK_PROBE = 1
      If Micros() - t0 > ProbeMaxDisk
        ProbeMaxDisk = Micros() - t0
      EndIf
    CompilerEndIf
    Service()
    C1Where = 8
    While (Micros() - tpass) < #C1_PASS_US And ConOutHead = ConOutTail And DkReqSeq = DkDoneSeq
      If Micros() - UsbLastSvc > 250     ; nothing to do: USB and the clock every 250 us
        Service()
        KwTick()
      EndIf
    Wend
  ForEver
EndProcedure

; The launch in a procedure of its own: the intrinsic works in r4-r7, and
; r4 holds FlagNZ for the processor - here it is saved and given back.
Procedure.i LaunchCore1()
  ProcedureReturn multicore_launch()
EndProcedure

Procedure Main()
  SafetyBoot()
  ClockInitKhz(#CLOCK_KHZ)
  UsbSerialInit()
  SafetyOk()
  BuildOpcodeTable()
  BuildOpcodeTableM()                    ; the mapped loop's table too, before any timing
  DiskInit()
  TapeReset()
  LoadTape()
  If #TAPE_START & 1                     ; no built-in tape: wait for one on the port
    Mode = #MODE_IDLE
    CpuReset()
    Halted = 1
    FromSerial = 1
  Else
    StartCpu(#TAPE_START, #TAPE_SWITCHES)
    Bells = 0
    ConOutTail = ConOutHead
    Mode = #MODE_RUN
    FromDisk = 0
    ProgStart = Micros()
    ProgUpSec = UpSec
    ProgUpAcc = UpAcc
  EndIf
  CompilerIf #DESK_PROBE = 1
    ProbeFeedLoad()
  CompilerEndIf
  PswSnap = PswGet()
  SmpBarrier()                           ; all of the above, before core 1 starts
  If LaunchCore1() = 1                   ; core 1 runs Core1Main
    Core0Loop()                          ; never returns
  EndIf
  C1Alone = 1                            ; core 1 did not answer: keep USB alive on core 0
  Core1Main()
EndProcedure

; ======================================================================
;  DESK PROBE (#DESK_PROBE = 1) - the proof that this firmware cannot
;  starve USB. Service() times every gap between two services and keeps
;  the longest for each state (waiting for the port, running, halted, in
;  a WAIT); the status line and the HALT report print them. With
;  #PROBE_BOOTSEL_US set it also feeds the uploader's reboot phrase into
;  the USB library's receive path after that long, in whatever state the
;  processor is in then - arm_run reports "rebooted to BOOTSEL" when it
;  works. (The emulator's USB host sends nothing to the board, so the
;  phrase goes in one step past the wire: the library's own receive
;  routine, which is what the bytes reach from the wire.)
; ======================================================================
CompilerIf #DESK_PROBE = 1
DataSection
ProbePhrase:
  Data.u 82, 101, 115, 101, 116, 80, 105, 99, 111, 84, 111, 66, 111, 111, 116, 83, 101, 108, 49, 50, 53, 52
EndDataSection
CompilerEndIf
