; ======================================================================
;  instructions.pico2 - every J-11 instruction as one procedure, and the
;  jump table that dispatches them. Raspberry Pi Pico 2 (RP2350).
;
;  Requires cpu.pico2 - include it BEFORE this file.
;
;  ONE PROCEDURE PER INSTRUCTION, named Instruction<MNEMONIC>_<octal>.
;  BuildOpcodeTable() at the foot fills OpTable() so that
;      CallFunctionFast(OpTable(Op))
;  runs the right one. On the Pico 2 the table has one entry per opcode
;  (65,536), so the commonest register forms get their own handlers - see
;  REGISTER FAST PATHS near the foot. Entry comments below are in the
;  Pico's 8192-entry numbering (Op >> 3); multiply by 8 for this table.
;
;  THE SHAPE OF A HANDLER, and why (see SPEED in cpu.pico2):
;    * no Protected locals - Src, Dst, Res and Ea are Globals, cheaper here;
;    * register mode (mode 0) is tested for and done INLINE, so the common
;      case never pays for a call;
;    * N and Z are one store to FlagNZ (word result as is, byte result
;      shifted left 8); V and C are plain stores;
;    * the emulated time is added last: ClockCycles = ClockCycles + #J11_T_*
;      (the compiler refuses the "ClockCycles + n" shorthand - write it out).
;
;  ;name and ;disassembly lines are kept, commented out, as in the 8080
;  core this layout comes from - a disassembler can be switched in later
;  without touching the arithmetic.
; ======================================================================

;-MOV-------------------------------------------------------------------
Procedure InstructionMOV_01()            ; 01SSDD   entries $0200-$03FF
  ;name = "MOV"
  Src = SrcWord()
  If (Op & $38) = 0
    Reg(Op & 7) = Src
  Else
    WriteWord(EaWord(Op & $3F), Src)
  EndIf
  FlagNZ = Src
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("MOV " + ;name)
EndProcedure

Procedure InstructionMOVB_11()           ; 11SSDD   entries $1200-$13FF
  ;name = "MOVB"
  Src = SrcByte()
  If (Op & $38) = 0
    Reg(Op & 7) = (Src | (0 - (Src & $80))) & $FFFF   ; to a register it is sign-extended
  Else
    WriteByte(EaByte(Op & $3F), Src)
  EndIf
  FlagNZ = Src << 8
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("MOVB " + ;name)
EndProcedure

;-CMP-------------------------------------------------------------------
Procedure InstructionCMP_02()            ; 02SSDD   entries $0400-$05FF
  ;name = "CMP"
  Src = SrcWord()
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
  Else
    Dst = ReadWord(EaWord(Op & $3F))
  EndIf
  Res = Src - Dst                        ; src - dst, the other way round from SUB
  FlagC = (Res >> 16) & 1
  FlagV = (((Src ! Dst) & (Src ! Res)) >> 15) & 1
  FlagNZ = Res & $FFFF
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("CMP " + ;name)
EndProcedure

Procedure InstructionCMPB_12()           ; 12SSDD   entries $1400-$15FF
  ;name = "CMPB"
  Src = SrcByte()
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
  Else
    Dst = ReadByte(EaByte(Op & $3F))
  EndIf
  Res = Src - Dst
  FlagC = (Res >> 8) & 1
  FlagV = (((Src ! Dst) & (Src ! Res)) >> 7) & 1
  FlagNZ = (Res & $FF) << 8
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("CMPB " + ;name)
EndProcedure

;-BIT-------------------------------------------------------------------
Procedure InstructionBIT_03()            ; 03SSDD   entries $0600-$07FF
  ;name = "BIT"
  Src = SrcWord()
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
  Else
    Dst = ReadWord(EaWord(Op & $3F))
  EndIf
  FlagNZ = Src & Dst
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BIT " + ;name)
EndProcedure

Procedure InstructionBITB_13()           ; 13SSDD   entries $1600-$17FF
  ;name = "BITB"
  Src = SrcByte()
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
  Else
    Dst = ReadByte(EaByte(Op & $3F))
  EndIf
  FlagNZ = (Src & Dst) << 8
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BITB " + ;name)
EndProcedure

;-BIC-------------------------------------------------------------------
Procedure InstructionBIC_04()            ; 04SSDD   entries $0800-$09FF
  ;name = "BIC"
  Src = SrcWord()
  If (Op & $38) = 0
    Res = Reg(Op & 7) & ~Src & $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Res = ReadWord(Ea) & ~Src & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagNZ = Res
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BIC " + ;name)
EndProcedure

Procedure InstructionBICB_14()           ; 14SSDD   entries $1800-$19FF
  ;name = "BICB"
  Src = SrcByte()
  If (Op & $38) = 0
    Res = Reg(Op & 7) & ~Src & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Res = ReadByte(Ea) & ~Src & $FF
    WriteByte(Ea, Res)
  EndIf
  FlagNZ = Res << 8
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BICB " + ;name)
EndProcedure

;-BIS-------------------------------------------------------------------
Procedure InstructionBIS_05()            ; 05SSDD   entries $0A00-$0BFF
  ;name = "BIS"
  Src = SrcWord()
  If (Op & $38) = 0
    Res = Reg(Op & 7) | Src
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Res = ReadWord(Ea) | Src
    WriteWord(Ea, Res)
  EndIf
  FlagNZ = Res
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BIS " + ;name)
EndProcedure

Procedure InstructionBISB_15()           ; 15SSDD   entries $1A00-$1BFF
  ;name = "BISB"
  Src = SrcByte()
  If (Op & $38) = 0
    Res = (Reg(Op & 7) | Src) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Res = ReadByte(Ea) | Src
    WriteByte(Ea, Res)
  EndIf
  FlagNZ = Res << 8
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BISB " + ;name)
EndProcedure

;-ADD-------------------------------------------------------------------
Procedure InstructionADD_06()            ; 06SSDD   entries $0C00-$0DFF
  ;name = "ADD"
  Src = SrcWord()
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = Src + Dst
    Reg(Op & 7) = Res & $FFFF
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = Src + Dst
    WriteWord(Ea, Res)
  EndIf
  FlagC = (Res >> 16) & 1
  FlagV = ((~(Src ! Dst) & (Src ! Res)) >> 15) & 1
  FlagNZ = Res & $FFFF
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("ADD " + ;name)
EndProcedure

;-SUB-------------------------------------------------------------------
Procedure InstructionSUB_16()            ; 16SSDD   entries $1C00-$1DFF
  ;name = "SUB"
  Src = SrcWord()
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = Dst - Src
    Reg(Op & 7) = Res & $FFFF
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = Dst - Src
    WriteWord(Ea, Res)
  EndIf
  FlagC = (Res >> 16) & 1                ; borrow
  FlagV = (((Src ! Dst) & (Dst ! Res)) >> 15) & 1
  FlagNZ = Res & $FFFF
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("SUB " + ;name)
EndProcedure

; ======================================================================
;  SINGLE-OPERAND. The destination is fetched at the top and stored at
;  the bottom, each with register mode inline.
; ======================================================================

;-CLR-------------------------------------------------------------------
Procedure InstructionCLR_0050()          ; 0050DD   entries $0140-$0147
  ;name = "CLR"
  If (Op & $38) = 0
    Reg(Op & 7) = 0
  Else
    WriteWord(EaWord(Op & $3F), 0)
  EndIf
  FlagNZ = 0
  FlagV = 0
  FlagC = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("CLR " + ;name)
EndProcedure

Procedure InstructionCLRB_1050()         ; 1050DD   entries $1140-$1147
  ;name = "CLRB"
  If (Op & $38) = 0
    Reg(Op & 7) = Reg(Op & 7) & $FF00
  Else
    WriteByte(EaByte(Op & $3F), 0)
  EndIf
  FlagNZ = 0
  FlagV = 0
  FlagC = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("CLRB " + ;name)
EndProcedure

;-COM-------------------------------------------------------------------
Procedure InstructionCOM_0051()          ; 0051DD   entries $0148-$014F
  ;name = "COM"
  If (Op & $38) = 0
    Res = Reg(Op & 7) ! $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Res = ReadWord(Ea) ! $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagNZ = Res
  FlagV = 0
  FlagC = 1
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("COM " + ;name)
EndProcedure

Procedure InstructionCOMB_1051()         ; 1051DD   entries $1148-$114F
  ;name = "COMB"
  If (Op & $38) = 0
    Res = (Reg(Op & 7) ! $FF) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Res = ReadByte(Ea) ! $FF
    WriteByte(Ea, Res)
  EndIf
  FlagNZ = Res << 8
  FlagV = 0
  FlagC = 1
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("COMB " + ;name)
EndProcedure

;-INC-------------------------------------------------------------------
Procedure InstructionINC_0052()          ; 0052DD   entries $0150-$0157   C unaffected
  ;name = "INC"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = (Dst + 1) & $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = (Dst + 1) & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagV = 0
  If Dst = $7FFF
    FlagV = 1
  EndIf
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("INC " + ;name)
EndProcedure

Procedure InstructionINCB_1052()         ; 1052DD   entries $1150-$1157
  ;name = "INCB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
    Res = (Dst + 1) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Dst = ReadByte(Ea)
    Res = (Dst + 1) & $FF
    WriteByte(Ea, Res)
  EndIf
  FlagV = 0
  If Dst = $7F
    FlagV = 1
  EndIf
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("INCB " + ;name)
EndProcedure

;-DEC-------------------------------------------------------------------
Procedure InstructionDEC_0053()          ; 0053DD   entries $0158-$015F   C unaffected
  ;name = "DEC"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = (Dst - 1) & $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = (Dst - 1) & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagV = 0
  If Dst = $8000
    FlagV = 1
  EndIf
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("DEC " + ;name)
EndProcedure

Procedure InstructionDECB_1053()         ; 1053DD   entries $1158-$115F
  ;name = "DECB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
    Res = (Dst - 1) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Dst = ReadByte(Ea)
    Res = (Dst - 1) & $FF
    WriteByte(Ea, Res)
  EndIf
  FlagV = 0
  If Dst = $80
    FlagV = 1
  EndIf
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("DECB " + ;name)
EndProcedure

;-NEG-------------------------------------------------------------------
Procedure InstructionNEG_0054()          ; 0054DD   entries $0160-$0167
  ;name = "NEG"
  If (Op & $38) = 0
    Res = (0 - Reg(Op & 7)) & $FFFF      ; 100000 negates to itself
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Res = (0 - ReadWord(Ea)) & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagV = 0
  If Res = $8000
    FlagV = 1
  EndIf
  FlagC = 1
  If Res = 0
    FlagC = 0
  EndIf
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("NEG " + ;name)
EndProcedure

Procedure InstructionNEGB_1054()         ; 1054DD   entries $1160-$1167
  ;name = "NEGB"
  If (Op & $38) = 0
    Res = (0 - Reg(Op & 7)) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Res = (0 - ReadByte(Ea)) & $FF
    WriteByte(Ea, Res)
  EndIf
  FlagV = 0
  If Res = $80
    FlagV = 1
  EndIf
  FlagC = 1
  If Res = 0
    FlagC = 0
  EndIf
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("NEGB " + ;name)
EndProcedure

;-ADC-------------------------------------------------------------------
Procedure InstructionADC_0055()          ; 0055DD   entries $0168-$016F
  ;name = "ADC"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = (Dst + FlagC) & $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = (Dst + FlagC) & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagV = 0
  If Dst = $7FFF And FlagC = 1
    FlagV = 1
  EndIf
  If Dst <> $FFFF Or FlagC = 0
    FlagC = 0
  EndIf
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ADC " + ;name)
EndProcedure

Procedure InstructionADCB_1055()         ; 1055DD   entries $1168-$116F
  ;name = "ADCB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
    Res = (Dst + FlagC) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Dst = ReadByte(Ea)
    Res = (Dst + FlagC) & $FF
    WriteByte(Ea, Res)
  EndIf
  FlagV = 0
  If Dst = $7F And FlagC = 1
    FlagV = 1
  EndIf
  If Dst <> $FF Or FlagC = 0
    FlagC = 0
  EndIf
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ADCB " + ;name)
EndProcedure

;-SBC-------------------------------------------------------------------
; C: set if the destination was 0 and C was 1, cleared otherwise (the
; processor handbook's rule; the C core in this repository leaves C set
; when C was clear - worth checking against a real machine or a test).
Procedure InstructionSBC_0056()          ; 0056DD   entries $0170-$0177
  ;name = "SBC"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = (Dst - FlagC) & $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = (Dst - FlagC) & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagV = 0
  If Dst = $8000
    FlagV = 1
  EndIf
  If Dst <> 0 Or FlagC = 0
    FlagC = 0
  EndIf
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("SBC " + ;name)
EndProcedure

Procedure InstructionSBCB_1056()         ; 1056DD   entries $1170-$1177
  ;name = "SBCB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
    Res = (Dst - FlagC) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Dst = ReadByte(Ea)
    Res = (Dst - FlagC) & $FF
    WriteByte(Ea, Res)
  EndIf
  FlagV = 0
  If Dst = $80
    FlagV = 1
  EndIf
  If Dst <> 0 Or FlagC = 0
    FlagC = 0
  EndIf
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("SBCB " + ;name)
EndProcedure

;-TST-------------------------------------------------------------------
Procedure InstructionTST_0057()          ; 0057DD   entries $0178-$017F
  ;name = "TST"
  If (Op & $38) = 0
    FlagNZ = Reg(Op & 7)
  Else
    FlagNZ = ReadWord(EaWord(Op & $3F))
  EndIf
  FlagV = 0
  FlagC = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("TST " + ;name)
EndProcedure

Procedure InstructionTSTB_1057()         ; 1057DD   entries $1178-$117F
  ;name = "TSTB"
  If (Op & $38) = 0
    FlagNZ = (Reg(Op & 7) & $FF) << 8
  Else
    FlagNZ = ReadByte(EaByte(Op & $3F)) << 8
  EndIf
  FlagV = 0
  FlagC = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("TSTB " + ;name)
EndProcedure

; ======================================================================
;  SHIFTS AND ROTATES. V is N xor C after the operation.
; ======================================================================

;-ROR-------------------------------------------------------------------
Procedure InstructionROR_0060()          ; 0060DD   entries $0180-$0187
  ;name = "ROR"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = (Dst >> 1) | (FlagC << 15)
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = (Dst >> 1) | (FlagC << 15)
    WriteWord(Ea, Res)
  EndIf
  FlagC = Dst & 1
  FlagV = (Res >> 15) ! FlagC
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ROR " + ;name)
EndProcedure

Procedure InstructionRORB_1060()         ; 1060DD   entries $1180-$1187
  ;name = "RORB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
    Res = (Dst >> 1) | (FlagC << 7)
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Dst = ReadByte(Ea)
    Res = (Dst >> 1) | (FlagC << 7)
    WriteByte(Ea, Res)
  EndIf
  FlagC = Dst & 1
  FlagV = (Res >> 7) ! FlagC
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("RORB " + ;name)
EndProcedure

;-ROL-------------------------------------------------------------------
Procedure InstructionROL_0061()          ; 0061DD   entries $0188-$018F
  ;name = "ROL"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = ((Dst << 1) | FlagC) & $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = ((Dst << 1) | FlagC) & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagC = (Dst >> 15) & 1
  FlagV = (Res >> 15) ! FlagC
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ROL " + ;name)
EndProcedure

Procedure InstructionROLB_1061()         ; 1061DD   entries $1188-$118F
  ;name = "ROLB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
    Res = ((Dst << 1) | FlagC) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Dst = ReadByte(Ea)
    Res = ((Dst << 1) | FlagC) & $FF
    WriteByte(Ea, Res)
  EndIf
  FlagC = (Dst >> 7) & 1
  FlagV = (Res >> 7) ! FlagC
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ROLB " + ;name)
EndProcedure

;-ASR-------------------------------------------------------------------
Procedure InstructionASR_0062()          ; 0062DD   entries $0190-$0197
  ;name = "ASR"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = (Dst >> 1) | (Dst & $8000)
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = (Dst >> 1) | (Dst & $8000)
    WriteWord(Ea, Res)
  EndIf
  FlagC = Dst & 1
  FlagV = (Res >> 15) ! FlagC
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ASR " + ;name)
EndProcedure

Procedure InstructionASRB_1062()         ; 1062DD   entries $1190-$1197
  ;name = "ASRB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
    Res = (Dst >> 1) | (Dst & $80)
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Dst = ReadByte(Ea)
    Res = (Dst >> 1) | (Dst & $80)
    WriteByte(Ea, Res)
  EndIf
  FlagC = Dst & 1
  FlagV = (Res >> 7) ! FlagC
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ASRB " + ;name)
EndProcedure

;-ASL-------------------------------------------------------------------
Procedure InstructionASL_0063()          ; 0063DD   entries $0198-$019F
  ;name = "ASL"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = (Dst << 1) & $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = (Dst << 1) & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagC = (Dst >> 15) & 1
  FlagV = (Res >> 15) ! FlagC
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ASL " + ;name)
EndProcedure

Procedure InstructionASLB_1063()         ; 1063DD   entries $1198-$119F
  ;name = "ASLB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7) & $FF
    Res = (Dst << 1) & $FF
    Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  Else
    Ea = EaByte(Op & $3F)
    Dst = ReadByte(Ea)
    Res = (Dst << 1) & $FF
    WriteByte(Ea, Res)
  EndIf
  FlagC = (Dst >> 7) & 1
  FlagV = (Res >> 7) ! FlagC
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ASLB " + ;name)
EndProcedure

;-SWAB------------------------------------------------------------------
Procedure InstructionSWAB_0003()         ; 0003DD   entries $0018-$001F
  ;name = "SWAB"
  If (Op & $38) = 0
    Dst = Reg(Op & 7)
    Res = ((Dst >> 8) | (Dst << 8)) & $FFFF
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Dst = ReadWord(Ea)
    Res = ((Dst >> 8) | (Dst << 8)) & $FFFF
    WriteWord(Ea, Res)
  EndIf
  FlagNZ = (Res & $FF) << 8              ; N and Z come from the low byte
  FlagV = 0
  FlagC = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("SWAB " + ;name)
EndProcedure

;-SXT-------------------------------------------------------------------
Procedure InstructionSXT_0067()          ; 0067DD   entries $01B8-$01BF   N unaffected
  ;name = "SXT"
  Res = 0
  If FlagN()
    Res = $FFFF
  EndIf
  If (Op & $38) = 0
    Reg(Op & 7) = Res
  Else
    WriteWord(EaWord(Op & $3F), Res)
  EndIf
  SetNZ(FlagN(), 1 - FlagN())
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("SXT " + ;name)
EndProcedure

;-MFPS / MTPS ----------------------------------------------------------
Procedure InstructionMFPS_1067()         ; 1067DD   entries $11B8-$11BF
  ;name = "MFPS"
  Res = PswGet() & $FF
  If (Op & $38) = 0
    Reg(Op & 7) = (Res | (0 - (Res & $80))) & $FFFF   ; sign-extended into a register
  Else
    WriteByte(EaByte(Op & $3F), Res)
  EndIf
  FlagNZ = Res << 8
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("MFPS " + ;name)
EndProcedure

Procedure InstructionMTPS_1064()         ; 1064SS   entries $11A0-$11A7   the T bit is not written
  ;name = "MTPS"
  If (Op & $38) = 0
    Src = Reg(Op & 7) & $FF
  Else
    Src = ReadByte(EaByte(Op & $3F))
  EndIf
  PswSet((PswGet() & $FF10) | (Src & $EF))
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("MTPS " + ;name)
EndProcedure

;-MFPI / MTPI / MFPD / MTPD -------------------------------------------
; One address space until the memory management unit is modelled, so the
; "previous" space is this one.
Procedure InstructionMFPI_0065()         ; 0065SS   entries $01A8-$01AF
  ;name = "MFPI"
  If (Op & $38) = 0
    Src = Reg(Op & 7)
  Else
    Src = ReadWord(EaWord(Op & $3F))
  EndIf
  Push(Src)
  FlagNZ = Src
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("MFPI " + ;name)
EndProcedure

Procedure InstructionMTPI_0066()         ; 0066DD   entries $01B0-$01B7
  ;name = "MTPI"
  Src = Pop()
  If (Op & $38) = 0
    Reg(Op & 7) = Src
  Else
    WriteWord(EaWord(Op & $3F), Src)
  EndIf
  FlagNZ = Src
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("MTPI " + ;name)
EndProcedure

Procedure InstructionMFPD_1065()         ; 1065SS   entries $11A8-$11AF
  ;name = "MFPD"
  InstructionMFPI_0065()
  ;disassembly("MFPD " + ;name)
EndProcedure

Procedure InstructionMTPD_1066()         ; 1066DD   entries $11B0-$11B7
  ;name = "MTPD"
  InstructionMTPI_0066()
  ;disassembly("MTPD " + ;name)
EndProcedure

; ======================================================================
;  BRANCHES. The offset is the low byte, signed, in words:
;      PC = PC + 2 * offset
;  written without a branch as ((Op & $FF) << 1) - ((Op & $80) << 2).
;  Each branch owns 32 table entries (its offset spills into bits 7-3).
; ======================================================================
Procedure BranchTaken()
  Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
EndProcedure

;-BR--------------------------------------------------------------------
Procedure InstructionBR_0004()           ; 000400   entries $0020-$003F
  ;name = "BR"
  Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BR " + ;name)
EndProcedure

Procedure InstructionBNE_0010()          ; 001000   entries $0040-$005F   Z = 0
  ;name = "BNE"
  If FlagNZ & $FFFF
    Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BNE " + ;name)
EndProcedure

Procedure InstructionBEQ_0014()          ; 001400   entries $0060-$007F   Z = 1
  ;name = "BEQ"
  If (FlagNZ & $FFFF) = 0
    Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BEQ " + ;name)
EndProcedure

Procedure InstructionBGE_0020()          ; 002000   entries $0080-$009F   N xor V = 0
  ;name = "BGE"
  If FlagN() = FlagV
    BranchTaken()
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BGE " + ;name)
EndProcedure

Procedure InstructionBLT_0024()          ; 002400   entries $00A0-$00BF   N xor V = 1
  ;name = "BLT"
  If FlagN() <> FlagV
    BranchTaken()
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BLT " + ;name)
EndProcedure

Procedure InstructionBGT_0030()          ; 003000   entries $00C0-$00DF   Z or (N xor V) = 0
  ;name = "BGT"
  If (FlagNZ & $FFFF) <> 0 And FlagN() = FlagV
    BranchTaken()
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BGT " + ;name)
EndProcedure

Procedure InstructionBLE_0034()          ; 003400   entries $00E0-$00FF   Z or (N xor V) = 1
  ;name = "BLE"
  If (FlagNZ & $FFFF) = 0 Or FlagN() <> FlagV
    BranchTaken()
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BLE " + ;name)
EndProcedure

Procedure InstructionBPL_1000()          ; 100000   entries $1000-$101F   N = 0
  ;name = "BPL"
  If (FlagNZ & $18000) = 0
    Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BPL " + ;name)
EndProcedure

Procedure InstructionBMI_1004()          ; 100400   entries $1020-$103F   N = 1
  ;name = "BMI"
  If FlagNZ & $18000
    Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BMI " + ;name)
EndProcedure

Procedure InstructionBHI_1010()          ; 101000   entries $1040-$105F   C = 0 and Z = 0
  ;name = "BHI"
  If FlagC = 0 And (FlagNZ & $FFFF) <> 0
    BranchTaken()
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BHI " + ;name)
EndProcedure

Procedure InstructionBLOS_1014()         ; 101400   entries $1060-$107F   C = 1 or Z = 1
  ;name = "BLOS"
  If FlagC = 1 Or (FlagNZ & $FFFF) = 0
    BranchTaken()
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BLOS " + ;name)
EndProcedure

Procedure InstructionBVC_1020()          ; 102000   entries $1080-$109F   V = 0
  ;name = "BVC"
  If FlagV = 0
    Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BVC " + ;name)
EndProcedure

Procedure InstructionBVS_1024()          ; 102400   entries $10A0-$10BF   V = 1
  ;name = "BVS"
  If FlagV
    Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BVS " + ;name)
EndProcedure

Procedure InstructionBCC_1030()          ; 103000   entries $10C0-$10DF   C = 0 (also BHIS)
  ;name = "BCC"
  If FlagC = 0
    Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BCC " + ;name)
EndProcedure

Procedure InstructionBCS_1034()          ; 103400   entries $10E0-$10FF   C = 1 (also BLO)
  ;name = "BCS"
  If FlagC
    Reg(7) = (Reg(7) + ((Op & $FF) << 1) - ((Op & $80) << 2)) & $FFFF
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BCS " + ;name)
EndProcedure

; ======================================================================
;  JUMPS AND SUBROUTINES
; ======================================================================

;-JMP-------------------------------------------------------------------
Procedure InstructionJMP_0001()          ; 0001DD   entries $0008-$000F
  ;name = "JMP"
  If (Op & $38) = 0
    TrapVector = #VEC_BUS                ; JMP to a register is illegal
  Else
    Reg(7) = EaWord(Op & $3F)
  EndIf
  ClockCycles = ClockCycles + #J11_T_JUMP
  ;disassembly("JMP " + ;name)
EndProcedure

;-JSR-------------------------------------------------------------------
Procedure InstructionJSR_004()           ; 004RDD   entries $0100-$013F
  ;name = "JSR"
  If (Op & $38) = 0
    TrapVector = #VEC_BUS                ; JSR to a register is illegal
  Else
    Ea = EaWord(Op & $3F)
    Push(Reg((Op >> 6) & 7))
    Reg((Op >> 6) & 7) = Reg(7)
    Reg(7) = Ea
  EndIf
  ClockCycles = ClockCycles + #J11_T_JUMP
  ;disassembly("JSR " + ;name)
EndProcedure

;-RTS-------------------------------------------------------------------
Procedure InstructionRTS_00020()         ; 00020R   entry $0010
  ;name = "RTS"
  Reg(7) = Reg(Op & 7)
  Reg(Op & 7) = Pop()
  ClockCycles = ClockCycles + #J11_T_JUMP
  ;disassembly("RTS " + ;name)
EndProcedure

;-MARK------------------------------------------------------------------
Procedure InstructionMARK_0064()         ; 0064NN   entries $01A0-$01A7
  ;name = "MARK"
  Reg(6) = (Reg(7) + ((Op & $3F) << 1)) & $FFFF
  Reg(7) = Reg(5)
  Reg(5) = Pop()
  ClockCycles = ClockCycles + #J11_T_JUMP
  ;disassembly("MARK " + ;name)
EndProcedure

;-SOB-------------------------------------------------------------------
Procedure InstructionSOB_077()           ; 077RNN   entries $0FC0-$0FFF
  ;name = "SOB"
  Reg((Op >> 6) & 7) = (Reg((Op >> 6) & 7) - 1) & $FFFF
  If Reg((Op >> 6) & 7)
    Reg(7) = (Reg(7) - ((Op & $3F) << 1)) & $FFFF
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("SOB " + ;name)
EndProcedure

; ======================================================================
;  EIS - MUL, DIV, ASH, ASHC, XOR. Register in bits 8-6, operand in 5-0.
; ======================================================================

;-MUL-------------------------------------------------------------------
Procedure InstructionMUL_070()           ; 070RSS   entries $0E00-$0E3F
  ;name = "MUL"
  If (Op & $38) = 0
    Src = Reg(Op & 7)
  Else
    Src = ReadWord(EaWord(Op & $3F))
  EndIf
  Src = Src - ((Src & $8000) << 1)                        ; signed 16
  Dst = Reg((Op >> 6) & 7)
  Dst = Dst - ((Dst & $8000) << 1)
  Res = Src * Dst                                          ; fits in 32 bits
  If Op & $40                                              ; odd register: low word only
    Reg((Op >> 6) & 7) = Res & $FFFF
  Else
    Reg((Op >> 6) & 7) = (Res >> 16) & $FFFF
    Reg(((Op >> 6) & 7) | 1) = Res & $FFFF
  EndIf
  SetNZ(Bool(Res < 0), Bool(Res = 0))
  FlagV = 0
  FlagC = 0
  If Res < -32768 Or Res > 32767
    FlagC = 1
  EndIf
  ClockCycles = ClockCycles + #J11_T_EIS
  ;disassembly("MUL " + ;name)
EndProcedure

;-DIV-------------------------------------------------------------------
Procedure InstructionDIV_071()           ; 071RSS   entries $0E40-$0E7F
  ;name = "DIV"
  If (Op & $38) = 0
    Src = Reg(Op & 7)
  Else
    Src = ReadWord(EaWord(Op & $3F))
  EndIf
  Src = Src - ((Src & $8000) << 1)
  Dst = (Reg((Op >> 6) & 7) << 16) | Reg(((Op >> 6) & 7) | 1)   ; the 32-bit dividend
  If Src = 0
    FlagV = 1
    FlagC = 1
  ElseIf Src = -1 And Dst = $80000000
    FlagV = 1
    FlagC = 0
  Else
    Res = Dst / Src
    If Res < -32768 Or Res > 32767
      FlagV = 1                                            ; registers unchanged
      FlagC = 0
    Else
      Reg((Op >> 6) & 7) = Res & $FFFF
      Reg(((Op >> 6) & 7) | 1) = (Dst - Res * Src) & $FFFF
      SetNZ(Bool(Res < 0), Bool(Res = 0))
      FlagV = 0
      FlagC = 0
    EndIf
  EndIf
  ClockCycles = ClockCycles + #J11_T_EIS
  ;disassembly("DIV " + ;name)
EndProcedure

;-ASH-------------------------------------------------------------------
; Shift count is the low six bits of the source, signed: positive shifts
; left, negative shifts right. A loop - rare instruction, correct first.
Procedure InstructionASH_072()           ; 072RSS   entries $0E80-$0EBF
  ;name = "ASH"
  If (Op & $38) = 0
    Src = Reg(Op & 7) & $3F
  Else
    Src = ReadWord(EaWord(Op & $3F)) & $3F
  EndIf
  Res = Reg((Op >> 6) & 7)
  FlagV = 0
  If Src & $20
    Src = 64 - Src                                         ; right by this many
    While Src > 0
      FlagC = Res & 1
      Res = (Res >> 1) | (Res & $8000)
      Src = Src - 1
    Wend
  Else
    While Src > 0
      FlagC = (Res >> 15) & 1
      Tmp = (Res << 1) & $FFFF
      If (Tmp ! Res) & $8000
        FlagV = 1                                          ; the sign changed
      EndIf
      Res = Tmp
      Src = Src - 1
    Wend
  EndIf
  Reg((Op >> 6) & 7) = Res
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_EIS
  ;disassembly("ASH " + ;name)
EndProcedure

;-ASHC------------------------------------------------------------------
Procedure InstructionASHC_073()          ; 073RSS   entries $0EC0-$0EFF
  ;name = "ASHC"
  If (Op & $38) = 0
    Src = Reg(Op & 7) & $3F
  Else
    Src = ReadWord(EaWord(Op & $3F)) & $3F
  EndIf
  Res = (Reg((Op >> 6) & 7) << 16) | Reg(((Op >> 6) & 7) | 1)
  FlagV = 0
  If Src & $20
    Src = 64 - Src
    While Src > 0
      FlagC = Res & 1
      Res = Res >> 1                                       ; arithmetic on a 32-bit .i
      Src = Src - 1
    Wend
  Else
    While Src > 0
      FlagC = (Res >> 31) & 1
      Tmp = Res << 1
      If (Tmp ! Res) & $80000000
        FlagV = 1
      EndIf
      Res = Tmp
      Src = Src - 1
    Wend
  EndIf
  Reg((Op >> 6) & 7) = (Res >> 16) & $FFFF
  Reg(((Op >> 6) & 7) | 1) = Res & $FFFF
  SetNZ(Bool(Res < 0), Bool(Res = 0))
  ClockCycles = ClockCycles + #J11_T_EIS
  ;disassembly("ASHC " + ;name)
EndProcedure

;-XOR-------------------------------------------------------------------
Procedure InstructionXOR_074()           ; 074RDD   entries $0F00-$0F3F
  ;name = "XOR"
  If (Op & $38) = 0
    Res = Reg(Op & 7) ! Reg((Op >> 6) & 7)
    Reg(Op & 7) = Res
  Else
    Ea = EaWord(Op & $3F)
    Res = ReadWord(Ea) ! Reg((Op >> 6) & 7)
    WriteWord(Ea, Res)
  EndIf
  FlagNZ = Res
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_EIS
  ;disassembly("XOR " + ;name)
EndProcedure

; ======================================================================
;  TRAPS AND MACHINE CONTROL
; ======================================================================
Procedure InstructionEMT_104()           ; 104000-104377   entries $1100-$111F
  ;name = "EMT"
  TrapVector = #VEC_EMT
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("EMT " + ;name)
EndProcedure

Procedure InstructionTRAP_1044()         ; 104400-104777   entries $1120-$113F
  ;name = "TRAP"
  TrapVector = #VEC_TRAP
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("TRAP " + ;name)
EndProcedure

Procedure InstructionHALT_000000()       ; entry $0000, sub-decoded
  ;name = "HALT"
  Halted = 1
  Reg(7) = (Reg(7) - 2) & $FFFF          ; PC stays on the HALT, as on the console
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("HALT")
EndProcedure

Procedure InstructionWAIT_000001()       ; entry $0000, sub-decoded
  ;name = "WAIT"
  Waiting = 1
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("WAIT")
EndProcedure

Procedure InstructionRTI_000002()        ; entry $0000, sub-decoded
  ;name = "RTI"
  Reg(7) = Pop()
  PswSet(Pop())
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("RTI")
EndProcedure

Procedure InstructionBPT_000003()        ; entry $0000, sub-decoded
  ;name = "BPT"
  TrapVector = #VEC_BPT
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("BPT")
EndProcedure

Procedure InstructionIOT_000004()        ; entry $0000, sub-decoded
  ;name = "IOT"
  TrapVector = #VEC_IOT
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("IOT")
EndProcedure

Procedure InstructionRESET_000005()      ; entry $0000, sub-decoded - no devices yet
  ;name = "RESET"
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("RESET")
EndProcedure

Procedure InstructionRTT_000006()        ; entry $0000, sub-decoded (T-bit timing not modelled)
  ;name = "RTT"
  Reg(7) = Pop()
  PswSet(Pop())
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("RTT")
EndProcedure

Procedure InstructionMFPT_000007()       ; entry $0000, sub-decoded
  ;name = "MFPT"
  Reg(0) = 5                             ; processor type 5 = J-11
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("MFPT")
EndProcedure

Procedure InstructionSPL_00023()         ; 00023N   entry $0013
  ;name = "SPL"
  PswHigh = (PswHigh & $FF1F) | ((Op & 7) << 5)
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("SPL")
EndProcedure

; 000240-000277: bit 4 = set (1) or clear (0), bits 3-0 = N Z V C.
; 000240 is NOP, 000257 CCC, 000277 SCC.
Procedure InstructionCC_00024()          ; 00024x-00027x   entries $0014-$0017
  ;name = "CLx/SEx"
  Tmp = PswGet()
  If Op & $10
    Tmp = Tmp | (Op & $F)
  Else
    Tmp = Tmp & ~(Op & $F)
  EndIf
  PswSet(Tmp)
  ClockCycles = ClockCycles + #J11_T_MISC
  ;disassembly("CC")
EndProcedure

Procedure InstructionReserved()          ; every opcode this model does not execute
  ;name = "reserved"
  TrapVector = #VEC_RESV
  ClockCycles = ClockCycles + #J11_T_TRAP
  ;disassembly(".WORD")
EndProcedure

; ======================================================================
;  REGISTER FAST PATHS (Pico 2 only). One table entry per opcode means the
;  entry already knows both addressing modes, so the commonest forms -
;  both operands in registers, or a single operand in a register - get
;  handlers with no mode test and no operand-helper call. The general
;  handlers above still take every other form. Anything not listed here
;  (ADC, SBC, the byte rotates...) is correct through its general handler.
; ======================================================================

Procedure InstructionMOV_01_RR()               ; 01SD, both operands in registers
  ;name = "MOV Rs,Rd"
  Src = Reg((Op >> 6) & 7)
  Reg(Op & 7) = Src
  FlagNZ = Src
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("MOV " + ;name)
EndProcedure

Procedure InstructionCMP_02_RR()               ; 02SD, both operands in registers
  ;name = "CMP Rs,Rd"
  Src = Reg((Op >> 6) & 7)
  Dst = Reg(Op & 7)
  Res = Src - Dst
  FlagC = (Res >> 16) & 1
  FlagV = (((Src ! Dst) & (Src ! Res)) >> 15) & 1
  FlagNZ = Res & $FFFF
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("CMP " + ;name)
EndProcedure

Procedure InstructionBIT_03_RR()               ; 03SD, both operands in registers
  ;name = "BIT Rs,Rd"
  FlagNZ = Reg((Op >> 6) & 7) & Reg(Op & 7)
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BIT " + ;name)
EndProcedure

Procedure InstructionBIC_04_RR()               ; 04SD, both operands in registers
  ;name = "BIC Rs,Rd"
  Res = Reg(Op & 7) & ~Reg((Op >> 6) & 7) & $FFFF
  Reg(Op & 7) = Res
  FlagNZ = Res
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BIC " + ;name)
EndProcedure

Procedure InstructionBIS_05_RR()               ; 05SD, both operands in registers
  ;name = "BIS Rs,Rd"
  Res = Reg(Op & 7) | Reg((Op >> 6) & 7)
  Reg(Op & 7) = Res
  FlagNZ = Res
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BIS " + ;name)
EndProcedure

Procedure InstructionADD_06_RR()               ; 06SD, both operands in registers
  ;name = "ADD Rs,Rd"
  Src = Reg((Op >> 6) & 7)
  Dst = Reg(Op & 7)
  Res = Src + Dst
  Reg(Op & 7) = Res & $FFFF
  FlagC = (Res >> 16) & 1
  FlagV = ((~(Src ! Dst) & (Src ! Res)) >> 15) & 1
  FlagNZ = Res & $FFFF
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("ADD " + ;name)
EndProcedure

Procedure InstructionMOVB_11_RR()              ; 11SD, both operands in registers
  ;name = "MOVB Rs,Rd"
  Src = Reg((Op >> 6) & 7) & $FF
  Reg(Op & 7) = (Src | (0 - (Src & $80))) & $FFFF
  FlagNZ = Src << 8
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("MOVB " + ;name)
EndProcedure

Procedure InstructionCMPB_12_RR()              ; 12SD, both operands in registers
  ;name = "CMPB Rs,Rd"
  Src = Reg((Op >> 6) & 7) & $FF
  Dst = Reg(Op & 7) & $FF
  Res = Src - Dst
  FlagC = (Res >> 8) & 1
  FlagV = (((Src ! Dst) & (Src ! Res)) >> 7) & 1
  FlagNZ = (Res & $FF) << 8
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("CMPB " + ;name)
EndProcedure

Procedure InstructionBITB_13_RR()              ; 13SD, both operands in registers
  ;name = "BITB Rs,Rd"
  FlagNZ = (Reg((Op >> 6) & 7) & Reg(Op & 7) & $FF) << 8
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BITB " + ;name)
EndProcedure

Procedure InstructionBICB_14_RR()              ; 14SD, both operands in registers
  ;name = "BICB Rs,Rd"
  Res = Reg(Op & 7) & ~Reg((Op >> 6) & 7) & $FF
  Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  FlagNZ = Res << 8
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BICB " + ;name)
EndProcedure

Procedure InstructionBISB_15_RR()              ; 15SD, both operands in registers
  ;name = "BISB Rs,Rd"
  Res = (Reg(Op & 7) | Reg((Op >> 6) & 7)) & $FF
  Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  FlagNZ = Res << 8
  FlagV = 0
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("BISB " + ;name)
EndProcedure

Procedure InstructionSUB_16_RR()               ; 16SD, both operands in registers
  ;name = "SUB Rs,Rd"
  Src = Reg((Op >> 6) & 7)
  Dst = Reg(Op & 7)
  Res = Dst - Src
  Reg(Op & 7) = Res & $FFFF
  FlagC = (Res >> 16) & 1
  FlagV = (((Src ! Dst) & (Dst ! Res)) >> 15) & 1
  FlagNZ = Res & $FFFF
  ClockCycles = ClockCycles + #J11_T_DOUBLE
  ;disassembly("SUB " + ;name)
EndProcedure

Procedure InstructionCLR_0050_R()              ; 0050R, operand in a register
  ;name = "CLR Rd"
  Reg(Op & 7) = 0
  FlagNZ = 0
  FlagV = 0
  FlagC = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("CLR " + ;name)
EndProcedure

Procedure InstructionCOM_0051_R()              ; 0051R, operand in a register
  ;name = "COM Rd"
  Res = Reg(Op & 7) ! $FFFF
  Reg(Op & 7) = Res
  FlagNZ = Res
  FlagV = 0
  FlagC = 1
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("COM " + ;name)
EndProcedure

Procedure InstructionINC_0052_R()              ; 0052R, operand in a register
  ;name = "INC Rd"
  Dst = Reg(Op & 7)
  Res = (Dst + 1) & $FFFF
  Reg(Op & 7) = Res
  FlagV = 0
  If Dst = $7FFF
    FlagV = 1
  EndIf
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("INC " + ;name)
EndProcedure

Procedure InstructionDEC_0053_R()              ; 0053R, operand in a register
  ;name = "DEC Rd"
  Dst = Reg(Op & 7)
  Res = (Dst - 1) & $FFFF
  Reg(Op & 7) = Res
  FlagV = 0
  If Dst = $8000
    FlagV = 1
  EndIf
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("DEC " + ;name)
EndProcedure

Procedure InstructionNEG_0054_R()              ; 0054R, operand in a register
  ;name = "NEG Rd"
  Res = (0 - Reg(Op & 7)) & $FFFF
  Reg(Op & 7) = Res
  FlagV = 0
  If Res = $8000
    FlagV = 1
  EndIf
  FlagC = 1
  If Res = 0
    FlagC = 0
  EndIf
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("NEG " + ;name)
EndProcedure

Procedure InstructionTST_0057_R()              ; 0057R, operand in a register
  ;name = "TST Rd"
  FlagNZ = Reg(Op & 7)
  FlagV = 0
  FlagC = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("TST " + ;name)
EndProcedure

Procedure InstructionROR_0060_R()              ; 0060R, operand in a register
  ;name = "ROR Rd"
  Dst = Reg(Op & 7)
  Res = (Dst >> 1) | (FlagC << 15)
  Reg(Op & 7) = Res
  FlagC = Dst & 1
  FlagV = (Res >> 15) ! FlagC
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ROR " + ;name)
EndProcedure

Procedure InstructionROL_0061_R()              ; 0061R, operand in a register
  ;name = "ROL Rd"
  Dst = Reg(Op & 7)
  Res = ((Dst << 1) | FlagC) & $FFFF
  Reg(Op & 7) = Res
  FlagC = (Dst >> 15) & 1
  FlagV = (Res >> 15) ! FlagC
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ROL " + ;name)
EndProcedure

Procedure InstructionASR_0062_R()              ; 0062R, operand in a register
  ;name = "ASR Rd"
  Dst = Reg(Op & 7)
  Res = (Dst >> 1) | (Dst & $8000)
  Reg(Op & 7) = Res
  FlagC = Dst & 1
  FlagV = (Res >> 15) ! FlagC
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ASR " + ;name)
EndProcedure

Procedure InstructionASL_0063_R()              ; 0063R, operand in a register
  ;name = "ASL Rd"
  Dst = Reg(Op & 7)
  Res = (Dst << 1) & $FFFF
  Reg(Op & 7) = Res
  FlagC = (Dst >> 15) & 1
  FlagV = (Res >> 15) ! FlagC
  FlagNZ = Res
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("ASL " + ;name)
EndProcedure

Procedure InstructionSWAB_0003_R()             ; 0003R, operand in a register
  ;name = "SWAB Rd"
  Dst = Reg(Op & 7)
  Res = ((Dst >> 8) | (Dst << 8)) & $FFFF
  Reg(Op & 7) = Res
  FlagNZ = (Res & $FF) << 8
  FlagV = 0
  FlagC = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("SWAB " + ;name)
EndProcedure

Procedure InstructionCLRB_1050_R()             ; 1050R, operand in a register
  ;name = "CLRB Rd"
  Reg(Op & 7) = Reg(Op & 7) & $FF00
  FlagNZ = 0
  FlagV = 0
  FlagC = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("CLRB " + ;name)
EndProcedure

Procedure InstructionINCB_1052_R()             ; 1052R, operand in a register
  ;name = "INCB Rd"
  Dst = Reg(Op & 7) & $FF
  Res = (Dst + 1) & $FF
  Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  FlagV = 0
  If Dst = $7F
    FlagV = 1
  EndIf
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("INCB " + ;name)
EndProcedure

Procedure InstructionDECB_1053_R()             ; 1053R, operand in a register
  ;name = "DECB Rd"
  Dst = Reg(Op & 7) & $FF
  Res = (Dst - 1) & $FF
  Reg(Op & 7) = (Reg(Op & 7) & $FF00) | Res
  FlagV = 0
  If Dst = $80
    FlagV = 1
  EndIf
  FlagNZ = Res << 8
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("DECB " + ;name)
EndProcedure

Procedure InstructionTSTB_1057_R()             ; 1057R, operand in a register
  ;name = "TSTB Rd"
  FlagNZ = (Reg(Op & 7) & $FF) << 8
  FlagV = 0
  FlagC = 0
  ClockCycles = ClockCycles + #J11_T_SINGLE
  ;disassembly("TSTB " + ;name)
EndProcedure

; ======================================================================
;  BuildOpcodeTable - call once, before CpuRun.
; ======================================================================
Global FillFrom.i, FillCount.i, FillProc.i

Procedure FillOps()
  While FillCount > 0
    OpTable(FillFrom) = FillProc
    FillFrom = FillFrom + 1
    FillCount = FillCount - 1
  Wend
EndProcedure

Procedure Ops(from.i, count.i, proc.i)
  FillFrom = from
  FillCount = count
  FillProc = proc
  FillOps()
EndProcedure

Procedure BuildOpcodeTable()
  Protected i.i, s.i, d.i
  For i = 0 To 65535
    OpTable(i) = @InstructionReserved
  Next

  ; ---- 0000xx - 0003xx ----
  OpTable($0000) = @InstructionHALT_000000         ; 000000
  OpTable($0001) = @InstructionWAIT_000001         ; 000001
  OpTable($0002) = @InstructionRTI_000002          ; 000002
  OpTable($0003) = @InstructionBPT_000003          ; 000003
  OpTable($0004) = @InstructionIOT_000004          ; 000004
  OpTable($0005) = @InstructionRESET_000005        ; 000005
  OpTable($0006) = @InstructionRTT_000006          ; 000006
  OpTable($0007) = @InstructionMFPT_000007         ; 000007
  Ops($0040, 64, @InstructionJMP_0001)             ; 000100-000177
  Ops($0080, 8, @InstructionRTS_00020)            ; 000200-000207
  Ops($0098, 8, @InstructionSPL_00023)            ; 000230-000237
  Ops($00A0, 32, @InstructionCC_00024)             ; 000240-000277
  Ops($00C0, 64, @InstructionSWAB_0003)            ; 000300-000377

  ; ---- branches, JSR, single operand ----
  Ops($0100, 256, @InstructionBR_0004)
  Ops($0200, 256, @InstructionBNE_0010)
  Ops($0300, 256, @InstructionBEQ_0014)
  Ops($0400, 256, @InstructionBGE_0020)
  Ops($0500, 256, @InstructionBLT_0024)
  Ops($0600, 256, @InstructionBGT_0030)
  Ops($0700, 256, @InstructionBLE_0034)
  Ops($0800, 512, @InstructionJSR_004)
  Ops($0A00, 64, @InstructionCLR_0050)
  Ops($0A40, 64, @InstructionCOM_0051)
  Ops($0A80, 64, @InstructionINC_0052)
  Ops($0AC0, 64, @InstructionDEC_0053)
  Ops($0B00, 64, @InstructionNEG_0054)
  Ops($0B40, 64, @InstructionADC_0055)
  Ops($0B80, 64, @InstructionSBC_0056)
  Ops($0BC0, 64, @InstructionTST_0057)
  Ops($0C00, 64, @InstructionROR_0060)
  Ops($0C40, 64, @InstructionROL_0061)
  Ops($0C80, 64, @InstructionASR_0062)
  Ops($0CC0, 64, @InstructionASL_0063)
  Ops($0D00, 64, @InstructionMARK_0064)
  Ops($0D40, 64, @InstructionMFPI_0065)
  Ops($0D80, 64, @InstructionMTPI_0066)
  Ops($0DC0, 64, @InstructionSXT_0067)

  ; ---- double operand, word ----
  Ops($1000, 4096, @InstructionMOV_01)
  Ops($2000, 4096, @InstructionCMP_02)
  Ops($3000, 4096, @InstructionBIT_03)
  Ops($4000, 4096, @InstructionBIC_04)
  Ops($5000, 4096, @InstructionBIS_05)
  Ops($6000, 4096, @InstructionADD_06)

  ; ---- EIS ----
  Ops($7000, 512, @InstructionMUL_070)
  Ops($7200, 512, @InstructionDIV_071)
  Ops($7400, 512, @InstructionASH_072)
  Ops($7600, 512, @InstructionASHC_073)
  Ops($7800, 512, @InstructionXOR_074)
  Ops($7E00, 512, @InstructionSOB_077)

  ; ---- 10xxxx ----
  Ops($8000, 256, @InstructionBPL_1000)
  Ops($8100, 256, @InstructionBMI_1004)
  Ops($8200, 256, @InstructionBHI_1010)
  Ops($8300, 256, @InstructionBLOS_1014)
  Ops($8400, 256, @InstructionBVC_1020)
  Ops($8500, 256, @InstructionBVS_1024)
  Ops($8600, 256, @InstructionBCC_1030)
  Ops($8700, 256, @InstructionBCS_1034)
  Ops($8800, 256, @InstructionEMT_104)
  Ops($8900, 256, @InstructionTRAP_1044)
  Ops($8A00, 64, @InstructionCLRB_1050)
  Ops($8A40, 64, @InstructionCOMB_1051)
  Ops($8A80, 64, @InstructionINCB_1052)
  Ops($8AC0, 64, @InstructionDECB_1053)
  Ops($8B00, 64, @InstructionNEGB_1054)
  Ops($8B40, 64, @InstructionADCB_1055)
  Ops($8B80, 64, @InstructionSBCB_1056)
  Ops($8BC0, 64, @InstructionTSTB_1057)
  Ops($8C00, 64, @InstructionRORB_1060)
  Ops($8C40, 64, @InstructionROLB_1061)
  Ops($8C80, 64, @InstructionASRB_1062)
  Ops($8CC0, 64, @InstructionASLB_1063)
  Ops($8D00, 64, @InstructionMTPS_1064)
  Ops($8D40, 64, @InstructionMFPD_1065)
  Ops($8D80, 64, @InstructionMTPD_1066)
  Ops($8DC0, 64, @InstructionMFPS_1067)

  ; ---- double operand, byte, and SUB ----
  Ops($9000, 4096, @InstructionMOVB_11)
  Ops($A000, 4096, @InstructionCMPB_12)
  Ops($B000, 4096, @InstructionBITB_13)
  Ops($C000, 4096, @InstructionBICB_14)
  Ops($D000, 4096, @InstructionBISB_15)
  Ops($E000, 4096, @InstructionSUB_16)

  ; 17xxxx (floating point, $F000-$FFFF) stays reserved until the FPJ11 is modelled.

  ; ---- register fast paths: overlay the general entries ----
  For s = 0 To 7
    For d = 0 To 7
      OpTable($1000 | (s << 6) | d) = @InstructionMOV_01_RR
      OpTable($2000 | (s << 6) | d) = @InstructionCMP_02_RR
      OpTable($3000 | (s << 6) | d) = @InstructionBIT_03_RR
      OpTable($4000 | (s << 6) | d) = @InstructionBIC_04_RR
      OpTable($5000 | (s << 6) | d) = @InstructionBIS_05_RR
      OpTable($6000 | (s << 6) | d) = @InstructionADD_06_RR
      OpTable($9000 | (s << 6) | d) = @InstructionMOVB_11_RR
      OpTable($A000 | (s << 6) | d) = @InstructionCMPB_12_RR
      OpTable($B000 | (s << 6) | d) = @InstructionBITB_13_RR
      OpTable($C000 | (s << 6) | d) = @InstructionBICB_14_RR
      OpTable($D000 | (s << 6) | d) = @InstructionBISB_15_RR
      OpTable($E000 | (s << 6) | d) = @InstructionSUB_16_RR
    Next
  Next
  For d = 0 To 7
    OpTable($0A00 | d) = @InstructionCLR_0050_R
    OpTable($0A40 | d) = @InstructionCOM_0051_R
    OpTable($0A80 | d) = @InstructionINC_0052_R
    OpTable($0AC0 | d) = @InstructionDEC_0053_R
    OpTable($0B00 | d) = @InstructionNEG_0054_R
    OpTable($0BC0 | d) = @InstructionTST_0057_R
    OpTable($0C00 | d) = @InstructionROR_0060_R
    OpTable($0C40 | d) = @InstructionROL_0061_R
    OpTable($0C80 | d) = @InstructionASR_0062_R
    OpTable($0CC0 | d) = @InstructionASL_0063_R
    OpTable($00C0 | d) = @InstructionSWAB_0003_R
    OpTable($8A00 | d) = @InstructionCLRB_1050_R
    OpTable($8A80 | d) = @InstructionINCB_1052_R
    OpTable($8AC0 | d) = @InstructionDECB_1053_R
    OpTable($8BC0 | d) = @InstructionTSTB_1057_R
  Next
EndProcedure
