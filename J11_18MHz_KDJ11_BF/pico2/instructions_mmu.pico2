InstructionDIV_071M:           ; 071RSS   entries $0E40-$0E7F
CompilerIf #ASM_OPS = 1
  PcOutM()
  ;name = "DIV"
  If (Op & $38) = 0
    Reg(#CPU_SRC) = Reg(Op & 7)
  Else
CompilerIf #ASM_EA = 1
      ASM Uses Op, GBase
        and.w r0, r8, #0x3f
