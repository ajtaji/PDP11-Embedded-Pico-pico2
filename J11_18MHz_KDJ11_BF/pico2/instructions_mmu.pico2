    MMReadByte(Dst, Ea)
    Res = (Dst + ((FlagC >> 16) & 1)) & $FF
    MMWriteByte(Ea, Res)
  EndIf
  FlagV = 0
  If Dst = $7F And (FlagC & $10000) <> 0
