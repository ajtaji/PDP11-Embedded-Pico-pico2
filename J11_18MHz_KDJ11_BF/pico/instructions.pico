; ======================================================================
;  instructions.pico - the J-11 run loop: every instruction, and the jump
;  table that dispatches them. Raspberry Pi Pico (RP2040).
;
;  Requires cpu.pico - include it BEFORE this file. Call BuildOpcodeTable()
;  once (CpuRun does it itself if you do not), then CpuRun(n).
;
;  THE TABLE has 8192 entries indexed by the top thirteen bits of the
;  instruction (Op >> 3); only HALT..MFPT (000000-000007) share one, told
;  apart by a short If chain (InstructionGroup0_0000). An entry knows both
;  addressing modes and the source register, so the commonest forms get
;  handlers of their own laid over the general ones - see REGISTER FAST
;  PATHS and IMMEDIATE FAST PATHS near the foot.
;
;  ONE PROCEDURE, EVERY INSTRUCTION A LABEL IN IT. CpuRun() below is the
;  whole emulator: each instruction's handler is a label inside it, named
;  Instruction<MNEMONIC>_<octal> in the 8080 core's layout, and
;  OpTable() is a '.Label' table filled with ?Name. An instruction is
;  fetched and then entered with one computed jump,
;      Goto OpTable(Op >> 3)
;  and every handler ENDS with the same few lines, which fetch the next
;  instruction and make that jump themselves - so no handler returns, and
;  there is no call, no frame and no return anywhere between two emulated
;  instructions (threaded dispatch). The comment on each label gives the
;  octal opcode and the table entries it owns.
;
;  THE TAIL - the lines every handler ends with, written once as macros
;  (NextSynced, NextNative, NextNativeTrap, beside THE EMULATED PC below)
;  and expanded in place, so each handler still has its own copy:
;    1. A handler that works on Reg(7) - through a variable register number
;       or a helper (EaWord, FetchWord, Push, Pop, TakeTrap) - starts with
;       PcOut() and ends with NextSynced(), which takes the PC back and then
;       takes any trap it left (TrapVector) through SlowTail. A NATIVE
;       handler works on the PC register directly and cannot trap (the
;       branches, SOB R0-R6, SPL, the condition-code ops, and every fast
;       path): NextNative(). One that reads memory at the PC (an immediate)
;       ends with NextNativeTrap(). A handler that is changed to touch
;       memory or Reg(7) MUST change tail, or its traps or its PC are lost.
;    2. Count the instruction (RunLeft); at zero, the window ends (RunEnd).
;    3. Fetch the next word straight from RAM when the PC is in RAM (and,
;       after a synced handler, even), and jump through the table.
;       Anything else (the I/O page, an odd PC) goes to SlowFetch.
;  HALT ends with Goto SlowTail instead: SlowTail is the only place that
;  looks at Halted, and nothing but HALT sets it. Anything added that sets
;  Halted must end the same way.
;  The loop this replaced ran the same steps in the same order - execute,
;  take a trap, count, stop at n or at HALT, fetch - so every instruction
;  behaves exactly as it did.
;
;  WHY, MEASURED (2026-09-22, the report's own instructions/s, self-test
;  PASS on both boards; Pico W at 200 MHz, Pico 2 W at 150 MHz):
;                                        Pico W       Pico 2 W
;    table of procedures + CallFunctionFast   801,600      810,807
;    threaded, one shared tail               904,981      879,757
;    threaded, the tail in every handler     927,991      911,830
;    ... and the tail tightened (below)    1,020,407    1,030,837
;    ... and ReserveRegister (cpu.pico)   1,176,391    1,127,812
;  The speed pass of 2026-09-23 was measured on the DESK only (arm_run,
;  which reads about 37% slow on the Pico and 12% on the Pico 2 - compare
;  the rows, not the boards; silicon is owed). "mix" is 32.0 million
;  instructions of 19 diagnostic tapes, every machine state identical to
;  the version before the pass:              bench (Pico / Pico 2)   mix
;    before (3cd8915)                          748,475 / 1,023,854   528,614 /   650,709
;    the emulated PC in a register             932,780 / 1,492,426   601,030 /   760,522
;    V and C lazy (bit 15 / bit 16)            968,931 / 1,587,171   602,387 /   763,042
;    register fast paths on the Pico too     1,213,505 / 1,587,171   617,868 /   763,042
;    memory and operand access as macros     1,225,401 / 1,587,171   677,361 /   835,410
;    branch conditions inline                1,225,376 / 1,587,171   686,707 /   849,560
;    no Dst in ADD/SUB/CMP; Op,PC,Res,RunLeft 1,315,682 / 1,694,760  693,207 /   852,525
;    immediate fast paths (OP #n,Rd)         1,315,682 / 1,694,760   759,294 /   939,886
;    condition codes set in place; MOVB/CMPB/BITB #n
;                                            1,315,710 / 1,694,808   961,633 / 1,204,004 <- this file
;  The tightening: the PC test is written as two nested Ifs, not one
;  "a And b" (which builds two truth values and then ands them), and the
;  handlers that cannot trap drop the TrapVector test. Repeating the tail
;  in every handler costs flash (about 12 KB on the Pico, 15 KB on the
;  Pico 2) and is still the fastest of the threaded forms.
;
;  THE SHAPE OF A HANDLER, and why (see SPEED in cpu.pico):
;    * no Protected locals - Src, Dst, Res and Ea are Globals, cheaper here;
;    * register mode (mode 0) is tested for and done INLINE, so the common
;      case never pays for a call;
;    * N and Z are one store to FlagNZ (word result as is, byte result
;      shifted left 8); V and C are stored raw, V in bit 15 and C in bit
;      16, with no shift or mask (see SPEED in cpu.pico);
;    * ClockCycles is commented out (nothing reads it - CLOCK in cpu.pico); the
;      old lines that added to it are kept, commented, where it belongs.
;
;  ;name and ;disassembly lines are kept, commented out, as in the 8080
;  core this layout comes from - a disassembler can be switched in later
;  without touching the arithmetic.
; ======================================================================



; ======================================================================
;  THE RUN LOOP - one procedure, every handler a label inside it
; ======================================================================
Global Dim OpTable.Label(8192)
Global OpTableReady.i                    ; 0 until the first CpuRun fills OpTable
Global FillFrom.i, FillCount.i           ; Ops() - Globals, cheaper than locals

; OpTable(from) .. OpTable(from + count - 1) = target. A '.Label' can only
; be taken with ?Name inside the procedure that owns the label, so CpuRun
; itself passes its labels in; this only stores them.
Procedure Ops(from.i, count.i, target.Label)
  FillFrom = from
  FillCount = count
  While FillCount > 0
    OpTable(FillFrom) = target
    FillFrom = FillFrom + 1
    FillCount = FillCount - 1
  Wend
EndProcedure

; Execute up to n instructions. Returns how many ran.
ProcedureRAM.i CpuRun(n.i)
; ---- THE EMULATED PC (see PC in cpu) ----------------------------------
; Between instructions the emulated PC lives in PC, a register; Reg(7)
; is a stale copy. A handler that reaches Reg(7) through a variable
; register number, or calls a helper that does (EaWord, FetchWord, Push,
; Pop, TakeTrap, PswSet is fine), starts with PcOut() and ends with
; NextSynced(), which takes the PC back. Every other handler - the
; branches, SOB, and the register forms whose register cannot be R7 -
; works on PC directly and ends with NextNative().
Macro PcOut()
  Reg(7) = PC
EndMacro

; ---- UNMAPPED ONLY: the tails in assembly (tools/mmu_gen.py leaves this block out) ----
; THE TAILS IN ASSEMBLY (#ASM_TAILS = 1). The same steps as the macros in
; the Else branch below, written for the Cortex-M0+ with Op, PC and RunLeft
; used where they live (r8, r9, r11). It needs a compiler with "ASM Uses"
; (an assembly block that declares the reserved Globals it reads and
; writes: PureMetal Forge main f408822d or later); with #ASM_TAILS = 0 the
; file builds with an older compiler too. r0-r2 are free at a tail: every
; handler starts at a label, and nothing is held in a register across one.
; PC is always 0-$FFFF, so the unsigned compare is the signed one; a far
; branch is the assembler's own long form.
; Measured on a Pico W, 2026-10-03, compiler f408822d: see images/README.md.
#ASM_TAILS = 1
CompilerIf #ASM_TAILS = 1
Macro NextSynced()
  ASM Uses PC, RunLeft, Op
    ldr r1, =global_reg
    ldr r0, [r1, #28]
    mov r9, r0
    ldr r1, =global_trapvector
    ldr r1, [r1]
    cmp r1, #0
    bne __ul_cpurun_slowtail
    mov r1, r11
    subs r1, #1
    mov r11, r1
    beq __ul_cpurun_runend
    ldr r1, =#RAM_BYTES
    cmp r0, r1
    bhs __ul_cpurun_slowfetch
    lsrs r1, r0, #1
    bcs __ul_cpurun_slowfetch
    ldr r1, =global_mem
    ldrh r2, [r1, r0]
    mov r8, r2
    adds r0, #2
    mov r9, r0
    lsrs r2, r2, #3
    lsls r2, r2, #2
    ldr r1, =global_optable
    ldr r1, [r1, r2]
    bx r1
  EndASM
EndMacro

Macro NextNative()
  ASM Uses PC, RunLeft, Op
    mov r1, r11
    subs r1, #1
    mov r11, r1
    beq __ul_cpurun_runend
    mov r0, r9
    ldr r1, =#RAM_BYTES
    cmp r0, r1
    bhs __ul_cpurun_slowfetch
    ldr r1, =global_mem
    ldrh r2, [r1, r0]
    mov r8, r2
    adds r0, #2
    mov r9, r0
    lsrs r2, r2, #3
    lsls r2, r2, #2
    ldr r1, =global_optable
    ldr r1, [r1, r2]
    bx r1
  EndASM
EndMacro

Macro NextNativeTrap()
  If TrapVector
    Goto SlowTail
  EndIf
  NextNative()
EndMacro
CompilerElse
; ---- END UNMAPPED ONLY ----
; THE TAIL (see the top of this file), written once as macros and
; expanded in place at the end of every handler - a macro costs nothing
; at run time, so every handler still has its own copy of these lines.
; After a synced handler: take the PC back, take any trap, count, fetch.
Macro NextSynced()
  PC = Reg(7)
  If TrapVector
    Goto SlowTail
  EndIf
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If PC < #RAM_BYTES
    If (PC & 1) = 0
      Op = Mem(PC >> 1)
      PC = PC + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch
EndMacro

; After a native handler: it cannot trap and the PC it leaves is even (it
; was even when fetched, and a branch moves it by an even amount), so the
; only test left is whether it is still in RAM.
Macro NextNative()
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If PC < #RAM_BYTES
    Op = Mem(PC >> 1)
    PC = PC + 2
    Goto OpTable(Op >> 3)
  EndIf
  Goto SlowFetch
EndMacro

; After a native handler that read memory (an immediate operand): that
; read can leave a trap (the I/O page), so take it; otherwise as above.
Macro NextNativeTrap()
  If TrapVector
    Goto SlowTail
  EndIf
  NextNative()
EndMacro
; ---- UNMAPPED ONLY: the tails in assembly (tools/mmu_gen.py leaves this block out) ----
CompilerEndIf
; ---- END UNMAPPED ONLY ----

; A branch taken: the low byte of the instruction, signed, in words.
; Op << 24 puts the offset's sign in bit 31, and the arithmetic >> 23
; brings it back down already doubled and sign-extended.
Macro BranchTo()
  PC = (PC + ((Op << 24) >> 23)) & $FFFF
EndMacro

  If OpTableReady = 0
    Goto BuildTable
  EndIf
RunStart:
  If n <= 0 Or Halted <> 0
    ProcedureReturn 0
  EndIf
  PC = Reg(7)                            ; the caller may have set Reg(7)
  RunFrom = InstrCount
  RunBank = n
  RunLeft = 0
  RunWindow = 0
  Goto RunEnd                            ; which lets the devices act, then opens a window
Fetch:
  If PC < #RAM_BYTES
    If (PC & 1) = 0
      Op = Mem(PC >> 1)                  ; fast fetch, straight from RAM
      PC = PC + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
SlowFetch:                               ; the I/O page, an odd PC, past the end of RAM
  Reg(7) = PC
  Op = FetchWord()
  PC = Reg(7)
  If TrapVector                          ; the fetch itself failed (odd PC, nothing there):
    Goto SlowTail                        ; trap through 4 and execute nothing - it read as
  EndIf                                  ; 0, a HALT (MAINDEC-11-DFKAB test 100). The PC stays
                                         ; incremented, as on the J-11 (Architecture Handbook
                                         ; 1983, model differences 28 and 30)
  Goto OpTable(Op >> 3)
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- ASM (tools/asm_mov_gen.py) ----
CompilerIf #ASM_EA = 1
  ASM
__eaw1:
    mov r12, r0
    movs r1, #7
    ands r1, r0
    ldr r2, =global_eareg
    str r1, [r2]
    lsrs r0, r0, #3
    cmp r0, #6
    bne __eaw1_m4
    ldr r2, =global_reg
    ldr r3, [r2, #28]
    ldr r0, =#RAM_BYTES
    cmp r3, r0
    bhs __eaw1_slow
    lsrs r0, r3, #1
    bcs __eaw1_slow
    ldr r0, =global_adr
    str r3, [r0]
    ldr r0, =global_mem
    ldrh r0, [r0, r3]
    ldr r2, =global_tmp
    str r0, [r2]
    adds r3, #2
    uxth r3, r3
    ldr r2, =global_reg
    str r3, [r2, #28]
    lsls r1, r1, #2
    ldr r1, [r2, r1]
    adds r0, r0, r1
    uxth r0, r0
    bx lr
__eaw1_m4:
    cmp r0, #4
    bne __eaw1_m2
    cmp r1, #7
    beq __eaw1_slow
    ldr r2, =global_reg
    lsls r3, r1, #2
    ldr r0, [r2, r3]
    subs r0, #2
    uxth r0, r0
    cmp r1, #6
    bne __eaw1_m4a
    lsrs r1, r0, #8
    beq __eaw1_slow
__eaw1_m4a:
    str r0, [r2, r3]
    movs r1, #4
    ldr r2, =global_tmp
    str r1, [r2]
    bx lr
__eaw1_m2:
    cmp r0, #2
    bne __eaw1_m1
    ldr r2, =global_reg
    lsls r3, r1, #2
    ldr r0, [r2, r3]
    adds r1, r0, #2
    uxth r1, r1
    str r1, [r2, r3]
    ldr r2, =global_tmp
    str r0, [r2]
    bx lr
__eaw1_m1:
    cmp r0, #1
    bne __eaw1_slow
    ldr r2, =global_tmp
    str r0, [r2]
    ldr r2, =global_reg
    lsls r1, r1, #2
    ldr r0, [r2, r1]
    bx lr
__eaw1_slow:
    mov r0, r12
    ldr r1, =global_easpec
    str r0, [r1]
    push {lr}
    bl eaword
    pop {pc}
__eab1:
    mov r12, r0
    movs r1, #7
    ands r1, r0
    movs r2, #1
    cmp r1, #6
    blo __eab1_step
    movs r2, #2
__eab1_step:
    ldr r3, =global_eastep
    str r2, [r3]
    lsrs r3, r0, #3
    cmp r3, #2
    beq __eab1_inc
    cmp r3, #4
    beq __eab1_dec
    b __eaw1
__eab1_inc:
    ldr r3, =global_eareg
    str r1, [r3]
    lsls r1, r1, #2
    ldr r3, =global_reg
    ldr r0, [r3, r1]
    adds r2, r0, r2
    uxth r2, r2
    str r2, [r3, r1]
    ldr r3, =global_tmp
    str r0, [r3]
    bx lr
__eab1_dec:
    cmp r1, #7
    beq __eab1_slow
    lsls r1, r1, #2
    ldr r3, =global_reg
    ldr r0, [r3, r1]
    subs r0, r0, r2
    uxth r0, r0
    cmp r1, #24
    bne __eab1_commit
    lsrs r2, r0, #8
    beq __eab1_slow
__eab1_commit:
    str r0, [r3, r1]
    lsrs r1, r1, #2
    ldr r3, =global_eareg
    str r1, [r3]
    movs r1, #4
    ldr r3, =global_tmp
    str r1, [r3]
    bx lr
__eab1_slow:
    mov r0, r12
    ldr r1, =global_easpec
    str r0, [r1]
    push {lr}
    bl eabyte
    pop {pc}
  EndASM
CompilerEndIf
; ---- END ASM ----
; ---- END UNMAPPED ONLY ----

;-MOV-------------------------------------------------------------------
; ---- UNMAPPED ONLY: MOV by addressing mode (tools/mmu_gen.py leaves this block out) ----
; ---- INDEXED SINGLE NATIVE ----
InstructionIX_CLR_0050:
CompilerIf #ASM_INDEXED = 1
  ASM Uses PC, Op, FlagNZ
    mov r2, r9
    ldr r0, =#RAM_BYTES
    cmp r2, r0
    bhs __ix_clru_slow
    ldr r0, =global_mem
    ldrh r0, [r0, r2]
    mov r1, r8
    lsls r1, r1, #29
    lsrs r1, r1, #29
    cmp r1, #7
    beq __ix_clru_pc
    lsls r1, r1, #2
    ldr r2, =global_reg
    ldr r2, [r2, r1]
    b __ix_clru_base
__ix_clru_pc:
    mov r2, r9
    adds r2, #2
    uxth r2, r2
__ix_clru_base:
    adds r0, r0, r2
    uxth r0, r0
    lsrs r1, r0, #1
    bcs __ix_clru_slow
    ldr r3, =#RAM_BYTES
    cmp r0, r3
    bhs __ix_clru_slow
    ldr r3, =global_mem
    adds r3, r3, r0
    movs r0, #0
    strh r0, [r3]
    movs r4, #0
    movs r0, #0
    ldr r1, =global_flagv
    str r0, [r1]
    ldr r1, =global_flagc
    str r0, [r1]
    mov r0, r9
    adds r0, #2
    uxth r0, r0
    mov r9, r0
  EndASM
CompilerIf #DISK_BACKEND = 0
  SingleHit = SingleHit + 1
CompilerEndIf
  ASM Uses PC, Op, RunLeft
    mov r1, r11
    subs r1, #1
    mov r11, r1
    beq __ul_cpurun_runend
    mov r0, r9
    ldr r1, =#RAM_BYTES
    cmp r0, r1
    bhs __ul_cpurun_slowfetch
    ldr r1, =global_mem
    ldrh r2, [r1, r0]
    mov r8, r2
    adds r0, #2
    mov r9, r0
    lsrs r2, r2, #3
    lsls r2, r2, #2
    ldr r1, =global_optable
    ldr r1, [r1, r2]
    bx r1
  EndASM
  ASM
__ix_clru_slow:
  EndASM
CompilerEndIf
  Goto InstructionCLR_0050

