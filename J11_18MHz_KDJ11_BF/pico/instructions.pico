    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionBGE_0020:          ; 002000   entries $0080-$009F   N xor V = 0
  ;name = "BGE"
  If FlagN() = FlagV
    BranchTaken()
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BGE " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionBLT_0024:          ; 002400   entries $00A0-$00BF   N xor V = 1
  ;name = "BLT"
  If FlagN() <> FlagV
    BranchTaken()
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BLT " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionBGT_0030:          ; 003000   entries $00C0-$00DF   Z or (N xor V) = 0
  ;name = "BGT"
  If (FlagNZ & $FFFF) <> 0 And FlagN() = FlagV
    BranchTaken()
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BGT " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
  If RunLeft = 0
    Goto RunEnd
  EndIf
  If Reg(7) < #RAM_BYTES
    If (Reg(7) & 1) = 0
      Op = Mem(Reg(7) >> 1)
      Reg(7) = Reg(7) + 2
      Goto OpTable(Op >> 3)
    EndIf
  EndIf
  Goto SlowFetch

InstructionBLE_0034:          ; 003400   entries $00E0-$00FF   Z or (N xor V) = 1
  ;name = "BLE"
  If (FlagNZ & $FFFF) = 0 Or FlagN() <> FlagV
    BranchTaken()
  EndIf
  ClockCycles = ClockCycles + #J11_T_BRANCH
  ;disassembly("BLE " + ;name)
  ; ---- next instruction - this one cannot trap (THE TAIL, top of file) ----
  RunLeft = RunLeft - 1
